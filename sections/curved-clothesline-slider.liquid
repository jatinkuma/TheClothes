{% comment %}
  ==============================================================================
  CURVED CLOTHESLINE PRODUCT SLIDER
  ------------------------------------------------------------------------------
  A realistic curved rope clothesline product slider for Shopify.
  
  Key Features:
  - Realistic sagging curved clothesline rope (catenary parabolic curve)
  - Products move along the curved rope trajectory in real time:
    * As slides scroll, garments dip towards the center and rise at the edges
    * Garments tilt naturally along the tangent slope of the curved rope
  - Realistic wooden clothespins (pegs) stay pinned to the curved rope
  - Zero card containers, zero white boxes — products hang freely in air
  - Subtle independent swinging breeze animations per garment
  - Partial peek of neighboring garments at the edges
  - Smooth horizontal carousel movement (touch swipe, mouse drag, arrows)
  - Minimal floating typography below garments without card containers
  - Fallback demonstration regalia when no collection is assigned
  ==============================================================================
{% endcomment %}

{% liquid
  assign section_id = section.id
  assign collection = section.settings.collection
  assign products_limit = section.settings.products_to_show | default: 8
  assign show_pegs = section.settings.show_pegs
  assign enable_sway = section.settings.enable_breeze_sway
  assign enable_tilt = section.settings.enable_curve_tilt
  assign blend_mode = section.settings.blend_mode | default: 'multiply'
  assign sag_depth = section.settings.rope_sag | default: 70
%}

<div
  id="curved-clothesline-{{ section_id }}"
  class="curved-clothesline-section{% if enable_sway %} curved-sway-active{% endif %}"
  data-sag="{{ sag_depth }}"
  data-tilt="{{ enable_tilt }}"
  style="
    --ccl-bg: {{ section.settings.bg_color | default: '#FAF7F2' }};
    --ccl-text: {{ section.settings.text_color | default: '#1F1A16' }};
    --ccl-price: {{ section.settings.price_color | default: '#845A25' }};
    --ccl-rope-color: {{ section.settings.rope_color | default: '#9E703B' }};
    --ccl-cols-desktop: {{ section.settings.desktop_columns | default: 4 }};
    --ccl-cols-mobile: {{ section.settings.mobile_columns | default: '1.35' }};
    --ccl-gap: {{ section.settings.gap | default: 36 }}px;
    --ccl-pt: {{ section.settings.padding_top | default: 60 }}px;
    --ccl-pb: {{ section.settings.padding_bottom | default: 80 }}px;
    --ccl-blend: {{ blend_mode }};
    --ccl-sag: {{ sag_depth }}px;
  "
>
  <!-- Background Ambient Tint & Radiant Glow -->
  <div class="curved-bg-glow" aria-hidden="true"></div>

  <!-- Section Header -->
  {% if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank %}
    <header class="curved-header text-{{ section.settings.header_alignment | default: 'center' }}">
      <div class="curved-header-inner">
        {% if section.settings.subheading != blank %}
          <span class="curved-badge">{{ section.settings.subheading }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="curved-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="curved-description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <!-- Curved Clothesline Stage Container -->
  <div class="curved-stage" data-curved-stage>
    
    <!-- Left & Right Wooden Anchoring Posts -->
    <div class="curved-post post-left" aria-hidden="true">
      <div class="post-wood-pole"></div>
      <div class="post-iron-bracket"></div>
      <div class="post-rope-knot"></div>
    </div>
    <div class="curved-post post-right" aria-hidden="true">
      <div class="post-wood-pole"></div>
      <div class="post-iron-bracket"></div>
      <div class="post-rope-knot"></div>
    </div>

    <!-- Dynamic SVG Curved Clothesline Rope (Parabolic / Catenary Arc) -->
    <div class="curved-rope-svg-wrap" aria-hidden="true">
      <svg class="curved-rope-svg" data-rope-svg viewBox="0 0 1200 220" preserveAspectRatio="none">
        <defs>
          <!-- Braided Rope Pattern / Linear Gradient -->
          <linearGradient id="ropeTwistGrad-{{ section_id }}" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#73461a"/>
            <stop offset="25%" stop-color="#a8743a"/>
            <stop offset="50%" stop-color="#dfba85"/>
            <stop offset="75%" stop-color="#b07d43"/>
            <stop offset="100%" stop-color="#693d14"/>
          </linearGradient>

          <!-- Ambient Rope Drop Shadow -->
          <filter id="ropeShadow-{{ section_id }}" x="-10%" y="-20%" width="120%" height="200%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
            <feOffset dx="0" dy="5" result="offsetblur"/>
            <feComponentTransfer>
              <feFuncA type="linear" slope="0.32"/>
            </feComponentTransfer>
            <feMerge>
              <feMergeNode/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <!-- Ambient Shadow Curve -->
        <path
          class="rope-path-shadow"
          data-rope-shadow
          d="M 0,35 Q 600,175 1200,35"
          fill="none"
          stroke="rgba(35, 18, 5, 0.25)"
          stroke-width="7"
          stroke-linecap="round"
        />

        <!-- Main Twisted Braided Rope Curve -->
        <path
          class="rope-path-core"
          data-rope-core
          d="M 0,30 Q 600,170 1200,30"
          fill="none"
          stroke="url(#ropeTwistGrad-{{ section_id }})"
          stroke-width="{{ section.settings.rope_thickness | default: 5 }}"
          stroke-linecap="round"
          filter="url(#ropeShadow-{{ section_id }})"
        />

        <!-- Top Fiber Highlight Ridge -->
        <path
          class="rope-path-highlight"
          data-rope-highlight
          d="M 0,29 Q 600,169 1200,29"
          fill="none"
          stroke="rgba(255, 255, 255, 0.45)"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
    </div>

    <!-- Carousel Viewport & Scroll Track -->
    <div
      class="curved-viewport"
      data-curved-viewport
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.heading | default: 'Curved Clothesline Products' }}"
    >
      <ul class="curved-track" data-curved-track>
        {% assign item_counter = 0 %}

        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign item_counter = item_counter | plus: 1 %}
            {% case block.type %}
              {% when 'product' %}
                {% assign b_product = block.settings.product %}
                {% if b_product != blank %}
                  <li
                    class="curved-slide"
                    data-curved-slide
                    style="--item-index: {{ forloop.index0 }};"
                    {{ block.shopify_attributes }}
                  >
                    <div class="curved-hanging-unit sway-variant-{{ forloop.index | modulo: 4 }}">
                      {% if show_pegs %}
                        <div class="curved-peg peg-left" aria-hidden="true">
                          {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                        </div>
                        <div class="curved-peg peg-right" aria-hidden="true">
                          {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                        </div>
                      {% endif %}

                      <a href="{{ b_product.url }}" class="curved-product-link" aria-label="{{ b_product.title | escape }}">
                        <div class="curved-media-wrap">
                          {% if b_product.featured_image != blank %}
                            <img
                              src="{{ b_product.featured_image | image_url: width: 700 }}"
                              alt="{{ b_product.title | escape }}"
                              class="curved-garment-img"
                              loading="lazy"
                            >
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'curved-placeholder-svg' }}
                          {% endif %}
                        </div>
                      </a>

                      <div class="curved-typography">
                        {% if section.settings.show_vendor and b_product.vendor != blank %}
                          <span class="curved-vendor">{{ b_product.vendor }}</span>
                        {% endif %}

                        {% if section.settings.show_title %}
                          <h3 class="curved-item-title">
                            <a href="{{ b_product.url }}">{{ b_product.title }}</a>
                          </h3>
                        {% endif %}

                        {% if section.settings.show_price %}
                          <div class="curved-price-row">
                            <span class="curved-price">{{ b_product.price | money }}</span>
                            {% if b_product.compare_at_price > b_product.price %}
                              <s class="curved-compare-price">{{ b_product.compare_at_price | money }}</s>
                            {% endif %}
                          </div>
                        {% endif %}

                        {% if section.settings.show_quick_buy %}
                          <a href="{{ b_product.url }}" class="curved-action-cta">
                            {{ section.settings.quick_buy_text | default: 'View Piece' }}
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </li>
                {% endif %}

              {% when 'custom_item' %}
                <li
                  class="curved-slide"
                  data-curved-slide
                  style="--item-index: {{ forloop.index0 }};"
                  {{ block.shopify_attributes }}
                >
                  <div class="curved-hanging-unit sway-variant-{{ forloop.index | modulo: 4 }}">
                    {% if show_pegs %}
                      <div class="curved-peg peg-left" aria-hidden="true">
                        {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                      </div>
                      <div class="curved-peg peg-right" aria-hidden="true">
                        {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                      </div>
                    {% endif %}

                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}" class="curved-product-link">
                    {% else %}
                      <div class="curved-product-link">
                    {% endif %}
                      <div class="curved-media-wrap">
                        {% if block.settings.image != blank %}
                          <img
                            src="{{ block.settings.image | image_url: width: 700 }}"
                            alt="{{ block.settings.title | escape }}"
                            class="curved-garment-img"
                            loading="lazy"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'curved-placeholder-svg' }}
                        {% endif %}
                      </div>
                    {% if block.settings.link != blank %}
                      </a>
                    {% else %}
                      </div>
                    {% endif %}

                    <div class="curved-typography">
                      {% if block.settings.title != blank %}
                        <h3 class="curved-item-title">{{ block.settings.title }}</h3>
                      {% endif %}
                      {% if block.settings.price != blank %}
                        <div class="curved-price-row">
                          <span class="curved-price">{{ block.settings.price }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </li>
            {% endcase %}
          {% endfor %}

        {% elsif collection != blank and collection.products_count > 0 %}
          {% for product in collection.products limit: products_limit %}
            {% assign item_counter = item_counter | plus: 1 %}
            <li
              class="curved-slide"
              data-curved-slide
              style="--item-index: {{ forloop.index0 }};"
            >
              <div class="curved-hanging-unit sway-variant-{{ forloop.index | modulo: 4 }}">
                {% if show_pegs %}
                  <div class="curved-peg peg-left" aria-hidden="true">
                    {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                  </div>
                  <div class="curved-peg peg-right" aria-hidden="true">
                    {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                  </div>
                {% endif %}

                <a href="{{ product.url }}" class="curved-product-link" aria-label="{{ product.title | escape }}">
                  <div class="curved-media-wrap">
                    {% if product.featured_image != blank %}
                      <img
                        src="{{ product.featured_image | image_url: width: 700 }}"
                        alt="{{ product.title | escape }}"
                        class="curved-garment-img"
                        loading="lazy"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'curved-placeholder-svg' }}
                    {% endif %}
                  </div>
                </a>

                <div class="curved-typography">
                  {% if section.settings.show_vendor and product.vendor != blank %}
                    <span class="curved-vendor">{{ product.vendor }}</span>
                  {% endif %}

                  {% if section.settings.show_title %}
                    <h3 class="curved-item-title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                  {% endif %}

                  {% if section.settings.show_price %}
                    <div class="curved-price-row">
                      <span class="curved-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <s class="curved-compare-price">{{ product.compare_at_price | money }}</s>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if section.settings.show_quick_buy %}
                    <a href="{{ product.url }}" class="curved-action-cta">
                      {{ section.settings.quick_buy_text | default: 'View Piece' }}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  {% endif %}
                </div>
              </div>
            </li>
          {% endfor %}

        {% else %}
          {% comment %}
            FALLBACK SHOWCASE: Handcrafted Royal Regalia displayed along the curved rope
          {% endcomment %}
          {% assign demo_items = "Imperial Cream & Gold Sherwani:Rs. 48,000:royal-product-sherwani-cream.jpg|Sapphire Blue Jodhpuri:Rs. 52,000:royal-product-sherwani-blue.jpg|Heritage Emerald Silk Sherwani:Rs. 50,000:royal-product-sherwani-green.jpg|Ruby Red Ceremonial Sherwani:Rs. 54,000:royal-product-sherwani-red.jpg|Maharaja Royal Embroidered Safa:Rs. 18,500:royal-product-safa.jpg|Handcrafted Zardozi Mojari:Rs. 14,000:royal-product-mojari.jpg" | split: "|" %}
          
          {% for item in demo_items %}
            {% assign parts = item | split: ":" %}
            {% assign d_title = parts[0] %}
            {% assign d_price = parts[1] %}
            {% assign d_asset = parts[2] %}
            
            <li
              class="curved-slide"
              data-curved-slide
              style="--item-index: {{ forloop.index0 }};"
            >
              <div class="curved-hanging-unit sway-variant-{{ forloop.index | modulo: 4 }}">
                {% if show_pegs %}
                  <div class="curved-peg peg-left" aria-hidden="true">
                    {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                  </div>
                  <div class="curved-peg peg-right" aria-hidden="true">
                    {% render 'clothesline-peg-svg', style: section.settings.peg_style %}
                  </div>
                {% endif %}

                <div class="curved-product-link">
                  <div class="curved-media-wrap">
                    <img
                      src="{{ d_asset | asset_url }}"
                      alt="{{ d_title | escape }}"
                      class="curved-garment-img"
                      loading="lazy"
                    >
                  </div>
                </div>

                <div class="curved-typography">
                  {% if section.settings.show_vendor %}
                    <span class="curved-vendor">ROYAL ATELIER</span>
                  {% endif %}

                  {% if section.settings.show_title %}
                    <h3 class="curved-item-title">{{ d_title }}</h3>
                  {% endif %}

                  {% if section.settings.show_price %}
                    <div class="curved-price-row">
                      <span class="curved-price">{{ d_price }}</span>
                    </div>
                  {% endif %}

                  {% if section.settings.show_quick_buy %}
                    <span class="curved-action-cta">
                      {{ section.settings.quick_buy_text | default: 'View Piece' }}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  {% endif %}
                </div>
              </div>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>

    <!-- Navigation Arrows -->
    {% if section.settings.show_arrows %}
      <button
        type="button"
        class="curved-nav-arrow arrow-prev"
        data-curved-prev
        aria-label="Previous garments"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        type="button"
        class="curved-nav-arrow arrow-next"
        data-curved-next
        aria-label="Next garments"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}
  </div>

  <!-- Progress Wire Bead Indicator -->
  {% if section.settings.show_progress_bar %}
    <div class="curved-progress-zone" aria-hidden="true">
      <div class="curved-progress-rail">
        <div class="curved-progress-bead" data-curved-bead></div>
      </div>
    </div>
  {% endif %}
</div>

{% comment %}
  ==============================================================================
  STYLES: Catenary Curved Rope, Trajectory Motion & Breeze Physics
  ==============================================================================
{% endcomment %}
<style>
  /* 1. Base Container */
  .curved-clothesline-section {
    position: relative;
    width: 100%;
    background-color: var(--ccl-bg);
    color: var(--ccl-text);
    padding-top: var(--ccl-pt);
    padding-bottom: var(--ccl-pb);
    overflow: hidden;
    font-family: inherit;
  }

  .curved-bg-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    max-width: 1200px;
    height: 480px;
    background: radial-gradient(ellipse at 50% 20%, rgba(255, 235, 195, 0.42) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* 2. Header */
  .curved-header {
    position: relative;
    z-index: 3;
    max-width: 820px;
    margin: 0 auto 32px auto;
    padding: 0 24px;
  }
  .curved-header.text-left { text-align: left; margin-left: max(24px, 5vw); margin-right: auto; }
  .curved-header.text-center { text-align: center; }
  .curved-header.text-right { text-align: right; margin-right: max(24px, 5vw); margin-left: auto; }

  .curved-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ccl-price);
    background: rgba(160, 112, 59, 0.10);
    border: 1px solid rgba(160, 112, 59, 0.22);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .curved-title {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.18;
    color: var(--ccl-text);
    margin: 0 0 10px 0;
  }

  .curved-description {
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--ccl-text);
    opacity: 0.78;
    margin: 0;
  }

  /* 3. Curved Stage & SVG Rope */
  .curved-stage {
    position: relative;
    width: 100%;
    z-index: 3;
    padding-top: 10px;
    padding-bottom: 30px;
  }

  /* SVG Curved Rope Container */
  .curved-rope-svg-wrap {
    position: absolute;
    top: 14px;
    left: 0;
    width: 100%;
    height: 180px;
    z-index: 4;
    pointer-events: none;
    overflow: visible;
  }

  .curved-rope-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Rustic Wooden Anchoring Posts at Left and Right Edges */
  .curved-post {
    position: absolute;
    top: 18px;
    width: 38px;
    height: 58px;
    z-index: 7;
    pointer-events: none;
  }
  .curved-post.post-left { left: 0; }
  .curved-post.post-right { right: 0; transform: scaleX(-1); }

  .post-wood-pole {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 48px;
    background: linear-gradient(90deg, #382414 0%, #684525 60%, #442a17 100%);
    border-radius: 0 5px 5px 0;
    box-shadow: 2px 4px 6px rgba(0, 0, 0, 0.35);
  }
  .post-iron-bracket {
    position: absolute;
    top: 18px;
    left: 14px;
    width: 16px;
    height: 16px;
    border: 3.5px solid #ab824e;
    border-radius: 50%;
    box-shadow: 1px 2px 4px rgba(0,0,0,0.25);
  }
  .post-rope-knot {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 18px;
    height: 12px;
    background: #805324;
    border-radius: 6px;
    box-shadow: 1px 2px 4px rgba(0,0,0,0.3);
  }

  /* 4. Carousel Viewport & Track */
  .curved-viewport {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-left: max(24px, 5vw);
    padding-right: max(24px, 5vw);
    cursor: grab;
    user-select: none;
  }
  .curved-viewport::-webkit-scrollbar {
    display: none;
  }
  .curved-viewport:active {
    cursor: grabbing;
  }

  .curved-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--ccl-gap);
    width: max-content;
  }

  /* 5. Each Slide along the Track */
  .curved-slide {
    position: relative;
    flex: 0 0 calc((100vw - (max(24px, 5vw) * 2) - (var(--ccl-gap) * (var(--ccl-cols-desktop) - 1))) / var(--ccl-cols-desktop));
    min-width: 240px;
    max-width: 380px;
    scroll-snap-align: center;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
    padding: 0;
  }

  @media (max-width: 1024px) {
    .curved-slide {
      flex: 0 0 calc((100vw - (max(20px, 4vw) * 2) - (var(--ccl-gap) * 2)) / 3);
      min-width: 220px;
    }
  }

  @media (max-width: 768px) {
    .curved-slide {
      flex: 0 0 calc((100vw - 48px) / var(--ccl-cols-mobile));
      min-width: 200px;
    }
  }

  /* 6. Dynamic Curve Trajectory Unit & Breeze Sway Physics */
  .curved-hanging-unit {
    position: relative;
    width: 100%;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    transform-origin: 50% 28px;
    will-change: transform;
    /* Smooth real-time update along curve arc */
    transform: translate3d(0, var(--curve-y, 0px), 0) rotate(calc(var(--curve-tilt, 0deg) + var(--breeze-angle, 0deg)));
    transition: transform 0.08s linear;
  }

  /* Subtle Organic Breeze Sway Phase Offsets */
  .curved-sway-active .curved-hanging-unit.sway-variant-0 {
    animation: curved-breeze-0 4.8s ease-in-out infinite;
    animation-delay: -0.3s;
  }
  .curved-sway-active .curved-hanging-unit.sway-variant-1 {
    animation: curved-breeze-1 5.4s ease-in-out infinite;
    animation-delay: -2.0s;
  }
  .curved-sway-active .curved-hanging-unit.sway-variant-2 {
    animation: curved-breeze-2 4.2s ease-in-out infinite;
    animation-delay: -3.5s;
  }
  .curved-sway-active .curved-hanging-unit.sway-variant-3 {
    animation: curved-breeze-3 5.9s ease-in-out infinite;
    animation-delay: -1.1s;
  }

  @keyframes curved-breeze-0 {
    0%, 100% { --breeze-angle: -1.5deg; }
    50% { --breeze-angle: 1.7deg; }
  }
  @keyframes curved-breeze-1 {
    0%, 100% { --breeze-angle: 1.8deg; }
    50% { --breeze-angle: -1.6deg; }
  }
  @keyframes curved-breeze-2 {
    0%, 100% { --breeze-angle: -1.3deg; }
    50% { --breeze-angle: 1.4deg; }
  }
  @keyframes curved-breeze-3 {
    0%, 100% { --breeze-angle: 2.0deg; }
    50% { --breeze-angle: -1.7deg; }
  }

  /* Interactive Hover Sway */
  .curved-hanging-unit:hover {
    --breeze-angle: 3deg !important;
    transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.0);
  }

  /* 7. Clothespins Clamping to Curved Rope */
  .curved-peg {
    position: absolute;
    top: 4px; /* Clamps firmly over the rope line */
    width: 20px;
    height: 54px;
    z-index: 10;
    pointer-events: none;
    transform-origin: 50% 26px;
    filter: drop-shadow(2px 4px 4px rgba(25, 12, 0, 0.36));
  }
  .curved-peg.peg-left { left: 22%; }
  .curved-peg.peg-right { right: 22%; }

  .curved-product-link {
    display: block;
    text-decoration: none;
    color: inherit;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* 8. Garment Presentation (NO CARD CONTAINER) */
  .curved-media-wrap {
    position: relative;
    width: 100%;
    padding-top: 30px;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .curved-garment-img {
    display: block;
    width: 100%;
    height: 380px;
    max-height: 420px;
    object-fit: contain;
    background: transparent;
    border: none;
    box-shadow: none;
    mix-blend-mode: var(--ccl-blend);
    filter: drop-shadow(0 16px 24px rgba(0, 0, 0, 0.12));
    transition: filter 0.35s ease, transform 0.35s ease;
  }

  @media (max-width: 768px) {
    .curved-garment-img {
      height: 300px;
      max-height: 320px;
    }
  }

  .curved-hanging-unit:hover .curved-garment-img {
    filter: drop-shadow(0 22px 30px rgba(0, 0, 0, 0.18));
  }

  .curved-placeholder-svg {
    width: 100%;
    height: 340px;
    background: rgba(0,0,0,0.03);
    border-radius: 8px;
  }

  /* 9. Minimal Floating Typography Below */
  .curved-typography {
    margin-top: 18px;
    text-align: center;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 8px;
  }

  .curved-vendor {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ccl-price);
    opacity: 0.85;
    margin-bottom: 4px;
  }

  .curved-item-title {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.015em;
    color: var(--ccl-text);
    margin: 0 0 6px 0;
  }
  .curved-item-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .curved-item-title a:hover {
    color: var(--ccl-price);
  }

  .curved-price-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .curved-price {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ccl-price);
  }

  .curved-compare-price {
    font-size: 0.88rem;
    color: var(--ccl-text);
    opacity: 0.45;
    text-decoration: line-through;
  }

  .curved-action-cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ccl-text);
    text-decoration: none;
    opacity: 0.75;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .curved-action-cta:hover {
    opacity: 1;
    transform: translateX(2px);
  }

  /* 10. Navigation Arrows */
  .curved-nav-arrow {
    position: absolute;
    top: 48%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(160, 112, 59, 0.25);
    color: var(--ccl-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(40, 20, 5, 0.12);
    z-index: 12;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .curved-nav-arrow:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 18px rgba(40, 20, 5, 0.20);
    color: var(--ccl-price);
  }
  .curved-nav-arrow.arrow-prev { left: max(12px, 2vw); }
  .curved-nav-arrow.arrow-next { right: max(12px, 2vw); }

  @media (max-width: 768px) {
    .curved-nav-arrow {
      width: 36px;
      height: 36px;
    }
  }

  /* 11. Progress Rail */
  .curved-progress-zone {
    width: min(280px, 80%);
    margin: 24px auto 0 auto;
    position: relative;
    z-index: 3;
  }
  .curved-progress-rail {
    position: relative;
    width: 100%;
    height: 3px;
    background: rgba(160, 112, 59, 0.22);
    border-radius: 2px;
  }
  .curved-progress-bead {
    position: absolute;
    top: 50%;
    left: 0%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    background: var(--ccl-price);
    border: 2px solid #ffffff;
    border-radius: 50%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.25);
    transition: left 0.12s linear;
  }
</style>

{% comment %}
  ==============================================================================
  CURVE TRAJECTORY PHYSICS ENGINE (Synchronizes Motion Along Rope Arc)
  ==============================================================================
{% endcomment %}
<script>
  (function() {
    function initCurvedSlider(sectionId) {
      var root = document.getElementById("curved-clothesline-" + sectionId);
      if (!root) return;

      var stage = root.querySelector("[data-curved-stage]");
      var viewport = root.querySelector("[data-curved-viewport]");
      var track = root.querySelector("[data-curved-track]");
      var prevBtn = root.querySelector("[data-curved-prev]");
      var nextBtn = root.querySelector("[data-curved-next]");
      var progressBead = root.querySelector("[data-curved-bead]");
      var ropeSvg = root.querySelector("[data-rope-svg]");
      var ropeCore = root.querySelector("[data-rope-core]");
      var ropeShadow = root.querySelector("[data-rope-shadow]");
      var ropeHighlight = root.querySelector("[data-rope-highlight]");

      if (!stage || !viewport || !track) return;

      var sagDepth = parseFloat(root.dataset.sag) || 70;
      var enableTilt = root.dataset.tilt === "true";
      var slides = Array.prototype.slice.call(track.querySelectorAll("[data-curved-slide]"));

      var yAnchor = 30; // Vertical anchor at the posts

      // 1. Update SVG Rope Curve Path to dynamically match container width
      function updateSvgCurve() {
        var w = stage.clientWidth || 1200;
        var h = Math.max(160, yAnchor + sagDepth + 50);

        if (ropeSvg) {
          ropeSvg.setAttribute("viewBox", "0 0 " + w + " " + h);
          ropeSvg.style.height = h + "px";
        }

        // Quadratic Bézier: M 0,yAnchor Q (w/2),(yAnchor + 2*sagDepth) w,yAnchor
        // Passes exactly through yAnchor + sagDepth at x = w/2
        var p1Y = yAnchor + (2.0 * sagDepth);
        var pathData = "M 0," + yAnchor + " Q " + (w * 0.5) + "," + p1Y + " " + w + "," + yAnchor;
        var shadowData = "M 0," + (yAnchor + 4) + " Q " + (w * 0.5) + "," + (p1Y + 4) + " " + w + "," + (yAnchor + 4);
        var highlightData = "M 0," + (yAnchor - 1) + " Q " + (w * 0.5) + "," + (p1Y - 1) + " " + w + "," + (yAnchor - 1);

        if (ropeCore) ropeCore.setAttribute("d", pathData);
        if (ropeShadow) ropeShadow.setAttribute("d", shadowData);
        if (ropeHighlight) ropeHighlight.setAttribute("d", highlightData);
      }

      // 2. Real-Time Curve Trajectory Update: Products move along the exact curve arc
      var isTicking = false;

      function updateItemCurvePositions() {
        isTicking = false;
        var stageRect = stage.getBoundingClientRect();
        var stageW = stageRect.width || 1200;
        var stageCenterX = stageRect.left + (stageW * 0.5);
        var halfW = Math.max(1, stageW * 0.5);

        for (var i = 0; i < slides.length; i++) {
          var slide = slides[i];
          var rect = slide.getBoundingClientRect();
          var slideCenterX = rect.left + (rect.width * 0.5);
          var relX = slideCenterX - stageCenterX;

          // Normalized coordinate: -1 (left edge), 0 (center sag), +1 (right edge)
          var u = relX / halfW;
          u = Math.max(-1.35, Math.min(1.35, u));

          // Parabolic dip matching the SVG rope: y = sagDepth * (1 - u^2)
          // Center (u=0) dips lowest (+sagDepth); ends (u=±1) rise to 0
          var yDip = Math.max(0, sagDepth * (1.0 - (u * u)));

          // Rope Tangent slope: dy/dx = - (2 * sagDepth * u) / halfW
          var slope = - (2.0 * sagDepth * u) / halfW;
          var angleDeg = (Math.atan(slope) * 180) / Math.PI;

          // Natural tilt along the curve (clamped to ±11° for elegance)
          var tilt = enableTilt ? Math.max(-11, Math.min(11, angleDeg)) : 0;

          var unit = slide.querySelector(".curved-hanging-unit");
          if (unit) {
            unit.style.setProperty("--curve-y", yDip.toFixed(1) + "px");
            unit.style.setProperty("--curve-tilt", tilt.toFixed(2) + "deg");
          }
        }

        // Update progress bead
        if (progressBead) {
          var maxScroll = viewport.scrollWidth - viewport.clientWidth;
          if (maxScroll <= 0) {
            progressBead.style.left = "0%";
          } else {
            var prog = Math.min(1.0, Math.max(0.0, viewport.scrollLeft / maxScroll));
            progressBead.style.left = (prog * 100) + "%";
          }
        }
      }

      function requestCurveUpdate() {
        if (!isTicking) {
          isTicking = true;
          requestAnimationFrame(updateItemCurvePositions);
        }
      }

      // 3. Mouse Drag-to-Scroll Mechanics
      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var isDragging = false;

      viewport.addEventListener("mousedown", function(e) {
        isDown = true;
        isDragging = false;
        startX = e.pageX - viewport.offsetLeft;
        scrollLeft = viewport.scrollLeft;
        viewport.style.scrollBehavior = "auto";
      });

      window.addEventListener("mouseup", function() {
        if (!isDown) return;
        isDown = false;
        viewport.style.scrollBehavior = "smooth";
        setTimeout(function() { isDragging = false; }, 50);
      });

      viewport.addEventListener("mousemove", function(e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - viewport.offsetLeft;
        var walk = (x - startX) * 1.35;
        if (Math.abs(walk) > 5) isDragging = true;
        viewport.scrollLeft = scrollLeft - walk;
        requestCurveUpdate();
      });

      viewport.addEventListener("click", function(e) {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      // 4. Button Navigation
      function getScrollStep() {
        var firstSlide = track.querySelector(".curved-slide");
        if (firstSlide) {
          return firstSlide.offsetWidth + 36;
        }
        return viewport.clientWidth * 0.75;
      }

      if (prevBtn) {
        prevBtn.addEventListener("click", function() {
          viewport.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", function() {
          viewport.scrollBy({ left: getScrollStep(), behavior: "smooth" });
        });
      }

      // Event listeners
      viewport.addEventListener("scroll", requestCurveUpdate, { passive: true });
      window.addEventListener("resize", function() {
        updateSvgCurve();
        requestCurveUpdate();
      }, { passive: true });

      // Initial layout calculations
      updateSvgCurve();
      updateItemCurvePositions();
      setTimeout(function() {
        updateSvgCurve();
        updateItemCurvePositions();
      }, 120);

      // 5. Keyboard Navigation
      viewport.addEventListener("keydown", function(e) {
        if (e.key === "ArrowLeft") {
          viewport.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
        } else if (e.key === "ArrowRight") {
          viewport.scrollBy({ left: getScrollStep(), behavior: "smooth" });
        }
      });

      // 6. Optional Autoplay
      {% if section.settings.autoplay %}
        var autoInterval = ({{ section.settings.autoplay_speed | default: 5 }}) * 1000;
        var autoTimer = null;

        function startAutoplay() {
          if (autoTimer) clearInterval(autoTimer);
          autoTimer = setInterval(function() {
            var maxScroll = viewport.scrollWidth - viewport.clientWidth;
            if (viewport.scrollLeft >= maxScroll - 10) {
              viewport.scrollTo({ left: 0, behavior: "smooth" });
            } else {
              viewport.scrollBy({ left: getScrollStep(), behavior: "smooth" });
            }
          }, autoInterval);
        }

        function stopAutoplay() {
          if (autoTimer) clearInterval(autoTimer);
        }

        root.addEventListener("mouseenter", stopAutoplay);
        root.addEventListener("mouseleave", startAutoplay);
        root.addEventListener("touchstart", stopAutoplay, { passive: true });
        startAutoplay();
      {% endif %}
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function() {
        initCurvedSlider("{{ section_id }}");
      });
    } else {
      initCurvedSlider("{{ section_id }}");
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail && e.detail.sectionId === "{{ section_id }}") {
        initCurvedSlider("{{ section_id }}");
      }
    });
  })();
</script>

