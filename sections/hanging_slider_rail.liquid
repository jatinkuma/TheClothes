{% comment %}
  ==============================================================================
  SCENE RAIL: HANGING PRODUCT SLIDER (CURVED METALLIC RAIL)
  ------------------------------------------------------------------------------
  - 100% Transparent background (no white box or unwanted image background).
  - Both initial and hover images have the EXACT SAME HEIGHT (guaranteed equal height).
  - Left / Side view (Initial) has narrow width (width km).
  - Front view (Hovered) expands to broad width.
  - Smooth flex width expansion on hover; neighboring clothes part aside.
  - Realistic left-to-right pendulum sway ("kapde jaise hilte hain").
  - Curved SVG metallic rail across viewport.
  - Floating paper price tags with hole grommet.
  ==============================================================================
{% endcomment %}

{% assign garment_h = section.settings.garment_height | default: 320 %}
{% assign base_init_w = section.settings.initial_width | default: 110 %}
{% assign base_hov_w = section.settings.hover_width | default: 260 %}

<section
  id="sr-{{ section.id }}"
  class="sr-sec sr-vh-d sr-vh-m sr-shaped{% if section.settings.blend_white_mockups %} sr-blend-mode{% endif %}"
  data-sr-section=""
  data-sag="{{ section.settings.rail_sag | default: 40 }}"
  data-tilt="{{ section.settings.enable_tilt | default: 3 }}"
  data-hover-speed="{{ section.settings.hover_speed | default: 400 }}"
  data-garment-h="{{ garment_h }}"
  style="
    --sr-txt: {{ section.settings.text_color | default: 'inherit' }};
    --sr-acc: {{ section.settings.accent_color | default: 'inherit' }};
    --sr-hspd: {{ section.settings.hover_speed | default: 400 }}ms;
    --sr-w-init: {{ base_init_w }}px;
    --sr-w-hov: {{ base_hov_w }}px;
    --sr-gap: {{ section.settings.product_gap | default: 20 }}px;
    --sr-h-desk: {{ garment_h }}px;
    --sr-h-slide: {{ garment_h | times: 0.82 | round }}px;
    --sr-sway: {{ section.settings.sway_intensity | default: 2.5 }}deg;
    --sr-pt: {{ section.settings.padding_top | default: 60 }}px;
    --sr-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    --sr-tag-bg: {{ section.settings.tag_background | default: '#FAF9F5' }};
    --sr-tag-tx: {{ section.settings.tag_text | default: '#000000' }};
  "
>
  {% if section.settings.show_background_image and section.settings.background_image != blank %}
    <div
      class="sr-bg-image"
      style="
        background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
        background-position: {{ section.settings.image_focus | default: 'center' }};
      "
    ></div>
    {% if section.settings.overlay_opacity > 0 %}
      <div class="sr-ov" style="background: rgba(0,0,0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});" aria-hidden="true"></div>
    {% endif %}
  {% endif %}

  <div class="sr-wrap">
    <!-- Top Bar: Eyebrow Caption & Heading -->
    <div class="sr-top">
      {% if section.settings.eyebrow != blank or section.settings.eyebrow_sub != blank %}
        <div class="sr-railcap">
          {% if section.settings.eyebrow != blank %}
            <span class="sr-railcap-main">{{ section.settings.eyebrow | escape }}</span>
          {% endif %}
          {% if section.settings.eyebrow != blank and section.settings.eyebrow_sub != blank %}
            <span class="sr-railcap-sep" aria-hidden="true"></span>
          {% endif %}
          {% if section.settings.eyebrow_sub != blank %}
            <span class="sr-railcap-dim">{{ section.settings.eyebrow_sub | escape }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="sr-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    <!-- Stage: SVG Rod & Hanging Garments -->
    <div class="sr-stage" data-sr-stage="">
      {% assign rail_thick = section.settings.rail_thickness | default: 7 %}
      <!-- Dynamic SVG Curved Rod -->
      <svg
        class="sr-rodsvg"
        data-sr-rodsvg=""
        aria-hidden="true"
        focusable="false"
        width="100%"
        height="160"
        viewBox="0 0 1400 160"
        preserveAspectRatio="none"
      >
        <defs>
          <linearGradient id="srg-{{ section.id }}" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#ffffff"/>
            <stop offset="20%" stop-color="#e3e6e9"/>
            <stop offset="50%" stop-color="#9da3aa"/>
            <stop offset="85%" stop-color="#60666d"/>
            <stop offset="100%" stop-color="#3d4247"/>
          </linearGradient>
        </defs>
        <!-- Soft Rail Drop Shadow -->
        <path
          data-sr-rod-shadow=""
          d="M -30,22 Q 700,102 1430,22"
          fill="none"
          stroke="rgba(0,0,0,0.25)"
          stroke-width="{{ rail_thick | plus: 3 }}"
          stroke-linecap="butt"
        />
        <!-- Metallic Core -->
        <path
          data-sr-rod-core=""
          d="M -30,17 Q 700,97 1430,17"
          fill="none"
          stroke="url(#srg-{{ section.id }})"
          stroke-width="{{ rail_thick }}"
          stroke-linecap="butt"
        />
        <!-- Top Highlight -->
        <path
          data-sr-rod-highlight=""
          d="M -30,16 Q 700,96 1430,16"
          fill="none"
          stroke="rgba(255,255,255,0.75)"
          stroke-width="1.5"
          stroke-linecap="butt"
        />
      </svg>

      <!-- Rack of Hanging Items -->
      <div
        class="sr-rack{% if section.settings.enable_breeze %} sr-breeze-active{% endif %}"
        data-sr-rack=""
      >
        {% assign block_count = section.blocks.size %}

        {% if block_count > 0 %}
          <!-- MERCHANT BLOCKS: Exact Same Height, Auto Width -->
          {% for block in section.blocks %}
            {% assign linked_product = block.settings.product %}
            {% assign item_url = block.settings.custom_link | default: linked_product.url | default: '#' %}
            {% assign item_title = block.settings.custom_title | default: linked_product.title | default: 'Atelier Piece' %}
            
            {% assign item_price = block.settings.custom_price %}
            {% if item_price == blank and linked_product != blank %}
              {% assign item_price = linked_product.price | money %}
            {% endif %}
            {% if item_price == blank %}
              {% assign item_price = section.settings.default_tag_price | default: '$199' %}
            {% endif %}

            {% assign initial_img = block.settings.initial_image | default: linked_product.featured_image %}
            {% assign hover_img = block.settings.hover_image | default: linked_product.images[1] | default: initial_img %}
            {% assign back_img = block.settings.back_image | default: linked_product.images[2] %}
            {% assign offset_y = block.settings.drop_offset | default: 0 %}

            {% assign init_scale = block.settings.initial_scale | default: 100 | divided_by: 100.0 %}
            {% assign hover_scale = block.settings.hover_scale | default: 100 | divided_by: 100.0 %}

            <div
              class="sr-item"
              data-sr-item=""
              role="button"
              tabindex="0"
              aria-label="{{ item_title | escape }}"
              data-name="{{ item_title | escape }}"
              data-price="{{ item_price | escape }}"
              data-url="{{ item_url }}"
              data-idx="{{ forloop.index }}"
              style="
                --sr-drop: {{ offset_y }}px;
                --item-w-init: {{ base_init_w }}px;
                --item-w-hov: {{ base_hov_w }}px;
              "
              {{ block.shopify_attributes }}
            >
              <!-- Dedicated Hanging Sway Container -->
              <div class="sr-hang-sway">
                <!-- Metallic Hanger Hook -->
                <div class="sr-hanger-hook" aria-hidden="true">
                  <svg viewBox="0 0 24 38" fill="none">
                    <path d="M 12 16 C 12 7 19 4 19 11 C 19 14 17 16 13 18 C 12 19 12 21 12 26" stroke="#9da3a9" stroke-width="2.4" stroke-linecap="round"/>
                    <circle cx="19" cy="11" r="1.6" fill="#9da3a9"/>
                    <rect x="10" y="26" width="4" height="4" rx="1" fill="#4d3a2c"/>
                  </svg>
                </div>

                <!-- Price Tag -->
                {% if section.settings.show_tags %}
                  <div class="sr-tag sr-tag-single" aria-hidden="true">
                    <span class="sr-tag-cord"></span>
                    <div class="sr-tag-inner">
                      <span class="sr-tag-eyelet"></span>
                      <span class="sr-tag-face sr-tag-front">{{ item_price }}</span>
                    </div>
                  </div>
                {% endif %}

                <!-- Hanging Garment Images (Guaranteed Identical Height) -->
                <div class="sr-garment">
                  <!-- Initial Image (Side View - Narrow Width, Full 100% Height) -->
                  <div class="sr-view" data-sr-pos="0">
                    {% if initial_img != blank %}
                      <img
                        src="{{ initial_img | image_url: height: 800 }}"
                        alt="{{ item_title | escape }} – side"
                        loading="lazy"
                        decoding="async"
                        style="{% if init_scale != 1.0 %}transform: scale({{ init_scale }});{% endif %}"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'sr-placeholder' }}
                    {% endif %}
                  </div>

                  <!-- Hovered Image (Front View - Broad Width, Full 100% Height) -->
                  <div class="sr-view" data-sr-pos="1">
                    {% if hover_img != blank %}
                      <img
                        src="{{ hover_img | image_url: height: 800 }}"
                        alt="{{ item_title | escape }} – front"
                        loading="lazy"
                        decoding="async"
                        style="{% if hover_scale != 1.0 %}transform: scale({{ hover_scale }});{% endif %}"
                      >
                    {% endif %}
                  </div>

                  <!-- Optional Back View -->
                  {% if back_img != blank %}
                    <div class="sr-view" data-sr-pos="-1">
                      <img
                        src="{{ back_img | image_url: height: 800 }}"
                        alt="{{ item_title | escape }} – back"
                        loading="lazy"
                        decoding="async"
                      >
                    </div>
                  {% endif %}
                </div>
              </div>

              <!-- Floor Drop Shadow -->
              <div class="sr-item-shadow" aria-hidden="true"></div>
            </div>
          {% endfor %}

        {% else %}
          <!-- DEFAULT PREVIEW (Nike / Streetwear Reference Pieces) -->
          {% assign demo_items = "Blazzer|$199.00|2610071515248388|2610071514560224#Hoodie|$199.00|2610071514447647|2610071514403809#Hoodie Black|$199.00|2610071101516777|2610071101472773#Sweatshirt|$199.00|2610071517384792|2610071517318112#Sweatshirt Plus|$199.00|2610071517049148|2610071516592552#Tshirt|$199.00|2610071516549024|2610071515314737#Hoodie|$199.00|2610071514447647|2610071514403809#Blazzer|$199.00|2610071515248388|2610071514560224#Hoodie|$199.00|2610071514447647|2610071514403809#Sweatshirt|$199.00|2610071517384792|2610071517318112#Blazzer|$199.00|2610071515248388|2610071514560224#Sweatshirt Plus|$199.00|2610071517049148|2610071516592552#Hoodie|$199.00|2610071514447647|2610071514403809#Blazzer|$199.00|2610071515248388|2610071514560224#Sweatshirt Plus|$199.00|2610071517049148|2610071516592552" | split: "#" %}

          {% for d_str in demo_items %}
            {% assign d_parts = d_str | split: "|" %}
            {% assign d_name = d_parts[0] %}
            {% assign d_price = d_parts[1] %}
            {% assign d_side_id = d_parts[2] %}
            {% assign d_front_id = d_parts[3] %}
            {% assign is_center_demo = false %}
            {% if forloop.index == 8 %}{% assign is_center_demo = true %}{% endif %}

            <div
              class="sr-item{% if is_center_demo %} is-demo-center{% endif %}"
              data-sr-item=""
              role="button"
              tabindex="0"
              aria-label="{{ d_name }}"
              data-name="{{ d_name }}"
              data-price="{{ d_price }}"
              data-url="/collections/all"
              data-idx="{{ forloop.index }}"
              style="
                --item-w-init: {{ base_init_w }}px;
                --item-w-hov: {{ base_hov_w }}px;
              "
            >
              <!-- Dedicated Hanging Sway Container -->
              <div class="sr-hang-sway">
                <!-- Hook -->
                <div class="sr-hanger-hook" aria-hidden="true">
                  <svg viewBox="0 0 24 38" fill="none">
                    <path d="M 12 16 C 12 7 19 4 19 11 C 19 14 17 16 13 18 C 12 19 12 21 12 26" stroke="#9da3a9" stroke-width="2.4" stroke-linecap="round"/>
                    <circle cx="19" cy="11" r="1.6" fill="#9da3a9"/>
                    <rect x="10" y="26" width="4" height="4" rx="1" fill="#4d3a2c"/>
                  </svg>
                </div>

                <!-- Tag -->
                <div class="sr-tag sr-tag-single" aria-hidden="true">
                  <span class="sr-tag-cord"></span>
                  <div class="sr-tag-inner">
                    <span class="sr-tag-eyelet"></span>
                    <span class="sr-tag-face sr-tag-front">{{ d_price | split: "." | first }}</span>
                  </div>
                </div>

                <!-- Garment: Exact Same Height for Both Views -->
                <div class="sr-garment">
                  <!-- Side View -->
                  <div class="sr-view" data-sr-pos="0">
                    <img
                      src="https://nike-makknzjs.myshopify.com/cdn/shop/files/{{ d_side_id }}.webp?height=640"
                      alt="{{ d_name }} – side"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <!-- Front View -->
                  <div class="sr-view" data-sr-pos="1">
                    <img
                      src="https://nike-makknzjs.myshopify.com/cdn/shop/files/{{ d_front_id }}.webp?height=640"
                      alt="{{ d_name }} – front"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                </div>
              </div>

              <!-- Shadow -->
              <div class="sr-item-shadow" aria-hidden="true"></div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <!-- Bottom Bar: Hint, Interactive Progress Indicator & Corner CTA -->
    <div class="sr-foot">
      <!-- Peek Info (Bottom Left) -->
      <div class="sr-peek">
        <span class="sr-peek-hint sr-hint-d">{{ section.settings.footer_hint | escape }}</span>
        <span class="sr-peek-hint sr-hint-m">{{ section.settings.mobile_hint | escape }}</span>
        <div class="sr-peek-info">
          <span class="sr-peek-name" data-sr-pname="">Blazzer</span>
          <span class="sr-peek-price" data-sr-pprice="">$199.00</span>
        </div>
      </div>

      <!-- Center Progress Rail -->
      {% if section.settings.show_progress %}
        <div class="sr-prog" data-sr-prog="">
          <div class="sr-prog-track">
            <div class="sr-prog-bar" data-sr-prog-bar=""></div>
          </div>
        </div>
      {% endif %}

      <!-- Bottom Right Corner Message & CTA -->
      <div class="sr-corner">
        {% if section.settings.footer_text != blank %}
          <div class="sr-corner-h">{{ section.settings.footer_text | escape }}</div>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="sr-cta-link">
            <span>{{ section.settings.cta_label | escape }}</span>
            <svg class="sr-cta-ar" viewBox="0 0 14 10" fill="none">
              <path d="M 1 5 L 13 5 M 9 1 L 13 5 L 9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  /* ========================================================================= */
  /* 100% TRANSPARENT BACKGROUND (No White Box, No Overlays)                   */
  /* ========================================================================= */
  .sr-sec,
  .sr-wrap,
  .sr-stage,
  .sr-rack,
  .sr-item,
  .sr-hang-sway,
  .sr-garment,
  .sr-view {
    background: transparent !important;
    background-color: transparent !important;
  }

  .sr-sec {
    position: relative;
    color: var(--sr-txt, inherit);
    overflow: hidden;
    padding-top: var(--sr-pt, 60px);
    padding-bottom: var(--sr-pb, 48px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .sr-sec.sr-vh-d { min-height: 85vh; }
  @media (max-width: 768px) {
    .sr-sec.sr-vh-m { min-height: 80vh; }
  }

  .sr-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    z-index: 1;
  }
  .sr-ov {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .sr-wrap {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    width: 100%;
  }

  /* Top Caption & Header */
  .sr-top {
    text-align: center;
    padding: 0 24px 20px 24px;
    z-index: 6;
  }
  .sr-railcap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.82;
    margin-bottom: 12px;
  }
  .sr-railcap-sep {
    display: inline-block;
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }
  .sr-railcap-dim {
    opacity: 0.65;
  }
  .sr-heading {
    font-size: clamp(28px, 4.2vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }

  /* Stage & SVG Rod */
  .sr-stage {
    position: relative;
    width: 100%;
    margin: 20px 0 10px 0;
    overflow: visible;
  }
  .sr-rodsvg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    z-index: 4;
    overflow: visible;
  }

  /* Rack & Horizontal Track */
  .sr-rack {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    gap: var(--sr-gap, 20px);
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    touch-action: pan-y;
    padding: 34px max(40px, 5vw) 26px max(40px, 5vw);
  }
  .sr-rack::-webkit-scrollbar { display: none; }
  .sr-rack.is-dragging { cursor: grabbing; }

  /* ========================================================================= */
  /* GARMENT ITEM CONTAINER (Narrow Side Width -> Expands on Hover)            */
  /* ========================================================================= */
  .sr-item {
    position: relative;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    outline: none;
    cursor: pointer;
    /* Narrow side width */
    width: var(--item-w-init, var(--sr-w-init, 110px));
    transform-origin: 50% 0%;
    transform: translate3d(0, calc(var(--curve-y, 0px) + var(--sr-drop, 0px)), 0) rotate(var(--curve-tilt, 0deg));
    transition: width var(--sr-hspd) cubic-bezier(0.25, 1, 0.5, 1), transform 0.08s linear;
    will-change: width, transform;
  }

  /* Hover & Active: Width smoothly expands, parting neighbor clothes */
  .sr-item:hover,
  .sr-item:focus-visible,
  .sr-item.is-active {
    width: var(--item-w-hov, var(--sr-w-hov, 260px));
    z-index: 10;
  }

  /* Default center demo item in unhovered state */
  .sr-rack:not(:hover):not(.has-active-item) .sr-item.is-demo-center {
    width: var(--item-w-hov, var(--sr-w-hov, 260px));
    z-index: 10;
  }

  /* ========================================================================= */
  /* REALISTIC PENDULUM SWAY (Hook, Tag & Garment swing left-to-right)          */
  /* ========================================================================= */
  .sr-hang-sway {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 6px; /* Pivots from hanger hook contact on the rod */
    will-change: transform;
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Breeze Sway Keyframe: Sinusoidal Left-to-Right Pendulum Motion */
  @keyframes srHangSway {
    0% {
      transform: rotate(calc(-1 * var(--sr-sway, 2.5deg)));
    }
    100% {
      transform: rotate(calc(1 * var(--sr-sway, 2.5deg)));
    }
  }

  /* Staggered Natural Timing for Each Hanging Garment */
  .sr-breeze-active .sr-item .sr-hang-sway {
    animation: srHangSway 4.8s ease-in-out infinite alternate;
  }
  .sr-breeze-active .sr-item:nth-child(2n) .sr-hang-sway {
    animation-duration: 5.4s;
    animation-delay: -1.5s;
  }
  .sr-breeze-active .sr-item:nth-child(3n) .sr-hang-sway {
    animation-duration: 4.2s;
    animation-delay: -2.8s;
  }
  .sr-breeze-active .sr-item:nth-child(4n) .sr-hang-sway {
    animation-duration: 5.8s;
    animation-delay: -0.8s;
  }
  .sr-breeze-active .sr-item:nth-child(5n) .sr-hang-sway {
    animation-duration: 4.6s;
    animation-delay: -3.4s;
  }
  .sr-breeze-active .sr-item:nth-child(6n) .sr-hang-sway {
    animation-duration: 5.1s;
    animation-delay: -2.1s;
  }
  .sr-breeze-active .sr-item:nth-child(7n) .sr-hang-sway {
    animation-duration: 4.4s;
    animation-delay: -1.2s;
  }
  .sr-breeze-active .sr-item:nth-child(8n) .sr-hang-sway {
    animation-duration: 5.6s;
    animation-delay: -3.9s;
  }

  /* On Hover: Garment straightens upright (0deg) and lifts slightly (-8px) */
  .sr-item:hover .sr-hang-sway,
  .sr-item:focus-visible .sr-hang-sway,
  .sr-item.is-active .sr-hang-sway {
    animation: none !important;
    transform: translateY(-8px) rotate(0deg) !important;
  }

  .sr-rack:not(:hover):not(.has-active-item) .sr-item.is-demo-center .sr-hang-sway {
    animation: none !important;
    transform: translateY(-4px) rotate(0deg) !important;
  }

  /* ========================================================================= */
  /* HANGER HOOK & REALISTIC PRICE TAG                                         */
  /* ========================================================================= */
  .sr-hanger-hook {
    position: relative;
    width: 24px;
    height: 38px;
    margin-top: -3px;
    margin-bottom: -10px;
    z-index: 6;
    pointer-events: none;
  }
  .sr-hanger-hook svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.18));
  }

  /* Price Tag */
  .sr-tag {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 7;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sr-tag-cord {
    display: block;
    width: 1px;
    height: 10px;
    background: rgba(80, 80, 80, 0.55);
  }
  .sr-tag-inner {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: var(--sr-tag-bg, #FAF9F5);
    color: var(--sr-tag-tx, #000000);
    padding: 3px 8px 3px 7px;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .sr-tag-eyelet {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #e8eaed;
    border: 1px solid #70757a;
    box-sizing: border-box;
  }

  /* ========================================================================= */
  /* GARMENT DISPLAY (GUARANTEED IDENTICAL HEIGHT FOR BOTH INITIAL & HOVER)    */
  /* ========================================================================= */
  .sr-garment {
    position: relative;
    /* Height is fixed and identical for both side and front views */
    height: var(--sr-h-desk, 320px);
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    perspective: 800px;
  }

  /* Views are centered absolutely without width clamping */
  .sr-view {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: var(--sr-h-desk, 320px);
    width: max-content;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    transform-origin: 50% 10%;
    backface-visibility: hidden;
    transition: opacity var(--sr-hspd) cubic-bezier(0.25, 1, 0.5, 1),
                transform var(--sr-hspd) cubic-bezier(0.25, 1, 0.5, 1);
    will-change: opacity, transform;
    pointer-events: none;
  }

  /* 
   * CRITICAL FIX FOR EQUAL HEIGHT:
   * Both images are locked to the EXACT same vertical height (var(--sr-h-desk)).
   * max-width: none ensures neither image shrinks vertically in narrow containers!
   */
  .sr-view img {
    display: block;
    height: var(--sr-h-desk, 320px) !important;
    width: auto !important;
    max-height: var(--sr-h-desk, 320px) !important;
    max-width: none !important;
    object-fit: contain;
    object-position: top center;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.12));
    transition: filter var(--sr-hspd) ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Blend mode to knock out white backgrounds from mockups if enabled */
  .sr-blend-mode .sr-view img {
    mix-blend-mode: multiply;
  }

  /* Initial Image (Side View): Visible by default, full height */
  .sr-view[data-sr-pos="0"] {
    opacity: 1;
    transform: translateX(-50%) rotateY(0deg);
    z-index: 2;
  }

  /* Hovered Image (Front View): Hidden by default, full height */
  .sr-view[data-sr-pos="1"] {
    opacity: 0;
    transform: translateX(-50%) rotateY(-25deg);
    z-index: 3;
  }

  /* Optional Back View */
  .sr-view[data-sr-pos="-1"] {
    opacity: 0;
    transform: translateX(-50%) rotateY(25deg);
    z-index: 1;
  }

  /* HOVER TRANSITION: Cross-fade & Turn into Front View */
  .sr-item:hover .sr-view[data-sr-pos="0"],
  .sr-item:focus-visible .sr-view[data-sr-pos="0"],
  .sr-item.is-active .sr-view[data-sr-pos="0"] {
    opacity: 0;
    transform: translateX(-50%) rotateY(25deg);
  }

  .sr-item:hover .sr-view[data-sr-pos="1"],
  .sr-item:focus-visible .sr-view[data-sr-pos="1"],
  .sr-item.is-active .sr-view[data-sr-pos="1"] {
    opacity: 1;
    transform: translateX(-50%) rotateY(0deg);
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.22));
  }

  /* Center demo item in default state */
  .sr-rack:not(:hover):not(.has-active-item) .sr-item.is-demo-center .sr-view[data-sr-pos="0"] {
    opacity: 0;
    transform: translateX(-50%) rotateY(25deg);
  }
  .sr-rack:not(:hover):not(.has-active-item) .sr-item.is-demo-center .sr-view[data-sr-pos="1"] {
    opacity: 1;
    transform: translateX(-50%) rotateY(0deg);
  }

  /* Floor Shadow */
  .sr-item-shadow {
    position: absolute;
    bottom: -16px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 12px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    transition: transform var(--sr-hspd) ease, opacity var(--sr-hspd) ease;
  }
  .sr-item:hover .sr-item-shadow,
  .sr-item.is-active .sr-item-shadow,
  .sr-rack:not(:hover):not(.has-active-item) .sr-item.is-demo-center .sr-item-shadow {
    transform: translateX(-50%) scale(1.4);
    opacity: 0.85;
  }

  /* ========================================================================= */
  /* FOOTER & PROGRESS BAR                                                     */
  /* ========================================================================= */
  .sr-foot {
    position: relative;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px max(40px, 5vw) 0 max(40px, 5vw);
    gap: 24px;
  }
  @media (max-width: 768px) {
    .sr-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding-left: 20px;
      padding-right: 20px;
    }
    .sr-garment,
    .sr-view,
    .sr-view img {
      height: var(--sr-h-slide, 260px) !important;
      max-height: var(--sr-h-slide, 260px) !important;
    }
    .sr-item {
      width: var(--item-w-init, 90px);
    }
    .sr-item:hover,
    .sr-item:focus-visible,
    .sr-item.is-active,
    .sr-rack:not(:hover):not(.has-active-item) .sr-item.is-demo-center {
      width: var(--item-w-hov, 220px);
    }
  }

  /* Peek Info (Bottom Left) */
  .sr-peek {
    font-size: 12px;
    opacity: 0.88;
  }
  .sr-peek-hint {
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.02em;
  }
  .sr-hint-m { display: none; }
  @media (max-width: 768px) {
    .sr-hint-d { display: none; }
    .sr-hint-m { display: block; }
  }
  .sr-peek-info {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .sr-peek-name {
    font-size: 14px;
    font-weight: 700;
  }
  .sr-peek-price {
    font-size: 14px;
    font-weight: 600;
    opacity: 0.85;
  }

  /* Progress Rail */
  .sr-prog {
    flex-grow: 1;
    max-width: 260px;
    margin: 0 auto;
  }
  .sr-prog-track {
    position: relative;
    width: 100%;
    height: 2px;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
  }
  .sr-prog-track::before {
    content: "";
    position: absolute;
    left: 0;
    top: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.2;
  }
  .sr-prog-track::after {
    content: "";
    position: absolute;
    right: 0;
    top: -2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.2;
  }
  .sr-prog-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 25%;
    background: currentColor;
    border-radius: 2px;
    transition: left 0.1s linear, width 0.1s linear;
  }

  /* Corner CTA (Bottom Right) */
  .sr-corner {
    text-align: right;
  }
  @media (max-width: 768px) {
    .sr-corner { text-align: left; }
  }
  .sr-corner-h {
    font-size: 14px;
    font-weight: 650;
    line-height: 1.35;
    margin-bottom: 10px;
    max-width: 320px;
  }
  .sr-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }
  .sr-cta-link:hover { opacity: 0.75; }
  .sr-cta-ar {
    width: 14px;
    height: 10px;
    display: inline-block;
  }
</style>

<script>
  (function() {
    function initSceneRailSection(sectionId) {
      var root = document.getElementById("sr-" + sectionId);
      if (!root) return;

      var stage = root.querySelector("[data-sr-stage]");
      var rack = root.querySelector("[data-sr-rack]");
      var rodSvg = root.querySelector("[data-sr-rodsvg]");
      var rodCore = root.querySelector("[data-sr-rod-core]");
      var rodShadow = root.querySelector("[data-sr-rod-shadow]");
      var rodHighlight = root.querySelector("[data-sr-rod-highlight]");

      var peekName = root.querySelector("[data-sr-pname]");
      var peekPrice = root.querySelector("[data-sr-pprice]");
      var progBar = root.querySelector("[data-sr-prog-bar]");

      if (!stage || !rack) return;

      var sag = parseFloat(root.dataset.sag) || 40;
      var tiltMult = parseFloat(root.dataset.tilt) || 3;
      var garmentH = parseFloat(root.dataset.garmentH) || 320;
      var items = Array.prototype.slice.call(rack.querySelectorAll("[data-sr-item]"));
      var yAnchor = 17;

      // 1. DYNAMIC SVG CURVED ROD
      function updateRodCurve() {
        var w = stage.clientWidth || 1400;
        var h = Math.max(160, yAnchor + sag + 50);

        if (rodSvg) {
          rodSvg.setAttribute("viewBox", "0 0 " + w + " " + h);
          rodSvg.style.height = h + "px";
        }

        var p1Y = yAnchor + (2.0 * sag);
        var pathData = "M -30," + yAnchor + " Q " + (w * 0.5) + "," + p1Y + " " + (w + 30) + "," + yAnchor;
        var shadowData = "M -30," + (yAnchor + 5) + " Q " + (w * 0.5) + "," + (p1Y + 5) + " " + (w + 30) + "," + (yAnchor + 5);
        var highlightData = "M -30," + (yAnchor - 1) + " Q " + (w * 0.5) + "," + (p1Y - 1) + " " + (w + 30) + "," + (yAnchor - 1);

        if (rodCore) rodCore.setAttribute("d", pathData);
        if (rodShadow) rodShadow.setAttribute("d", shadowData);
        if (rodHighlight) rodHighlight.setAttribute("d", highlightData);
      }

      // 2. REAL-TIME CURVE TRAJECTORY
      var isTicking = false;

      function updateItemTrajectory() {
        isTicking = false;
        var stageRect = stage.getBoundingClientRect();
        var stageW = stageRect.width || 1400;
        var stageCenterX = stageRect.left + (stageW * 0.5);
        var halfW = Math.max(1, stageW * 0.5);

        for (var i = 0; i < items.length; i++) {
          var item = items[i];
          var rect = item.getBoundingClientRect();
          var itemCenterX = rect.left + (rect.width * 0.5);
          var relX = itemCenterX - stageCenterX;

          var u = relX / halfW;
          u = Math.max(-1.3, Math.min(1.3, u));

          var yDip = Math.max(0, sag * (1.0 - (u * u)));
          var slope = - (2.0 * sag * u) / halfW;
          var angleDeg = (Math.atan(slope) * 180) / Math.PI;
          var tilt = Math.max(-tiltMult * 2.5, Math.min(tiltMult * 2.5, angleDeg * (tiltMult / 3)));

          item.style.setProperty("--curve-y", yDip.toFixed(1) + "px");
          item.style.setProperty("--curve-tilt", tilt.toFixed(2) + "deg");
        }

        if (progBar) {
          var maxScroll = rack.scrollWidth - rack.clientWidth;
          if (maxScroll > 0) {
            var ratio = rack.scrollLeft / maxScroll;
            var thumbW = Math.max(18, (rack.clientWidth / rack.scrollWidth) * 100);
            var leftPct = ratio * (100 - thumbW);
            progBar.style.width = thumbW + "%";
            progBar.style.left = leftPct + "%";
          }
        }
      }

      function requestCurveUpdate() {
        if (!isTicking) {
          isTicking = true;
          requestAnimationFrame(updateItemTrajectory);
        }
      }

      // 3. HOVER & PEEK INFO
      function setPeek(item) {
        var name = item.dataset.name;
        var price = item.dataset.price;
        if (peekName && name) peekName.textContent = name;
        if (peekPrice && price) peekPrice.textContent = price;
      }

      items.forEach(function(item) {
        item.addEventListener("mouseenter", function() {
          rack.classList.add("has-active-item");
          items.forEach(function(it) { it.classList.remove("is-active", "is-demo-center"); });
          item.classList.add("is-active");
          setPeek(item);
          setTimeout(requestCurveUpdate, 60);
        });

        // Click to navigate
        item.addEventListener("click", function(e) {
          if (isDragging) return;
          var url = item.dataset.url;
          if (url && url !== "#") window.location.href = url;
        });
      });

      rack.addEventListener("mouseleave", function() {
        rack.classList.remove("has-active-item");
        items.forEach(function(it) { it.classList.remove("is-active"); });
        var centerDemo = rack.querySelector(".sr-item:nth-child(8)") || items[0];
        if (centerDemo) setPeek(centerDemo);
        setTimeout(requestCurveUpdate, 60);
      });

      // 4. MOUSE DRAG TO SCROLL
      var isDragging = false;
      var startX = 0;
      var scrollStart = 0;

      rack.addEventListener("mousedown", function(e) {
        isDragging = true;
        rack.classList.add("is-dragging");
        startX = e.pageX - rack.offsetLeft;
        scrollStart = rack.scrollLeft;
      });

      window.addEventListener("mousemove", function(e) {
        if (!isDragging) return;
        e.preventDefault();
        var x = e.pageX - rack.offsetLeft;
        var walk = (x - startX) * 1.5;
        rack.scrollLeft = scrollStart - walk;
        requestCurveUpdate();
      });

      window.addEventListener("mouseup", function() {
        if (isDragging) {
          setTimeout(function() { isDragging = false; }, 50);
          rack.classList.remove("is-dragging");
        }
      });

      rack.addEventListener("scroll", requestCurveUpdate, { passive: true });
      window.addEventListener("resize", function() {
        updateRodCurve();
        requestCurveUpdate();
      });

      // Initialize
      updateRodCurve();
      setTimeout(function() {
        updateRodCurve();
        updateItemTrajectory();
        var centerDemo = rack.querySelector(".sr-item:nth-child(8)") || items[0];
        if (centerDemo) setPeek(centerDemo);
      }, 60);
    }

    document.addEventListener("DOMContentLoaded", function() {
      initSceneRailSection("{{ section.id }}");
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener("shopify:section:load", function(e) {
        if (e.detail && e.detail.sectionId === "{{ section.id }}") {
          initSceneRailSection("{{ section.id }}");
        }
      });
    }
  })();
</script>

