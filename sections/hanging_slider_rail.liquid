<script>
  (function() {
    // =========================================================================
    // CLIENT-SIDE CANVAS BACKGROUND ERASER & AUTO-CROPPER
    // - Erases white/light mockup backgrounds into 100% transparent PNGs in memory!
    // - Uses BFS border flood fill so white stripes/text inside clothes stay intact!
    // - Auto-crops canvas to garment boundaries so cards and overlap offsets vanish!
    // =========================================================================
    var cleanImageCache = {};

    function cleanMockupWhiteBackground(img) {
      if (!img) return;
      if (img.dataset.bgCleaned === "true") return;

      var originalSrc = img.currentSrc || img.src;
      if (!originalSrc || originalSrc.indexOf("data:image") === 0) {
        img.dataset.bgCleaned = "true";
        return;
      }

      // If already cleaned and cached, apply instantly to duplicate/cloned items!
      if (cleanImageCache[originalSrc]) {
        img.src = cleanImageCache[originalSrc];
        img.dataset.bgCleaned = "true";
        return;
      }

      function executeClean() {
        if (img.dataset.bgCleaned === "true") return;
        if (cleanImageCache[originalSrc]) {
          img.src = cleanImageCache[originalSrc];
          img.dataset.bgCleaned = "true";
          return;
        }

        var w = img.naturalWidth;
        var h = img.naturalHeight;
        if (!w || !h || w < 20 || h < 20) return;

        var canvas = document.createElement("canvas");
        canvas.width = w;
        canvas.height = h;
        var ctx = canvas.getContext("2d", { willReadFrequently: true });
        if (!ctx) return;

        try {
          ctx.drawImage(img, 0, 0);
          var imgData = ctx.getImageData(0, 0, w, h);
          var d = imgData.data;
          var totalPixels = w * h;

          // Check if corners have white/light background
          var cornerIndices = [0, (w - 1) * 4, ((h - 1) * w) * 4, (totalPixels - 1) * 4];
          var isWhiteBg = false;
          for (var c = 0; c < cornerIndices.length; c++) {
            var ci = cornerIndices[c];
            if (d[ci + 3] > 15 && d[ci] > 215 && d[ci + 1] > 215 && d[ci + 2] > 215) {
              isWhiteBg = true;
              break;
            }
          }

          if (!isWhiteBg) {
            img.dataset.bgCleaned = "true";
            return;
          }

          // BFS Flood Fill from all 4 image borders (preserves interior white stripes & text)
          var visited = new Uint8Array(totalPixels);
          var queue = new Int32Array(totalPixels);
          var qHead = 0;
          var qTail = 0;

          function trySeed(x, y) {
            var idx = y * w + x;
            if (visited[idx]) return;
            var pi = idx * 4;
            var r = d[pi], g = d[pi + 1], b = d[pi + 2], a = d[pi + 3];
            if (a > 15 && r > 210 && g > 210 && b > 210 &&
                Math.abs(r - g) < 26 && Math.abs(r - b) < 26 && Math.abs(g - b) < 26) {
              visited[idx] = 1;
              queue[qTail++] = idx;
            }
          }

          for (var x = 0; x < w; x++) {
            trySeed(x, 0);
            trySeed(x, h - 1);
          }
          for (var y = 0; y < h; y++) {
            trySeed(0, y);
            trySeed(w - 1, y);
          }

          while (qHead < qTail) {
            var curr = queue[qHead++];
            var cx = curr % w;
            var cy = Math.floor(curr / w);

            var neighbors = [
              cx > 0 ? curr - 1 : -1,
              cx < w - 1 ? curr + 1 : -1,
              cy > 0 ? curr - w : -1,
              cy < h - 1 ? curr + w : -1
            ];

            for (var n = 0; n < 4; n++) {
              var nIdx = neighbors[n];
              if (nIdx >= 0 && !visited[nIdx]) {
                visited[nIdx] = 1;
                var npi = nIdx * 4;
                var nr = d[npi], ng = d[npi + 1], nb = d[npi + 2], na = d[npi + 3];
                if (na > 15 && nr > 210 && ng > 210 && nb > 210 &&
                    Math.abs(nr - ng) < 26 && Math.abs(nr - nb) < 26 && Math.abs(ng - nb) < 26) {
                  queue[qTail++] = nIdx;
                }
              }
            }
          }

          // Knock out background pixels to transparent & find garment bounding box
          var minX = w, maxX = 0, minY = h, maxY = 0;
          var hasGarment = false;

          for (var p = 0; p < totalPixels; p++) {
            var p4 = p * 4;
            if (visited[p]) {
              d[p4 + 3] = 0; // Alpha = 0 (100% Transparent)
            } else if (d[p4 + 3] > 20) {
              hasGarment = true;
              var px = p % w;
              var py = Math.floor(p / w);
              if (px < minX) minX = px;
              if (px > maxX) maxX = px;
              if (py < minY) minY = py;
              if (py > maxY) maxY = py;
            }
          }

          if (hasGarment && minX <= maxX && minY <= maxY) {
            ctx.putImageData(imgData, 0, 0);

            // Auto-crop tightly to the actual garment boundaries (eliminates wide card offsets!)
            var cropW = Math.max(10, maxX - minX + 1);
            var cropH = Math.max(10, maxY - minY + 1);
            var cropCanvas = document.createElement("canvas");
            cropCanvas.width = cropW;
            cropCanvas.height = cropH;
            var cropCtx = cropCanvas.getContext("2d");
            cropCtx.drawImage(canvas, minX, minY, cropW, cropH, 0, 0, cropW, cropH);

            var transparentDataUrl = cropCanvas.toDataURL("image/png");
            cleanImageCache[originalSrc] = transparentDataUrl;

            img.src = transparentDataUrl;
            img.dataset.bgCleaned = "true";

            // Update all duplicate cloned images immediately
            var allSame = document.querySelectorAll('.sr-view img[src="' + originalSrc + '"]');
            allSame.forEach(function(dup) {
              dup.src = transparentDataUrl;
              dup.dataset.bgCleaned = "true";
            });
          } else {
            img.dataset.bgCleaned = "true";
          }
        } catch (err) {
          console.warn("Canvas background removal fallback:", err);
          img.dataset.bgCleaned = "true";
        }
      }

      if (img.complete && img.naturalWidth > 0) {
        executeClean();
      } else {
        img.addEventListener("load", executeClean, { once: true });
      }
    }

    function initSceneRailSection(sectionId) {
      var root = document.getElementById("sr-" + sectionId);
      if (!root) return;

      var stage = root.querySelector("[data-sr-stage]");
      var rack = root.querySelector("[data-sr-rack]");
      var trackInner = root.querySelector("[data-sr-track-inner]");
      var rodSvg = root.querySelector("[data-sr-rodsvg]");
      var rodCore = root.querySelector("[data-sr-rod-core]");
      var rodShadow = root.querySelector("[data-sr-rod-shadow]");
      var rodHighlight = root.querySelector("[data-sr-rod-highlight]");

      var peekName = root.querySelector("[data-sr-pname]");
      var peekPrice = root.querySelector("[data-sr-pprice]");
      var progBar = root.querySelector("[data-sr-prog-bar]");

      if (!stage || !rack) return;

      // Automatically clean and transparentize all garment images
      var allGarmentImgs = rack.querySelectorAll(".sr-view img");
      allGarmentImgs.forEach(cleanMockupWhiteBackground);

      var sag = parseFloat(root.dataset.sag) || 40;
      var tiltMult = parseFloat(root.dataset.tilt) || 3;
      var autoDriftSpeed = parseFloat(root.dataset.autoDrift) || 0;
      var isInfiniteEnabled = root.dataset.infinite !== "false";
      var items = Array.prototype.slice.call(rack.querySelectorAll("[data-sr-item]"));
      var yAnchor = 17;

      var repeatCount = trackInner ? (parseInt(trackInner.dataset.repeat, 10) || 1) : 1;
      var singleSetWidth = 0;

      function updateSetWidth() {
        if (trackInner && repeatCount > 1) {
          singleSetWidth = trackInner.scrollWidth / repeatCount;
        } else {
          singleSetWidth = rack.scrollWidth;
        }
      }

      // 1. DYNAMIC SVG CURVED ROD
      function updateRodCurve() {
        var w = stage.clientWidth || 1400;
        var h = Math.max(160, yAnchor + sag + 50);

        if (rodSvg) {
          rodSvg.setAttribute("viewBox", "0 0 " + w + " " + h);
          rodSvg.style.height = h + "px";
        }

        var p1Y = yAnchor + (2.0 * sag);
        var pathData = "M -30," + yAnchor + " Q " + (w * 0.5) + "," + p1Y + " " + (w + 30) + "," + yAnchor;
        var shadowData = "M -30," + (yAnchor + 5) + " Q " + (w * 0.5) + "," + (p1Y + 5) + " " + (w + 30) + "," + (yAnchor + 5);
        var highlightData = "M -30," + (yAnchor - 1) + " Q " + (w * 0.5) + "," + (p1Y - 1) + " " + (w + 30) + "," + (yAnchor - 1);

        if (rodCore) rodCore.setAttribute("d", pathData);
        if (rodShadow) rodShadow.setAttribute("d", shadowData);
        if (rodHighlight) rodHighlight.setAttribute("d", highlightData);
      }

      // 2. REAL-TIME CURVE TRAJECTORY
      var isTicking = false;

      function updateItemTrajectory() {
        isTicking = false;
        var stageRect = stage.getBoundingClientRect();
        var stageW = stageRect.width || 1400;
        var stageCenterX = stageRect.left + (stageW * 0.5);
        var halfW = Math.max(1, stageW * 0.5);

        for (var i = 0; i < items.length; i++) {
          var item = items[i];
          var rect = item.getBoundingClientRect();
          var itemCenterX = rect.left + (rect.width * 0.5);
          var relX = itemCenterX - stageCenterX;

          var u = relX / halfW;
          u = Math.max(-1.3, Math.min(1.3, u));

          var yDip = Math.max(0, sag * (1.0 - (u * u)));
          var slope = - (2.0 * sag * u) / halfW;
          var angleDeg = (Math.atan(slope) * 180) / Math.PI;
          var tilt = Math.max(-tiltMult * 2.5, Math.min(tiltMult * 2.5, angleDeg * (tiltMult / 3)));

          item.style.setProperty("--curve-y", yDip.toFixed(1) + "px");
          item.style.setProperty("--curve-tilt", tilt.toFixed(2) + "deg");
        }

        if (progBar && singleSetWidth > 0) {
          var normPos = rack.scrollLeft % singleSetWidth;
          var ratio = normPos / singleSetWidth;
          progBar.style.left = (ratio * 75).toFixed(1) + "%";
        }
      }

      function requestCurveUpdate() {
        if (!isTicking) {
          isTicking = true;
          requestAnimationFrame(updateItemTrajectory);
        }
      }

      // 3. SEAMLESS INFINITE LOOP WRAPPER
      function handleInfiniteWrap() {
        if (!isInfiniteEnabled || singleSetWidth <= 10) return;
        
        // Wrap right
        if (rack.scrollLeft >= singleSetWidth * 2.5) {
          rack.scrollLeft -= singleSetWidth;
        }
        // Wrap left
        else if (rack.scrollLeft <= singleSetWidth * 0.5) {
          rack.scrollLeft += singleSetWidth;
        }
      }

      // 4. CONTINUOUS INFINITE DRIFT (CONVEYOR)
      var isHovered = false;
      var isInteracting = false;
      var driftAnimationId = null;

      function startDrift() {
        if (autoDriftSpeed <= 0 || !isInfiniteEnabled) return;
        
        function tickDrift() {
          if (!isHovered && !isInteracting) {
            rack.scrollLeft += autoDriftSpeed;
            handleInfiniteWrap();
            requestCurveUpdate();
          }
          driftAnimationId = requestAnimationFrame(tickDrift);
        }
        driftAnimationId = requestAnimationFrame(tickDrift);
      }

      // 5. HOVER & PEEK INFO
      function setPeek(item) {
        var name = item.dataset.name;
        var price = item.dataset.price;
        var url = item.getAttribute("href") || item.dataset.url;
        if (peekName && name) peekName.textContent = name;
        if (peekPrice && price) peekPrice.textContent = price;
        var peekLink = root.querySelector("[data-sr-plink]");
        if (peekLink && url && url !== "#") peekLink.href = url;
      }

      // 6. MOUSE & TOUCH DRAGGING (Accurate Drag vs Click Detection)
      var isPointerDown = false;
      var hasDragged = false;
      var touchHasDragged = false;
      var startX = 0;
      var startY = 0;
      var scrollStart = 0;
      var dragThreshold = 6; // movement threshold in px to distinguish click from drag

      items.forEach(function(item) {
        item.addEventListener("mouseenter", function() {
          isHovered = true;
          rack.classList.add("has-active-item");
          items.forEach(function(it) { it.classList.remove("is-active", "is-demo-center"); });
          item.classList.add("is-active");
          setPeek(item);
          setTimeout(requestCurveUpdate, 60);
        });

        // Click handler: navigate to product page if it wasn't a drag gesture
        item.addEventListener("click", function(e) {
          if (hasDragged || touchHasDragged) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
          var url = item.getAttribute("href") || item.dataset.url;
          if (url && url !== "#") {
            window.location.href = url;
          }
        });
      });

      rack.addEventListener("mouseenter", function() {
        isHovered = true;
      });

      rack.addEventListener("mouseleave", function() {
        isHovered = false;
        rack.classList.remove("has-active-item");
        items.forEach(function(it) { it.classList.remove("is-active"); });
        var centerDemo = rack.querySelector(".sr-item:nth-child(8)") || items[0];
        if (centerDemo) setPeek(centerDemo);
        setTimeout(requestCurveUpdate, 60);
      });

      // Mouse drag on rack
      rack.addEventListener("mousedown", function(e) {
        if (e.button !== 0) return; // Only track left mouse button
        isPointerDown = true;
        hasDragged = false;
        isInteracting = true;
        startX = e.pageX;
        startY = e.pageY;
        scrollStart = rack.scrollLeft;
      });

      window.addEventListener("mousemove", function(e) {
        if (!isPointerDown) return;
        var deltaX = e.pageX - startX;
        
        if (!hasDragged && Math.abs(deltaX) > dragThreshold) {
          hasDragged = true;
          rack.classList.add("is-dragging");
        }

        if (hasDragged) {
          e.preventDefault();
          rack.scrollLeft = scrollStart - (deltaX * 1.5);
          handleInfiniteWrap();
          requestCurveUpdate();
        }
      });

      window.addEventListener("mouseup", function() {
        if (isPointerDown) {
          isPointerDown = false;
          rack.classList.remove("is-dragging");
          setTimeout(function() {
            hasDragged = false;
            isInteracting = false;
          }, 100);
        }
      });

      // Touch drag on rack
      var touchStartX = 0;
      var touchStartY = 0;

      rack.addEventListener("touchstart", function(e) {
        if (!e.touches || !e.touches[0]) return;
        isInteracting = true;
        touchHasDragged = false;
        touchStartX = e.touches[0].pageX;
        touchStartY = e.touches[0].pageY;
        scrollStart = rack.scrollLeft;
      }, { passive: true });

      rack.addEventListener("touchmove", function(e) {
        if (!e.touches || !e.touches[0]) return;
        var deltaX = e.touches[0].pageX - touchStartX;
        if (!touchHasDragged && Math.abs(deltaX) > dragThreshold) {
          touchHasDragged = true;
        }
        if (touchHasDragged) {
          var walk = deltaX * 1.4;
          rack.scrollLeft = scrollStart - walk;
          handleInfiniteWrap();
          requestCurveUpdate();
        }
      }, { passive: true });

      rack.addEventListener("touchend", function() {
        setTimeout(function() {
          touchHasDragged = false;
          isInteracting = false;
        }, 100);
      });

      rack.addEventListener("scroll", function() {
        handleInfiniteWrap();
        requestCurveUpdate();
      }, { passive: true });

      window.addEventListener("resize", function() {
        updateRodCurve();
        updateSetWidth();
        requestCurveUpdate();
      });

      // Initialize
      updateRodCurve();
      updateSetWidth();

      setTimeout(function() {
        updateRodCurve();
        updateSetWidth();
        if (isInfiniteEnabled && singleSetWidth > 0) {
          rack.scrollLeft = singleSetWidth;
        }
        updateItemTrajectory();
        var centerDemo = rack.querySelector(".sr-item:nth-child(8)") || items[0];
        if (centerDemo) setPeek(centerDemo);
        startDrift();
      }, 80);
    }

    document.addEventListener("DOMContentLoaded", function() {
      initSceneRailSection("{{ section.id }}");
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener("shopify:section:load", function(e) {
        if (e.detail && e.detail.sectionId === "{{ section.id }}") {
          initSceneRailSection("{{ section.id }}");
        }
      });
    }
  })();
</script>

