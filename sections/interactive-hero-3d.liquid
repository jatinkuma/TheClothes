{% comment %}
  ==============================================================================
  INTERACTIVE 3D CARTOON MASCOT HERO SECTION
  Phase 1: Interactive 3D Mascot Character with Gaze Tracking & Electric Blue Butterfly
  ------------------------------------------------------------------------------
  Architecture:
  - Three.js WebGL 3D Character Engine (Rigged Mascot with Head, Neck & Eye Tracking)
  - Autonomous Cyan/Electric Blue 3D Trailing Butterfly Cursor Engine
  - Fully Scalable & Modular Architecture (Easily extendable for future phases)
  - Responsive Desktop, Tablet & Mobile layout with touch gesture support
  - Respects prefers-reduced-motion accessibility
  ==============================================================================
{% endcomment %}

<!-- Three.js & GLTF Loader CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

<div
  id="interactive-hero-3d-{{ section.id }}"
  class="hero-3d-wrapper"
  style="--hero-bg: {{ section.settings.bg_color | default: '#E2A522' }};"
>
  <!-- 1. LUXURY BRAND HEADER & NAVIGATION -->
  <header class="hero-3d-header">
    <div class="hero-3d-header-brand">
      <div class="hero-3d-crown-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
        </svg>
      </div>
      <h1 class="hero-3d-title">{{ section.settings.brand_title | default: 'The Royal Attire *' }}</h1>
    </div>

    <nav class="hero-3d-nav" aria-label="Main Navigation">
      <a href="#collection" class="hero-3d-nav-link">Collection</a>
      <a href="#atelier" class="hero-3d-nav-link">Atelier</a>
      <a href="#heritage" class="hero-3d-nav-link">Heritage</a>
      <a href="#visit" class="hero-3d-nav-link">Visit</a>
    </nav>

    <div class="hero-3d-socials">
      <a href="https://instagram.com" target="_blank" rel="noopener" class="hero-3d-social-icon" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </a>
      <a href="https://facebook.com" target="_blank" rel="noopener" class="hero-3d-social-icon" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://wa.me/" target="_blank" rel="noopener" class="hero-3d-social-icon" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
    </div>
  </header>

  <!-- 2. HERO CONTENT TITLES -->
  <div class="hero-3d-text-container">
    <span class="hero-3d-badge">{{ section.settings.subheading | default: 'THE COLLECTION' }}</span>
    <h2 class="hero-3d-heading">{{ section.settings.heading | default: 'Worn by royalty, made by hand' }}</h2>
    <p class="hero-3d-desc">{{ section.settings.description | default: 'Step into the royal atelier. Hand-spun silk, royal zardozi, and time-honored Indian craftsmanship brought alive in interactive 3D.' }}</p>
  </div>

  <!-- 3. CENTRAL 3D INTERACTIVE MASCOT STAGE -->
  <div id="hero-3d-stage-{{ section.id }}" class="hero-3d-stage">
    
    <!-- Loading Spinner -->
    <div id="hero-3d-spinner-{{ section.id }}" class="hero-3d-spinner" aria-live="polite">
      <div class="hero-3d-spinner-ring"></div>
      <span class="hero-3d-spinner-text">Awakening Royal Mascot...</span>
    </div>

    <!-- WebGL Canvas for Rigged 3D Character -->
    <canvas id="hero-3d-canvas-{{ section.id }}" class="hero-3d-canvas"></canvas>

    <!-- 3D Hint Pill -->
    <div class="hero-3d-hint">
      <span class="hero-3d-hint-icon">✦</span>
      <span class="hero-3d-hint-text">Interactive 3D Mascot &bull; Move mouse or drag to explore</span>
    </div>
  </div>

  <!-- FULL-SECTION Fairy Dust Sparkle Particle Canvas -->
  {% if section.settings.enable_butterfly %}
    <canvas id="hero-3d-sparkles-{{ section.id }}" class="hero-3d-sparkles-canvas"></canvas>
  {% endif %}

  <!-- 4. FULL-SECTION 3D ROYAL BUTTERFLY CREATURE (Matching Section 1 & Royal Fashion Doll) -->
  {% if section.settings.enable_butterfly %}
    <div
      id="hero-3d-butterfly-{{ section.id }}"
      class="hero-3d-butterfly royal-butterfly-creature"
      aria-hidden="true"
    >
      <div class="butterfly-3d-rig">
        <!-- Left Wing -->
        <div class="butterfly-wing wing-left">
          <svg viewBox="0 0 70 80" width="70" height="80">
            <defs>
              <linearGradient id="heroBfWingL-{{ section.id }}" x1="0%" y1="30%" x2="100%" y2="70%">
                <stop offset="0%" stop-color="#140742" />
                <stop offset="25%" stop-color="#4a148c" />
                <stop offset="55%" stop-color="#2979ff" />
                <stop offset="85%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#80d8ff" />
              </linearGradient>
              <radialGradient id="heroBfGlowL-{{ section.id }}" cx="60%" cy="45%" r="50%">
                <stop offset="0%" stop-color="#69f0ae" stop-opacity="0.75" />
                <stop offset="60%" stop-color="#00e5ff" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#2979ff" stop-opacity="0" />
              </radialGradient>
              <filter id="heroBfShadowL-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00e5ff" flood-opacity="0.6"/>
              </filter>
            </defs>
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#heroBfWingL-{{ section.id }})" filter="url(#heroBfShadowL-{{ section.id }})" stroke="#0d47a1" stroke-width="0.8" />
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#heroBfGlowL-{{ section.id }})" />
            <path d="M 66 38 C 58 44, 46 48, 30 52 C 16 56, 12 66, 20 74 C 28 82, 48 78, 58 64 C 64 54, 66 44, 66 38 Z"
                  fill="url(#heroBfWingL-{{ section.id }})" stroke="#1a237e" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.6)" stroke-width="0.65" fill="none">
              <path d="M 66 36 Q 40 24 16 12" />
              <path d="M 66 36 Q 36 32 10 24" />
              <path d="M 66 36 Q 42 40 24 38" />
              <path d="M 65 42 Q 46 56 26 68" />
              <path d="M 65 42 Q 52 64 42 74" />
            </g>
            <circle cx="10" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="6" cy="22" r="1" fill="#ffffff" />
            <circle cx="18" cy="72" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Body -->
        <div class="butterfly-body">
          <svg viewBox="0 0 16 80" width="16" height="80">
            <defs>
              <linearGradient id="heroBfBodyGrad-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4a148c" />
                <stop offset="50%" stop-color="#1a237e" />
                <stop offset="100%" stop-color="#00e5ff" />
              </linearGradient>
            </defs>
            <path d="M 7 24 Q 4 12 1 6 Q 0 4 2 4 Q 4 4 5 10 Q 6 18 7 24" fill="#311b92" />
            <path d="M 9 24 Q 12 12 15 6 Q 16 4 14 4 Q 12 4 11 10 Q 10 18 9 24" fill="#311b92" />
            <circle cx="2" cy="4" r="1.5" fill="#00e5ff" />
            <circle cx="14" cy="4" r="1.5" fill="#00e5ff" />
            <circle cx="8" cy="26" r="3.5" fill="#1a237e" />
            <circle cx="6.5" cy="25" r="0.9" fill="#69f0ae" />
            <circle cx="9.5" cy="25" r="0.9" fill="#69f0ae" />
            <ellipse cx="8" cy="35" rx="3.8" ry="6" fill="url(#heroBfBodyGrad-{{ section.id }})" />
            <path d="M 5 40 Q 4 54 7 66 Q 8 68 9 66 Q 12 54 11 40 Z" fill="url(#heroBfBodyGrad-{{ section.id }})" />
            <ellipse cx="8" cy="34" rx="1.8" ry="2.8" fill="#00e5ff" opacity="0.95" />
          </svg>
        </div>

        <!-- Right Wing -->
        <div class="butterfly-wing wing-right">
          <svg viewBox="0 0 70 80" width="70" height="80">
            <defs>
              <linearGradient id="heroBfWingR-{{ section.id }}" x1="100%" y1="30%" x2="0%" y2="70%">
                <stop offset="0%" stop-color="#140742" />
                <stop offset="25%" stop-color="#4a148c" />
                <stop offset="55%" stop-color="#2979ff" />
                <stop offset="85%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#80d8ff" />
              </linearGradient>
              <radialGradient id="heroBfGlowR-{{ section.id }}" cx="40%" cy="45%" r="50%">
                <stop offset="0%" stop-color="#69f0ae" stop-opacity="0.75" />
                <stop offset="60%" stop-color="#00e5ff" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#2979ff" stop-opacity="0" />
              </radialGradient>
              <filter id="heroBfShadowR-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00e5ff" flood-opacity="0.6"/>
              </filter>
            </defs>
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#heroBfWingR-{{ section.id }})" filter="url(#heroBfShadowR-{{ section.id }})" stroke="#0d47a1" stroke-width="0.8" />
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#heroBfGlowR-{{ section.id }})" />
            <path d="M 4 38 C 12 44, 24 48, 40 52 C 54 56, 58 66, 50 74 C 42 82, 22 78, 12 64 C 6 54, 4 44, 4 38 Z"
                  fill="url(#heroBfWingR-{{ section.id }})" stroke="#1a237e" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.6)" stroke-width="0.65" fill="none">
              <path d="M 4 36 Q 30 24 54 12" />
              <path d="M 4 36 Q 34 32 60 24" />
              <path d="M 4 36 Q 28 40 46 38" />
              <path d="M 5 42 Q 24 56 44 68" />
              <path d="M 5 42 Q 18 64 28 74" />
            </g>
            <circle cx="60" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="64" cy="22" r="1" fill="#ffffff" />
            <circle cx="52" cy="72" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  /* ==========================================================================
     HERO 3D SECTION STYLING (Scoped)
     ========================================================================== */
  #interactive-hero-3d-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 88vh;
    background-color: var(--hero-bg, #E2A522);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #2B1810;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Luxury Header */
  #interactive-hero-3d-{{ section.id }} .hero-3d-header {
    width: 100%;
    max-width: 1360px;
    padding: 24px 32px 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #2A1508;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-title {
    font-family: "Georgia", "Playfair Display", serif;
    font-size: 1.45rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
    color: #2A1508;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-nav-link {
    color: #3C220E;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-nav-link:hover {
    color: #100602;
    opacity: 0.8;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-social-icon {
    color: #3C220E;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-social-icon:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* Titles & Descriptions */
  #interactive-hero-3d-{{ section.id }} .hero-3d-text-container {
    text-align: center;
    padding: 16px 24px 8px 24px;
    max-width: 820px;
    z-index: 5;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(42, 21, 8, 0.75);
    margin-bottom: 8px;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-heading {
    font-family: "Georgia", "Playfair Display", serif;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 10px 0;
    color: #241105;
    letter-spacing: -0.02em;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-desc {
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.5;
    color: rgba(36, 17, 5, 0.85);
    margin: 0 auto;
    max-width: 640px;
  }

  /* 3D Stage Container */
  #interactive-hero-3d-{{ section.id }} .hero-3d-stage {
    position: relative;
    width: 100%;
    max-width: 680px;
    height: 540px;
    margin-top: -10px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 6;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    outline: none;
    cursor: grab;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-canvas:active {
    cursor: grabbing;
  }

  /* Spinner */
  #interactive-hero-3d-{{ section.id }} .hero-3d-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    z-index: 12;
    background: transparent;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-spinner-ring {
    width: 44px;
    height: 44px;
    border: 3.5px solid rgba(42, 21, 8, 0.15);
    border-top-color: #241105;
    border-radius: 50%;
    animation: hero3dSpin 0.85s linear infinite;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-spinner-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #241105;
    letter-spacing: 0.04em;
  }

  @keyframes hero3dSpin {
    to { transform: rotate(360deg); }
  }

  /* Hint Pill */
  #interactive-hero-3d-{{ section.id }} .hero-3d-hint {
    position: absolute;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #241105;
    box-shadow: 0 4px 14px rgba(42, 21, 8, 0.08);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* Full-Section Canvas for Sparkles */
  #interactive-hero-3d-{{ section.id }} .hero-3d-sparkles-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 15;
  }

  /* FULL-SECTION 3D Royal Butterfly Creature (Matching Section 1) */
  #interactive-hero-3d-{{ section.id }} .royal-butterfly-creature {
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 70px;
    pointer-events: none !important;
    z-index: 20;
    transform: translate3d(-200px, -200px, 0);
    will-change: transform;
    transition: opacity 0.3s ease;
  }

  #interactive-hero-3d-{{ section.id }} .butterfly-3d-rig {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 700px;
    transform-style: preserve-3d;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #interactive-hero-3d-{{ section.id }} .butterfly-body {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 60px;
    z-index: 4;
  }

  #interactive-hero-3d-{{ section.id }} .butterfly-body svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 4px rgba(0, 229, 255, 0.7));
  }

  /* Butterfly Wings */
  #interactive-hero-3d-{{ section.id }} .butterfly-wing.wing-left {
    position: absolute;
    right: 50%;
    top: 50%;
    margin-right: -4px;
    margin-top: -30px;
    width: 58px;
    height: 64px;
    transform-origin: right 45%;
    transform-style: preserve-3d;
    animation: flapLeftWingHero 0.16s ease-in-out infinite alternate;
    z-index: 2;
  }

  #interactive-hero-3d-{{ section.id }} .butterfly-wing.wing-right {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -4px;
    margin-top: -30px;
    width: 58px;
    height: 64px;
    transform-origin: left 45%;
    transform-style: preserve-3d;
    animation: flapRightWingHero 0.16s ease-in-out infinite alternate;
    z-index: 2;
  }

  #interactive-hero-3d-{{ section.id }} .butterfly-wing svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes flapLeftWingHero {
    0% { transform: rotateY(0deg) rotateZ(0deg); }
    50% { transform: rotateY(52deg) rotateZ(-6deg); }
    100% { transform: rotateY(78deg) rotateZ(-12deg); }
  }

  @keyframes flapRightWingHero {
    0% { transform: rotateY(0deg) rotateZ(0deg); }
    50% { transform: rotateY(-52deg) rotateZ(6deg); }
    100% { transform: rotateY(-78deg) rotateZ(12deg); }
  }

  #interactive-hero-3d-{{ section.id }} .royal-butterfly-creature.fast-flap .wing-left {
    animation-duration: 0.11s;
  }
  #interactive-hero-3d-{{ section.id }} .royal-butterfly-creature.fast-flap .wing-right {
    animation-duration: 0.11s;
  }
  #interactive-hero-3d-{{ section.id }} .royal-butterfly-creature.hover-flap .wing-left {
    animation-duration: 0.22s;
  }
  #interactive-hero-3d-{{ section.id }} .royal-butterfly-creature.hover-flap .wing-right {
    animation-duration: 0.22s;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    #interactive-hero-3d-{{ section.id }} .hero-3d-nav {
      display: none;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-stage {
      height: 480px;
    }
  }

  @media (max-width: 600px) {
    #interactive-hero-3d-{{ section.id }} {
      min-height: 82vh;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-header {
      padding: 16px 20px 8px 20px;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-stage {
      height: 400px;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    #interactive-hero-3d-{{ section.id }} .hero-bf-wing-left,
    #interactive-hero-3d-{{ section.id }} .hero-bf-wing-right {
      animation: none !important;
    }
  }
</style>

<script>
(function() {
  /**
   * ============================================================================
   * MODULAR INTERACTIVE 3D HERO CONTROLLER
   * Phase 1 Architecture:
   * - Mascot3DManager: Three.js WebGL engine, 22-bone armature, real-time gaze tracking & organic blinking
   * - ElectricButterflyController: Physics-based cyan butterfly trailing cursor with independent fluttering
   * - Modular & extensible: Ready for future outfit swapping, audio, and camera transitions
   * ============================================================================
   */
  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("interactive-hero-3d-" + sectionId);
  var stageEl = document.getElementById("hero-3d-stage-" + sectionId);
  var canvasEl = document.getElementById("hero-3d-canvas-" + sectionId);
  var spinnerEl = document.getElementById("hero-3d-spinner-" + sectionId);
  var butterflyEl = document.getElementById("hero-3d-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("hero-3d-sparkles-" + sectionId);

  if (!sectionEl || !canvasEl) return;

  // 1. CONFIGURATION
  var config = {
    modelUrl: "{{ section.settings.character_model_url | default: '' }}",
    defaultAssetUrl: "{{ 'royal-cartoon-mascot.glb' | asset_url }}",
    fallbackAssetUrl: "{{ 'royal-attire-character.glb' | asset_url }}",
    sensitivity: {{ section.settings.tracking_sensitivity | default: 28 }},
    enableButterfly: {% if section.settings.enable_butterfly %}true{% else %}false{% endif %},
    butterflySpeed: 0.09
  };

  var activeModelUrl = config.modelUrl.trim() !== "" ? config.modelUrl.trim() : config.defaultAssetUrl;

  // 2. MASCOT 3D MANAGER
  var Mascot3DManager = {
    scene: null,
    camera: null,
    renderer: null,
    characterGroup: null,
    gltfLoader: null,
    isReady: false,
    
    // Skeleton Joint References
    bones: {
      head: null,
      neck: null,
      chest: null,
      spine: null,
      root: null,
      eyeLeft: null,
      eyeRight: null
    },

    // Smooth Cursor Tracking Angles (Euler degrees)
    targetRotY: 0,
    targetRotX: 0,
    currentRotY: 0,
    currentRotX: 0,
    targetRoll: 0,
    currentRoll: 0,
    
    // 360 Drag & Orbit
    isDragging: false,
    prevMouseX: 0,
    orbitAngleY: 0,

    init: function() {
      if (typeof THREE === "undefined") {
        console.warn("Three.js not found, retrying...");
        setTimeout(Mascot3DManager.init, 150);
        return;
      }

      try {
        var w = stageEl.clientWidth || 640;
        var h = stageEl.clientHeight || 540;

        // Scene & Perspective Camera
        this.scene = new THREE.Scene();
        this.camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
        this.camera.position.set(0, 1.18, 3.3);
        this.camera.lookAt(0, 0.98, 0);

        // WebGL Renderer
        this.renderer = new THREE.WebGLRenderer({
          canvas: canvasEl,
          alpha: true,
          antialias: true,
          powerPreference: "high-performance"
        });
        this.renderer.setSize(w, h);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.renderer.outputEncoding = THREE.sRGBEncoding;

        // Studio 3-Point Lighting
        var ambientLight = new THREE.AmbientLight(0xFFF6E5, 1.4);
        this.scene.add(ambientLight);

        var keyLight = new THREE.DirectionalLight(0xFFFFFF, 1.8);
        keyLight.position.set(3.5, 4.5, 4.0);
        this.scene.add(keyLight);

        var fillLight = new THREE.DirectionalLight(0xE0F2FE, 1.1);
        fillLight.position.set(-3.5, 2.5, 3.0);
        this.scene.add(fillLight);

        var rimLight = new THREE.DirectionalLight(0xFFD700, 1.5);
        rimLight.position.set(0, 3.5, -3.5);
        this.scene.add(rimLight);

        // Character Group Container
        this.characterGroup = new THREE.Group();
        this.scene.add(this.characterGroup);

        // Load 3D GLB Model
        this.gltfLoader = new THREE.GLTFLoader();
        this.loadModel(activeModelUrl);

        // Setup Events & Loop
        this.setupEventListeners();
        requestAnimationFrame(this.renderLoop.bind(this));

      } catch (err) {
        console.error("3D Mascot initialization error:", err);
      }
    },

    loadModel: function(url) {
      if (!this.gltfLoader) return;
      if (spinnerEl) spinnerEl.style.display = "flex";

      var self = this;
      this.gltfLoader.load(url, function(gltf) {
        while (self.characterGroup.children.length > 0) {
          self.characterGroup.remove(self.characterGroup.children[0]);
        }

        var model = gltf.scene;
        model.position.set(0, 0, 0);
        self.characterGroup.add(model);

        // Scan and bind skeleton bones
        self.bones = {
          head: null, neck: null, chest: null, spine: null, root: null,
          eyeLeft: null, eyeRight: null
        };

        model.traverse(function(node) {
          if (node.isBone || node.type === "Bone") {
            var name = (node.name || "").toLowerCase();
            if (name.indexOf("head") !== -1 && !self.bones.head) self.bones.head = node;
            else if (name.indexOf("neck") !== -1 && !self.bones.neck) self.bones.neck = node;
            else if (name.indexOf("chest") !== -1 && !self.bones.chest) self.bones.chest = node;
            else if (name.indexOf("spine") !== -1 && !self.bones.spine) self.bones.spine = node;
            else if (name.indexOf("root") !== -1 && !self.bones.root) self.bones.root = node;
            else if ((name.indexOf("eye.l") !== -1 || name === "eye_l" || name === "eyel") && !self.bones.eyeLeft) self.bones.eyeLeft = node;
            else if ((name.indexOf("eye.r") !== -1 || name === "eye_r" || name === "eyer") && !self.bones.eyeRight) self.bones.eyeRight = node;
          }
          if (node.isMesh) {
            node.castShadow = true;
            node.receiveShadow = true;
          }
        });

        // Hide spinner
        if (spinnerEl) spinnerEl.style.display = "none";
        self.isReady = true;

      }, undefined, function(err) {
        console.warn("Could not load primary model from " + url + ", trying fallback asset:", err);
        if (url !== config.fallbackAssetUrl) {
          self.loadModel(config.fallbackAssetUrl);
        } else if (spinnerEl) {
          spinnerEl.style.display = "none";
        }
      });
    },

    setupEventListeners: function() {
      var self = this;

      // Natural Circular Gaze & Body Tracking (NO 360 SPIN - FRONT FACING)
      function updatePointer(clientX, clientY) {
        if (!stageEl) return;
        var rect = stageEl.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height * 0.45;

        var deltaX = (clientX - centerX) / (window.innerWidth * 0.44);
        var deltaY = (clientY - centerY) / (window.innerHeight * 0.44);

        // Circular polar coordinates for continuous circular loops
        var angle = Math.atan2(deltaY, deltaX);
        var dist = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        var r = Math.min(1.20, dist);

        var sens = self.sens() || 24;
        var maxPitch = 15;

        // Left cursor -> Left turn & lean, Right cursor -> Right turn & lean
        self.targetRotY = Math.cos(angle) * (r * sens);
        self.targetRotX = Math.sin(angle) * (r * maxPitch);
        self.targetRoll = Math.cos(angle) * (r * 3.8);
      }

      window.addEventListener("mousemove", function(e) {
        updatePointer(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updatePointer(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      document.addEventListener("mouseleave", function() {
        self.targetRotY = 0;
        self.targetRotX = 0;
        self.targetRoll = 0;
      });

      // Window Resize
      window.addEventListener("resize", function() {
        if (!self.renderer || !self.camera || !stageEl) return;
        var rw = stageEl.clientWidth || 640;
        var rh = stageEl.clientHeight || 540;
        self.camera.aspect = rw / rh;
        self.camera.updateProjectionMatrix();
        self.renderer.setSize(rw, rh);
      });
    },

    sens: function() {
      return config.sensitivity || 28;
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));

      // Smooth Spring Interpolation
      this.currentRotY += (this.targetRotY - this.currentRotY) * 0.082;
      this.currentRotX += (this.targetRotX - this.currentRotX) * 0.082;
      this.currentRoll += (this.targetRoll - this.currentRoll) * 0.082;

      if (this.isReady && this.characterGroup) {
        // 1. Signature Weight-Shift Leaning Physics (NO 360 SPIN - FRONT FACING)
        var leanRatio = this.currentRotY / (this.sens() || 24);
        this.characterGroup.position.x = leanRatio * 0.085;
        this.characterGroup.rotation.z = -leanRatio * 0.035;
        this.characterGroup.rotation.y = leanRatio * 0.08; // Locked front-facing natural posture

        // 2. Idle Organic Breathing
        var breathWave = Math.sin(time * 0.0022);
        this.characterGroup.position.y = breathWave * 0.016;

        // 3. Real 3D Head & Neck Bone Rotation
        var radYaw = (this.currentRotY * Math.PI) / 180;
        var radPitch = (this.currentRotX * Math.PI) / 180;
        var radRoll = (this.currentRoll * Math.PI) / 180;

        if (this.bones.head) {
          this.bones.head.rotation.y = radYaw * 0.78;
          this.bones.head.rotation.x = radPitch * 0.88;
          this.bones.head.rotation.z = radRoll;
        }
        if (this.bones.neck) {
          this.bones.neck.rotation.y = radYaw * 0.42;
          this.bones.neck.rotation.x = radPitch * 0.36;
        }
        if (this.bones.chest) {
          this.bones.chest.rotation.y = radYaw * 0.12;
        }

        // 4. Expressive Eye Tracking & Natural Blinking
        var eyeYaw = radYaw * 1.30;   // Eyes dart further to focus on the butterfly
        var eyePitch = radPitch * 1.40;

        var blinkCycle = (time % 3500) / 3500;
        var blinkScale = 1.0;
        if (blinkCycle > 0.955) {
          var bt = (blinkCycle - 0.955) / 0.045;
          blinkScale = 1.0 - Math.sin(bt * Math.PI) * 0.90;
        }

        if (this.bones.eyeLeft) {
          this.bones.eyeLeft.rotation.y = eyeYaw;
          this.bones.eyeLeft.rotation.x = eyePitch;
          this.bones.eyeLeft.scale.z = blinkScale;
        }
        if (this.bones.eyeRight) {
          this.bones.eyeRight.rotation.y = eyeYaw;
          this.bones.eyeRight.rotation.x = eyePitch;
          this.bones.eyeRight.scale.z = blinkScale;
        }

        this.renderer.render(this.scene, this.camera);
      }
    }
  };

  // 3. FAIRY DUST STARDUST SPARKLE TRAIL
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !config.enableButterfly) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !sectionEl) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 600;
      this.canvas.width = w * dpr;
      this.canvas.height = h * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    addParticle: function(x, y) {
      if (this.particles.length > 55) return;
      var hues = ['#00e5ff', '#651fff', '#ffd700', '#76ff03', '#80d8ff'];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 8,
        radius: Math.random() * 2.2 + 0.8,
        alpha: 1.0,
        decay: Math.random() * 0.024 + 0.014,
        vx: (Math.random() - 0.5) * 0.8,
        vy: Math.random() * 0.5 + 0.3,
        color: hues[Math.floor(Math.random() * hues.length)]
      });
    },

    updateAndRender: function() {
      if (!this.ctx || !sectionEl) return;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 600;
      this.ctx.clearRect(0, 0, w, h);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        this.ctx.save();
        this.ctx.globalAlpha = Math.max(0, p.alpha);
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();
      }
    }
  };

  // 4. FULL-SECTION 3D ROYAL BUTTERFLY CONTROLLER (Exact Physics & Dynamics of Section 1)
  var ElectricButterflyController = {
    el: butterflyEl,
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    angle: 0,
    isHovering: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (!this.el || !config.enableButterfly) return;

      var self = this;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 600;
      this.posX = w * 0.28;
      this.posY = h * 0.36;
      this.targetX = this.posX;
      this.targetY = this.posY;

      function updateTarget(clientX, clientY) {
        if (!sectionEl) return;
        var secRect = sectionEl.getBoundingClientRect();
        self.targetX = clientX - secRect.left;
        self.targetY = clientY - secRect.top;
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }

      sectionEl.addEventListener("mousemove", function(e) {
        updateTarget(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 80 && e.clientY <= r.bottom + 80) {
          updateTarget(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updateTarget(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      sectionEl.addEventListener("mouseleave", function() {
        self.isHovering = false;
      });

      requestAnimationFrame(this.renderLoop.bind(this));
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));

      if (!this.el || !config.enableButterfly) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 600;

      // Autonomous circular flight patrol around character when idle
      if (!this.isHovering || (time - this.lastMoveTime > 3200)) {
        var t = time * 0.0012;
        var patrolCenterX = secW * 0.5;
        var patrolCenterY = secH * 0.36;
        this.targetX = patrolCenterX + Math.cos(t) * (secW * 0.35);
        this.targetY = patrolCenterY + Math.sin(t * 2) * (secH * 0.20);
      }

      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      var dist = Math.sqrt(dx * dx + dy * dy);

      var vx = dx * 0.082;
      var vy = dy * 0.082;
      this.posX += vx;
      this.posY += vy;

      // Natural hovering bob
      var hoverX = Math.sin(time * 0.0035) * 10;
      var hoverY = Math.cos(time * 0.0042) * 8;
      var fx = this.posX + hoverX;
      var fy = this.posY + hoverY;

      // Restrain within full section boundaries
      fx = Math.max(30, Math.min(secW - 70, fx));
      fy = Math.max(30, Math.min(secH - 70, fy));

      if (dist > 2) {
        var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        var diff = (targetAngle - this.angle + 540) % 360 - 180;
        this.angle += diff * 0.12;
      }

      var tilt = Math.max(-25, Math.min(25, vx * 1.8));

      if (dist > 40) {
        this.el.classList.add("fast-flap");
        this.el.classList.remove("hover-flap");
      } else {
        this.el.classList.remove("fast-flap");
        this.el.classList.add("hover-flap");
      }

      this.el.style.transform =
        "translate3d(" + (fx - 45).toFixed(1) + "px, " + (fy - 35).toFixed(1) + "px, 0px) " +
        "rotate(" + this.angle.toFixed(1) + "deg) " +
        "rotateY(" + tilt.toFixed(1) + "deg)";

      if (Math.random() < 0.45) {
        SparkleTrail.addParticle(fx, fy);
      }

      SparkleTrail.updateAndRender();
    }
  };

  // 5. BOOTSTRAP HERO SECTION
  function bootHeroSection() {
    Mascot3DManager.init();
    SparkleTrail.init();
    ElectricButterflyController.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootHeroSection);
  } else {
    bootHeroSection();
  }

  // Shopify Theme Editor Integration
  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      bootHeroSection();
    }
  });

})();
</script>

