{% comment %}
  ==============================================================================
  THE ROYAL ATTIRE — 3D CARTOON MASCOT HERO SECTION
  Crafted with High-Fidelity 3D Gaze Tracking & Electric Blue Butterfly
  ------------------------------------------------------------------------------
  Features:
  - Atmospheric Golden Cloud / Painterly Watercolor Vignette Background
  - Royal Brand Header (Crown Icon, 'The Royal Attire *', Navigation, Socials)
  - Luxury Serif Typography with Centered 2-Line Heading & Collection Badge
  - Cute Royal Chipmunk Mascot Character in Traditional Rajasthani Royal Attire:
    * Multicolored Royal Safa with Kalgi Brooch & Feather Plume
    * Round Gold Wireframe Glasses
    * Ivory Brocade Sherwani with Gold Placket Buttons
    * Royal Red Zardozi Embroidered Stole (Angavastram)
    * Gold Royal Medallion Necklace & Fluffy Tail
    * Curled Royal Rajasthani Mojari Shoes
  - Cursor-Responsive 3D Gaze Engine:
    * Real-time 3D perspective head & neck rotation (yaw, pitch, curious roll)
    * Real-time eye pupil gaze darting towards cursor & butterfly
    * Procedural eyelid blinking every ~3.5s
    * Organic idle breathing wave
    * Dynamic floor contact shadow
  - Autonomous Cyan / Electric Blue Butterfly with Physics Trailing Lag:
    * Rapid 3D wing fluttering
    * Banking angle tilt into flight curves
    * High-performance Canvas Sparkle Fairy Dust Trail (Twinkling Stardust)
  - Embedded Three.js WebGL Engine for Custom GLB 3D Models
  - Smooth Touch Drag on Mobile / Tablets
  - Fully accessible (prefers-reduced-motion safe)
  ==============================================================================
{% endcomment %}

<!-- Three.js CDN for GLB 3D Model Support -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

<div
  id="interactive-hero-3d-{{ section.id }}"
  class="hero-3d-wrapper"
  style="
    --hero-bg: {{ section.settings.bg_color | default: '#E5A625' }};
    {% if section.settings.use_bg_image %}
      --hero-bg-image: url('{{ 'hero-atmospheric-bg.jpg' | asset_url }}');
    {% endif %}
  "
>
  <!-- Atmospheric Painterly Cloud Vignette -->
  <div class="hero-3d-cloud-vignette" aria-hidden="true"></div>

  <!-- 1. LUXURY BRAND HEADER -->
  <header class="hero-3d-header">
    <div class="hero-3d-header-brand">
      <div class="hero-3d-crown-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
        </svg>
      </div>
      <h1 class="hero-3d-title">{{ section.settings.brand_title | default: 'The Royal Attire *' }}</h1>
    </div>

    <nav class="hero-3d-nav" aria-label="Main Navigation">
      <a href="#collection" class="hero-3d-nav-link">Collection</a>
      <a href="#atelier" class="hero-3d-nav-link">Atelier</a>
      <a href="#heritage" class="hero-3d-nav-link">Heritage</a>
      <a href="#visit" class="hero-3d-nav-link">Visit</a>
    </nav>

    <div class="hero-3d-socials">
      <a href="https://instagram.com" target="_blank" rel="noopener" class="hero-3d-social-icon" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </a>
      <a href="https://facebook.com" target="_blank" rel="noopener" class="hero-3d-social-icon" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://wa.me/" target="_blank" rel="noopener" class="hero-3d-social-icon" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
    </div>
  </header>

  <!-- 2. HERO HEADINGS & DESCRIPTION -->
  <div class="hero-3d-text-container">
    <span class="hero-3d-badge">{{ section.settings.subheading | default: 'THE COLLECTION' }}</span>
    <h2 class="hero-3d-heading">
      Worn by royalty, made by<br>
      <span class="hero-3d-heading-line2">hand</span>
    </h2>
    <p class="hero-3d-desc">{{ section.settings.description | default: 'Step into the royal atelier. Hand-spun silk, royal zardozi, and time-honored Indian craftsmanship brought alive in interactive 3D.' }}</p>
  </div>

  <!-- 3. CENTRAL 3D INTERACTIVE MASCOT STAGE -->
  <div id="hero-3d-stage-{{ section.id }}" class="hero-3d-stage">

    <!-- MAGICAL STARDUST CANVAS TRAIL -->
    <canvas id="hero-3d-sparkles-{{ section.id }}" class="hero-3d-sparkles-canvas"></canvas>

    <!-- HIGH-FIDELITY INTERACTIVE 3D MASCOT RIG -->
    <div id="hero-mascot-rig-{{ section.id }}" class="hero-mascot-rig">
      
      <!-- Contact Ground Shadow -->
      <div id="hero-mascot-shadow-{{ section.id }}" class="hero-mascot-shadow" aria-hidden="true"></div>

      <!-- Mascot Body & Tail (Brocade Sherwani, Red Stole, Necklace, Churidar, Curled Mojaris) -->
      <div id="hero-mascot-body-{{ section.id }}" class="hero-mascot-layer hero-mascot-body-layer">
        <img
          src="{{ 'mascot-body.png' | asset_url }}"
          alt="Royal Indian Mascot Body"
          width="250"
          height="293"
          loading="eager"
          decoding="async"
        >
      </div>

      <!-- Mascot Head, Turban, Kalgi & Glasses (3D Perspective Rotation on Neck Pivot) -->
      <div id="hero-mascot-head-{{ section.id }}" class="hero-mascot-layer hero-mascot-head-layer">
        <img
          src="{{ 'mascot-head.png' | asset_url }}"
          alt="Royal Indian Mascot Head with Rajasthani Safa and Glasses"
          width="250"
          height="293"
          loading="eager"
          decoding="async"
        >

        <!-- Expressive Darting Eye Pupils Behind Glasses -->
        <div class="hero-mascot-eyes-container" aria-hidden="true">
          <!-- Left Eye Pupil -->
          <div class="hero-mascot-eye hero-eye-left">
            <div id="hero-pupil-left-{{ section.id }}" class="hero-mascot-pupil"></div>
            <div id="hero-eyelid-left-{{ section.id }}" class="hero-mascot-eyelid"></div>
          </div>
          <!-- Right Eye Pupil -->
          <div class="hero-mascot-eye hero-eye-right">
            <div id="hero-pupil-right-{{ section.id }}" class="hero-mascot-pupil"></div>
            <div id="hero-eyelid-right-{{ section.id }}" class="hero-mascot-eyelid"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- OPTIONAL THREE.JS WEBGL CANVAS (For Custom GLB Models) -->
    <canvas
      id="hero-3d-canvas-{{ section.id }}"
      class="hero-3d-canvas"
      style="display: {% if section.settings.character_model_url != blank %}block{% else %}none{% endif %};"
    ></canvas>

    <!-- 3D Hint Pill -->
    <div class="hero-3d-hint">
      <span class="hero-3d-hint-icon">✦</span>
      <span class="hero-3d-hint-text">Interactive 3D Mascot &bull; Move mouse or drag to explore</span>
    </div>
  </div>

  <!-- 4. AUTONOMOUS CYAN / ELECTRIC BLUE 3D BUTTERFLY -->
  {% if section.settings.enable_butterfly %}
    <div
      id="hero-3d-butterfly-{{ section.id }}"
      class="hero-3d-butterfly"
      aria-hidden="true"
      style="--bf-cyan: {{ section.settings.butterfly_color | default: '#00E5FF' }};"
    >
      <div class="hero-3d-butterfly-wings">
        <!-- Left Wing -->
        <div class="hero-bf-wing hero-bf-wing-left">
          <svg viewBox="0 0 64 74" width="58" height="68">
            <defs>
              <linearGradient id="heroBfWingL-{{ section.id }}" x1="100%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#0a1d37" />
                <stop offset="25%" stop-color="#0d47a1" />
                <stop offset="55%" stop-color="#0288d1" />
                <stop offset="85%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 60 52 C 50 36, 24 16, 6 2 C -2 -4, -2 8, 5 22 C 10 32, 28 46, 60 56 Z"
                  fill="url(#heroBfWingL-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 60 52 C 44 48, 18 42, 10 32 C 2 20, -2 32, 6 44 C 14 56, 32 64, 60 54 Z"
                  fill="url(#heroBfWingL-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 58 50 Q 34 32 14 14 M 50 48 Q 28 34 16 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="8" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="16" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Slender Body -->
        <div class="hero-bf-body">
          <div class="hero-bf-antennae"></div>
          <div class="hero-bf-thorax"></div>
          <div class="hero-bf-abdomen"></div>
        </div>

        <!-- Right Wing -->
        <div class="hero-bf-wing hero-bf-wing-right">
          <svg viewBox="0 0 64 74" width="58" height="68">
            <defs>
              <linearGradient id="heroBfWingR-{{ section.id }}" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#0a1d37" />
                <stop offset="25%" stop-color="#0d47a1" />
                <stop offset="55%" stop-color="#0288d1" />
                <stop offset="85%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 4 52 C 14 36, 40 16, 58 2 C 66 -4, 66 8, 59 22 C 54 32, 36 46, 4 56 Z"
                  fill="url(#heroBfWingR-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 4 52 C 20 48, 46 42, 54 32 C 62 20, 66 32, 58 44 C 50 56, 32 64, 4 54 Z"
                  fill="url(#heroBfWingR-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 6 50 Q 30 32 50 14 M 14 48 Q 36 34 48 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="56" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="48" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  /* ==========================================================================
     HERO 3D SECTION STYLING (Scoped & Responsive)
     ========================================================================== */
  #interactive-hero-3d-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 92vh;
    background-color: var(--hero-bg, #E5A625);
    background-image: var(--hero-bg-image, radial-gradient(circle at 50% 50%, #f0bd4a 0%, #e2a022 55%, #c98818 100%));
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #241105;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Painterly Atmosphere Border Vignette */
  #interactive-hero-3d-{{ section.id }} .hero-3d-cloud-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(ellipse at 50% 50%, transparent 45%, rgba(200, 140, 30, 0.25) 80%, rgba(175, 115, 15, 0.45) 100%);
  }

  /* Luxury Header Overlay */
  #interactive-hero-3d-{{ section.id }} .hero-3d-header {
    width: 100%;
    max-width: 1360px;
    padding: 26px 40px 14px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
    position: relative;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #241105;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-crown-icon {
    display: flex;
    align-items: center;
    color: #241105;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-title {
    font-family: "Georgia", "Playfair Display", serif;
    font-size: 1.48rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
    color: #241105;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-nav-link {
    color: #381c0c;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-nav-link:hover {
    color: #100602;
    opacity: 0.85;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-social-icon {
    color: #381c0c;
    opacity: 0.9;
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-social-icon:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* Headings & Description */
  #interactive-hero-3d-{{ section.id }} .hero-3d-text-container {
    text-align: center;
    padding: 14px 24px 6px 24px;
    max-width: 820px;
    z-index: 5;
    position: relative;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-badge {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #4a2c14;
    margin-bottom: 8px;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-heading {
    font-family: "Georgia", "Playfair Display", serif;
    font-size: clamp(2.3rem, 4.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.14;
    margin: 0 0 12px 0;
    color: #221005;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 14px rgba(40, 20, 5, 0.06);
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-heading-line2 {
    display: inline-block;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-desc {
    font-size: clamp(0.94rem, 1.2vw, 1.05rem);
    line-height: 1.54;
    color: #381c0c;
    margin: 0 auto;
    max-width: 630px;
  }

  /* 3D Stage Container */
  #interactive-hero-3d-{{ section.id }} .hero-3d-stage {
    position: relative;
    width: 100%;
    max-width: 800px;
    height: 560px;
    margin-top: -6px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 6;
  }

  /* Magical Sparkles Canvas */
  #interactive-hero-3d-{{ section.id }} .hero-3d-sparkles-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 14;
  }

  /* High-Fidelity 3D Mascot Rig */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-rig {
    position: relative;
    width: clamp(270px, 32vw, 360px);
    height: clamp(320px, 38vw, 420px);
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 850px;
    transform-style: preserve-3d;
  }

  /* Ground Contact Shadow */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-shadow {
    position: absolute;
    bottom: 12px;
    width: 68%;
    height: 28px;
    background: radial-gradient(ellipse at center, rgba(60, 30, 8, 0.42) 0%, rgba(60, 30, 8, 0.16) 50%, transparent 75%);
    border-radius: 50%;
    filter: blur(5px);
    z-index: 1;
    transform-origin: 50% 50%;
    transition: transform 0.08s ease-out;
  }

  /* Mascot Image Layers */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backface-visibility: hidden;
  }

  #interactive-hero-3d-{{ section.id }} .hero-mascot-layer img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Body Layer */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-body-layer {
    z-index: 2;
    transform-origin: 50% 80%;
    will-change: transform;
  }

  /* Head Layer with 3D Gaze Rotation on Neck Joint */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-head-layer {
    z-index: 3;
    transform-origin: 50% 50.5%; /* Base of neck */
    will-change: transform;
    transform-style: preserve-3d;
  }

  /* Expressive Eyes Container Behind Glasses */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-eyes-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  #interactive-hero-3d-{{ section.id }} .hero-mascot-eye {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    overflow: hidden;
  }

  #interactive-hero-3d-{{ section.id }} .hero-eye-left {
    left: 42.8%;
    top: 36.2%;
  }

  #interactive-hero-3d-{{ section.id }} .hero-eye-right {
    left: 61.2%;
    top: 37.9%;
  }

  #interactive-hero-3d-{{ section.id }} .hero-mascot-pupil {
    position: absolute;
    width: 12px;
    height: 12px;
    left: 5px;
    top: 5px;
    background: radial-gradient(circle at 35% 35%, #22120b 0%, #110703 80%, #000000 100%);
    border-radius: 50%;
    box-shadow: inset 0 0 2px rgba(255, 255, 255, 0.4);
    will-change: transform;
    transition: transform 0.05s ease-out;
  }

  #interactive-hero-3d-{{ section.id }} .hero-mascot-pupil::after {
    content: '';
    position: absolute;
    width: 3.5px;
    height: 3.5px;
    top: 2px;
    left: 2px;
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.95;
  }

  /* Procedural Eyelids for Natural Blinking */
  #interactive-hero-3d-{{ section.id }} .hero-mascot-eyelid {
    position: absolute;
    inset: 0;
    background: #d89858;
    transform: scaleY(0);
    transform-origin: top center;
    border-radius: 50% 50% 0 0;
    z-index: 5;
    transition: transform 0.08s ease-in-out;
  }

  /* Optional WebGL Canvas */
  #interactive-hero-3d-{{ section.id }} .hero-3d-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    outline: none;
    cursor: grab;
    z-index: 5;
  }

  /* Hint Pill Matching Reference */
  #interactive-hero-3d-{{ section.id }} .hero-3d-hint {
    position: absolute;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 235, 192, 0.74);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.65);
    padding: 7px 18px;
    border-radius: 22px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #241105;
    box-shadow: 0 4px 16px rgba(40, 20, 5, 0.08);
    pointer-events: none;
    z-index: 10;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-hint-icon {
    font-size: 0.95rem;
    color: #241105;
  }

  /* ==========================================================================
     CYAN / ELECTRIC BLUE 3D BUTTERFLY
     ========================================================================== */
  #interactive-hero-3d-{{ section.id }} .hero-3d-butterfly {
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 75px;
    pointer-events: none !important;
    z-index: 20;
    will-change: transform;
    filter: drop-shadow(0 4px 16px rgba(0, 229, 255, 0.85));
    transition: opacity 0.3s ease;
  }

  #interactive-hero-3d-{{ section.id }} .hero-3d-butterfly-wings {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 480px;
    width: 100%;
    height: 100%;
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-wing {
    width: 44px;
    height: 52px;
    display: block;
    transform-style: preserve-3d;
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-wing-left {
    transform-origin: 100% 50%;
    animation: heroBfFlapLeft 0.12s ease-in-out infinite alternate;
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-wing-right {
    transform-origin: 0% 50%;
    animation: heroBfFlapRight 0.12s ease-in-out infinite alternate;
  }

  @keyframes heroBfFlapLeft {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(76deg) scaleX(0.40); }
  }

  @keyframes heroBfFlapRight {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(-76deg) scaleX(0.40); }
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-body {
    position: relative;
    width: 5px;
    height: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-antennae {
    position: absolute;
    top: -6px;
    width: 14px;
    height: 7px;
    border-top: 1.8px solid #00E5FF;
    border-radius: 8px 8px 0 0;
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-thorax {
    width: 5px;
    height: 9px;
    background: #0a1d37;
    border-radius: 3px 3px 2px 2px;
    border: 0.6px solid #00E5FF;
  }

  #interactive-hero-3d-{{ section.id }} .hero-bf-abdomen {
    width: 4px;
    height: 20px;
    background: linear-gradient(to bottom, #0a1d37, #0288d1);
    border-radius: 1px 1px 3px 3px;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    #interactive-hero-3d-{{ section.id }} .hero-3d-nav {
      display: none;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-header {
      padding: 20px 24px 10px 24px;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-stage {
      height: 490px;
    }
  }

  @media (max-width: 600px) {
    #interactive-hero-3d-{{ section.id }} {
      min-height: 85vh;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-heading {
      font-size: 2.1rem;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-stage {
      height: 440px;
    }
    #interactive-hero-3d-{{ section.id }} .hero-3d-hint {
      font-size: 0.74rem;
      padding: 6px 14px;
    }
  }
</style>

<script>
(function() {
  "use strict";

  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("interactive-hero-3d-" + sectionId);
  var stageEl = document.getElementById("hero-3d-stage-" + sectionId);
  var headEl = document.getElementById("hero-mascot-head-" + sectionId);
  var bodyEl = document.getElementById("hero-mascot-body-" + sectionId);
  var shadowEl = document.getElementById("hero-mascot-shadow-" + sectionId);
  var pupilLEl = document.getElementById("hero-pupil-left-" + sectionId);
  var pupilREl = document.getElementById("hero-pupil-right-" + sectionId);
  var eyelidLEl = document.getElementById("hero-eyelid-left-" + sectionId);
  var eyelidREl = document.getElementById("hero-eyelid-right-" + sectionId);
  var butterflyEl = document.getElementById("hero-3d-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("hero-3d-sparkles-" + sectionId);
  var webglCanvas = document.getElementById("hero-3d-canvas-" + sectionId);

  if (!sectionEl || !stageEl) return;

  var config = {
    sensitivity: {{ section.settings.tracking_sensitivity | default: 26 }},
    enableButterfly: {% if section.settings.enable_butterfly %}true{% else %}false{% endif %},
    enableSparkles: {% if section.settings.enable_sparkles %}true{% else %}false{% endif %},
    customModelUrl: "{{ section.settings.character_model_url | default: '' }}"
  };

  // ==========================================================================
  // 1. REAL-TIME 3D PERSPECTIVE GAZE & HEAD TRACKING ENGINE
  // ==========================================================================
  var GazeTrackingEngine = {
    targetX: 0,
    targetY: 0,
    currentX: 0,
    currentY: 0,
    isHovering: false,
    
    // Natural Rotation Bounds (degrees)
    maxHeadYaw: config.sensitivity,
    maxHeadPitch: 15,
    maxHeadRoll: 6,

    init: function() {
      var self = this;

      // Mouse tracking
      window.addEventListener("mousemove", function(e) {
        if (!stageEl) return;
        var rect = stageEl.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height * 0.44;

        // Normalized offset (-1 to +1)
        var dx = (e.clientX - centerX) / (window.innerWidth * 0.48);
        var dy = (e.clientY - centerY) / (window.innerHeight * 0.48);

        self.targetX = Math.max(-1, Math.min(1, dx));
        self.targetY = Math.max(-1, Math.min(1, dy));
        self.isHovering = true;
      }, { passive: true });

      // Return naturally to neutral when mouse leaves window
      document.addEventListener("mouseleave", function() {
        self.targetX = 0;
        self.targetY = 0;
        self.isHovering = false;
      });

      // Mobile Touch Interaction
      window.addEventListener("touchmove", function(e) {
        if (!stageEl || !e.touches || e.touches.length === 0) return;
        var touch = e.touches[0];
        var rect = stageEl.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height * 0.44;

        var dx = (touch.clientX - centerX) / (window.innerWidth * 0.48);
        var dy = (touch.clientY - centerY) / (window.innerHeight * 0.48);

        self.targetX = Math.max(-1, Math.min(1, dx));
        self.targetY = Math.max(-1, Math.min(1, dy));
        self.isHovering = true;
      }, { passive: true });

      window.addEventListener("touchend", function() {
        self.targetX = 0;
        self.targetY = 0;
        self.isHovering = false;
      });

      requestAnimationFrame(this.tick.bind(this));
    },

    tick: function(time) {
      requestAnimationFrame(this.tick.bind(this));

      // Smooth Spring-Mass Damping
      this.currentX += (this.targetX - this.currentX) * 0.082;
      this.currentY += (this.targetY - this.currentY) * 0.082;

      // 1. Calculate Head 3D Perspective Angles
      var headYaw = this.currentX * this.maxHeadYaw;
      var headPitch = -this.currentY * this.maxHeadPitch;
      var headRoll = this.currentX * this.maxHeadRoll;
      var headParallaxX = this.currentX * 10;
      var headParallaxY = this.currentY * 6;

      // 2. Idle Organic Breathing
      var breathWave = Math.sin(time * 0.0026);
      var breathY = breathWave * 2.8;

      // 3. Apply Head 3D Transform
      if (headEl) {
        headEl.style.transform =
          "translate3d(" + headParallaxX.toFixed(2) + "px, " + (headParallaxY + breathY).toFixed(2) + "px, 14px) " +
          "rotateY(" + headYaw.toFixed(2) + "deg) " +
          "rotateX(" + headPitch.toFixed(2) + "deg) " +
          "rotateZ(" + headRoll.toFixed(2) + "deg)";
      }

      // 4. Subtle Body & Tail Posture Follow
      if (bodyEl) {
        var bodyYaw = this.currentX * 3.8;
        var bodyX = this.currentX * 2.5;
        bodyEl.style.transform =
          "translate3d(" + bodyX.toFixed(2) + "px, " + (breathY * 0.65).toFixed(2) + "px, 0px) " +
          "rotateY(" + bodyYaw.toFixed(2) + "deg)";
      }

      // 5. Contact Shadow Dynamic Skew
      if (shadowEl) {
        var shadowSkew = -this.currentX * 6;
        var shadowScale = 1.0 - Math.abs(this.currentY) * 0.05;
        shadowEl.style.transform =
          "translateX(" + (this.currentX * 12).toFixed(1) + "px) " +
          "skewX(" + shadowSkew.toFixed(1) + "deg) " +
          "scale(" + shadowScale.toFixed(2) + ")";
      }

      // 6. Eye Pupils Tracking
      var eyeOffsetX = this.currentX * 4.5;
      var eyeOffsetY = this.currentY * 3.8;
      if (pupilLEl) {
        pupilLEl.style.transform = "translate(" + eyeOffsetX.toFixed(1) + "px, " + eyeOffsetY.toFixed(1) + "px)";
      }
      if (pupilREl) {
        pupilREl.style.transform = "translate(" + eyeOffsetX.toFixed(1) + "px, " + eyeOffsetY.toFixed(1) + "px)";
      }

      // 7. Procedural Blinking (~ every 3.5 seconds)
      var blinkCycle = (time % 3500) / 3500;
      var isBlinking = blinkCycle > 0.955;
      var blinkScale = isBlinking ? (1.0 - Math.sin(((blinkCycle - 0.955) / 0.045) * Math.PI)) : 0;
      if (eyelidLEl && eyelidREl) {
        eyelidLEl.style.transform = "scaleY(" + (1 - blinkScale).toFixed(2) + ")";
        eyelidREl.style.transform = "scaleY(" + (1 - blinkScale).toFixed(2) + ")";
      }
    }
  };

  // ==========================================================================
  // 2. ELECTRIC BLUE BUTTERFLY & MAGICAL FAIRY DUST SPARKLE TRAIL
  // ==========================================================================
  var SparkleTrailEngine = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],
    dpr: window.devicePixelRatio || 1,

    init: function() {
      if (!this.canvas || !config.enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.canvas.width = rect.width * this.dpr;
      this.canvas.height = rect.height * this.dpr;
      if (this.ctx) {
        this.ctx.scale(this.dpr, this.dpr);
      }
    },

    spawn: function(x, y, vx, vy) {
      if (!config.enableSparkles || this.particles.length > 90) return;

      var colors = ["#00E5FF", "#B2EBF2", "#FFFFFF", "#FFD54F"];
      var color = colors[Math.floor(Math.random() * colors.length)];

      this.particles.push({
        x: x + (Math.random() - 0.5) * 12,
        y: y + (Math.random() - 0.5) * 10,
        vx: (Math.random() - 0.5) * 1.2 - vx * 0.12,
        vy: (Math.random() - 0.5) * 1.2 + 0.65, // Gentle downward gravity drift
        size: Math.random() * 2.8 + 1.2,
        alpha: 1.0,
        decay: Math.random() * 0.024 + 0.016,
        color: color,
        phase: Math.random() * Math.PI * 2
      });
    },

    render: function(time) {
      if (!this.ctx || !stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      this.ctx.clearRect(0, 0, rect.width, rect.height);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        // Twinkle luminance
        var twinkle = Math.sin(time * 0.015 + p.phase) * 0.3 + 0.7;
        var drawAlpha = Math.max(0, Math.min(1, p.alpha * twinkle));

        this.ctx.save();
        this.ctx.globalAlpha = drawAlpha;
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 8;

        // Draw 4-point sparkle star
        var s = p.size;
        this.ctx.beginPath();
        this.ctx.moveTo(p.x, p.y - s * 1.5);
        this.ctx.lineTo(p.x + s * 0.4, p.y - s * 0.4);
        this.ctx.lineTo(p.x + s * 1.5, p.y);
        this.ctx.lineTo(p.x + s * 0.4, p.y + s * 0.4);
        this.ctx.lineTo(p.x, p.y + s * 1.5);
        this.ctx.lineTo(p.x - s * 0.4, p.y + s * 0.4);
        this.ctx.lineTo(p.x - s * 1.5, p.y);
        this.ctx.lineTo(p.x - s * 0.4, p.y - s * 0.4);
        this.ctx.closePath();
        this.ctx.fill();

        this.ctx.restore();
      }
    }
  };

  var ElectricButterflyEngine = {
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    currentAngle: 0,
    isActive: false,

    init: function() {
      if (!butterflyEl || !config.enableButterfly) return;

      var secRect = sectionEl.getBoundingClientRect();
      this.posX = secRect.width * 0.62;
      this.posY = secRect.height * 0.38;
      this.targetX = this.posX;
      this.targetY = this.posY;

      var self = this;
      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var rect = sectionEl.getBoundingClientRect();
        self.targetX = e.clientX - rect.left;
        self.targetY = e.clientY - rect.top;
        self.isActive = true;
      }, { passive: true });

      requestAnimationFrame(this.flightLoop.bind(this));
    },

    flightLoop: function(time) {
      requestAnimationFrame(this.flightLoop.bind(this));

      if (!butterflyEl || !config.enableButterfly) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 620;

      // Gentle autonomous patrol hovering if idle
      if (!this.isActive) {
        var t = time * 0.0016;
        this.targetX = secW * 0.58 + Math.cos(t) * (secW * 0.18);
        this.targetY = secH * 0.38 + Math.sin(t * 1.8) * (secH * 0.12);
      }

      // Smooth Trailing Lag
      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      var dist = Math.sqrt(dx * dx + dy * dy);

      this.posX += dx * 0.092;
      this.posY += dy * 0.092;

      // Natural Sinusoidal Buoyancy
      var hoverX = Math.sin(time * 0.0036) * 7;
      var hoverY = Math.cos(time * 0.0042) * 6;
      var finalX = this.posX + hoverX;
      var finalY = this.posY + hoverY;

      // Boundary Clamping
      finalX = Math.max(25, Math.min(secW - 95, finalX));
      finalY = Math.max(20, Math.min(secH - 85, finalY));

      // Calculate Heading Angle & Bank Tilt
      if (dist > 3) {
        var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        var diff = (targetAngle - this.currentAngle + 540) % 360 - 180;
        this.currentAngle += diff * 0.12;
      }
      var bankTilt = Math.max(-28, Math.min(28, (dx * 0.092) * 2.2));

      // Apply 3D Transform to Butterfly
      butterflyEl.style.transform =
        "translate3d(" + (finalX - 35).toFixed(1) + "px, " + (finalY - 30).toFixed(1) + "px, 0px) " +
        "rotate(" + this.currentAngle.toFixed(1) + "deg) " +
        "rotateY(" + bankTilt.toFixed(1) + "deg)";

      // Emit Magical Sparkles into Canvas Trail
      if (stageEl && SparkleTrailEngine.ctx) {
        var stageRect = stageEl.getBoundingClientRect();
        var secRect = sectionEl.getBoundingClientRect();
        var canvasRelX = finalX - (stageRect.left - secRect.left);
        var canvasRelY = finalY - (stageRect.top - secRect.top);

        if (dist > 2 || Math.random() < 0.3) {
          SparkleTrailEngine.spawn(canvasRelX, canvasRelY, dx * 0.05, dy * 0.05);
        }
      }

      SparkleTrailEngine.render(time);
    }
  };

  // ==========================================================================
  // 3. OPTIONAL THREE.JS WEBGL GLB ENGINE (For Custom Uploaded 3D Models)
  // ==========================================================================
  var WebGL3DManager = {
    scene: null,
    camera: null,
    renderer: null,
    model: null,
    bones: {},

    init: function() {
      if (!webglCanvas || !config.customModelUrl || config.customModelUrl.trim() === "") return;
      if (typeof THREE === "undefined" || typeof THREE.GLTFLoader === "undefined") return;

      var self = this;
      var w = stageEl.clientWidth || 640;
      var h = stageEl.clientHeight || 540;

      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
      this.camera.position.set(0, 1.18, 3.3);
      this.camera.lookAt(0, 0.98, 0);

      this.renderer = new THREE.WebGLRenderer({
        canvas: webglCanvas,
        alpha: true,
        antialias: true
      });
      this.renderer.setSize(w, h);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      var amb = new THREE.AmbientLight(0xFFF6E5, 1.4);
      this.scene.add(amb);
      var dir = new THREE.DirectionalLight(0xFFFFFF, 1.8);
      dir.position.set(3.5, 4.5, 4.0);
      this.scene.add(dir);

      var loader = new THREE.GLTFLoader();
      loader.load(config.customModelUrl, function(gltf) {
        self.model = gltf.scene;
        self.scene.add(self.model);
        self.model.traverse(function(n) {
          if (n.isBone) {
            var nm = (n.name || "").toLowerCase();
            if (nm.indexOf("head") !== -1 && !self.bones.head) self.bones.head = n;
            if (nm.indexOf("neck") !== -1 && !self.bones.neck) self.bones.neck = n;
          }
        });
      });
    }
  };

  // ==========================================================================
  // 4. BOOTSTRAP
  // ==========================================================================
  function bootSection() {
    GazeTrackingEngine.init();
    SparkleTrailEngine.init();
    ElectricButterflyEngine.init();
    WebGL3DManager.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootSection);
  } else {
    bootSection();
  }

  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      bootSection();
    }
  });

})();
</script>

