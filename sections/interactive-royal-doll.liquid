    }

    .card-image-box {
      height: 180px;
    }

    /* Keep butterfly visible on mobile */
    .royal-butterfly-creature {
      transform: scale(0.85);
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .royal-doll--idle {
      animation: none !important;
    }
    .butterfly-wing {
      animation: none !important;
      transform: rotateY(20deg) !important;
    }
    .royal-butterfly-creature {
      display: none !important;
    }
    .royal-butterfly-canvas {
      display: none !important;
    }
  }
</style>

<script>
  (function() {
    /**
     * Royal Fashion Doll Interactive Controller
     * Handles product card selection, outfit crossfades, and 3D butterfly flight physics.
     */
    function initRoyalDollSection() {
      var sectionContainer = document.getElementById('RoyalDoll-{{ section.id }}');
      if (!sectionContainer) return;

      var dollViewer = document.getElementById('RoyalDollViewer-{{ section.id }}');
      var headRig = document.getElementById('RoyalDollHeadRig-{{ section.id }}');
      var bodyRig = document.getElementById('RoyalDollBodyRig-{{ section.id }}');
      var bodyImgs = sectionContainer.querySelectorAll('.royal-body-img');
      var headImgs = sectionContainer.querySelectorAll('.royal-head-img');
      var customDollBox = document.getElementById('RoyalDollCustom-{{ section.id }}');
      var cards = sectionContainer.querySelectorAll('.royal-product-card');
      var categoryPills = sectionContainer.querySelectorAll('.royal-cat-pill');
      var cardsTrack = document.getElementById('RoyalCardsTrack-{{ section.id }}');
      var prevBtn = sectionContainer.querySelector('.arrow-prev');
      var nextBtn = sectionContainer.querySelector('.arrow-next');

      // Live Details elements
      var titleEl = document.getElementById('RoyalSelectedTitle-{{ section.id }}');
      var subtitleEl = document.getElementById('RoyalSelectedSubtitle-{{ section.id }}');
      var priceEl = document.getElementById('RoyalSelectedPrice-{{ section.id }}');
      var storyEl = document.getElementById('RoyalSelectedStory-{{ section.id }}');
      var categoryEl = document.getElementById('RoyalSelectedCategory-{{ section.id }}');
      var numberEl = document.getElementById('RoyalSelectedNumber-{{ section.id }}');
      var ctaEl = document.getElementById('RoyalSelectedCTA-{{ section.id }}');
      var outfitBadgeEl = document.getElementById('RoyalActiveOutfitName-{{ section.id }}');

      /* ----------------------------------------------------
         1. Outfit Selection & Crossfade Logic
         ---------------------------------------------------- */
      function selectCard(card) {
        if (!card) return;

        // Visual Card State
        cards.forEach(function(c) {
          c.classList.remove('selected');
          c.setAttribute('aria-pressed', 'false');
        });
        card.classList.add('selected');
        card.setAttribute('aria-pressed', 'true');

        // Extract metadata
        var outfitKey = card.getAttribute('data-outfit-key') || 'cream';
        var customOutfitUrl = card.getAttribute('data-outfit-url');
        var title = card.getAttribute('data-title');
        var subtitle = card.getAttribute('data-subtitle');
        var price = card.getAttribute('data-price');
        var story = card.getAttribute('data-story');
        var category = card.getAttribute('data-category');
        var productUrl = card.getAttribute('data-product-url');
        var cardIndex = card.querySelector('.card-index') ? card.querySelector('.card-index').textContent : '01';

        // Update Info Panel
        if (titleEl && title) titleEl.textContent = title;
        if (subtitleEl && subtitle) subtitleEl.textContent = subtitle;
        if (priceEl && price) priceEl.textContent = price;
        if (storyEl && story) storyEl.textContent = story;
        if (categoryEl && category) categoryEl.textContent = category.toUpperCase() + ' CREATION';
        if (numberEl && cardIndex) numberEl.textContent = cardIndex;
        if (outfitBadgeEl && title) outfitBadgeEl.textContent = title;
        if (ctaEl && productUrl) {
          ctaEl.setAttribute('href', productUrl !== '#' ? productUrl : '#');
        }

        // Crossfade Doll Appearance
        var matched = false;

        // A) If merchant specified a custom uploaded doll image in block
        if (customOutfitUrl && customOutfitUrl.trim() !== '') {
          var customImg = document.getElementById('RoyalCustomDoll-{{ section.id }}');
          if (!customImg) {
            customImg = document.createElement('img');
            customImg.id = 'RoyalCustomDoll-{{ section.id }}';
            customImg.className = 'royal-doll-img';
            customImg.alt = title;
            if (customDollBox) customDollBox.appendChild(customImg);
          }
          customImg.src = customOutfitUrl;
          if (bodyRig) bodyRig.style.display = 'none';
          if (headRig) headRig.style.display = 'none';
          customImg.classList.add('active');
          matched = true;
        }

        // B) Match against preloaded character variations (cream, red, blue, green)
        if (!matched) {
          if (bodyRig) bodyRig.style.display = 'block';
          if (headRig) headRig.style.display = 'block';
          var customImg = document.getElementById('RoyalCustomDoll-{{ section.id }}');
          if (customImg) customImg.classList.remove('active');

          bodyImgs.forEach(function(img) {
            if (img.getAttribute('data-outfit-key') === outfitKey) {
              img.classList.add('active');
            } else {
              img.classList.remove('active');
            }
          });

          headImgs.forEach(function(img) {
            if (img.getAttribute('data-outfit-key') === outfitKey) {
              img.classList.add('active');
            } else {
              img.classList.remove('active');
            }
          });
        }
      }

      // Card Click & Keyboard Listeners
      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          selectCard(card);
        });
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectCard(card);
          }
        });
      });

      // Carousel Horizontal Arrow Navigation
      if (prevBtn && cardsTrack) {
        prevBtn.addEventListener('click', function() {
          cardsTrack.scrollBy({ left: -280, behavior: 'smooth' });
        });
      }
      if (nextBtn && cardsTrack) {
        nextBtn.addEventListener('click', function() {
          cardsTrack.scrollBy({ left: 280, behavior: 'smooth' });
        });
      }

      // Category Pill Filtering
      categoryPills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          categoryPills.forEach(function(p) { p.classList.remove('active'); });
          pill.classList.add('active');

          var selectedCat = pill.getAttribute('data-category');
          var firstVisible = null;

          cards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category');
            if (selectedCat === 'all' || cardCat === selectedCat) {
              card.style.display = 'block';
              if (!firstVisible) firstVisible = card;
            } else {
              card.style.display = 'none';
            }
          });

          // Automatically select the first piece in this category
          if (firstVisible) {
            selectCard(firstVisible);
          }
        });
      });

      /* ----------------------------------------------------
         2. Interactive 3D Cursor Tracking & Butterfly Engine
         ---------------------------------------------------- */
      var butterfly = document.getElementById('RoyalButterfly-{{ section.id }}');
      var canvas = document.getElementById('RoyalButterflyCanvas-{{ section.id }}');
      var auraDisc = sectionContainer.querySelector('.royal-aura-disc');
      var enableDollTracking = dollViewer && dollViewer.getAttribute('data-doll-tracking') !== 'false';
      var enableIdleFloat = dollViewer && dollViewer.getAttribute('data-idle-float') !== 'false';
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var animationFrameId = null;
      var rect = sectionContainer.getBoundingClientRect();
      var width = sectionContainer.offsetWidth;
      var height = sectionContainer.offsetHeight;

      if (canvas) {
        canvas.width = width;
        canvas.height = height;
      }

      function handleResize() {
        if (!sectionContainer) return;
        rect = sectionContainer.getBoundingClientRect();
        width = sectionContainer.offsetWidth;
        height = sectionContainer.offsetHeight;
        if (canvas) {
          canvas.width = width;
          canvas.height = height;
        }
      }
      window.addEventListener('resize', handleResize);

      // Mouse & Pointer Tracking State
      var isCursorInside = false;
      var lastMoveTime = performance.now();
      var currentClientX = window.innerWidth * 0.5;
      var currentClientY = window.innerHeight * 0.5;

      // Butterfly Position & Flight State
      var posX = width * 0.2;
      var posY = height * 0.2;
      var targetX = posX;
      var targetY = posY;
      var currentAngle = 0;
      var speedVal = butterfly ? (parseFloat(butterfly.getAttribute('data-speed')) || 8) : 8;
      var ease = speedVal / 100;
      var particles = [];

      // Body 3D Orientation State
      var bodyRotY = 0;
      var bodyRotX = 0;
      var bodyTransX = 0;

      // Head & Neck 3D Orientation State
      var headRotY = 0;
      var headRotX = 0;
      var headRotZ = 0;
      var headTransX = 0;

      // Sparkle Particle Class
      function Particle(x, y) {
        this.x = x + (Math.random() - 0.5) * 8;
        this.y = y + (Math.random() - 0.5) * 8;
        this.radius = Math.random() * 2.2 + 0.8;
        this.alpha = 1;
        this.decay = Math.random() * 0.025 + 0.015;
        this.vx = (Math.random() - 0.5) * 0.8;
        this.vy = Math.random() * 0.5 + 0.3;
        var hues = ['#00e5ff', '#651fff', '#ffd700', '#76ff03', '#80d8ff'];
        this.color = hues[Math.floor(Math.random() * hues.length)];
      }

      Particle.prototype.update = function() {
        this.x += this.vx;
        this.y += this.vy;
        this.alpha -= this.decay;
      };

      Particle.prototype.draw = function(c) {
        c.save();
        c.globalAlpha = Math.max(0, this.alpha);
        c.fillStyle = this.color;
        c.shadowColor = this.color;
        c.shadowBlur = 6;
        c.beginPath();
        c.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        c.fill();
        c.restore();
      };

      function updateTargetFromEvent(e) {
        var clientX = e.clientX;
        var clientY = e.clientY;
        if (e.touches && e.touches.length > 0) {
          clientX = e.touches[0].clientX;
          clientY = e.touches[0].clientY;
        }
        currentClientX = clientX;
        currentClientY = clientY;
        rect = sectionContainer.getBoundingClientRect();
        targetX = clientX - rect.left;
        targetY = clientY - rect.top;
        isCursorInside = true;
        lastMoveTime = performance.now();
      }

      sectionContainer.addEventListener('mousemove', updateTargetFromEvent);
      sectionContainer.addEventListener('mouseenter', updateTargetFromEvent);
      sectionContainer.addEventListener('mouseleave', function() {
        isCursorInside = false;
      });
      sectionContainer.addEventListener('touchmove', updateTargetFromEvent, { passive: true });
      sectionContainer.addEventListener('touchstart', updateTargetFromEvent, { passive: true });

      // Unified 60fps Animation Loop
      function animateStage(time) {
        if (prefersReducedMotion) return;

        // --- A. 3D Doll Head, Neck & Body Cursor Tracking ---
        if (dollViewer && enableDollTracking) {
          var targetBodyRotY = 0;
          var targetBodyRotX = 0;
          var targetBodyTransX = 0;

          var targetHeadRotY = 0;
          var targetHeadRotX = 0;
          var targetHeadRotZ = 0;
          var targetHeadTransX = 0;

          if (isCursorInside) {
            var dollRect = dollViewer.getBoundingClientRect();
            var dollMidX = dollRect.left + dollRect.width / 2;
            var dollMidY = dollRect.top + dollRect.height * 0.38;

            var relX = (currentClientX - dollMidX) / (window.innerWidth * 0.42);
            var relY = (currentClientY - dollMidY) / (window.innerHeight * 0.42);

            relX = Math.max(-1.2, Math.min(1.2, relX));
            relY = Math.max(-1.2, Math.min(1.2, relY));

            // HEAD & NECK: Active rotation following the cursor
            // Moves smoothly to the side where the cursor is
            targetHeadRotY = relX * 28;
            targetHeadRotX = -relY * 12;
            targetHeadRotZ = relX * 4.5;
            targetHeadTransX = relX * 12;

            // BODY: Grounded posture with subtle secondary lean
            targetBodyRotY = relX * 7;
            targetBodyRotX = -relY * 3.5;
            targetBodyTransX = relX * 8;
          } else if (butterfly && (!isCursorInside || (time - lastMoveTime > 3000))) {
            // When mouse is idle, head and neck swivel to watch the autonomous butterfly!
            var dollLocalX = width * 0.5;
            var diffX = (posX - dollLocalX) / (width * 0.45);
            var diffY = (posY - (height * 0.35)) / (height * 0.45);

            diffX = Math.max(-1.1, Math.min(1.1, diffX));
            diffY = Math.max(-1.1, Math.min(1.1, diffY));

            targetHeadRotY = diffX * 22;
            targetHeadRotX = -diffY * 10;
            targetHeadRotZ = diffX * 3;
            targetHeadTransX = diffX * 8;

            targetBodyRotY = diffX * 5;
            targetBodyTransX = diffX * 5;
          }

          // Smooth lerp damping for fluid, organic motion
          headRotY += (targetHeadRotY - headRotY) * 0.085;
          headRotX += (targetHeadRotX - headRotX) * 0.085;
          headRotZ += (targetHeadRotZ - headRotZ) * 0.085;
          headTransX += (targetHeadTransX - headTransX) * 0.085;

          bodyRotY += (targetBodyRotY - bodyRotY) * 0.07;
          bodyRotX += (targetBodyRotX - bodyRotX) * 0.07;
          bodyTransX += (targetBodyTransX - bodyTransX) * 0.07;

          var idleY = enableIdleFloat ? Math.sin(time * 0.0016) * 6 : 0;

          // Apply to Body Rig
          if (bodyRig) {
            bodyRig.style.transform =
              'translate3d(' + bodyTransX.toFixed(2) + 'px, ' + idleY.toFixed(2) + 'px, 0px) ' +
              'rotateY(' + bodyRotY.toFixed(2) + 'deg) ' +
              'rotateX(' + bodyRotX.toFixed(2) + 'deg)';
          }

          // Apply to Head Rig (turns on neck joint!)
          if (headRig) {
            headRig.style.transform =
              'translate3d(' + headTransX.toFixed(2) + 'px, ' + idleY.toFixed(2) + 'px, 0px) ' +
              'rotateY(' + headRotY.toFixed(2) + 'deg) ' +
              'rotateX(' + headRotX.toFixed(2) + 'deg) ' +
              'rotateZ(' + headRotZ.toFixed(2) + 'deg)';
          }

          // Background Golden Aura Disc Counter-Parallax
          if (auraDisc) {
            var auraX = -headRotY * 1.6;
            var auraY = -headRotX * 1.2;
            auraDisc.style.transform = 'translate3d(calc(-50% + ' + auraX.toFixed(1) + 'px), ' + auraY.toFixed(1) + 'px, 0)';
          }
        }

        // --- B. Interactive 3D Butterfly Flight ---
        if (butterfly && canvas) {
          var ctx = canvas.getContext('2d');

          // If mouse is idle or outside, autonomous curved patrol around doll
          if (!isCursorInside || (time - lastMoveTime > 3500)) {
            var patrolCenterY = height * 0.32;
            var patrolCenterX = width * 0.5;
            var t = time * 0.0012;
            targetX = patrolCenterX + Math.cos(t) * (width * 0.28);
            targetY = patrolCenterY + Math.sin(t * 2) * (height * 0.18);
          }

          var dx = targetX - posX;
          var dy = targetY - posY;
          var dist = Math.sqrt(dx * dx + dy * dy);

          var vx = dx * ease;
          var vy = dy * ease;
          posX += vx;
          posY += vy;

          var hoverX = Math.sin(time * 0.0035) * 10;
          var hoverY = Math.cos(time * 0.0042) * 8;
          var finalX = posX + hoverX;
          var finalY = posY + hoverY;

          finalX = Math.max(30, Math.min(width - 70, finalX));
          finalY = Math.max(30, Math.min(height - 70, finalY));

          if (dist > 2) {
            var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
            var angleDiff = (targetAngle - currentAngle + 540) % 360 - 180;
            currentAngle += angleDiff * 0.12;
          }

          var tilt = Math.max(-25, Math.min(25, vx * 1.8));

          if (dist > 40) {
            butterfly.classList.add('fast-flap');
            butterfly.classList.remove('hover-flap');
          } else {
            butterfly.classList.remove('fast-flap');
            butterfly.classList.add('hover-flap');
          }

          butterfly.style.transform =
            'translate3d(' + (finalX - 45) + 'px, ' + (finalY - 35) + 'px, 0px) ' +
            'rotate(' + currentAngle.toFixed(1) + 'deg) ' +
            'rotateY(' + tilt.toFixed(1) + 'deg)';

          if (Math.random() < 0.45 && particles.length < 50) {
            particles.push(new Particle(finalX, finalY));
          }

          ctx.clearRect(0, 0, width, height);
          for (var i = particles.length - 1; i >= 0; i--) {
            particles[i].update();
            if (particles[i].alpha <= 0) {
              particles.splice(i, 1);
            } else {
              particles[i].draw(ctx);
            }
          }
        }

        animationFrameId = requestAnimationFrame(animateStage);
      }

      animationFrameId = requestAnimationFrame(animateStage);

      // Teardown logic on section unload
      document.addEventListener('shopify:section:unload', function(e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          if (animationFrameId) cancelAnimationFrame(animationFrameId);
          window.removeEventListener('resize', handleResize);
        }
      });
    }

    // Initialize on DOM load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRoyalDollSection);
    } else {
      initRoyalDollSection();
    }

    // Re-initialize when Shopify Theme Editor re-renders the section
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initRoyalDollSection();
      }
    });
  })();
</script>

