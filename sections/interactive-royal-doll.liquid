{% comment %}
  Interactive Royal Fashion Doll Section
  Production-ready 3D character doll showcase with interactive product-to-outfit mapping,
  continuous 3D butterfly flight animation, and royal palace ambiance.
{% endcomment %}

<div
  id="RoyalDoll-{{ section.id }}"
  class="royal-doll-section royal-doll--{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --royal-bg-color: {{ section.settings.bg_color | default: '#fdf6e9' }};
    --royal-accent-gold: {{ section.settings.accent_color | default: '#c89332' }};
    --royal-gold-light: {{ section.settings.gold_light | default: '#f3dfb2' }};
    --royal-text-primary: {{ section.settings.text_color | default: '#2b1810' }};
    --royal-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --royal-padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --royal-doll-height: {{ section.settings.doll_max_height | default: 560 }}px;
    {% if section.settings.bg_image != blank %}
      --royal-bg-image: url('{{ section.settings.bg_image | image_url: width: 2400 }}');
    {% elsif section.settings.use_default_bg %}
      --royal-bg-image: url('{{ "palace-background.jpg" | asset_url }}');
    {% else %}
      --royal-bg-image: none;
    {% endif %}
  "
>
  <!-- Background Palace Texture / Gradient Overlay -->
  <div class="royal-palace-backdrop" aria-hidden="true">
    <div class="royal-arch-glow"></div>
  </div>

  <!-- Interactive 3D Cursor Butterfly & Sparkle Trail Canvas -->
  {% if section.settings.enable_butterfly %}
    <canvas id="RoyalButterflyCanvas-{{ section.id }}" class="royal-butterfly-canvas" aria-hidden="true"></canvas>

    <div
      id="RoyalButterfly-{{ section.id }}"
      class="royal-butterfly-creature"
      aria-hidden="true"
      data-speed="{{ section.settings.butterfly_speed | default: 8 }}"
    >
      <div class="butterfly-3d-rig">
        <!-- Left Wing -->
        <div class="butterfly-wing wing-left">
          <svg viewBox="0 0 70 80" width="70" height="80">
            <defs>
              <linearGradient id="bfWingL-{{ section.id }}" x1="0%" y1="30%" x2="100%" y2="70%">
                <stop offset="0%" stop-color="#140742" />
                <stop offset="25%" stop-color="#4a148c" />
                <stop offset="55%" stop-color="#2979ff" />
                <stop offset="85%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#80d8ff" />
              </linearGradient>
              <radialGradient id="bfGlowL-{{ section.id }}" cx="60%" cy="45%" r="50%">
                <stop offset="0%" stop-color="#69f0ae" stop-opacity="0.75" />
                <stop offset="60%" stop-color="#00e5ff" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#2979ff" stop-opacity="0" />
              </radialGradient>
              <filter id="bfShadowL-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00e5ff" flood-opacity="0.6"/>
              </filter>
            </defs>
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#bfWingL-{{ section.id }})" filter="url(#bfShadowL-{{ section.id }})" stroke="#0d47a1" stroke-width="0.8" />
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#bfGlowL-{{ section.id }})" />
            <path d="M 66 38 C 58 44, 46 48, 30 52 C 16 56, 12 66, 20 74 C 28 82, 48 78, 58 64 C 64 54, 66 44, 66 38 Z"
                  fill="url(#bfWingL-{{ section.id }})" stroke="#1a237e" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.6)" stroke-width="0.65" fill="none">
              <path d="M 66 36 Q 40 24 16 12" />
              <path d="M 66 36 Q 36 32 10 24" />
              <path d="M 66 36 Q 42 40 24 38" />
              <path d="M 65 42 Q 46 56 26 68" />
              <path d="M 65 42 Q 52 64 42 74" />
            </g>
            <circle cx="10" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="6" cy="22" r="1" fill="#ffffff" />
            <circle cx="18" cy="72" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Body -->
        <div class="butterfly-body">
          <svg viewBox="0 0 16 80" width="16" height="80">
            <defs>
              <linearGradient id="bfBodyGrad-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4a148c" />
                <stop offset="50%" stop-color="#1a237e" />
                <stop offset="100%" stop-color="#00e5ff" />
              </linearGradient>
            </defs>
            <path d="M 7 24 Q 4 12 1 6 Q 0 4 2 4 Q 4 4 5 10 Q 6 18 7 24" fill="#311b92" />
            <path d="M 9 24 Q 12 12 15 6 Q 16 4 14 4 Q 12 4 11 10 Q 10 18 9 24" fill="#311b92" />
            <circle cx="2" cy="4" r="1.5" fill="#00e5ff" />
            <circle cx="14" cy="4" r="1.5" fill="#00e5ff" />
            <circle cx="8" cy="26" r="3.5" fill="#1a237e" />
            <circle cx="6.5" cy="25" r="0.9" fill="#69f0ae" />
            <circle cx="9.5" cy="25" r="0.9" fill="#69f0ae" />
            <ellipse cx="8" cy="35" rx="3.8" ry="6" fill="url(#bfBodyGrad-{{ section.id }})" />
            <path d="M 5 40 Q 4 54 7 66 Q 8 68 9 66 Q 12 54 11 40 Z" fill="url(#bfBodyGrad-{{ section.id }})" />
            <ellipse cx="8" cy="34" rx="1.8" ry="2.8" fill="#00e5ff" opacity="0.95" />
          </svg>
        </div>

        <!-- Right Wing -->
        <div class="butterfly-wing wing-right">
          <svg viewBox="0 0 70 80" width="70" height="80">
            <defs>
              <linearGradient id="bfWingR-{{ section.id }}" x1="100%" y1="30%" x2="0%" y2="70%">
                <stop offset="0%" stop-color="#140742" />
                <stop offset="25%" stop-color="#4a148c" />
                <stop offset="55%" stop-color="#2979ff" />
                <stop offset="85%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#80d8ff" />
              </linearGradient>
              <radialGradient id="bfGlowR-{{ section.id }}" cx="40%" cy="45%" r="50%">
                <stop offset="0%" stop-color="#69f0ae" stop-opacity="0.75" />
                <stop offset="60%" stop-color="#00e5ff" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#2979ff" stop-opacity="0" />
              </radialGradient>
              <filter id="bfShadowR-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00e5ff" flood-opacity="0.6"/>
              </filter>
            </defs>
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#bfWingR-{{ section.id }})" filter="url(#bfShadowR-{{ section.id }})" stroke="#0d47a1" stroke-width="0.8" />
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#bfGlowR-{{ section.id }})" />
            <path d="M 4 38 C 12 44, 24 48, 40 52 C 54 56, 58 66, 50 74 C 42 82, 22 78, 12 64 C 6 54, 4 44, 4 38 Z"
                  fill="url(#bfWingR-{{ section.id }})" stroke="#1a237e" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.6)" stroke-width="0.65" fill="none">
              <path d="M 4 36 Q 30 24 54 12" />
              <path d="M 4 36 Q 34 32 60 24" />
              <path d="M 4 36 Q 28 40 46 38" />
              <path d="M 5 42 Q 24 56 44 68" />
              <path d="M 5 42 Q 18 64 28 74" />
            </g>
            <circle cx="60" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="64" cy="22" r="1" fill="#ffffff" />
            <circle cx="52" cy="72" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}

  <div class="royal-container">
    <!-- Section Header / Brand Title -->
    <header class="royal-header text-{{ section.settings.text_alignment | default: 'center' }}">
      {% if section.settings.subtitle != blank %}
        <div class="royal-subtitle">
          <span class="royal-sub-ornament">✦</span>
          <span>{{ section.settings.subtitle | escape }}</span>
          <span class="royal-sub-ornament">✦</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="royal-title">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="royal-desc">{{ section.settings.description | escape }}</p>
      {% endif %}
    </header>

    <!-- Main Showcase Layout: Doll Center Stage with Category Nav & Details Panel -->
    <div class="royal-showcase-stage">
      
      <!-- Category Filter Pills (Desktop & Tablet) -->
      <nav class="royal-category-nav" aria-label="Attire Categories">
        <button type="button" class="royal-cat-pill active" data-category="all">
          <span class="pill-dot"></span> All Pieces
        </button>
        <button type="button" class="royal-cat-pill" data-category="safa">
          <span class="pill-dot"></span> Safa / Turbans
        </button>
        <button type="button" class="royal-cat-pill" data-category="sherwani">
          <span class="pill-dot"></span> Sherwanis
        </button>
        <button type="button" class="royal-cat-pill" data-category="mojari">
          <span class="pill-dot"></span> Mojari
        </button>
      </nav>

      <!-- Center Stage: 3D Royal Doll Canvas & Frame -->
      <div class="royal-doll-podium">
        <div class="royal-jharokha-frame">
          <!-- Animated Royal Aura -->
          <div class="royal-aura-disc"></div>

          <!-- Articulated 3D Doll Character Container -->
          <div
            id="RoyalDollViewer-{{ section.id }}"
            class="royal-doll-character"
            data-doll-tracking="{{ section.settings.enable_doll_cursor_tracking | default: true }}"
            data-idle-float="{{ section.settings.enable_idle_float | default: true }}"
          >
            <!-- Body Layer (Torso, Sherwani, Arms, Legs, Mojari) -->
            <div id="RoyalDollBodyRig-{{ section.id }}" class="royal-doll-body-rig">
              <img
                id="RoyalDollBody-cream-{{ section.id }}"
                class="royal-body-img active"
                data-outfit-key="cream"
                src="{{ 'royal-doll-cream-body.png' | asset_url }}"
                alt="Imperial Ivory Sherwani Body"
                width="848"
                height="1264"
                loading="eager"
              >
              <img
                id="RoyalDollBody-red-{{ section.id }}"
                class="royal-body-img"
                data-outfit-key="red"
                src="{{ 'royal-doll-red-body.png' | asset_url }}"
                alt="Ruby Red Royal Sherwani Body"
                width="848"
                height="1264"
                loading="lazy"
              >
              <img
                id="RoyalDollBody-blue-{{ section.id }}"
                class="royal-body-img"
                data-outfit-key="blue"
                src="{{ 'royal-doll-blue-body.png' | asset_url }}"
                alt="Sapphire Blue Royal Sherwani Body"
                width="848"
                height="1264"
                loading="lazy"
              >
              <img
                id="RoyalDollBody-green-{{ section.id }}"
                class="royal-body-img"
                data-outfit-key="green"
                src="{{ 'royal-doll-green-body.png' | asset_url }}"
                alt="Emerald Green Heritage Sherwani Body"
                width="848"
                height="1264"
                loading="lazy"
              >
            </div>

            <!-- Head & Neck Layer (Pivots independently on the neck socket) -->
            <div id="RoyalDollHeadRig-{{ section.id }}" class="royal-doll-head-rig">
              <img
                id="RoyalDollHead-cream-{{ section.id }}"
                class="royal-head-img active"
                data-outfit-key="cream"
                src="{{ 'royal-doll-cream-head.png' | asset_url }}"
                alt="Imperial Ivory Safa & Face"
                width="848"
                height="1264"
                loading="eager"
              >
              <img
                id="RoyalDollHead-red-{{ section.id }}"
                class="royal-head-img"
                data-outfit-key="red"
                src="{{ 'royal-doll-red-head.png' | asset_url }}"
                alt="Ruby Red Royal Safa & Face"
                width="848"
                height="1264"
                loading="lazy"
              >
              <img
                id="RoyalDollHead-blue-{{ section.id }}"
                class="royal-head-img"
                data-outfit-key="blue"
                src="{{ 'royal-doll-blue-head.png' | asset_url }}"
                alt="Sapphire Blue Royal Safa & Face"
                width="848"
                height="1264"
                loading="lazy"
              >
              <img
                id="RoyalDollHead-green-{{ section.id }}"
                class="royal-head-img"
                data-outfit-key="green"
                src="{{ 'royal-doll-green-head.png' | asset_url }}"
                alt="Emerald Green Heritage Safa & Face"
                width="848"
                height="1264"
                loading="lazy"
              >
            </div>

            <!-- Optional Custom Merchant Full-Body Image Layer -->
            <div id="RoyalDollCustom-{{ section.id }}" class="royal-doll-custom-layer" aria-hidden="true"></div>
          </div>

          <!-- Current Outfit Title Tag -->
          <div class="royal-outfit-badge">
            <span class="badge-icon">👑</span>
            <span id="RoyalActiveOutfitName-{{ section.id }}" class="badge-text">Imperial Ivory & Zari Sherwani</span>
          </div>
        </div>

        <!-- Live Selected Product Information Panel -->
        <aside class="royal-selected-info" id="RoyalSelectedInfo-{{ section.id }}">
          <div class="selected-info-inner">
            <span class="selected-piece-number" id="RoyalSelectedNumber-{{ section.id }}">01</span>
            <div class="selected-category-tag" id="RoyalSelectedCategory-{{ section.id }}">Sherwani Collection</div>
            <h3 class="selected-product-title" id="RoyalSelectedTitle-{{ section.id }}">Imperial Ivory & Zari Sherwani</h3>
            <div class="selected-product-subtitle" id="RoyalSelectedSubtitle-{{ section.id }}">Hand-Woven Chanderi Silk with 24k Gold Zari Threading</div>
            <div class="selected-product-price" id="RoyalSelectedPrice-{{ section.id }}">₹ 48,000</div>
            <p class="selected-product-story" id="RoyalSelectedStory-{{ section.id }}">
              Inspired by the grandeur of the Jaipur Court, crafted with delicate floral jaal embroidery and finished with heritage pearl buttons.
            </p>

            <div class="selected-action-row">
              <a
                id="RoyalSelectedCTA-{{ section.id }}"
                href="#the-collection"
                class="royal-cta-btn royal-cta--primary"
              >
                <span>Enquire / Add to Wardrobe</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </aside>
      </div>

      <!-- Multiple Selectable Product Cards (Horizontal Carousel / Row) -->
      <section class="royal-collection-strip" aria-label="Royal Collection Items">
        <div class="royal-strip-heading">
          <div class="strip-header-left">
            <span class="strip-sub">THE WARDROBE</span>
            <h3 class="strip-title">Click any creation to drape the doll</h3>
          </div>
          <div class="royal-carousel-arrows" aria-hidden="true">
            <button type="button" class="royal-nav-arrow arrow-prev" aria-label="Previous products">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="royal-nav-arrow arrow-next" aria-label="Next products">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        <div class="royal-cards-track" id="RoyalCardsTrack-{{ section.id }}">
          
          {% comment %}
            Render merchant blocks if added; otherwise render pristine default royal items
          {% endcomment %}
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {%- liquid
                assign p = block.settings.product
                assign title = block.settings.title_override | default: p.title
                assign price = p.price | money
                if block.settings.price_override != blank
                  assign price = block.settings.price_override
                endif

                assign card_image = block.settings.custom_product_image
                if card_image == blank and p.featured_image != blank
                  assign card_image = p.featured_image
                endif

                assign outfit_img = block.settings.doll_outfit_image
                assign outfit_url = ''
                if outfit_img != blank
                  assign outfit_url = outfit_img | image_url: width: 1200
                endif
              -%}

              <article
                class="royal-product-card {% if forloop.first %}selected{% endif %}"
                data-block-id="{{ block.id }}"
                data-category="{{ block.settings.category | default: 'sherwani' }}"
                data-outfit-url="{{ outfit_url }}"
                data-outfit-key="{{ block.settings.outfit_palette | default: 'cream' }}"
                data-title="{{ title | escape }}"
                data-subtitle="{{ block.settings.subtitle | escape }}"
                data-price="{{ price | escape }}"
                data-story="{{ block.settings.description | default: p.description | strip_html | truncate: 180 | escape }}"
                data-product-url="{{ p.url | default: '#' }}"
                data-product-id="{{ p.selected_or_first_available_variant.id }}"
                tabindex="0"
                role="button"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                <div class="card-image-box">
                  {% if card_image != blank %}
                    <img
                      src="{{ card_image | image_url: width: 450 }}"
                      alt="{{ title | escape }}"
                      loading="lazy"
                      width="320"
                      height="320"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'card-placeholder-svg' }}
                  {% endif %}

                  <span class="card-try-on-pill">
                    <span class="sparkle-icon">✨</span> Try On
                  </span>
                </div>

                <div class="card-meta">
                  <div class="card-index">0{{ forloop.index }}</div>
                  <h4 class="card-title">{{ title | escape }}</h4>
                  <div class="card-sub">{{ block.settings.subtitle | escape }}</div>
                  <div class="card-price">{{ price }}</div>
                </div>

                <div class="card-active-glow" aria-hidden="true"></div>
              </article>
            {% endfor %}

          {% else %}
            {% comment %} Demo fallback items matching reference video {% endcomment %}
            
            <!-- Item 1: Safa / Turban -->
            <article
              class="royal-product-card"
              data-category="safa"
              data-outfit-key="cream"
              data-title="Royal Safa Turban"
              data-subtitle="Hand-Dyed Leheriya Silk with Brocade Kalangi"
              data-price="₹ 14,500"
              data-story="Wave-dyed in spiraling pastel leheriya bands, wound into the prestigious Jodhpur crown and finished with antique gold kalangi brooch."
              data-product-url="#"
              tabindex="0"
              role="button"
              aria-pressed="false"
            >
              <div class="card-image-box">
                <img src="{{ 'royal-product-safa.jpg' | asset_url }}" alt="Royal Safa Turban" width="320" height="320" loading="lazy">
                <span class="card-try-on-pill"><span class="sparkle-icon">✨</span> Try On</span>
              </div>
              <div class="card-meta">
                <div class="card-index">01</div>
                <h4 class="card-title">Royal Safa</h4>
                <div class="card-sub">Leheriya Silk</div>
                <div class="card-price">₹ 14,500</div>
              </div>
              <div class="card-active-glow"></div>
            </article>

            <!-- Item 2: Imperial Ivory Sherwani (Active) -->
            <article
              class="royal-product-card selected"
              data-category="sherwani"
              data-outfit-key="cream"
              data-title="Imperial Ivory & Zari Sherwani"
              data-subtitle="Handcrafted Silk with 24k Gold Threading"
              data-price="₹ 48,000"
              data-story="Inspired by the Jaipur Royal Court, intricately embellished with floral paisley medallions and pure freshwater pearl buttons."
              data-product-url="#"
              tabindex="0"
              role="button"
              aria-pressed="true"
            >
              <div class="card-image-box">
                <img src="{{ 'royal-product-sherwani-cream.jpg' | asset_url }}" alt="Imperial Ivory Sherwani" width="320" height="320" loading="lazy">
                <span class="card-try-on-pill"><span class="sparkle-icon">✨</span> Try On</span>
              </div>
              <div class="card-meta">
                <div class="card-index">02</div>
                <h4 class="card-title">Imperial Ivory</h4>
                <div class="card-sub">Zari Embroidered Silk</div>
                <div class="card-price">₹ 48,000</div>
              </div>
              <div class="card-active-glow"></div>
            </article>

            <!-- Item 3: Ruby Crimson Sherwani -->
            <article
              class="royal-product-card"
              data-category="sherwani"
              data-outfit-key="red"
              data-title="Ruby Royal Crimson Sherwani"
              data-subtitle="Pure Raw Silk with Antique Gold Zardozi"
              data-price="₹ 56,000"
              data-story="A stately crimson hue fit for royal processions, featuring architectural paisley arches and gold zari borders."
              data-product-url="#"
              tabindex="0"
              role="button"
              aria-pressed="false"
            >
              <div class="card-image-box">
                <img src="{{ 'royal-product-sherwani-red.jpg' | asset_url }}" alt="Ruby Royal Crimson Sherwani" width="320" height="320" loading="lazy">
                <span class="card-try-on-pill"><span class="sparkle-icon">✨</span> Try On</span>
              </div>
              <div class="card-meta">
                <div class="card-index">03</div>
                <h4 class="card-title">Ruby Crimson</h4>
                <div class="card-sub">Raw Silk & Zardozi</div>
                <div class="card-price">₹ 56,000</div>
              </div>
              <div class="card-active-glow"></div>
            </article>

            <!-- Item 4: Sapphire Blue Royal Sherwani -->
            <article
              class="royal-product-card"
              data-category="sherwani"
              data-outfit-key="blue"
              data-title="Sapphire Blue Jodhpuri Attire"
              data-subtitle="Royal Blue Brocade with Golden Floral Motifs"
              data-price="₹ 52,000"
              data-story="Handwoven in the royal workshops of Mewar, combining celestial lapis blue silk with warm golden brocade accents."
              data-product-url="#"
              tabindex="0"
              role="button"
              aria-pressed="false"
            >
              <div class="card-image-box">
                <img src="{{ 'royal-product-sherwani-blue.jpg' | asset_url }}" alt="Sapphire Blue Sherwani" width="320" height="320" loading="lazy">
                <span class="card-try-on-pill"><span class="sparkle-icon">✨</span> Try On</span>
              </div>
              <div class="card-meta">
                <div class="card-index">04</div>
                <h4 class="card-title">Sapphire Jodhpuri</h4>
                <div class="card-sub">Royal Blue Brocade</div>
                <div class="card-price">₹ 52,000</div>
              </div>
              <div class="card-active-glow"></div>
            </article>

            <!-- Item 5: Emerald Green Heritage Sherwani -->
            <article
              class="royal-product-card"
              data-category="sherwani"
              data-outfit-key="green"
              data-title="Emerald Heritage Court Sherwani"
              data-subtitle="Deep Emerald Silk with Heritage Gold Filigree"
              data-price="₹ 54,000"
              data-story="A rich royal emerald green silk ensemble featuring master needlework inspired by royal Mughal garden florals."
              data-product-url="#"
              tabindex="0"
              role="button"
