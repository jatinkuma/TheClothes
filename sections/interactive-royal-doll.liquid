  .royal-butterfly-creature.fast-flap .wing-left {
    animation-duration: 0.11s;
  }
  .royal-butterfly-creature.fast-flap .wing-right {
    animation-duration: 0.11s;
  }

  /* Hover gentle flutter */
  .royal-butterfly-creature.hover-flap .wing-left {
    animation-duration: 0.22s;
  }
  .royal-butterfly-creature.hover-flap .wing-right {
    animation-duration: 0.22s;
  }

