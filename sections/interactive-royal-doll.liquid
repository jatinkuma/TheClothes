{% comment %}
  Interactive Royal Fashion Doll Section — "The Royal Attire"
  Faithful, production-ready recreation of the reference video:
  - Living character with continuous organic 30fps animation (breathing, looking, blinking, head-turning)
  - Interactive 3D cursor/pointer tracking driven by a 36-frame sequential character spritesheet + 3D CSS pitch & yaw
  - Independent 3D butterfly with continuous flapping wings and starlight particle trail
  - "The Collection ↓" scroll pill revealing "Worn by royalty, made by hand"
  - Horizontal luxury card carousel (Safa, Odhni, Ghagra, Mojari, Sherwani)
  - Full Shopify Theme Editor blocks for real product mapping and merchant custom configuration
{% endcomment %}

<div
  id="RoyalDoll-{{ section.id }}"
  class="royal-attire-section royal-attire--{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --royal-hero-bg: {{ section.settings.bg_color | default: '#ea9b1b' }};
    --royal-text-main: {{ section.settings.text_color | default: '#2b1408' }};
    --royal-accent-gold: {{ section.settings.accent_gold | default: '#d48812' }};
    --royal-card-bg: {{ section.settings.card_bg | default: '#fef8ee' }};
    --royal-btn-bg: {{ section.settings.button_bg | default: '#1a100a' }};
    --royal-btn-text: {{ section.settings.button_text | default: '#ffffff' }};
    --royal-statue-height: {{ section.settings.statue_height | default: 560 }}px;
  "
>
  <!-- Interactive Flying 3D Butterfly & Sparkle Trail Canvas -->
  {% if section.settings.enable_butterfly %}
    <canvas id="RoyalButterflyCanvas-{{ section.id }}" class="royal-butterfly-canvas" aria-hidden="true"></canvas>

    <div
      id="RoyalButterfly-{{ section.id }}"
      class="royal-butterfly-creature"
      aria-hidden="true"
      data-speed="{{ section.settings.butterfly_speed | default: 8 }}"
    >
      <div class="butterfly-3d-rig">
        <!-- Left Wing with realistic flap -->
        <div class="butterfly-wing wing-left">
          <svg viewBox="0 0 70 80" width="60" height="70">
            <defs>
              <linearGradient id="bfWingL-{{ section.id }}" x1="0%" y1="30%" x2="100%" y2="70%">
                <stop offset="0%" stop-color="#0b1b4f" />
                <stop offset="30%" stop-color="#2563eb" />
                <stop offset="65%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#a7f3d0" />
              </linearGradient>
              <radialGradient id="bfGlowL-{{ section.id }}" cx="55%" cy="45%" r="55%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
                <stop offset="70%" stop-color="#1d4ed8" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#0b1b4f" stop-opacity="0" />
              </radialGradient>
              <filter id="bfDropL-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#38bdf8" flood-opacity="0.7"/>
              </filter>
            </defs>
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#bfWingL-{{ section.id }})" filter="url(#bfDropL-{{ section.id }})" stroke="#0b1b4f" stroke-width="0.8" />
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#bfGlowL-{{ section.id }})" />
            <path d="M 66 38 C 58 44, 46 48, 30 52 C 16 56, 12 66, 20 74 C 28 82, 48 78, 58 64 C 64 54, 66 44, 66 38 Z"
                  fill="url(#bfWingL-{{ section.id }})" stroke="#0b1b4f" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.7)" stroke-width="0.65" fill="none">
              <path d="M 66 36 Q 40 24 16 12" />
              <path d="M 66 36 Q 36 32 10 24" />
              <path d="M 66 36 Q 42 40 24 38" />
              <path d="M 65 42 Q 46 56 26 68" />
            </g>
            <circle cx="12" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="20" cy="70" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Butterfly Body -->
        <div class="butterfly-body">
          <svg viewBox="0 0 16 80" width="14" height="70">
            <defs>
              <linearGradient id="bfBodyGrad-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#1e1b4b" />
                <stop offset="50%" stop-color="#1e3a8a" />
                <stop offset="100%" stop-color="#38bdf8" />
              </linearGradient>
            </defs>
            <path d="M 7 24 Q 4 12 1 6 Q 0 4 2 4 Q 4 4 5 10 Q 6 18 7 24" fill="#0b1b4f" />
            <path d="M 9 24 Q 12 12 15 6 Q 16 4 14 4 Q 12 4 11 10 Q 10 18 9 24" fill="#0b1b4f" />
            <circle cx="2" cy="4" r="1.4" fill="#38bdf8" />
            <circle cx="14" cy="4" r="1.4" fill="#38bdf8" />
            <circle cx="8" cy="26" r="3.2" fill="#0f172a" />
            <ellipse cx="8" cy="35" rx="3.6" ry="6" fill="url(#bfBodyGrad-{{ section.id }})" />
            <path d="M 5 40 Q 4 54 7 66 Q 8 68 9 66 Q 12 54 11 40 Z" fill="url(#bfBodyGrad-{{ section.id }})" />
            <ellipse cx="8" cy="34" rx="1.6" ry="2.6" fill="#38bdf8" opacity="0.9" />
          </svg>
        </div>

        <!-- Right Wing with realistic flap -->
        <div class="butterfly-wing wing-right">
          <svg viewBox="0 0 70 80" width="60" height="70">
            <defs>
              <linearGradient id="bfWingR-{{ section.id }}" x1="100%" y1="30%" x2="0%" y2="70%">
                <stop offset="0%" stop-color="#0b1b4f" />
                <stop offset="30%" stop-color="#2563eb" />
                <stop offset="65%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#a7f3d0" />
              </linearGradient>
              <radialGradient id="bfGlowR-{{ section.id }}" cx="45%" cy="45%" r="55%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
                <stop offset="70%" stop-color="#1d4ed8" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#0b1b4f" stop-opacity="0" />
              </radialGradient>
              <filter id="bfDropR-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#38bdf8" flood-opacity="0.7"/>
              </filter>
            </defs>
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#bfWingR-{{ section.id }})" filter="url(#bfDropR-{{ section.id }})" stroke="#0b1b4f" stroke-width="0.8" />
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#bfGlowR-{{ section.id }})" />
            <path d="M 4 38 C 12 44, 24 48, 40 52 C 54 56, 58 66, 50 74 C 42 82, 22 78, 12 64 C 6 54, 4 44, 4 38 Z"
                  fill="url(#bfWingR-{{ section.id }})" stroke="#0b1b4f" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.7)" stroke-width="0.65" fill="none">
              <path d="M 4 36 Q 30 24 54 12" />
              <path d="M 4 36 Q 34 32 60 24" />
              <path d="M 4 36 Q 28 40 46 38" />
              <path d="M 5 42 Q 24 56 44 68" />
            </g>
            <circle cx="58" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="50" cy="70" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- =========================================================================
       HERO STAGE: "The Royal Attire" with Living Interactive Character
       ========================================================================= -->
  <section class="royal-hero-screen" id="RoyalHero-{{ section.id }}">
    <!-- Top Navigation Bar matching video -->
    <header class="royal-top-nav" aria-label="Royal Attire Navigation">
      <div class="royal-brand">
        <span class="royal-brand-title">{{ section.settings.brand_title | default: 'The Royal Attire' }}</span>
        <span class="royal-brand-symbol">✻</span>
      </div>

      <nav class="royal-nav-links" aria-label="Site Links">
        <a href="#the-collection-{{ section.id }}" class="royal-nav-link">{{ section.settings.nav_link_1 | default: 'Collection' }}</a>
        <a href="#the-collection-{{ section.id }}" class="royal-nav-link">{{ section.settings.nav_link_2 | default: 'Atelier' }}</a>
        <a href="#the-collection-{{ section.id }}" class="royal-nav-link">{{ section.settings.nav_link_3 | default: 'Heritage' }}</a>
        <a href="#the-collection-{{ section.id }}" class="royal-nav-link">{{ section.settings.nav_link_4 | default: 'Visit' }}</a>
      </nav>

      <div class="royal-social-links" aria-label="Social Channels">
        <a href="{{ section.settings.instagram_url | default: '#' }}" class="royal-social-icon" aria-label="Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="{{ section.settings.facebook_url | default: '#' }}" class="royal-social-icon" aria-label="Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a href="{{ section.settings.pinterest_url | default: '#' }}" class="royal-social-icon" aria-label="Pinterest" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="22"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </a>
        <a href="{{ section.settings.whatsapp_url | default: '#' }}" class="royal-social-icon" aria-label="WhatsApp" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- Central 3D Interactive Living Character Podium -->
    <div class="royal-statue-center-stage">
      <div
        id="RoyalStatueViewer-{{ section.id }}"
        class="royal-statue-rig"
        data-statue-tracking="{{ section.settings.enable_statue_cursor_tracking | default: true }}"
        data-idle-float="{{ section.settings.enable_idle_float | default: true }}"
      >
        <!-- Ground Contact Shadow -->
        <div class="royal-floor-shadow" aria-hidden="true"></div>

        <!-- 3D Articulated Living Rig: Continuous 60fps Spritesheet Canvas + Video + 3D CSS pitch & yaw -->
        <div id="RoyalStatueInnerRig-{{ section.id }}" class="royal-statue-inner-rig">
          
          <!-- Interactive Character Canvas (36-Frame Smooth Sequence from Reference Video) -->
          <canvas
            id="RoyalStatueCanvas-{{ section.id }}"
            class="royal-character-canvas active"
            width="320"
            height="640"
            data-spritesheet="{{ 'royal-owl-spritesheet.jpg' | asset_url }}"
            data-spritesheet-png="{{ 'royal-owl-spritesheet.png' | asset_url }}"
          ></canvas>

          <!-- Native HTML5 Video Stream Fallback -->
          <video
            id="RoyalStatueVideo-{{ section.id }}"
            class="royal-character-video"
            src="{{ 'royal-owl-animation.mp4' | asset_url }}"
            autoplay
            loop
            muted
            playsinline
            aria-hidden="true"
          ></video>

          <!-- Preload/Base High-Res Pose Image -->
          <img
            id="StatueAngle-center-{{ section.id }}"
            class="royal-statue-pose fallback-base"
            src="{{ 'royal-owl-statue-center.jpg' | asset_url }}"
            alt="The Royal Attire Character"
            width="420"
            height="830"
            loading="eager"
          >

          <!-- Optional Merchant Custom Doll Upload Override -->
          {% if section.settings.custom_doll_image != blank %}
            <img
              id="StatueCustomUpload-{{ section.id }}"
              class="royal-statue-pose custom-override active"
              src="{{ section.settings.custom_doll_image | image_url: width: 800 }}"
              alt="Custom Royal Doll"
              width="420"
              height="830"
              loading="eager"
            >
          {% endif %}
        </div>
      </div>

      <!-- Floating "The Collection ↓" pill button matching reference video -->
      <a href="#the-collection-{{ section.id }}" id="RoyalScrollPill-{{ section.id }}" class="royal-collection-pill">
        <span>The Collection</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <!-- =========================================================================
       THE COLLECTION SECTION: Horizontal Cards Carousel matching reference video
       ========================================================================= -->
  <section class="royal-collection-showcase" id="the-collection-{{ section.id }}">
    <div class="royal-collection-inner">
      
      <header class="royal-collection-header">
        <span class="royal-collection-sub">{{ section.settings.collection_subtitle | default: 'THE COLLECTION' }}</span>
        <h2 class="royal-collection-headline">{{ section.settings.collection_heading | default: 'Worn by royalty, made by hand' }}</h2>
      </header>

      <!-- Horizontal Cards Carousel Track -->
      <div class="royal-carousel-container">
        <div class="royal-cards-slider" id="RoyalCardsSlider-{{ section.id }}">

          {% if section.blocks.size > 0 %}
            {% comment %} Merchant-configured Shopify product blocks {% endcomment %}
            {% for block in section.blocks %}
              {%- liquid
                assign prod = block.settings.product
                assign title = block.settings.title_override | default: prod.title
                assign subtitle = block.settings.subtitle
                assign origin = block.settings.origin_city | default: 'JAIPUR'
                assign story = block.settings.description | default: prod.description | strip_html | truncate: 150
                assign price = prod.price | money
                if block.settings.price_override != blank
                  assign price = block.settings.price_override
                endif

                assign card_img = block.settings.product_image
                if card_img == blank and prod.featured_image != blank
                  assign card_img = prod.featured_image
                endif
              -%}

              <article
                class="royal-item-card {% if forloop.first %}active{% endif %}"
                data-card-index="{{ forloop.index }}"
                data-product-url="{{ prod.url | default: '#' }}"
                {{ block.shopify_attributes }}
              >
                <div class="item-card-visual">
                  {% if card_img != blank %}
                    <img
                      src="{{ card_img | image_url: width: 600 }}"
                      alt="{{ title | escape }}"
                      width="380"
                      height="380"
                      loading="lazy"
                    >
                  {% else %}
                    <img src="{{ 'royal-card-safa.jpg' | asset_url }}" alt="{{ title | escape }}" width="380" height="380" loading="lazy">
                  {% endif %}
                </div>

                <div class="item-card-details">
                  <span class="item-number">0{{ forloop.index }}</span>
                  <h3 class="item-title">{{ title | escape }}</h3>
                  {% if subtitle != blank %}
                    <div class="item-subtitle">{{ subtitle | escape }}</div>
                  {% endif %}
                  <p class="item-story">{{ story | escape }}</p>
                  <div class="item-origin">{{ origin | upcase }}</div>

                  <a href="{{ prod.url | default: '#' }}" class="item-enquire-btn">
                    <span>{{ block.settings.button_text | default: 'Enquire about this piece' }}</span>
                  </a>
                </div>
              </article>
            {% endfor %}

          {% else %}
            {% comment %} Authentic default collection items extracted directly from video {% endcomment %}

            <!-- 01: Safa (Leheriya Silk) -->
            <article class="royal-item-card active" data-card-index="1" data-piece-name="Safa">
              <div class="item-card-visual">
                <img src="{{ 'royal-card-safa.jpg' | asset_url }}" alt="Safa - Leheriya Silk" width="380" height="380" loading="lazy">
              </div>
              <div class="item-card-details">
                <span class="item-number">01</span>
                <h3 class="item-title">Safa</h3>
                <div class="item-subtitle">Leheriya Silk</div>
                <p class="item-story">Wave-dyed in spiralling bands, wound by hand into the Jodhpuri crown. Finished with a ruby kalgi.</p>
                <div class="item-origin">JODHPUR</div>
                <a href="#the-collection-{{ section.id }}" class="item-enquire-btn">
                  <span>Enquire about this piece</span>
                </a>
              </div>
            </article>

            <!-- 02: Odhni (Bandhani Tie-Dye) -->
            <article class="royal-item-card" data-card-index="2" data-piece-name="Odhni">
              <div class="item-card-visual">
                <img src="{{ 'royal-card-odhni.jpg' | asset_url }}" alt="Odhni - Bandhani Tie-Dye" width="380" height="380" loading="lazy">
              </div>
              <div class="item-card-details">
                <span class="item-number">02</span>
                <h3 class="item-title">Odhni</h3>
                <div class="item-subtitle">Bandhani Tie-Dye</div>
                <p class="item-story">Thousands of points tied by fingernail before dyeing, each dot opening into a starburst white circle.</p>
                <div class="item-origin">KUTCH</div>
                <a href="#the-collection-{{ section.id }}" class="item-enquire-btn">
                  <span>Enquire about this piece</span>
                </a>
              </div>
            </article>

            <!-- 03: Ghagra (Gota-Patti Zari) -->
            <article class="royal-item-card" data-card-index="3" data-piece-name="Ghagra">
              <div class="item-card-visual">
                <img src="{{ 'royal-card-ghagra.jpg' | asset_url }}" alt="Ghagra - Gota-Patti Zari" width="380" height="380" loading="lazy">
              </div>
              <div class="item-card-details">
                <span class="item-number">03</span>
                <h3 class="item-title">Ghagra</h3>
                <div class="item-subtitle">Gota-Patti Zari</div>
                <p class="item-story">Scalloped gold ribbon laid in radiating bands, pleated so the hem opens to a full circle in motion.</p>
                <div class="item-origin">JAIPUR</div>
                <a href="#the-collection-{{ section.id }}" class="item-enquire-btn">
                  <span>Enquire about this piece</span>
                </a>
              </div>
            </article>

            <!-- 04: Mojari (Hand-Embroidered Leather) -->
            <article class="royal-item-card" data-card-index="4" data-piece-name="Mojari">
              <div class="item-card-visual">
                <img src="{{ 'royal-card-mojari.jpg' | asset_url }}" alt="Mojari - Hand-Embroidered Leather" width="380" height="380" loading="lazy">
              </div>
              <div class="item-card-details">
                <span class="item-number">04</span>
                <h3 class="item-title">Mojari</h3>
                <div class="item-subtitle">Hand-Embroidered Leather</div>
                <p class="item-story">Curled at the toe, stitched without a single nail, embroidered across the vamp in coloured zari.</p>
                <div class="item-origin">BIKANER</div>
                <a href="#the-collection-{{ section.id }}" class="item-enquire-btn">
                  <span>Enquire about this piece</span>
                </a>
              </div>
            </article>

            <!-- 05: Sherwani (Ivory Raw Silk) -->
            <article class="royal-item-card" data-card-index="5" data-piece-name="Sherwani">
              <div class="item-card-visual">
                <img src="{{ 'royal-card-sherwani.jpg' | asset_url }}" alt="Sherwani - Ivory Raw Silk" width="380" height="380" loading="lazy">
              </div>
              <div class="item-card-details">
                <span class="item-number">05</span>
                <h3 class="item-title">Sherwani</h3>
                <div class="item-subtitle">Ivory Raw Silk</div>
                <p class="item-story">Tailored from pure handwoven silk, adorned with subtle hand-stitched detailing and heritage buttons.</p>
                <div class="item-origin">JAIPUR</div>
                <a href="#the-collection-{{ section.id }}" class="item-enquire-btn">
                  <span>Enquire about this piece</span>
                </a>
              </div>
            </article>

          {% endif %}
        </div>

        <!-- Carousel navigation arrows -->
        <div class="royal-carousel-controls">
          <button type="button" class="royal-arrow-btn arrow-prev" aria-label="Previous card">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="royal-arrow-btn arrow-next" aria-label="Next card">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- =========================================================================
     SCOPED STYLES
     ========================================================================= -->
<style>
  .royal-attire-section {
    position: relative;
    width: 100%;
    background-color: var(--royal-hero-bg);
    color: var(--royal-text-main);
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    cursor: default;
  }

  /* ---------------- Butterfly 3D Creature & Canvas ---------------- */
  .royal-butterfly-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 25;
  }

  .royal-butterfly-creature {
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 70px;
    margin-left: -30px;
    margin-top: -35px;
    pointer-events: none;
    z-index: 30;
    will-change: transform;
    transform-style: preserve-3d;
  }

  .butterfly-3d-rig {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .butterfly-wing {
    position: absolute;
    top: 0;
    height: 100%;
    width: 50%;
    transform-style: preserve-3d;
    backface-visibility: visible;
  }

  .wing-left {
    right: 50%;
    transform-origin: right center;
    animation: flapLeftWing 0.16s ease-in-out infinite alternate;
  }

  .wing-right {
    left: 50%;
    transform-origin: left center;
    animation: flapRightWing 0.16s ease-in-out infinite alternate;
  }

  .butterfly-body {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    pointer-events: none;
  }

  @keyframes flapLeftWing {
    0% { transform: rotateY(0deg) rotateZ(0deg); }
    50% { transform: rotateY(52deg) rotateZ(-6deg); }
    100% { transform: rotateY(78deg) rotateZ(-12deg); }
  }

  @keyframes flapRightWing {
    0% { transform: rotateY(0deg) rotateZ(0deg); }
    50% { transform: rotateY(-52deg) rotateZ(6deg); }
    100% { transform: rotateY(-78deg) rotateZ(12deg); }
  }

  /* ---------------- HERO SCREEN ---------------- */
  .royal-hero-screen {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 48px 40px;
    box-sizing: border-box;
    background: radial-gradient(circle at 50% 40%, rgba(255,255,255,0.12) 0%, rgba(0,0,0,0.06) 100%), var(--royal-hero-bg);
  }

  /* Top Navigation Bar */
  .royal-top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    z-index: 10;
  }

  .royal-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Didot", "Bodoni MT", "Cinzel", "Playfair Display", Georgia, serif;
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--royal-text-main);
    letter-spacing: -0.02em;
  }

  .royal-brand-symbol {
    font-size: 1.3rem;
    color: var(--royal-text-main);
    opacity: 0.85;
  }

  .royal-nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .royal-nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--royal-text-main);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .royal-nav-link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .royal-social-links {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .royal-social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--royal-text-main);
    text-decoration: none;
    opacity: 0.8;
    transition: all 0.25s ease;
  }

  .royal-social-icon:hover {
    opacity: 1;
    transform: scale(1.12);
  }

  /* Center Stage Living Character */
  .royal-statue-center-stage {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
  }

  .royal-statue-rig {
    position: relative;
    width: 100%;
    max-width: 440px;
    height: var(--royal-statue-height);
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    transform-style: preserve-3d;
    user-select: none;
    -webkit-user-select: none;
  }

  .royal-floor-shadow {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 32px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(30, 15, 0, 0.42) 0%, rgba(30, 15, 0, 0) 72%);
    filter: blur(4px);
    pointer-events: none;
    z-index: 1;
  }

  .royal-statue-inner-rig {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
    z-index: 2;
  }

  /* Canvas and Video Character Animators */
  .royal-character-canvas,
  .royal-character-video {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    height: calc(100% - 30px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
    pointer-events: none;
    z-index: 2;
    border-radius: 12px;
    display: none;
  }

  .royal-character-canvas.active,
  .royal-character-video.active {
    display: block;
  }

  .royal-statue-pose {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    height: calc(100% - 30px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    z-index: 1;
  }

  .royal-statue-pose.active {
    opacity: 1;
    visibility: visible;
  }

  .royal-statue-pose.custom-override {
    z-index: 10;
  }

  /* Bottom Pill Button: "The Collection ↓" */
  .royal-collection-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--royal-text-main);
    text-decoration: none;
    z-index: 10;
    margin-top: 10px;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .royal-collection-pill:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  /* ---------------- THE COLLECTION SECTION ---------------- */
  .royal-collection-showcase {
    position: relative;
    width: 100%;
    background-color: var(--royal-hero-bg);
    padding: 70px 48px 100px;
    box-sizing: border-box;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  .royal-collection-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .royal-collection-header {
    margin-bottom: 40px;
  }

  .royal-collection-sub {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--royal-text-main);
    opacity: 0.65;
    margin-bottom: 8px;
  }

  .royal-collection-headline {
    font-family: "Didot", "Bodoni MT", "Cinzel", "Playfair Display", Georgia, serif;
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--royal-text-main);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0;
  }

  /* Cards Horizontal Track */
  .royal-carousel-container {
    position: relative;
    width: 100%;
  }

  .royal-cards-slider {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 16px 4px 28px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .royal-cards-slider::-webkit-scrollbar {
    display: none;
  }

  /* Luxury Item Card matching video */
  .royal-item-card {
    flex: 0 0 520px;
    display: grid;
    grid-template-columns: 240px 1fr;
    background: var(--royal-card-bg);
    border-radius: 26px;
    padding: 24px;
    gap: 24px;
    box-shadow: 0 8px 26px rgba(43, 20, 8, 0.08);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s;
    box-sizing: border-box;
    cursor: pointer;
  }

  .royal-item-card:hover,
  .royal-item-card.active {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(43, 20, 8, 0.14);
    outline: 2px solid var(--royal-accent-gold);
  }

  .item-card-visual {
    width: 100%;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.6);
  }

  .item-card-visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .royal-item-card:hover .item-card-visual img {
    transform: scale(1.06);
  }

  .item-card-details {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .item-number {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--royal-text-main);
    opacity: 0.5;
  }

  .item-title {
    font-family: "Didot", "Bodoni MT", "Cinzel", "Playfair Display", Georgia, serif;
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--royal-text-main);
    margin: 2px 0;
    line-height: 1.2;
  }

  .item-subtitle {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--royal-accent-gold);
    margin-bottom: 8px;
  }

  .item-story {
    font-size: 0.88rem;
    line-height: 1.48;
    color: var(--royal-text-main);
    opacity: 0.78;
    margin: 0 0 12px;
  }

  .item-origin {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--royal-text-main);
    opacity: 0.55;
    margin-bottom: 14px;
  }

  .item-enquire-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 30px;
    background: var(--royal-btn-bg);
    color: var(--royal-btn-text);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.25s ease;
    align-self: flex-start;
  }

  .item-enquire-btn:hover {
    background: #000000;
    transform: scale(1.04);
  }

  /* Carousel Navigation Buttons */
  .royal-carousel-controls {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 18px;
  }

  .royal-arrow-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: var(--royal-text-main);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .royal-arrow-btn:hover {
    background: #ffffff;
    transform: scale(1.08);
  }

  /* ---------------- Responsive ---------------- */
  @media (max-width: 900px) {
    .royal-hero-screen {
      padding: 24px 20px 32px;
    }

    .royal-top-nav {
      flex-wrap: wrap;
      gap: 16px;
    }

    .royal-nav-links {
      display: none;
    }

    .royal-brand {
      font-size: 1.5rem;
    }

    .royal-collection-showcase {
      padding: 50px 20px 70px;
    }

    .royal-collection-headline {
      font-size: 2rem;
    }

    .royal-item-card {
      flex: 0 0 340px;
      grid-template-columns: 1fr;
      padding: 18px;
    }

    .item-card-visual {
      height: 190px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .butterfly-wing {
      animation: none !important;
    }
    .royal-butterfly-creature {
      display: none !important;
    }
    .royal-butterfly-canvas {
      display: none !important;
    }
    .royal-character-canvas,
    .royal-character-video {
      animation: none !important;
    }
  }
</style>

<!-- =========================================================================
     INTERACTIVE JAVASCRIPT CONTROLLER
     ========================================================================= -->
<script>
  (function() {
    function initRoyalAttire() {
      var section = document.getElementById('RoyalDoll-{{ section.id }}');
      if (!section) return;

      var statueViewer = document.getElementById('RoyalStatueViewer-{{ section.id }}');
      var statueRig = document.getElementById('RoyalStatueInnerRig-{{ section.id }}');
      var charCanvas = document.getElementById('RoyalStatueCanvas-{{ section.id }}');
      var charVideo = document.getElementById('RoyalStatueVideo-{{ section.id }}');
      var fallbackBase = statueRig ? statueRig.querySelector('.fallback-base') : null;
      var butterfly = document.getElementById('RoyalButterfly-{{ section.id }}');
      var canvas = document.getElementById('RoyalButterflyCanvas-{{ section.id }}');
      var slider = document.getElementById('RoyalCardsSlider-{{ section.id }}');
      var prevBtn = section.querySelector('.arrow-prev');
      var nextBtn = section.querySelector('.arrow-next');
      var cards = section.querySelectorAll('.royal-item-card');

      var enableTracking = statueViewer && statueViewer.getAttribute('data-statue-tracking') !== 'false';
      var enableIdleFloat = statueViewer && statueViewer.getAttribute('data-idle-float') !== 'false';
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ----------------------------------------------------
         1. 36-Frame Authentic Character Animation Engine
         ---------------------------------------------------- */
      var COLS = 6;
      var ROWS = 6;
      var TOTAL_FRAMES = 36;
      var FRAME_W = 160;
      var FRAME_H = 320;

      var spriteImg = new Image();
      var isSpriteLoaded = false;
      var spriteSrc = charCanvas ? (charCanvas.getAttribute('data-spritesheet') || '') : '';
      
      if (spriteSrc) {
        spriteImg.onload = function() {
          isSpriteLoaded = true;
          if (charCanvas) charCanvas.classList.add('active');
          if (fallbackBase) fallbackBase.style.display = 'none';
        };
        spriteImg.onerror = function() {
          // If spritesheet fails, activate HTML5 video stream
          if (charVideo) charVideo.classList.add('active');
          if (fallbackBase) fallbackBase.style.display = 'none';
        };
        spriteImg.src = spriteSrc;
      }

      var currentFrameIndex = 18.0; // Center frame
      var targetFrameIndex = 18.0;
      var animLoopProgress = 0.0;
      var isPointerActive = false;
      var lastPointerMoveTime = performance.now();

      function drawCharacterFrame(frameIdx) {
        if (!charCanvas || !isSpriteLoaded) return;
        var ctx = charCanvas.getContext('2d');
        if (!ctx) return;

        var safeIdx = Math.max(0, Math.min(TOTAL_FRAMES - 1, Math.floor(frameIdx)));
        var col = safeIdx % COLS;
        var row = Math.floor(safeIdx / COLS);

        ctx.clearRect(0, 0, charCanvas.width, charCanvas.height);
        ctx.drawImage(
          spriteImg,
          col * FRAME_W,
          row * FRAME_H,
          FRAME_W,
          FRAME_H,
          0,
          0,
          charCanvas.width,
          charCanvas.height
        );
      }

      /* ----------------------------------------------------
         2. 3D Butterfly Physics & Sparkle Particle Engine
         ---------------------------------------------------- */
      var width = section.offsetWidth;
      var height = section.offsetHeight;
      var rect = section.getBoundingClientRect();

      if (canvas) {
        canvas.width = width;
        canvas.height = height;
      }

      function updateDimensions() {
        if (!section) return;
        width = section.offsetWidth;
        height = section.offsetHeight;
        rect = section.getBoundingClientRect();
        if (canvas) {
          canvas.width = width;
          canvas.height = height;
        }
      }
      window.addEventListener('resize', updateDimensions);

      var posX = width * 0.22;
      var posY = height * 0.25;
      var targetX = posX;
      var targetY = posY;
      var currentClientX = window.innerWidth * 0.5;
      var currentClientY = window.innerHeight * 0.4;
      var isInside = false;
      var speedSetting = butterfly ? (parseFloat(butterfly.getAttribute('data-speed')) || 8) : 8;
      var ease = speedSetting / 100;
      var particles = [];

      function Particle(x, y) {
        this.x = x + (Math.random() - 0.5) * 8;
        this.y = y + (Math.random() - 0.5) * 8;
        this.radius = Math.random() * 2.2 + 0.8;
        this.alpha = 1;
        this.decay = Math.random() * 0.024 + 0.016;
        this.vx = (Math.random() - 0.5) * 0.7;
        this.vy = Math.random() * 0.6 + 0.3;
        var colors = ['#38bdf8', '#2563eb', '#93c5fd', '#fef08a', '#ffffff'];
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }

      Particle.prototype.update = function() {
        this.x += this.vx;
        this.y += this.vy;
        this.alpha -= this.decay;
      };

      Particle.prototype.draw = function(ctx) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, this.alpha);
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      };

      function handlePointer(e) {
        var cx = e.clientX;
        var cy = e.clientY;
        if (e.touches && e.touches.length > 0) {
          cx = e.touches[0].clientX;
          cy = e.touches[0].clientY;
        }
        currentClientX = cx;
        currentClientY = cy;
        rect = section.getBoundingClientRect();
        targetX = cx - rect.left;
        targetY = cy - rect.top;
        isInside = true;
        isPointerActive = true;
        lastPointerMoveTime = performance.now();
      }

      section.addEventListener('mousemove', handlePointer);
      section.addEventListener('mouseenter', handlePointer);
      section.addEventListener('mouseleave', function() {
        isInside = false;
        isPointerActive = false;
      });
      section.addEventListener('touchmove', handlePointer, { passive: true });
      section.addEventListener('touchstart', handlePointer, { passive: true });

      var rigRotY = 0;
      var rigRotX = 0;
      var rigTransX = 0;

      /* ----------------------------------------------------
         3. Unified 60fps Animation Loop
         ---------------------------------------------------- */
      function render(now) {
        if (prefersReducedMotion) return;

        // Autonomous Butterfly patrol when cursor is outside or idle
        if (!isInside || (now - lastPointerMoveTime > 3500)) {
          var t = now * 0.0014;
          var patrolCenterX = width * 0.5;
          var patrolCenterY = height * 0.28;
          targetX = patrolCenterX + Math.cos(t) * (width * 0.28);
          targetY = patrolCenterY + Math.sin(t * 2) * (height * 0.16);
          isPointerActive = false;
        }

        // Butterfly Movement Interpolation
        var dx = targetX - posX;
        var dy = targetY - posY;
        posX += dx * ease;
        posY += dy * ease;

        if (butterfly) {
          // Bank body in travel direction
          var tilt = Math.max(-28, Math.min(28, dx * 0.45));
          butterfly.style.transform = 'translate3d(' + posX.toFixed(1) + 'px, ' + posY.toFixed(1) + 'px, 0) rotate(' + tilt.toFixed(1) + 'deg)';
        }

        // Sparkle Particles
        if (canvas) {
          var ctx = canvas.getContext('2d');
          ctx.clearRect(0, 0, width, height);

          if (Math.hypot(dx, dy) > 2 || Math.random() < 0.35) {
            particles.push(new Particle(posX, posY + 10));
          }

          for (var i = particles.length - 1; i >= 0; i--) {
            var pt = particles[i];
            pt.update();
            pt.draw(ctx);
            if (pt.alpha <= 0) particles.splice(i, 1);
          }
        }

        // --- CHARACTER ANIMATION & TRACKING ---
        if (statueViewer && enableTracking) {
          var sRect = statueViewer.getBoundingClientRect();
          var statueMidX = sRect.left + sRect.width * 0.5;
          var statueMidY = sRect.top + sRect.height * 0.35;

          // Normalized offset from statue center [-1 to 1]
          var relX = (currentClientX - statueMidX) / (window.innerWidth * 0.45);
          var relY = (currentClientY - statueMidY) / (window.innerHeight * 0.45);

          relX = Math.max(-1.2, Math.min(1.2, relX));
          relY = Math.max(-1.0, Math.min(1.0, relY));

          // MODE A: Pointer active -> Character tracks cursor across 36 frame angles
          if (isPointerActive) {
            // Map relX [-1 to 1] to turn frame sequence
            // Far Left: 5, Mid Left: 10, Center: 18, Mid Right: 24, Far Right: 30
            var normalized = (relX + 1.2) / 2.4; // 0 to 1
            targetFrameIndex = normalized * 35.0;
            currentFrameIndex += (targetFrameIndex - currentFrameIndex) * 0.16;
          } else {
            // MODE B: Pointer idle -> Continuous living character animation loop!
            // Cycles smoothly through authentic video sequence at 20fps
            animLoopProgress += 0.32;
            if (animLoopProgress >= TOTAL_FRAMES) {
              animLoopProgress = 0;
            }
            currentFrameIndex = animLoopProgress;
          }

          // Draw active frame on Canvas
          drawCharacterFrame(currentFrameIndex);

          // Continuous micro 3D CSS pitch and yaw for depth
          var targetRotY = isPointerActive ? (relX * 10) : (Math.sin(now * 0.0015) * 3);
          var targetRotX = isPointerActive ? (-relY * 7) : (Math.cos(now * 0.002) * 2);
          var targetTransX = isPointerActive ? (relX * 6) : 0;

          rigRotY += (targetRotY - rigRotY) * 0.09;
          rigRotX += (targetRotX - rigRotX) * 0.09;
          rigTransX += (targetTransX - rigTransX) * 0.09;

          var idleY = enableIdleFloat ? Math.sin(now * 0.0022) * 4 : 0;

          if (statueRig) {
            statueRig.style.transform =
              'translate3d(' + rigTransX.toFixed(2) + 'px, ' + idleY.toFixed(2) + 'px, 0px) ' +
              'rotateY(' + rigRotY.toFixed(2) + 'deg) ' +
              'rotateX(' + rigRotX.toFixed(2) + 'deg)';
          }
        }

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);

      /* ----------------------------------------------------
         4. Carousel Arrows & Card Selection
         ---------------------------------------------------- */
      if (prevBtn && slider) {
        prevBtn.addEventListener('click', function() {
          slider.scrollBy({ left: -420, behavior: 'smooth' });
        });
      }
      if (nextBtn && slider) {
        nextBtn.addEventListener('click', function() {
          slider.scrollBy({ left: 420, behavior: 'smooth' });
        });
      }

      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          cards.forEach(function(c) { c.classList.remove('active'); });
          card.classList.add('active');

          // Subtle interactive nod / reaction from character when a piece is chosen
          if (statueRig) {
            statueRig.style.transition = 'transform 0.25s ease';
            statueRig.style.transform = 'translate3d(0, -8px, 0) scale(1.02)';
            setTimeout(function() {
              statueRig.style.transition = '';
            }, 300);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRoyalAttire);
    } else {
      initRoyalAttire();
    }

    // Shopify Theme Editor support
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.classList.contains('royal-attire-section')) {
        initRoyalAttire();
      }
    });
  })();
</script>

