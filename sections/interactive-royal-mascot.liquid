  var InteractionState = {
    cursorClientX: window.innerWidth * 0.5,
    cursorClientY: window.innerHeight * 0.38,
    cursorSecX: (sectionEl.offsetWidth || window.innerWidth) * 0.5,
    cursorSecY: (sectionEl.offsetHeight || 740) * 0.36,
    isHovering: false,
    lastMoveTime: performance.now(),

    isStationary: false,
    stationaryPointSecX: (sectionEl.offsetWidth || window.innerWidth) * 0.5,
    stationaryPointSecY: (sectionEl.offsetHeight || 740) * 0.36,
    stationaryPointClientX: window.innerWidth * 0.5,
    stationaryPointClientY: window.innerHeight * 0.38,
    stationaryStartTime: performance.now(),

    syncWeight: 0,

    butterflySecX: (sectionEl.offsetWidth || window.innerWidth) * 0.35,
    butterflySecY: (sectionEl.offsetHeight || 740) * 0.32,
    butterflyClientX: window.innerWidth * 0.45,
    butterflyClientY: window.innerHeight * 0.35,

    onPointerMove: function(clientX, clientY) {
      if (!sectionEl) return;
      var secRect = sectionEl.getBoundingClientRect();
      this.cursorClientX = clientX;
      this.cursorClientY = clientY;
      this.cursorSecX = clientX - secRect.left;
      this.cursorSecY = clientY - secRect.top;
      this.isHovering = true;
      this.isStationary = false;
      this.lastMoveTime = performance.now();
    },

    updateStationaryState: function(now) {
      var idleElapsed = now - this.lastMoveTime;
      if (idleElapsed > 150) {
        if (!this.isStationary) {
          this.isStationary = true;
          this.stationaryStartTime = now;
          this.stationaryPointSecX = this.cursorSecX;
          this.stationaryPointSecY = this.cursorSecY;
          this.stationaryPointClientX = this.cursorClientX;
          this.stationaryPointClientY = this.cursorClientY;
        }
      } else {
        this.isStationary = false;
      }
    }
  };

  // ==========================================================================
  // 1. THREE.JS 3D AVATAR MANAGER (NATURAL BODY MOVEMENT & CIRCULAR GAZE)
  // No 360° spin: authentic human biomechanics, head & torso tracking, weight shift
  // ==========================================================================
  var ThreeAvatarManager = {
    scene: null,
    camera: null,
    renderer: null,
    characterGroup: null,
    bodyMesh: null,
    headGroup: null,
    headMesh: null,
    shadowMesh: null,
    textureLoader: null,
    loadedTextures: {},
    isReady: false,
    isGlbLoaded: false,
    headBone: null,
    neckBone: null,
    torsoBone: null,
    rootBone: null,
    eyeLeftBone: null,
    eyeRightBone: null,
    fullCatMesh: null,

    // Smooth Biomechanical Angles
    headYaw: 0,
    headPitch: 0,
    headRoll: 0,
    targetHeadYaw: 0,
    targetHeadPitch: 0,
    targetHeadRoll: 0,

    torsoYaw: 0,
    torsoPitch: 0,
    torsoLean: 0,
    targetTorsoYaw: 0,
    targetTorsoPitch: 0,
    targetTorsoLean: 0,

    leanX: 0,
    targetLeanX: 0,

    isCursorActive: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (typeof THREE === "undefined") {
        setTimeout(ThreeAvatarManager.init, 120);
        return;
      }

      try {
        var w = stageEl.clientWidth || 580;
        var h = canvasEl.clientHeight || 480;

        // Scene
        this.scene = new THREE.Scene();

        // Perspective Camera directly viewing the FRONT of the character
        this.camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
