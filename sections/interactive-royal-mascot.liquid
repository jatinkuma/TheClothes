      headLeft: "{{ 'royal-owl-head-left.png' | asset_url }}",
      headRight: "{{ 'royal-owl-head-right.png' | asset_url }}",
      headFarLeft: "{{ 'royal-owl-head-far-left.png' | asset_url }}",
      headFarRight: "{{ 'royal-owl-head-far-right.png' | asset_url }}",
      headBlink: "{{ 'royal-owl-head-blink.png' | asset_url }}",
      outfits: {
        cream: "{{ 'royal-owl-master.png' | asset_url }}",
        blue: "{{ 'royal-owl-achkan.png' | asset_url }}",
