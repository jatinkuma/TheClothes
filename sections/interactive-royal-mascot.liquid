                var name = (node.name || "").toLowerCase();
                if (name.indexOf("head") !== -1 && !self.headBone) self.headBone = node;
                else if (name.indexOf("neck") !== -1 && !self.neckBone) self.neckBone = node;
                else if ((name.indexOf("chest") !== -1 || name.indexOf("spine") !== -1) && !self.torsoBone) self.torsoBone = node;
                else if (name.indexOf("root") !== -1 && !self.rootBone) self.rootBone = node;
                else if (name.indexOf("eye.l") !== -1 || name === "eye_l") self.eyeLeftBone = node;
                else if (name.indexOf("eye.r") !== -1 || name === "eye_r") self.eyeRightBone = node;
              }
              if (node.isMesh) {
                node.castShadow = true;
                node.receiveShadow = true;
                if (node.material) {
                  node.material.roughness = 0.38;
                  node.material.metalness = 0.08;
                }
              }
            });
            self.isGlbLoaded = true;
            if (spinnerEl) spinnerEl.classList.add("loaded");
          }, undefined, function(err) {
            console.warn("GLTF loader fallback to seamless procedural rig:", err);
          });
        }

        // Setup Event Listeners & Animation Loop
        this.setupEventListeners();
        requestAnimationFrame(this.renderLoop.bind(this));

        // Hide spinner once loaded
        if (spinnerEl) spinnerEl.classList.add("loaded");
        this.isReady = true;

      } catch (err) {
        console.error("Three.js Avatar initialization error:", err);
      }
    },

    loadTexture: function(url, callback) {
      if (this.loadedTextures[url]) {
        if (callback) callback(this.loadedTextures[url]);
        return this.loadedTextures[url];
      }
      var self = this;
      var tex = this.textureLoader.load(url, function(loaded) {
        loaded.generateMipmaps = true;
        loaded.minFilter = THREE.LinearMipmapLinearFilter;
        loaded.magFilter = THREE.LinearFilter;
        loaded.encoding = THREE.sRGBEncoding;
        if (callback) callback(loaded);
      });
      tex.encoding = THREE.sRGBEncoding;
      this.loadedTextures[url] = tex;
      return tex;
    },

    // 3D Volumetric Mesh Constructor: Generates a TRUE 3D SOLID CLOSED SHELL
    // with organic facial contours, protruding snout, chubby cheeks, lateral side walls,
    // and rounded back cranium (ensures realistic 3D volume from every viewing angle, NO flat paper look!)
    createCurvedGeometry: function(width, height, segX, segY, maxDepth, isHead, vMin, vMax) {
      var nx = segX + 1;
      var ny = segY + 1;
      var halfW = width * 0.5;
      var halfH = height * 0.5;
      var hasVWindow = (typeof vMin === "number" && typeof vMax === "number");

      var positions = [];
      var uvs = [];
      var indices = [];

      // 1. Front Volumetric Facial / Chest Surface
      for (var j = 0; j < ny; j++) {
        var vNorm = j / (ny - 1);
        var y = -halfH + vNorm * height;
        var vCoord = hasVWindow ? (vMin + vNorm * (vMax - vMin)) : vNorm;
        var v = y / halfH; // -1 to +1

        for (var i = 0; i < nx; i++) {
          var uNorm = i / (nx - 1);
          var x = -halfW + uNorm * width;
          var u = x / halfW; // -1 to +1

          var depth = 0;
          var u2 = u * u;
          if (u2 < 1.0) {
            if (isHead) {
              // Organic 3D Spherical Head Dome + Chubby Cheeks + Protruding Snout + Recessed Eyes
              var r2_dome = Math.min(1.0, u2 * 0.85 + (v * 0.5) * (v * 0.5));
              var baseDome = Math.sqrt(Math.max(0, 1.0 - r2_dome)) * maxDepth;

              // Chubby cheeks
              var dCheek = Math.min(
                Math.sqrt(Math.pow(u - (-0.36), 2) * 1.5 + Math.pow(v - (-0.15), 2) * 4.0),
                Math.sqrt(Math.pow(u - 0.36, 2) * 1.5 + Math.pow(v - (-0.15), 2) * 4.0)
              );
              var cheekPuff = Math.pow(Math.max(0, 1.0 - dCheek * 1.6), 2) * 0.16;

              // Protruding snout & muzzle
              var dSnout = Math.sqrt(u * u * 2.5 + Math.pow(v - (-0.18), 2) * 6.0);
              var snoutPuff = Math.pow(Math.max(0, 1.0 - dSnout * 2.2), 2) * 0.22;

              // Eye socket indentation
              var dEyeL = Math.sqrt(Math.pow(u - (-0.24), 2) * 2.5 + Math.pow(v - 0.05, 2) * 4.5);
              var dEyeR = Math.sqrt(Math.pow(u - 0.24, 2) * 2.5 + Math.pow(v - 0.05, 2) * 4.5);
              var eyeSocket = Math.min(
                Math.pow(Math.max(0, 1.0 - dEyeL * 2.2), 2),
                Math.pow(Math.max(0, 1.0 - dEyeR * 2.2), 2)
              ) * 0.04;

              depth = Math.max(0, baseDome + cheekPuff + snoutPuff - eyeSocket);
            } else {
              // Cylindrical chest curvature for court sherwani
              var r2_body = Math.max(0, 1.0 - u2 * 0.82);
              depth = Math.sqrt(r2_body) * maxDepth;
            }
          }

          positions.push(x, y, depth);
          uvs.push(uNorm, vCoord);
        }
      }

      // Front Indices
      for (var j = 0; j < ny - 1; j++) {
        for (var i = 0; i < nx - 1; i++) {
          var v0 = j * nx + i;
          var v1 = j * nx + (i + 1);
          var v2 = (j + 1) * nx + (i + 1);
          var v3 = (j + 1) * nx + i;
          indices.push(v0, v1, v2);
          indices.push(v0, v2, v3);
        }
      }

      // 2. Back Volumetric Cranium / Torso Shell
      var vBackStart = positions.length / 3;
      for (var j = 0; j < ny; j++) {
        var vNorm = j / (ny - 1);
        var y = -halfH + vNorm * height;
        var vCoord = hasVWindow ? (vMin + vNorm * (vMax - vMin)) : vNorm;
        var v = y / halfH;

        for (var i = 0; i < nx; i++) {
          var uNorm = i / (nx - 1);
          var x = (-halfW + uNorm * width) * 0.88;
          var u = x / halfW;

          var backDepth = -0.06;
          var u2 = u * u;
          if (u2 < 1.0) {
            if (isHead) {
              var r2_back = Math.min(1.0, u2 * 0.80 + (v * 0.6) * (v * 0.6));
              backDepth = - (Math.sqrt(Math.max(0, 1.0 - r2_back)) * (maxDepth * 0.95) + 0.08);
            } else {
              backDepth = - (Math.sqrt(Math.max(0, 1.0 - u2 * 0.80)) * (maxDepth * 0.85) + 0.05);
            }
          }

          positions.push(x, y, backDepth);
          uvs.push(uNorm, vCoord);
        }
      }

      // Back Indices (reversed winding)
      for (var j = 0; j < ny - 1; j++) {
        for (var i = 0; i < nx - 1; i++) {
          var v0 = vBackStart + j * nx + i;
          var v1 = vBackStart + j * nx + (i + 1);
          var v2 = vBackStart + (j + 1) * nx + (i + 1);
          var v3 = vBackStart + (j + 1) * nx + i;
          indices.push(v0, v2, v1);
          indices.push(v0, v3, v2);
        }
      }

      // 3. Lateral Side Profile Walls (connect front to back for true 3D side profile!)
      // Left Wall
      for (var j = 0; j < ny - 1; j++) {
        var f0 = j * nx;
        var f1 = (j + 1) * nx;
        var b0 = vBackStart + j * nx;
        var b1 = vBackStart + (j + 1) * nx;
        indices.push(f0, b0, b1);
        indices.push(f0, b1, f1);
      }

      // Right Wall
      for (var j = 0; j < ny - 1; j++) {
        var f0 = j * nx + (nx - 1);
        var f1 = (j + 1) * nx + (nx - 1);
        var b0 = vBackStart + j * nx + (nx - 1);
        var b1 = vBackStart + (j + 1) * nx + (nx - 1);
        indices.push(f0, f1, b1);
        indices.push(f0, b1, b0);
      }

      // Bottom Rim
      for (var i = 0; i < nx - 1; i++) {
        var f0 = i;
        var f1 = i + 1;
        var b0 = vBackStart + i;
        var b1 = vBackStart + i + 1;
        indices.push(f0, b1, b0);
        indices.push(f0, f1, b1);
      }

      // Top Rim
      var topF = (ny - 1) * nx;
      var topB = vBackStart + (ny - 1) * nx;
      for (var i = 0; i < nx - 1; i++) {
        var f0 = topF + i;
        var f1 = topF + i + 1;
        var b0 = topB + i;
        var b1 = topB + i + 1;
        indices.push(f0, b0, b1);
        indices.push(f0, b1, f1);
      }

      var geo = new THREE.BufferGeometry();
      geo.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
      geo.setAttribute("uv", new THREE.Float32BufferAttribute(uvs, 2));
      geo.setIndex(indices);
      geo.computeVertexNormals();
      return geo;
    },

    buildAvatarRig: function(outfitKey) {
      if (config.activeMascot === "cat") {
        // True Chubby Proportions (Aspect ratio matches natural British Shorthair feline face)
        var charHeight = 2.05;
        var charWidth = 2.68; // Generous width: restores full chubby cheeks and broad royal attire

        var catTex = this.loadTexture(config.catAssets.full);

        // 1. Torso & Sherwani Mesh (Height from y=0 to y=0.72m, UV [0.0 to 0.352])
        var bodyHeight = 0.72;
        var bodyGeo = this.createCurvedGeometry(charWidth, bodyHeight, 64, 32, 0.16, false, 0.0, 0.352);
        var bodyMat = new THREE.MeshStandardMaterial({
          map: catTex,
          transparent: true,
          alphaTest: 0.005,
          roughness: 0.40,
          metalness: 0.05,
          side: THREE.DoubleSide
        });
        this.bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
        this.bodyMesh.position.set(0, bodyHeight * 0.5, 0);
        this.bodyMesh.renderOrder = 2;
        this.characterGroup.add(this.bodyMesh);

        // 2. Articulated Head Group (Pivoted at exact anatomical collar: y = 0.641m)
        var neckPivotY = 0.641;
        this.headGroup = new THREE.Group();
        this.headGroup.position.set(0, neckPivotY, 0.035);
        this.characterGroup.add(this.headGroup);

        // 3. Head & Safa Mesh (Height from y=0.58m to y=2.05m -> total 1.47m, UV [0.273 to 1.0])
        // Overlaps the torso collar by 0.14m (5.5 inches) -> ZERO GAP PHYSICALLY POSSIBLE!
        var headHeight = charHeight - 0.58; // 1.47m
        var headGeo = this.createCurvedGeometry(charWidth, headHeight, 64, 64, 0.28, true, 0.273, 1.0);
        var headMat = new THREE.MeshStandardMaterial({
          map: catTex,
          transparent: true,
          alphaTest: 0.005,
          roughness: 0.40,
          metalness: 0.05,
          side: THREE.DoubleSide
        });
        this.headMesh = new THREE.Mesh(headGeo, headMat);
        // Center relative to headGroup: bottom is at 0.58 - 0.641 = -0.061, top is at 2.05 - 0.641 = +1.409
        this.headMesh.position.set(0, 0.674, 0);
        this.headMesh.renderOrder = 3;
        this.headGroup.add(this.headMesh);
        return;
      }

      if (config.activeMascot === "chipmunk") {
        // Proportions matching the Royal Chipmunk mascot from user image (301w x 411h)
        var charHeight = 2.40;
        var charWidth = charHeight * (301.0 / 411.0); // ~1.758
        var bodyHeight = charHeight * (228.0 / 411.0); // ~1.331
        var headHeight = charHeight * (205.0 / 411.0); // ~1.197
        var neckPivotY = charHeight * (222.0 / 411.0); // ~1.296

        // 1. Torso & Body: True 3D Cylindrical Curved Mesh
        var bodyGeo = this.createCurvedGeometry(charWidth, bodyHeight, 56, 56, 0.13, false);
        var bodyTex = this.loadTexture(config.chipmunkAssets.body);
        var bodyMat = new THREE.MeshStandardMaterial({
          map: bodyTex,
          transparent: true,
          alphaTest: 0.005,
          roughness: 0.38,
          metalness: 0.08,
          side: THREE.DoubleSide
        });
        this.bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
        this.bodyMesh.position.set(0, bodyHeight * 0.5, 0);
        this.bodyMesh.renderOrder = 2;
        this.characterGroup.add(this.bodyMesh);

        // 2. Head Group & 3D Ellipsoidal Curved Mesh with Forward Neck Pivot
        this.headGroup = new THREE.Group();
        this.headGroup.position.set(0, neckPivotY, 0.035);
        this.characterGroup.add(this.headGroup);

        var headGeo = this.createCurvedGeometry(charWidth, headHeight, 56, 56, 0.20, true);
        var headTex = this.loadTexture(config.chipmunkAssets.head);
        var headMat = new THREE.MeshStandardMaterial({
          map: headTex,
          transparent: true,
          alphaTest: 0.005,
          roughness: 0.38,
          metalness: 0.12,
          side: THREE.DoubleSide
        });
        this.headMesh = new THREE.Mesh(headGeo, headMat);
        this.headMesh.position.set(0, (headHeight * 0.5) - 0.06, 0);
        this.headMesh.renderOrder = 3;
        this.headGroup.add(this.headMesh);
        return;
      }

      // Fallback Owl rig
      var charWidth = 1.35;
      var bodyHeight = charWidth * (415.0 / 210.0);
      var headHeight = charWidth * (195.0 / 210.0);
      var neckPivotY = bodyHeight * ((415.0 - 170.0) / 415.0);

      var bodyGeo = this.createCurvedGeometry(charWidth, bodyHeight, 48, 48, 0.12, false);
      var bodyTex = this.loadTexture(config.owlAssets.body);
      var bodyMat = new THREE.MeshStandardMaterial({
        map: bodyTex,
        transparent: true,
        alphaTest: 0.005,
        roughness: 0.42,
        metalness: 0.10,
        side: THREE.DoubleSide
      });
      this.bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
      this.bodyMesh.position.set(0, bodyHeight * 0.5, 0);
      this.bodyMesh.renderOrder = 2;
      this.characterGroup.add(this.bodyMesh);

      this.headGroup = new THREE.Group();
      this.headGroup.position.set(0, neckPivotY, 0.055);
      this.characterGroup.add(this.headGroup);

      var headGeo = this.createCurvedGeometry(charWidth, headHeight, 48, 48, 0.18, true);
      var headTex = this.loadTexture(config.owlAssets.headCenter);
      var headMat = new THREE.MeshStandardMaterial({
        map: headTex,
        transparent: true,
        alphaTest: 0.005,
        roughness: 0.38,
        metalness: 0.14,
        side: THREE.DoubleSide
      });
      this.headMesh = new THREE.Mesh(headGeo, headMat);
      this.headMesh.position.set(0, (headHeight * 0.5) - 0.20, 0);
      this.headMesh.renderOrder = 3;
      this.headGroup.add(this.headMesh);
    },

    equipDress: function(outfitKey, customUrl) {
      var self = this;
      if (customUrl) {
        this.loadTexture(customUrl, function(t) {
          if (self.bodyMesh) {
            self.bodyMesh.material.map = t;
            self.bodyMesh.material.needsUpdate = true;
          }
        });
        return;
      }

      var outfitUrl = null;
      if (config.activeMascot === 'cat' && config.catAssets && config.catAssets.outfits) {
        outfitUrl = config.catAssets.outfits[outfitKey] || config.catAssets.body;
      } else if (config.activeMascot === 'chipmunk' && config.chipmunkAssets && config.chipmunkAssets.outfits) {
        outfitUrl = config.chipmunkAssets.outfits[outfitKey] || config.chipmunkAssets.body;
      } else {
        outfitUrl = config.owlAssets.outfits[outfitKey] || config.owlAssets.outfits.cream;
      }
      this.loadTexture(outfitUrl, function(tex) {
        if (self.bodyMesh) {
          self.bodyMesh.material.map = tex;
          self.bodyMesh.material.needsUpdate = true;
        }
      });
    },

    setupEventListeners: function() {
      var self = this;

      function handlePointer(clientX, clientY) {
        InteractionState.onPointerMove(clientX, clientY);
      }

      sectionEl.addEventListener("mousemove", function(e) {
        handlePointer(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 80 && e.clientY <= r.bottom + 80) {
          handlePointer(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        handlePointer(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      sectionEl.addEventListener("mouseleave", function() {
        InteractionState.isHovering = false;
      });

      window.addEventListener("resize", function() {
        if (!self.renderer || !self.camera || !stageEl) return;
        var w = stageEl.clientWidth || 580;
        var h = canvasEl.clientHeight || 480;
        self.camera.aspect = w / h;
        self.camera.updateProjectionMatrix();
        self.renderer.setSize(w, h);
      });
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));
      if (!this.isReady || !this.characterGroup) return;

      var dt = Math.min(0.05, Math.max(0.001, (time - (this.lastFrameTime || time)) * 0.001));
      this.lastFrameTime = time;

      // Update stationary state
      InteractionState.updateStationaryState(time);

      // ----------------------------------------------------------------------
      // SMOOTH SYNCHRONIZATION TRANSITION
      // When cursor is stationary at a designated point: syncWeight ramps from 0 to 1 over ~350ms
      // When cursor moves: syncWeight drops quickly from 1 to 0 over ~180ms
      // ----------------------------------------------------------------------
      if (InteractionState.isStationary) {
        InteractionState.syncWeight = Math.min(1.0, InteractionState.syncWeight + dt * 2.85);
      } else {
        InteractionState.syncWeight = Math.max(0.0, InteractionState.syncWeight - dt * 5.2);
      }

      // Smooth cubic Hermite curve for seamless, organic transition
      var s = InteractionState.syncWeight;
      var smoothSync = s * s * (3 - 2 * s);

      // Character center of gaze in screen coordinates
      var sRect = stageEl.getBoundingClientRect();
      var sCenterX = sRect.left + sRect.width / 2;
      var sCenterY = sRect.top + sRect.height * 0.40;

      // Target 1: Cursor Position
      var curDeltaX = (InteractionState.cursorClientX - sCenterX) / (window.innerWidth * 0.42);
      var curDeltaY = (InteractionState.cursorClientY - sCenterY) / (window.innerHeight * 0.42);

      // Target 2: Live Fluttering Butterfly Position
      var butDeltaX = (InteractionState.butterflyClientX - sCenterX) / (window.innerWidth * 0.42);
      var butDeltaY = (InteractionState.butterflyClientY - sCenterY) / (window.innerHeight * 0.42);

      // Blended Target:
      // While cursor is in motion (smoothSync = 0): Character turns head to follow cursor position with lifelike responsiveness.
      // While cursor is stationary (smoothSync -> 1): Both butterfly motion and character head movement become SYNCHRONIZED!
      var effDeltaX = (1.0 - smoothSync) * curDeltaX + smoothSync * butDeltaX;
      var effDeltaY = (1.0 - smoothSync) * curDeltaY + smoothSync * butDeltaY;

      // Circular polar calculation for smooth 3D tracking
      var effAngle = Math.atan2(effDeltaY, effDeltaX);
      var effDist = Math.sqrt(effDeltaX * effDeltaX + effDeltaY * effDeltaY);
      var effR = Math.min(1.22, effDist);

      var sens = 16; // Calibrated for natural 3D depth without perspective compression
      var maxPitch = 12;

      // Exact natural direction (left -> head turns left, right -> head turns right, up/down pitch)
      this.targetHeadYaw = Math.cos(effAngle) * (effR * sens);
      this.targetHeadPitch = Math.sin(effAngle) * (effR * maxPitch);
      this.targetHeadRoll = Math.cos(effAngle) * (effR * 3.8);

      // Natural Torso Anatomical Follow-Through
      this.targetTorsoYaw = this.targetHeadYaw * 0.32;
      this.targetTorsoPitch = this.targetHeadPitch * 0.22;
      this.targetTorsoLean = -this.targetHeadYaw * 0.0018;

      // Weight-shift leaning displacement towards target
      this.targetLeanX = (this.targetHeadYaw / sens) * 0.082;

      // Smooth Spring-Damper Lerp (0.088)
      var ease = 0.088;
      this.headYaw += (this.targetHeadYaw - this.headYaw) * ease;
      this.headPitch += (this.targetHeadPitch - this.headPitch) * ease;
      this.headRoll += (this.targetHeadRoll - this.headRoll) * ease;

      this.torsoYaw += (this.targetTorsoYaw - this.torsoYaw) * ease;
      this.torsoPitch += (this.targetTorsoPitch - this.torsoPitch) * ease;
      this.torsoLean += (this.targetTorsoLean - this.torsoLean) * ease;
      this.leanX += (this.targetLeanX - this.leanX) * ease;

      // Gentle organic sinusoidal breathing float
      var breatheY = Math.sin(time * 0.0018) * 0.012;
      var breathePitch = Math.sin(time * 0.0018) * 0.008;

      // 1. Character Group: Grounded Leaning & Weight Shift
      this.characterGroup.position.x = this.leanX;
      this.characterGroup.position.y = breatheY;
      this.characterGroup.rotation.z = this.torsoLean;
      this.characterGroup.rotation.y = 0; // Front-facing lock (no 360 spin)

      var radHeadYaw = (this.headYaw * Math.PI) / 180;
      var radHeadPitch = (this.headPitch * Math.PI) / 180;
      var radHeadRoll = (this.headRoll * Math.PI) / 180;
      var radTorsoYaw = (this.torsoYaw * Math.PI) / 180;
      var radTorsoPitch = (this.torsoPitch * Math.PI) / 180;

      // 2. Drive 3D Rigged Bones if GLTF model is active
      if (this.isGlbLoaded) {
        if (this.headBone) {
          this.headBone.rotation.y = radHeadYaw * 0.75;
          this.headBone.rotation.x = radHeadPitch * 0.85;
          this.headBone.rotation.z = radHeadRoll * 0.45;
        }
        if (this.neckBone) {
          this.neckBone.rotation.y = radHeadYaw * 0.35;
          this.neckBone.rotation.x = radHeadPitch * 0.25;
        }
        if (this.torsoBone) {
          this.torsoBone.rotation.y = radTorsoYaw * 0.20;
          this.torsoBone.rotation.x = radTorsoPitch * 0.15;
        }

        // 3D Eyes Tracking & Natural Blinking
        var eyeYaw = radHeadYaw * 1.25;
        var eyePitch = radHeadPitch * 1.35;
        var blinkProgress = (time % 3600) / 3600;
        var blinkScale = 1.0;
        if (blinkProgress > 0.955) {
          var bt = (blinkProgress - 0.955) / 0.045;
          blinkScale = 1.0 - Math.sin(bt * Math.PI) * 0.90;
        }
        if (this.eyeLeftBone) {
          this.eyeLeftBone.rotation.y = eyeYaw;
          this.eyeLeftBone.rotation.x = eyePitch;
          this.eyeLeftBone.scale.z = blinkScale;
        }
        if (this.eyeRightBone) {
          this.eyeRightBone.rotation.y = eyeYaw;
          this.eyeRightBone.rotation.x = eyePitch;
          this.eyeRightBone.scale.z = blinkScale;
        }
      } else {
        // High-Fidelity Articulated Procedural 3D Rig (Head turns on neck + Torso follow-through)
        if (this.bodyMesh) {
          this.bodyMesh.rotation.y = radTorsoYaw * 0.25;
          this.bodyMesh.rotation.x = radTorsoPitch * 0.18 + breathePitch;
        }

        if (this.headGroup) {
          this.headGroup.rotation.y = radHeadYaw * 0.78;
          this.headGroup.rotation.x = radHeadPitch * 0.85 + breathePitch * 0.6;
          this.headGroup.rotation.z = radHeadRoll * 0.45;
        }

        if (config.activeMascot === "owl") {
          var blinkProgress = (time % 3600) / 3600;
          this.isBlinking = (blinkProgress > 0.965);

          var activeHeadKey = "headCenter";
          if (this.isBlinking) {
            activeHeadKey = "headBlink";
          } else if (this.headYaw < -13) {
            activeHeadKey = "headFarLeft";
          } else if (this.headYaw < -3.5) {
            activeHeadKey = "headLeft";
          } else if (this.headYaw > 13) {
            activeHeadKey = "headFarRight";
          } else if (this.headYaw > 3.5) {
            activeHeadKey = "headRight";
          }

          if (activeHeadKey !== this.currentHeadKey && this.loadedTextures[config.owlAssets[activeHeadKey]]) {
            this.currentHeadKey = activeHeadKey;
            if (this.headMesh) {
              this.headMesh.material.map = this.loadedTextures[config.owlAssets[activeHeadKey]];
              this.headMesh.material.needsUpdate = true;
            }
          }
        }

        if (this.headGroup) {
          this.headGroup.rotation.y = radHeadYaw * 0.72;
          this.headGroup.rotation.x = radHeadPitch * 0.85 + breathePitch * 0.6;
          this.headGroup.rotation.z = radHeadRoll * 0.55;
        }
      }

      // 5. Ground Contact Shadow: Dynamic shift reacting to lean
      if (this.shadowMesh) {
        this.shadowMesh.position.x = this.leanX * 0.88;
        this.shadowMesh.scale.x = 1.0 - Math.abs(this.headPitch / 30) * 0.06;
      }

      // Render WebGL frame
      if (this.renderer && this.scene && this.camera) {
        this.renderer.render(this.scene, this.camera);
      }
    }
  };

  // ==========================================================================
  // 2. DRESS-UP & WARDROBE SYSTEM ("Append the dress we want")
  // ==========================================================================
  var WardrobeManager = {
    swatchBtns: sectionEl.querySelectorAll(".dock-swatch-btn"),

    init: function() {
      var self = this;
      this.swatchBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
          self.selectOutfit(btn);
        });
      });
    },

    selectOutfit: function(btn) {
      var outfitKey = btn.getAttribute("data-outfit");
      var title = btn.getAttribute("data-title");
      var price = btn.getAttribute("data-price");
      var desc = btn.getAttribute("data-desc");
      var customUrl = btn.getAttribute("data-custom-url");

      // Update active swatch state
      this.swatchBtns.forEach(function(b) { b.classList.remove("active"); });
      btn.classList.add("active");

      // Update badge & info card
      if (badgeNameEl && title) badgeNameEl.textContent = title + " Sherwani";
      if (cardTitleEl && title) cardTitleEl.textContent = title;
      if (cardPriceEl && price) cardPriceEl.textContent = price;
      if (cardDescEl && desc) cardDescEl.textContent = desc;

      // Equip dress in Three.js WebGL
      ThreeAvatarManager.equipDress(outfitKey, customUrl);

      // Magical fairy dust equip sparkle burst around the character
      if (config.enableSparkles && SparkleTrail.ctx) {
        var stageRect = stageEl.getBoundingClientRect();
        var secRect = sectionEl.getBoundingClientRect();
        var cx = (stageRect.left + stageRect.width / 2) - secRect.left;
        var cy = (stageRect.top + stageRect.height * 0.42) - secRect.top;
        for (var i = 0; i < 28; i++) {
          SparkleTrail.addParticle(
            cx + (Math.random() - 0.5) * 160,
            cy + (Math.random() - 0.5) * 220
          );
        }
      }
    }
  };

  // ==========================================================================
  // 3. FULL-SECTION 3D ROYAL BUTTERFLY & SPARKLE TRAIL
  // ==========================================================================
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !config.enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !sectionEl) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 740;
      this.canvas.width = w * dpr;
      this.canvas.height = h * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    addParticle: function(x, y) {
      if (this.particles.length > 55) return;
      var hues = ['#00e5ff', '#651fff', '#ffd700', '#76ff03', '#80d8ff'];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 8,
        radius: Math.random() * 2.2 + 0.8,
        alpha: 1.0,
        decay: Math.random() * 0.024 + 0.014,
        vx: (Math.random() - 0.5) * 0.8,
        vy: Math.random() * 0.5 + 0.3,
        color: hues[Math.floor(Math.random() * hues.length)]
      });
    },

    updateAndRender: function() {
      if (!this.ctx || !sectionEl) return;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 740;
      this.ctx.clearRect(0, 0, w, h);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        this.ctx.save();
        this.ctx.globalAlpha = Math.max(0, p.alpha);
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();
      }
    }
  };

  // ==========================================================================
  // 4. FULL-SECTION 3D ROYAL BUTTERFLY CREATURE
  // Continuously flutters dynamically around cursor; synchronizes motion
  // with character head when cursor remains stationary at a designated point.
  // ==========================================================================
  var ButterflyFollower = {
    el: butterflyEl,
    posX: 0,
    posY: 0,
    vx: 0,
    vy: 0,
    angle: 0,
    bank: 0,
    lastTime: performance.now(),

    init: function() {
      if (!this.el || !config.enableButterfly) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 740;
      this.posX = secW * 0.35;
      this.posY = secH * 0.32;
      this.lastTime = performance.now();

      requestAnimationFrame(this.renderLoop.bind(this));
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));
      if (!this.el || !config.enableButterfly) return;

      var dt = Math.min(0.05, Math.max(0.001, (time - this.lastTime) * 0.001));
      this.lastTime = time;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 740;
      var secRect = sectionEl.getBoundingClientRect();

      // Update stationary state detection
      InteractionState.updateStationaryState(time);

      var destX, destY;

      if (!InteractionState.isHovering || (time - InteractionState.lastMoveTime > 4500)) {
        // Broad ambient court flight patrol when inactive for > 4.5s
        var pt = time * 0.0011;
        destX = (secW * 0.5) + Math.cos(pt) * (secW * 0.34);
        destY = (secH * 0.36) + Math.sin(pt * 2) * (secH * 0.18);
      } else if (InteractionState.isStationary) {
        // ------------------------------------------------------------------
        // DESIGNATED STATIONARY POINT: Harmonic figure-8 / flower petal flutter
        // The butterfly continuously flutters in fluid, natural harmony around
        // the designated point where the cursor stopped.
        // ------------------------------------------------------------------
        var st = (time - InteractionState.stationaryStartTime) * 0.0028;
        var statR_X = 54;
        var statR_Y = 40;
        var hoverFlutterX = Math.sin(st) * statR_X + Math.sin(st * 2.2) * 16;
        var hoverFlutterY = Math.sin(st * 2.0) * (statR_Y * 0.60) + Math.cos(st * 3.1) * 12;
        destX = InteractionState.stationaryPointSecX + hoverFlutterX;
        destY = InteractionState.stationaryPointSecY + hoverFlutterY;
      } else {
        // ------------------------------------------------------------------
        // MOVING CURSOR: Continuously flutters dynamically around the cursor!
        // Creates a dynamic trailing & orbiting visual effect around cursor
        // ------------------------------------------------------------------
        var ot = time * 0.0036;
        var dynR_X = 42;
        var dynR_Y = 30;
        var flutterX = Math.sin(ot) * dynR_X + Math.sin(ot * 2.5) * 14;
        var flutterY = Math.cos(ot * 1.35) * dynR_Y + Math.cos(ot * 3.2) * 10;
        destX = InteractionState.cursorSecX + flutterX;
        destY = InteractionState.cursorSecY + flutterY;
      }

      // Air resistance and smooth pursuit acceleration
      var dx = destX - this.posX;
      var dy = destY - this.posY;
      var dist = Math.sqrt(dx * dx + dy * dy);

      var accel = (dist > 120) ? 0.095 : 0.082;
      this.vx += (dx * accel - this.vx) * 0.24;
      this.vy += (dy * accel - this.vy) * 0.24;
      this.posX += this.vx;
      this.posY += this.vy;

      // Natural micro-wing bobbing
      var wingBobX = Math.cos(time * 0.0052) * 3.2;
      var wingBobY = Math.sin(time * 0.0068) * 4.2;
      var finalX = this.posX + wingBobX;
      var finalY = this.posY + wingBobY;

      // Restrain within section boundaries
      finalX = Math.max(30, Math.min(secW - 75, finalX));
      finalY = Math.max(30, Math.min(secH - 75, finalY));

      // Publish live coordinates for ThreeAvatarManager synchronization
      InteractionState.butterflySecX = finalX;
      InteractionState.butterflySecY = finalY;
      InteractionState.butterflyClientX = secRect.left + finalX;
      InteractionState.butterflyClientY = secRect.top + finalY;

      // Shortest-arc angular interpolation for natural heading orientation
      if (dist > 3 || Math.abs(this.vx) + Math.abs(this.vy) > 0.8) {
        var targetAngle = Math.atan2(this.vy, this.vx) * (180 / Math.PI) + 90;
        var diff = (targetAngle - this.angle + 540) % 360 - 180;
        this.angle += diff * 0.14;
      }

      // Dynamic banking tilt into turns
      var bankTarget = Math.max(-28, Math.min(28, this.vx * 2.2));
      this.bank += (bankTarget - this.bank) * 0.16;

      // Dynamic wing flapping: Fast-flap when pursuing distance, hover-flap when hovering
      var currentSpeed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
      if (dist > 45 || currentSpeed > 3.2) {
        this.el.classList.add("fast-flap");
        this.el.classList.remove("hover-flap");
      } else {
        this.el.classList.remove("fast-flap");
        this.el.classList.add("hover-flap");
      }

      // Render 3D transform of butterfly
      this.el.style.transform =
        "translate3d(" + (finalX - 45).toFixed(1) + "px, " + (finalY - 35).toFixed(1) + "px, 0px) " +
        "rotate(" + this.angle.toFixed(1) + "deg) " +
        "rotateY(" + this.bank.toFixed(1) + "deg)";

      // Emit fairy stardust sparkles from wings
      if (config.enableSparkles && Math.random() < 0.48) {
        SparkleTrail.addParticle(finalX, finalY);
      }
      SparkleTrail.updateAndRender();
    }
  };

  function boot() {
    ThreeAvatarManager.init();
    WardrobeManager.init();
    SparkleTrail.init();
    ButterflyFollower.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      boot();
    }
  });

})();
</script>

