{% comment %}
  ==============================================================================
  ROYAL MASCOT — FRONT-FACING INTERACTIVE 3D MASCOT SECTION
  ------------------------------------------------------------------------------
  Features:
  - 100% FRONT-FACING view of the Royal Indian Mascot matching user's image:
    * Rajasthani multicolored royal safa with jewel Kalgi brooch & white plume
    * Round gold wireframe goggles/glasses with 3D stereoscopic parallax pop
    * Fluffy cartoon chipmunk face, snout, button nose & cute smile
    * Cream brocade Sherwani with gold buttons & royal red zardozi stole
    * Gold medallion necklace, churidar & curled royal mojari shoes
  - Signature "Momentable Action" matching the bottom section:
    * Dynamic 3D perspective body leaning towards cursor (yaw + pitch tilt)
    * Smooth spring-damped lerp physics (damping 0.08)
    * Organic idle breathing & vertical floating wave
    * Ground contact shadow reacting dynamically to character movement
  - Perfect "Gogal Moment" (3D Goggles Parallax & Head Gaze):
    * Head turns in 3D perspective with natural yaw, pitch, and curious roll tilt
    * Gold wireframe goggles float in front on the nose bridge with 3D depth
    * Expressive dark eye pupils dart smoothly behind the lenses
    * Procedural eyelid blinking every ~3.5 seconds
  - ZERO 360-degree rotation (No drag-to-spin; strictly natural gaze & posture tracking)
  - Cyan / Electric Blue Butterfly with 3D wing fluttering & cursor trailing physics
  - Live Canvas Fairy Dust Sparkle Trail
  - Single-finger mobile touch gaze tracking with smooth return to center
  ==============================================================================
{% endcomment %}

<div
  id="royal-mascot-section-{{ section.id }}"
  class="royal-mascot-section"
  style="
    --mascot-bg: {{ section.settings.bg_color | default: '#E5A625' }};
    --mascot-size: {{ section.settings.mascot_size | default: 340 }}px;
  "
>
  <!-- Background Radiant Center Glow -->
  <div class="royal-mascot-bg-glow" aria-hidden="true"></div>

  <!-- Stage Container -->
  <div id="royal-mascot-stage-{{ section.id }}" class="royal-mascot-stage">

    <!-- Fairy Dust Sparkle Particle Canvas -->
    {% if section.settings.enable_sparkles %}
      <canvas id="royal-mascot-sparkles-{{ section.id }}" class="royal-mascot-sparkles-canvas"></canvas>
    {% endif %}

    <!-- Dynamic Ground Contact Shadow -->
    <div id="royal-mascot-shadow-{{ section.id }}" class="royal-mascot-shadow" aria-hidden="true"></div>

    <!-- Mascot 3D Leaning Container (Matches Bottom Section Motion) -->
    <div id="royal-mascot-viewer-{{ section.id }}" class="royal-mascot-viewer">
      
      <!-- Body Layer (Brocade Sherwani, Red Stole, Necklace, Churidar, Curled Mojari Shoes, Fluffy Tail) -->
      <div id="royal-mascot-body-{{ section.id }}" class="royal-mascot-layer royal-mascot-body">
        <img
          src="{{ 'royal-mascot-body.png' | asset_url }}"
          alt="Royal Indian Mascot Body"
          width="228"
          height="312"
          loading="eager"
          decoding="async"
        >
      </div>

      <!-- Head Layer (Turban, Kalgi Brooch, Feather Plume, Furry Cheeks, Snout) -->
      <div id="royal-mascot-head-{{ section.id }}" class="royal-mascot-layer royal-mascot-head">
        <img
          src="{{ 'royal-mascot-head.png' | asset_url }}"
          alt="Royal Indian Mascot Head with Rajasthani Safa"
          width="228"
          height="312"
          loading="eager"
          decoding="async"
        >

        <!-- Expressive Darting Eye Pupils Behind Goggles -->
        <div class="royal-mascot-eyes" aria-hidden="true">
          <!-- Left Eye Pupil -->
          <div class="royal-eye royal-eye-left">
            <div id="royal-pupil-left-{{ section.id }}" class="royal-pupil"></div>
            <div id="royal-eyelid-left-{{ section.id }}" class="royal-eyelid"></div>
          </div>
          <!-- Right Eye Pupil -->
          <div class="royal-eye royal-eye-right">
            <div id="royal-pupil-right-{{ section.id }}" class="royal-pupil"></div>
            <div id="royal-eyelid-right-{{ section.id }}" class="royal-eyelid"></div>
          </div>
        </div>

        <!-- 3D Goggles Layer (Parallax Pop Effect / Perfect Goggle Movement) -->
        <div id="royal-mascot-goggles-{{ section.id }}" class="royal-mascot-layer royal-mascot-goggles" aria-hidden="true">
          <img
            src="{{ 'royal-mascot-goggles.png' | asset_url }}"
            alt="Gold Wireframe Goggles"
            width="228"
            height="312"
            loading="eager"
            decoding="async"
          >
        </div>

      </div>

    </div>

    <!-- Interactive Hint Pill Matching Reference Image -->
    {% if section.settings.show_hint %}
      <div class="royal-mascot-hint">
        <span class="royal-mascot-hint-icon">✦</span>
        <span class="royal-mascot-hint-text">{{ section.settings.hint_text | default: 'Interactive 3D Mascot • Move mouse or touch to explore' }}</span>
      </div>
    {% endif %}

  </div>

  <!-- Cyan / Electric Blue Butterfly Cursor Follower -->
  {% if section.settings.enable_butterfly %}
    <div
      id="royal-mascot-butterfly-{{ section.id }}"
      class="royal-mascot-butterfly"
      aria-hidden="true"
      style="--bf-cyan: {{ section.settings.butterfly_color | default: '#00E5FF' }};"
    >
      <div class="royal-bf-wings">
        <!-- Left Wing -->
        <div class="royal-bf-wing royal-bf-wing-left">
          <svg viewBox="0 0 64 74" width="56" height="66">
            <defs>
              <linearGradient id="rmBfWingL-{{ section.id }}" x1="100%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#091b35" />
                <stop offset="28%" stop-color="#0d47a1" />
                <stop offset="60%" stop-color="#0288d1" />
                <stop offset="88%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 60 52 C 50 36, 24 16, 6 2 C -2 -4, -2 8, 5 22 C 10 32, 28 46, 60 56 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 60 52 C 44 48, 18 42, 10 32 C 2 20, -2 32, 6 44 C 14 56, 32 64, 60 54 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 58 50 Q 34 32 14 14 M 50 48 Q 28 34 16 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="8" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="16" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Body -->
        <div class="royal-bf-body">
          <div class="royal-bf-antennae"></div>
          <div class="royal-bf-thorax"></div>
          <div class="royal-bf-abdomen"></div>
        </div>

        <!-- Right Wing -->
        <div class="royal-bf-wing royal-bf-wing-right">
          <svg viewBox="0 0 64 74" width="56" height="66">
            <defs>
              <linearGradient id="rmBfWingR-{{ section.id }}" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#091b35" />
                <stop offset="28%" stop-color="#0d47a1" />
                <stop offset="60%" stop-color="#0288d1" />
                <stop offset="88%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 4 52 C 14 36, 40 16, 58 2 C 66 -4, 66 8, 59 22 C 54 32, 36 46, 4 56 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 4 52 C 20 48, 46 42, 54 32 C 62 20, 66 32, 58 44 C 50 56, 32 64, 4 54 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 6 50 Q 30 32 50 14 M 14 48 Q 36 34 48 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="56" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="48" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  /* ==========================================================================
     ROYAL MASCOT SECTION STYLING (Scoped & Responsive)
     ========================================================================== */
  #royal-mascot-section-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 560px;
    background-color: var(--mascot-bg, #E5A625);
    background: radial-gradient(ellipse at 50% 50%, #f4c45a 0%, #e2a022 55%, #c98818 100%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    padding: 24px 20px 36px 20px;
  }

  /* Subtle Warm Center Glow */
  #royal-mascot-section-{{ section.id }} .royal-mascot-bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 48%, rgba(255, 235, 175, 0.45) 0%, transparent 65%);
    z-index: 1;
  }

  /* Stage Container (Perspective Stage matching bottom section) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
    position: relative;
    width: 100%;
    max-width: 680px;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1100px;
    transform-style: preserve-3d;
    z-index: 5;
  }

  /* Dynamic Ground Contact Shadow */
  #royal-mascot-section-{{ section.id }} .royal-mascot-shadow {
    position: absolute;
    bottom: 24px;
    width: 220px;
    height: 28px;
    background: radial-gradient(ellipse at center, rgba(60, 30, 8, 0.48) 0%, rgba(60, 30, 8, 0.18) 50%, transparent 75%);
    border-radius: 50%;
    filter: blur(6px);
    z-index: 2;
    transform-origin: 50% 50%;
    will-change: transform;
    pointer-events: none;
  }

  /* Mascot 3D Leaning Viewer (Matches Bottom Section dollViewer) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-viewer {
    position: relative;
    width: var(--mascot-size, 340px);
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center 85%;
    transform-style: preserve-3d;
    will-change: transform;
    filter: drop-shadow(0 14px 26px rgba(45, 22, 6, 0.16));
    z-index: 3;
    cursor: default;
  }

  /* Mascot Layers */
  #royal-mascot-section-{{ section.id }} .royal-mascot-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backface-visibility: hidden;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-layer img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Body Layer */
  #royal-mascot-section-{{ section.id }} .royal-mascot-body {
    z-index: 2;
    transform-origin: 52% 80%;
    will-change: transform;
  }

  /* Head Layer (3D Perspective Turning on Neck Pivot) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-head {
    z-index: 3;
    transform-origin: 52% 48.7%; /* Base of neck */
    will-change: transform;
    transform-style: preserve-3d;
  }

  /* Goggles 3D Parallax Pop (The "Gogal Moment" Feature) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-goggles {
    z-index: 6;
    pointer-events: none;
    transform-origin: 52% 48.7%;
    will-change: transform;
    filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.22));
  }

  /* Eyes Container Behind Goggles */
  #royal-mascot-section-{{ section.id }} .royal-mascot-eyes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  #royal-mascot-section-{{ section.id }} .royal-eye {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    overflow: hidden;
  }

  #royal-mascot-section-{{ section.id }} .royal-eye-left {
    left: 49.8%;
    top: 27.2%;
  }

  #royal-mascot-section-{{ section.id }} .royal-eye-right {
    left: 75.6%;
    top: 24.0%;
  }

  #royal-mascot-section-{{ section.id }} .royal-pupil {
    position: absolute;
    width: 12px;
    height: 12px;
    left: 4px;
    top: 4px;
    background: radial-gradient(circle at 35% 35%, #24130c 0%, #110703 80%, #000000 100%);
    border-radius: 50%;
    box-shadow: 0 0 2px rgba(0,0,0,0.8);
    transition: transform 0.05s ease-out;
    will-change: transform;
  }

  #royal-mascot-section-{{ section.id }} .royal-pupil::after {
    content: '';
    position: absolute;
    width: 3.5px;
    height: 3.5px;
    background: #ffffff;
    border-radius: 50%;
    top: 2px;
    left: 2px;
  }

  #royal-mascot-section-{{ section.id }} .royal-eyelid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #c98836;
    border-radius: 50%;
    transform-origin: top center;
    transform: scaleY(0);
    z-index: 5;
    pointer-events: none;
  }

  /* Fairy Dust Canvas */
  #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 15;
  }

  /* Hint Pill Matching Reference */
  #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
    position: absolute;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 235, 192, 0.76);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.68);
    padding: 7px 18px;
    border-radius: 22px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #241105;
    box-shadow: 0 4px 16px rgba(40, 20, 5, 0.08);
    pointer-events: none;
    z-index: 10;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-hint-icon {
    font-size: 0.95rem;
    color: #241105;
  }

  /* ==========================================================================
     CYAN / ELECTRIC BLUE 3D BUTTERFLY
     ========================================================================== */
  #royal-mascot-section-{{ section.id }} .royal-mascot-butterfly {
    position: absolute;
    top: 0;
    left: 0;
    width: 86px;
    height: 72px;
    pointer-events: none !important;
    z-index: 20;
    will-change: transform;
    filter: drop-shadow(0 4px 16px rgba(0, 229, 255, 0.85));
    transition: opacity 0.3s ease;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wings {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 480px;
    width: 100%;
    height: 100%;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing {
    width: 42px;
    height: 50px;
    display: block;
    transform-style: preserve-3d;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing-left {
    transform-origin: 100% 50%;
    animation: rmBfFlapLeft 0.12s ease-in-out infinite alternate;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing-right {
    transform-origin: 0% 50%;
    animation: rmBfFlapRight 0.12s ease-in-out infinite alternate;
  }

  @keyframes rmBfFlapLeft {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(76deg) scaleX(0.40); }
  }

  @keyframes rmBfFlapRight {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(-76deg) scaleX(0.40); }
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-body {
    position: relative;
    width: 4.5px;
    height: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-antennae {
    position: absolute;
    top: -5px;
    width: 12px;
    height: 6px;
    border-top: 1.8px solid #00E5FF;
    border-radius: 8px 8px 0 0;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-thorax {
    width: 4.5px;
    height: 8px;
    background: #091b35;
    border-radius: 3px 3px 2px 2px;
    border: 0.6px solid #00E5FF;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-abdomen {
    width: 3.5px;
    height: 18px;
    background: linear-gradient(to bottom, #091b35, #0288d1);
    border-radius: 1px 1px 3px 3px;
  }

  @media (max-width: 600px) {
    #royal-mascot-section-{{ section.id }} {
      min-height: 480px;
      padding: 16px 8px;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
      height: 450px;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
      font-size: 0.74rem;
      padding: 6px 14px;
    }
  }

  /* Accessibility: Respect Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    #royal-mascot-section-{{ section.id }} .royal-bf-wing {
      animation: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-butterfly {
      display: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
      display: none !important;
    }
  }
</style>

<script>
(function() {
  "use strict";

  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("royal-mascot-section-" + sectionId);
  var stageEl = document.getElementById("royal-mascot-stage-" + sectionId);
  var viewerEl = document.getElementById("royal-mascot-viewer-" + sectionId);
  var headEl = document.getElementById("royal-mascot-head-" + sectionId);
  var gogglesEl = document.getElementById("royal-mascot-goggles-" + sectionId);
  var bodyEl = document.getElementById("royal-mascot-body-" + sectionId);
  var shadowEl = document.getElementById("royal-mascot-shadow-" + sectionId);
  var pupilLEl = document.getElementById("royal-pupil-left-" + sectionId);
  var pupilREl = document.getElementById("royal-pupil-right-" + sectionId);
  var eyelidLEl = document.getElementById("royal-eyelid-left-" + sectionId);
  var eyelidREl = document.getElementById("royal-eyelid-right-" + sectionId);
  var butterflyEl = document.getElementById("royal-mascot-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("royal-mascot-sparkles-" + sectionId);

  if (!sectionEl || !stageEl || !viewerEl) return;

  var sensitivity = {{ section.settings.sensitivity | default: 24 }};
  var enableButterfly = {% if section.settings.enable_butterfly %}true{% else %}false{% endif %};
  var enableSparkles = {% if section.settings.enable_sparkles %}true{% else %}false{% endif %};
  var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ==========================================================================
  // 1. CHARACTER GAZE & GOGGLES TRACKING ENGINE
  // Combining Bottom-Section Full-Body Leaning Physics with Independent Goggles 3D Depth
  // ==========================================================================
  var MascotGazeEngine = {
    targetX: 0,
    targetY: 0,
    currentX: 0,
    currentY: 0,
    isHovering: false,
    lastMoveTime: performance.now(),

    // Whole body leaning state (matches interactive-royal-doll)
    dollRotY: 0,
    dollRotX: 0,
    dollTransX: 0,

    init: function() {
      var self = this;

      function updatePointer(clientX, clientY) {
        if (!stageEl) return;
        var rect = stageEl.getBoundingClientRect();
        var midX = rect.left + rect.width / 2;
        var midY = rect.top + rect.height * 0.44;

        // Normalized relative displacement
        var dx = (clientX - midX) / (window.innerWidth * 0.44);
        var dy = (clientY - midY) / (window.innerHeight * 0.44);

        self.targetX = Math.max(-1.15, Math.min(1.15, dx));
        self.targetY = Math.max(-1.15, Math.min(1.15, dy));
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }

      // Mouse tracking (Strictly natural gaze, ZERO 360-degree drag rotation)
      window.addEventListener("mousemove", function(e) {
        updatePointer(e.clientX, e.clientY);
      }, { passive: true });

      document.addEventListener("mouseleave", function() {
        self.targetX = 0;
        self.targetY = 0;
        self.isHovering = false;
      });

      // Mobile Touch Drag Tracking
      window.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updatePointer(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      window.addEventListener("touchend", function() {
        self.targetX = 0;
        self.targetY = 0;
        self.isHovering = false;
      });

      requestAnimationFrame(this.tick.bind(this));
    },

    tick: function(time) {
      requestAnimationFrame(this.tick.bind(this));
      if (prefersReducedMotion) return;

      // Spring-mass smoothing (damping: 0.08 matches bottom section)
      this.currentX += (this.targetX - this.currentX) * 0.082;
      this.currentY += (this.targetY - this.currentY) * 0.082;

      // ----------------------------------------------------------------------
      // A. SIGNATURE BOTTOM-SECTION LEANING & DISPLACEMENT ACTION
      // Whole mascot statue leans and shifts in 3D perspective towards cursor
      // ----------------------------------------------------------------------
      var targetDollRotY = this.currentX * 18;
      var targetDollRotX = -this.currentY * 8;
      var targetDollTransX = this.currentX * 14;

      this.dollRotY += (targetDollRotY - this.dollRotY) * 0.08;
      this.dollRotX += (targetDollRotX - this.dollRotX) * 0.08;
      this.dollTransX += (targetDollTransX - this.dollTransX) * 0.08;

      // Gentle organic idle breathing float
      var idleY = Math.sin(time * 0.0018) * 6;

      if (viewerEl) {
        viewerEl.style.transform =
          "translate3d(" + this.dollTransX.toFixed(2) + "px, " + idleY.toFixed(2) + "px, 0px) " +
          "rotateY(" + this.dollRotY.toFixed(2) + "deg) " +
          "rotateX(" + this.dollRotX.toFixed(2) + "deg)";
      }

      // ----------------------------------------------------------------------
      // B. PERFECT GOGGLE MOVEMENT ("GOGAL MOMENT") & 3D HEAD ROTATION
      // Head rotates on neck pivot, with goggles sitting proud with stereoscopic pop
      // ----------------------------------------------------------------------
      var headYaw = this.currentX * (sensitivity * 0.85);
      var headPitch = -this.currentY * 13;
      var headRoll = this.currentX * 4.8; // Curious natural head tilt
      var parallaxX = this.currentX * 8.5;
      var parallaxY = this.currentY * 5.5;

      // 1. Move Head in 3D Perspective
      if (headEl) {
        headEl.style.transform =
          "translate3d(" + parallaxX.toFixed(2) + "px, " + parallaxY.toFixed(2) + "px, 12px) " +
          "rotateY(" + headYaw.toFixed(2) + "deg) " +
          "rotateX(" + headPitch.toFixed(2) + "deg) " +
          "rotateZ(" + headRoll.toFixed(2) + "deg)";
      }

      // 2. Goggles Parallax Pop (Moves gold wireframe goggles in 3D over face)
      if (gogglesEl) {
        // Goggles sit in front (20px translateZ) and rotate with extra depth
        var gogglePopX = parallaxX * 0.32;
        var gogglePopY = parallaxY * 0.30;
        var goggleYaw = headYaw * 0.12;
        gogglesEl.style.transform =
          "translate3d(" + gogglePopX.toFixed(2) + "px, " + gogglePopY.toFixed(2) + "px, 20px) " +
          "rotateY(" + goggleYaw.toFixed(2) + "deg)";
      }

      // 3. Subtle Body Counter-Posture
      if (bodyEl) {
        var bodyYaw = this.currentX * 2.8;
        var bodyX = this.currentX * 1.8;
        bodyEl.style.transform =
          "translate3d(" + bodyX.toFixed(2) + "px, 0px, 0px) " +
          "rotateY(" + bodyYaw.toFixed(2) + "deg)";
      }

      // 4. Ground Contact Shadow (Reacts and skews with character leaning)
      if (shadowEl) {
        var shadowX = this.currentX * 15;
        var shadowSkew = -this.currentX * 6.0;
        var shadowScale = 1.0 - Math.abs(this.currentY) * 0.05;
        shadowEl.style.transform =
          "translateX(" + shadowX.toFixed(1) + "px) " +
          "skewX(" + shadowSkew.toFixed(1) + "deg) " +
          "scale(" + shadowScale.toFixed(2) + ")";
      }

      // 5. Eye Pupil Darting (Eyes actively look through lenses at cursor)
      var eyeX = this.currentX * 4.4;
      var eyeY = this.currentY * 3.6;
      if (pupilLEl) {
        pupilLEl.style.transform = "translate(" + eyeX.toFixed(1) + "px, " + eyeY.toFixed(1) + "px)";
      }
      if (pupilREl) {
        pupilREl.style.transform = "translate(" + eyeX.toFixed(1) + "px, " + eyeY.toFixed(1) + "px)";
      }

      // 6. Procedural Eyelid Blinking
      var blinkCycle = (time % 3600) / 3600;
      var isBlinking = blinkCycle > 0.955;
      var blinkScale = isBlinking ? (1.0 - Math.sin(((blinkCycle - 0.955) / 0.045) * Math.PI)) : 0;
      if (eyelidLEl && eyelidREl) {
        eyelidLEl.style.transform = "scaleY(" + (1 - blinkScale).toFixed(2) + ")";
        eyelidREl.style.transform = "scaleY(" + (1 - blinkScale).toFixed(2) + ")";
      }
    }
  };

  // ==========================================================================
  // 2. CYAN / ELECTRIC BLUE BUTTERFLY & SPARKLE TRAIL
  // ==========================================================================
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.canvas.width = rect.width * dpr;
      this.canvas.height = rect.height * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    addParticle: function(x, y) {
      if (this.particles.length > 55) return;
      var hues = ["#00E5FF", "#80D8FF", "#00B0FF", "#FFE082", "#FFFFFF"];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 8,
        vx: (Math.random() - 0.5) * 0.9,
        vy: Math.random() * 0.8 + 0.3,
        size: Math.random() * 2.8 + 1.0,
        alpha: 1.0,
        decay: Math.random() * 0.022 + 0.015,
        color: hues[Math.floor(Math.random() * hues.length)]
      });
    },

    updateAndRender: function() {
      if (!this.ctx || !stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      this.ctx.clearRect(0, 0, rect.width, rect.height);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        this.ctx.save();
        this.ctx.globalAlpha = Math.max(0, p.alpha);
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();
      }
    }
  };

  var ButterflyFollower = {
    el: butterflyEl,
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    angle: 0,
    isHovering: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (!this.el || !enableButterfly) return;

      var self = this;
      var rect = stageEl.getBoundingClientRect();
      this.posX = rect.width * 0.72;
      this.posY = rect.height * 0.32;
      this.targetX = this.posX;
      this.targetY = this.posY;

      window.addEventListener("mousemove", function(e) {
        if (!stageEl) return;
        var sRect = stageEl.getBoundingClientRect();
        // Hover slightly offset to the top-right of cursor
        self.targetX = e.clientX - sRect.left + 24;
        self.targetY = e.clientY - sRect.top - 20;
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }, { passive: true });

      window.addEventListener("touchmove", function(e) {
        if (!stageEl || !e.touches || e.touches.length === 0) return;
        var sRect = stageEl.getBoundingClientRect();
        self.targetX = e.touches[0].clientX - sRect.left + 20;
        self.targetY = e.touches[0].clientY - sRect.top - 30;
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }, { passive: true });

      requestAnimationFrame(this.renderLoop.bind(this));
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));
      if (prefersReducedMotion) return;

      var rect = stageEl.getBoundingClientRect();

      // If mouse is idle for > 3.2 seconds, gentle autonomous patrol around mascot
      if (!this.isHovering || (time - this.lastMoveTime > 3200)) {
        var t = time * 0.0014;
        this.targetX = (rect.width * 0.5) + Math.cos(t) * (rect.width * 0.32);
        this.targetY = (rect.height * 0.34) + Math.sin(t * 2) * (rect.height * 0.16);
      }

      // Smooth trailing physics
      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      this.posX += dx * 0.082;
      this.posY += dy * 0.082;

      // Natural hovering bob
      var hoverX = Math.sin(time * 0.0036) * 7;
      var hoverY = Math.cos(time * 0.0044) * 6;

      // Banking angle towards flight vector
      var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
      var diff = (targetAngle - this.angle + 540) % 360 - 180;
      this.angle += diff * 0.12;

      var fx = this.posX + hoverX;
      var fy = this.posY + hoverY;

      // Restrain within stage bounds
      fx = Math.max(10, Math.min(rect.width - 70, fx));
      fy = Math.max(10, Math.min(rect.height - 70, fy));

      this.el.style.transform =
        "translate3d(" + fx.toFixed(1) + "px, " + fy.toFixed(1) + "px, 0px) " +
        "rotate(" + this.angle.toFixed(1) + "deg)";

      // Sparkle emission from butterfly wings
      if (enableSparkles && Math.random() < 0.65) {
        SparkleTrail.addParticle(fx + 28, fy + 32);
      }

      SparkleTrail.updateAndRender();
    }
  };

  // Initialize all engines
  MascotGazeEngine.init();
  SparkleTrail.init();
  ButterflyFollower.init();

})();
</script>

