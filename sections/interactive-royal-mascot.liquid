    enableSparkles: {{ section.settings.enable_sparkles | json }},
    activeMascot: "{{ section.settings.mascot_character | default: 'cat' }}",
    glbUrl: "{{ 'royal-cat-mascot.glb' | asset_url }}",
    catAssets: {
      body: "{{ 'royal-cat-mascot.png' | asset_url }}",
      head: "{{ 'royal-cat-head.png' | asset_url }}",
      full: "{{ 'royal-cat-mascot.png' | asset_url }}",
      outfits: {
        cream: "{{ 'royal-cat-mascot.png' | asset_url }}",
        blue: "{{ 'royal-cat-body.png' | asset_url }}",
