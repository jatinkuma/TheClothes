        this.renderer.setSize(w, h);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.renderer.outputEncoding = THREE.sRGBEncoding;
        this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
        this.renderer.toneMappingExposure = 1.25;

        // Studio 3-Point Lighting for authentic 3D Volumetric Specular Depth & Shading
        var ambientLight = new THREE.AmbientLight(0xFFF5E4, 1.35);
        this.scene.add(ambientLight);

        var keyLight = new THREE.DirectionalLight(0xFFFFFF, 1.45);
        keyLight.position.set(2.8, 3.8, 3.2);
        this.scene.add(keyLight);

        var fillLight = new THREE.DirectionalLight(0xFFE8D0, 0.75);
        fillLight.position.set(-2.4, 1.6, 2.2);
        this.scene.add(fillLight);

        var rimLight = new THREE.DirectionalLight(0xFFFFFF, 0.65);
        rimLight.position.set(0, 3.2, -2.5);
        this.scene.add(rimLight);

        // Ground Contact Shadow Mesh (Reacts smoothly to character lean & posture)
        var shadowGeo = new THREE.PlaneGeometry(1.65, 0.45);
        var shadowCanvas = document.createElement("canvas");
        shadowCanvas.width = 256;
        shadowCanvas.height = 128;
        var sctx = shadowCanvas.getContext("2d");
        var grad = sctx.createRadialGradient(128, 64, 0, 128, 64, 110);
        grad.addColorStop(0, "rgba(35, 18, 5, 0.50)");
        grad.addColorStop(0.45, "rgba(35, 18, 5, 0.16)");
        grad.addColorStop(1, "rgba(35, 18, 5, 0)");
        sctx.fillStyle = grad;
        sctx.fillRect(0, 0, 256, 128);

        var shadowTex = new THREE.CanvasTexture(shadowCanvas);
        var shadowMat = new THREE.MeshBasicMaterial({
          map: shadowTex,
          transparent: true,
          opacity: 0.85,
          depthWrite: false
        });
        var shadowPlane = new THREE.Mesh(shadowGeo, shadowMat);
        shadowPlane.rotation.x = -Math.PI / 2;
        shadowPlane.position.set(0, 0.02, 0);
        this.scene.add(shadowPlane);
        this.shadowMesh = shadowPlane;

        // Character Group (Anchored naturally on floor)
        this.characterGroup = new THREE.Group();
        this.scene.add(this.characterGroup);

        // Build 3D Articulated Avatar Hierarchy & Preload Head Angle Textures
        this.textureLoader = new THREE.TextureLoader();

        // Preload Royal Chipmunk and owl textures
        if (config.catAssets) {
          this.loadTexture(config.catAssets.body);
          this.loadTexture(config.catAssets.head);
          this.loadTexture(config.catAssets.full);
        }
        if (config.chipmunkAssets) {
          this.loadTexture(config.chipmunkAssets.body);
          this.loadTexture(config.chipmunkAssets.head);
          this.loadTexture(config.chipmunkAssets.full);
        }
        for (var hKey in config.owlAssets) {
          if (typeof config.owlAssets[hKey] === "string") {
            this.loadTexture(config.owlAssets[hKey]);
          }
        }
        for (var oKey in config.owlAssets.outfits) {
          this.loadTexture(config.owlAssets.outfits[oKey]);
        }

        this.buildAvatarRig("cream");

        // Load Authentic 3D Rigged Cat Model (.glb) with CORS and absolute URL handling
        var self = this;
        if (typeof THREE.GLTFLoader !== "undefined" && config.activeMascot === "cat" && config.glbUrl) {
          var gltfLoader = new THREE.GLTFLoader();
          gltfLoader.setCrossOrigin('anonymous');
          var modelUrl = config.glbUrl;
          if (modelUrl.indexOf("//") === 0) {
            modelUrl = window.location.protocol + modelUrl;
          }
          gltfLoader.load(modelUrl, function(gltf) {
            // Remove procedural meshes when full 3D GLB arrives
            while (self.characterGroup.children.length > 0) {
              self.characterGroup.remove(self.characterGroup.children[0]);
            }
            var charModel = gltf.scene;
            charModel.position.set(0, 0, 0);
            charModel.scale.set(1, 1, 1);
            self.characterGroup.add(charModel);

