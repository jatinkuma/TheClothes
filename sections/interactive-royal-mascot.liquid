{% comment %}
  ==============================================================================
  ROYAL MASCOT — INTERACTIVE DRESS-UP CHARACTER & 3D BUTTERFLY ATELIER
  ------------------------------------------------------------------------------
  Features:
  - Front-Facing Indian Prince Fashion Doll Character in Royal Regalia
  - Instant Dress-Up & Outfit Customizer ("Append the dress we want"):
    * Imperial Cream & Gold Sherwani
    * Sapphire Blue Royal Jodhpuri
    * Heritage Emerald Silk Sherwani
    * Ruby Red Ceremonial Sherwani
    * Custom merchant outfit upload support via Shopify theme blocks
    * Seamless crossfade transitions with magical fairy dust sparkle burst
  - Natural Gaze & Circular Tracking Physics (Matching Signature Bottom Section):
    * Organic yaw (left-right) & vertical pitch (up-down) tracking the cursor
    * Signature bottom-section leaning displacement physics
    * Responsive dynamic ground contact shadow that shifts with lean
    * Gentle idle floating wave and butterfly gaze tracking
  - Full-Section 3D Royal Butterfly Creature & Live Multi-Hue Fairy Dust Trail:
    * Exact multi-stop gradient wings, emerald core glow, 3D banking, and speed toggle
    * Flying across full section width & height without clipping
  - Responsive across Mobile, Tablet, and Desktop touch displays
  ==============================================================================
{% endcomment %}

<div
  id="royal-mascot-section-{{ section.id }}"
  class="royal-mascot-section"
  style="
    --mascot-bg: {{ section.settings.bg_color | default: '#E5A625' }};
    --mascot-width: {{ section.settings.mascot_size | default: 440 }}px;
  "
>
  <!-- Background Radiant Center Glow -->
  <div class="royal-mascot-bg-glow" aria-hidden="true"></div>

  <!-- Section Header / Brand Title -->
  <header class="royal-mascot-header">
    <span class="royal-mascot-badge">{{ section.settings.subheading | default: 'ROYAL COURT ATELIER' }}</span>
    <h2 class="royal-mascot-title">{{ section.settings.heading | default: 'Interactive Royal Wardrobe' }}</h2>
    <p class="royal-mascot-subtitle">{{ section.settings.description | default: 'Select any royal regalia below to instantly drape the character in handcrafted court attire.' }}</p>
  </header>

  <!-- FULL-SECTION Fairy Dust Sparkle Particle Canvas -->
  {% if section.settings.enable_sparkles %}
    <canvas id="royal-mascot-sparkles-{{ section.id }}" class="royal-mascot-sparkles-canvas"></canvas>
  {% endif %}

  <!-- FULL-SECTION 3D Royal Butterfly Creature (Matching Royal Fashion Doll) -->
  {% if section.settings.enable_butterfly %}
    <div
      id="royal-mascot-butterfly-{{ section.id }}"
      class="royal-mascot-butterfly royal-butterfly-creature"
      aria-hidden="true"
      data-speed="{{ section.settings.butterfly_speed | default: 8 }}"
    >
      <div class="butterfly-3d-rig">
        <!-- Left Wing -->
        <div class="butterfly-wing wing-left">
          <svg viewBox="0 0 70 80" width="70" height="80">
            <defs>
              <linearGradient id="rmBfWingL-{{ section.id }}" x1="0%" y1="30%" x2="100%" y2="70%">
                <stop offset="0%" stop-color="#140742" />
                <stop offset="25%" stop-color="#4a148c" />
                <stop offset="55%" stop-color="#2979ff" />
                <stop offset="85%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#80d8ff" />
              </linearGradient>
              <radialGradient id="rmBfGlowL-{{ section.id }}" cx="60%" cy="45%" r="50%">
                <stop offset="0%" stop-color="#69f0ae" stop-opacity="0.75" />
                <stop offset="60%" stop-color="#00e5ff" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#2979ff" stop-opacity="0" />
              </radialGradient>
              <filter id="rmBfShadowL-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00e5ff" flood-opacity="0.6"/>
              </filter>
            </defs>
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" filter="url(#rmBfShadowL-{{ section.id }})" stroke="#0d47a1" stroke-width="0.8" />
            <path d="M 68 36 C 60 18, 42 2, 18 2 C 8 2, 2 10, 4 20 C 6 30, 22 42, 38 46 C 54 50, 64 45, 68 36 Z"
                  fill="url(#rmBfGlowL-{{ section.id }})" />
            <path d="M 66 38 C 58 44, 46 48, 30 52 C 16 56, 12 66, 20 74 C 28 82, 48 78, 58 64 C 64 54, 66 44, 66 38 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" stroke="#1a237e" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.6)" stroke-width="0.65" fill="none">
              <path d="M 66 36 Q 40 24 16 12" />
              <path d="M 66 36 Q 36 32 10 24" />
              <path d="M 66 36 Q 42 40 24 38" />
              <path d="M 65 42 Q 46 56 26 68" />
              <path d="M 65 42 Q 52 64 42 74" />
            </g>
            <circle cx="10" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="6" cy="22" r="1" fill="#ffffff" />
            <circle cx="18" cy="72" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Body -->
        <div class="butterfly-body">
          <svg viewBox="0 0 16 80" width="16" height="80">
            <defs>
              <linearGradient id="rmBfBodyGrad-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4a148c" />
                <stop offset="50%" stop-color="#1a237e" />
                <stop offset="100%" stop-color="#00e5ff" />
              </linearGradient>
            </defs>
            <path d="M 7 24 Q 4 12 1 6 Q 0 4 2 4 Q 4 4 5 10 Q 6 18 7 24" fill="#311b92" />
            <path d="M 9 24 Q 12 12 15 6 Q 16 4 14 4 Q 12 4 11 10 Q 10 18 9 24" fill="#311b92" />
            <circle cx="2" cy="4" r="1.5" fill="#00e5ff" />
            <circle cx="14" cy="4" r="1.5" fill="#00e5ff" />
            <circle cx="8" cy="26" r="3.5" fill="#1a237e" />
            <circle cx="6.5" cy="25" r="0.9" fill="#69f0ae" />
            <circle cx="9.5" cy="25" r="0.9" fill="#69f0ae" />
            <ellipse cx="8" cy="35" rx="3.8" ry="6" fill="url(#rmBfBodyGrad-{{ section.id }})" />
            <path d="M 5 40 Q 4 54 7 66 Q 8 68 9 66 Q 12 54 11 40 Z" fill="url(#rmBfBodyGrad-{{ section.id }})" />
            <ellipse cx="8" cy="34" rx="1.8" ry="2.8" fill="#00e5ff" opacity="0.95" />
          </svg>
        </div>

        <!-- Right Wing -->
        <div class="butterfly-wing wing-right">
          <svg viewBox="0 0 70 80" width="70" height="80">
            <defs>
              <linearGradient id="rmBfWingR-{{ section.id }}" x1="100%" y1="30%" x2="0%" y2="70%">
                <stop offset="0%" stop-color="#140742" />
                <stop offset="25%" stop-color="#4a148c" />
                <stop offset="55%" stop-color="#2979ff" />
                <stop offset="85%" stop-color="#00e5ff" />
                <stop offset="100%" stop-color="#80d8ff" />
              </linearGradient>
              <radialGradient id="rmBfGlowR-{{ section.id }}" cx="40%" cy="45%" r="50%">
                <stop offset="0%" stop-color="#69f0ae" stop-opacity="0.75" />
                <stop offset="60%" stop-color="#00e5ff" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#2979ff" stop-opacity="0" />
              </radialGradient>
              <filter id="rmBfShadowR-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00e5ff" flood-opacity="0.6"/>
              </filter>
            </defs>
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" filter="url(#rmBfShadowR-{{ section.id }})" stroke="#0d47a1" stroke-width="0.8" />
            <path d="M 2 36 C 10 18, 28 2, 52 2 C 62 2, 68 10, 66 20 C 64 30, 48 42, 32 46 C 16 50, 6 45, 2 36 Z"
                  fill="url(#rmBfGlowR-{{ section.id }})" />
            <path d="M 4 38 C 12 44, 24 48, 40 52 C 54 56, 58 66, 50 74 C 42 82, 22 78, 12 64 C 6 54, 4 44, 4 38 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" stroke="#1a237e" stroke-width="0.8" />
            <g stroke="rgba(255,255,255,0.6)" stroke-width="0.65" fill="none">
              <path d="M 4 36 Q 30 24 54 12" />
              <path d="M 4 36 Q 34 32 60 24" />
              <path d="M 4 36 Q 28 40 46 38" />
              <path d="M 5 42 Q 24 56 44 68" />
              <path d="M 5 42 Q 18 64 28 74" />
            </g>
            <circle cx="60" cy="14" r="1.3" fill="#ffffff" />
            <circle cx="64" cy="22" r="1" fill="#ffffff" />
            <circle cx="52" cy="72" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Central Stage: Interactive Doll & Wardrobe Atelier -->
  <div id="royal-mascot-stage-{{ section.id }}" class="royal-mascot-stage">

    <!-- Active Outfit Floating Pill -->
    <div class="royal-active-outfit-badge" id="royal-outfit-badge-{{ section.id }}">
      <span class="badge-crown">👑</span>
      <span class="badge-name" id="royal-active-name-{{ section.id }}">Imperial Cream & Gold Sherwani</span>
    </div>

    <!-- Master Interactive Doll Character with Gaze & Leaning Physics -->
    <div
      id="royal-mascot-doll-{{ section.id }}"
      class="royal-doll-character"
      data-doll-tracking="true"
      data-idle-float="true"
    >
      <!-- Preloaded Built-in Outfits for Instant Seamless Crossfade -->
      <img
        id="royal-doll-cream-{{ section.id }}"
        class="royal-doll-img active"
        data-outfit="cream"
        src="{{ 'royal-doll-cream.png' | asset_url }}"
        alt="Imperial Cream & Gold Sherwani"
        loading="eager"
        width="848"
        height="1264"
      />
      <img
        id="royal-doll-blue-{{ section.id }}"
        class="royal-doll-img"
        data-outfit="blue"
        src="{{ 'royal-doll-blue.png' | asset_url }}"
        alt="Sapphire Blue Jodhpuri"
        loading="lazy"
        width="848"
        height="1264"
      />
      <img
        id="royal-doll-green-{{ section.id }}"
        class="royal-doll-img"
        data-outfit="green"
        src="{{ 'royal-doll-green.png' | asset_url }}"
        alt="Heritage Emerald Silk Sherwani"
        loading="lazy"
        width="848"
        height="1264"
      />
      <img
        id="royal-doll-red-{{ section.id }}"
        class="royal-doll-img"
        data-outfit="red"
        src="{{ 'royal-doll-red.png' | asset_url }}"
        alt="Ruby Red Ceremonial Sherwani"
        loading="lazy"
        width="848"
        height="1264"
      />

      <!-- Custom Merchant Uploaded Outfits (via Blocks) -->
      {% for block in section.blocks %}
        {% if block.settings.custom_outfit_image != blank %}
          <img
            id="royal-doll-block-{{ block.id }}"
            class="royal-doll-img"
            data-outfit="block-{{ block.id }}"
            src="{{ block.settings.custom_outfit_image | image_url: width: 1000 }}"
            alt="{{ block.settings.outfit_name }}"
            loading="lazy"
            width="848"
            height="1264"
            {{ block.shopify_attributes }}
          />
        {% endif %}
      {% endfor %}

      <!-- Dynamic Ground Contact Shadow (Moves & squashes with leaning physics) -->
      <div id="royal-doll-shadow-{{ section.id }}" class="royal-doll-ground-shadow" aria-hidden="true"></div>
    </div>

    <!-- Quick-Dressing Wardrobe Swatches Dock -->
    <div class="royal-wardrobe-dock" id="royal-wardrobe-dock-{{ section.id }}">
      <span class="dock-label">✨ DRAPE DRESS:</span>
      <div class="dock-swatches">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign block_outfit_key = block.settings.outfit_key %}
            {% if block.settings.custom_outfit_image != blank %}
              {% assign block_outfit_key = 'block-' | append: block.id %}
            {% endif %}
            <button
              type="button"
              class="dock-swatch-btn {% if forloop.first %}active{% endif %}"
              data-outfit="{{ block_outfit_key }}"
              data-title="{{ block.settings.outfit_name | escape }}"
              data-price="{{ block.settings.price | default: 'Rs. 48,000' | escape }}"
              data-desc="{{ block.settings.description | default: 'Hand-tailored court sherwani.' | escape }}"
              aria-label="Dress character in {{ block.settings.outfit_name | escape }}"
              {{ block.shopify_attributes }}
            >
              <span class="swatch-ring" style="--swatch-color: {{ block.settings.swatch_color | default: '#F5E5C9' }};"></span>
              <span class="swatch-text">{{ block.settings.outfit_name }}</span>
            </button>
          {% endfor %}
        {% else %}
          <button
            type="button"
            class="dock-swatch-btn active"
            data-outfit="cream"
            data-title="Imperial Cream & Gold"
            data-price="Rs. 48,000"
            data-desc="Chanderi silk woven with intricate ivory-on-cream needlework, freshwater pearl button fastenings, and gold piping."
          >
            <span class="swatch-ring" style="--swatch-color: #F5E5C9;"></span>
            <span class="swatch-text">Cream & Gold</span>
          </button>
          <button
            type="button"
            class="dock-swatch-btn"
            data-outfit="blue"
            data-title="Sapphire Blue Jodhpuri"
            data-price="Rs. 52,000"
            data-desc="Celestial lapis blue brocade adorned with real silver and gold thread floral booti motifs and mandarin collar."
          >
            <span class="swatch-ring" style="--swatch-color: #1B3B6F;"></span>
            <span class="swatch-text">Sapphire Blue</span>
          </button>
          <button
            type="button"
            class="dock-swatch-btn"
            data-outfit="green"
            data-title="Heritage Emerald Silk"
            data-price="Rs. 54,000"
            data-desc="Rich forest emerald raw silk sherwani featuring heritage paisleys, antique gold placket, and emerald buttons."
          >
            <span class="swatch-ring" style="--swatch-color: #1E4A38;"></span>
            <span class="swatch-text">Emerald Green</span>
          </button>
          <button
            type="button"
            class="dock-swatch-btn"
            data-outfit="red"
            data-title="Ruby Red Ceremonial"
            data-price="Rs. 56,000"
            data-desc="Ceremonial state regalia in deep ruby velvet enriched with dense antique gold zardozi placket embroidery."
          >
            <span class="swatch-ring" style="--swatch-color: #8B1E1E;"></span>
            <span class="swatch-text">Ruby Red</span>
          </button>
        {% endif %}
      </div>
    </div>

    <!-- Active Outfit Info Card / Atelier Drawer -->
    <div class="royal-outfit-info-card" id="royal-info-card-{{ section.id }}">
      <div class="info-card-left">
        <span class="info-card-tag">AUTHENTIC COURT REGALIA</span>
        <h4 class="info-card-title" id="royal-card-title-{{ section.id }}">Imperial Cream & Gold</h4>
        <p class="info-card-desc" id="royal-card-desc-{{ section.id }}">Chanderi silk woven with intricate ivory-on-cream needlework, freshwater pearl button fastenings, and gold piping.</p>
      </div>
      <div class="info-card-right">
        <span class="info-card-price" id="royal-card-price-{{ section.id }}">Rs. 48,000</span>
        <a href="#the-collection" class="info-card-btn">
          <span>Add to Wardrobe</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Interaction Hint Pill -->
    {% if section.settings.show_hint %}
      <div class="royal-mascot-hint">
        <span class="royal-mascot-hint-icon">✦</span>
        <span class="royal-mascot-hint-text">{{ section.settings.hint_text | default: 'Click any dress to drape the character • Move mouse to track natural gaze in real-time' }}</span>
      </div>
    {% endif %}

  </div>
</div>

<style>
  /* ==========================================================================
     ROYAL MASCOT & DRESS-UP ATELIER STYLING
     ========================================================================== */
  #royal-mascot-section-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 720px;
    background-color: var(--mascot-bg, #E5A625);
    background: radial-gradient(ellipse at 50% 45%, #f7cb67 0%, #e5a625 50%, #c48210 100%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    padding: 36px 20px 48px 20px;
  }

  /* Subtle Warm Center Glow */
  #royal-mascot-section-{{ section.id }} .royal-mascot-bg-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.22) 0%, rgba(245, 185, 50, 0.10) 45%, transparent 75%);
    pointer-events: none;
    z-index: 1;
  }

  /* Section Header */
  #royal-mascot-section-{{ section.id }} .royal-mascot-header {
    position: relative;
    z-index: 6;
    text-align: center;
    max-width: 680px;
    margin-bottom: 12px;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-badge {
    display: inline-block;
    padding: 4px 14px;
    background: rgba(30, 20, 10, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #3b2207;
    margin-bottom: 8px;
    backdrop-filter: blur(4px);
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-title {
    font-family: inherit;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 800;
    color: #2b1704;
    line-height: 1.15;
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 8px rgba(255, 255, 255, 0.4);
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-subtitle {
    font-size: clamp(0.85rem, 1.4vw, 0.98rem);
    color: #4e300d;
    margin: 0 auto;
    max-width: 540px;
    line-height: 1.45;
  }

  /* Full-Section Canvas for Sparkles */
  #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 15;
  }

  /* FULL-SECTION 3D Royal Butterfly Creature */
  #royal-mascot-section-{{ section.id }} .royal-butterfly-creature {
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 70px;
    pointer-events: none !important;
    z-index: 20;
    transform: translate3d(-200px, -200px, 0);
    will-change: transform;
    transition: opacity 0.3s ease;
  }

  #royal-mascot-section-{{ section.id }} .butterfly-3d-rig {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 700px;
    transform-style: preserve-3d;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #royal-mascot-section-{{ section.id }} .butterfly-body {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 60px;
    z-index: 4;
  }

  #royal-mascot-section-{{ section.id }} .butterfly-body svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 4px rgba(0, 229, 255, 0.7));
  }

  /* Butterfly Wings */
  #royal-mascot-section-{{ section.id }} .butterfly-wing.wing-left {
    position: absolute;
    right: 50%;
    top: 50%;
    margin-right: -4px;
    margin-top: -30px;
    width: 58px;
    height: 64px;
    transform-origin: right 45%;
    transform-style: preserve-3d;
    animation: flapLeftWing 0.16s ease-in-out infinite alternate;
    z-index: 2;
  }

  #royal-mascot-section-{{ section.id }} .butterfly-wing.wing-right {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -4px;
    margin-top: -30px;
    width: 58px;
    height: 64px;
    transform-origin: left 45%;
    transform-style: preserve-3d;
    animation: flapRightWing 0.16s ease-in-out infinite alternate;
    z-index: 2;
  }

  #royal-mascot-section-{{ section.id }} .butterfly-wing svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes flapLeftWing {
    0% { transform: rotateY(0deg) rotateZ(0deg); }
    50% { transform: rotateY(52deg) rotateZ(-6deg); }
    100% { transform: rotateY(78deg) rotateZ(-12deg); }
  }

  @keyframes flapRightWing {
    0% { transform: rotateY(0deg) rotateZ(0deg); }
    50% { transform: rotateY(-52deg) rotateZ(6deg); }
    100% { transform: rotateY(-78deg) rotateZ(12deg); }
  }

  #royal-mascot-section-{{ section.id }} .royal-butterfly-creature.fast-flap .wing-left {
    animation-duration: 0.11s;
  }
  #royal-mascot-section-{{ section.id }} .royal-butterfly-creature.fast-flap .wing-right {
    animation-duration: 0.11s;
  }
  #royal-mascot-section-{{ section.id }} .royal-butterfly-creature.hover-flap .wing-left {
    animation-duration: 0.22s;
  }
  #royal-mascot-section-{{ section.id }} .royal-butterfly-creature.hover-flap .wing-right {
    animation-duration: 0.22s;
  }

  /* Stage Container */
  #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
    position: relative;
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 5;
    perspective: 1000px;
  }

  /* Active Outfit Pill Badge */
  #royal-mascot-section-{{ section.id }} .royal-active-outfit-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(229, 166, 37, 0.6);
    box-shadow: 0 4px 18px rgba(90, 50, 10, 0.12);
    border-radius: 30px;
    padding: 6px 18px;
    margin-bottom: 6px;
    z-index: 8;
    backdrop-filter: blur(8px);
    transition: transform 0.25s ease, background 0.25s ease;
  }

  #royal-mascot-section-{{ section.id }} .royal-active-outfit-badge .badge-crown {
    font-size: 1.05rem;
  }

  #royal-mascot-section-{{ section.id }} .royal-active-outfit-badge .badge-name {
    font-size: 0.86rem;
    font-weight: 700;
    color: #2b1704;
    letter-spacing: 0.02em;
  }

  /* Master Character Container */
  #royal-mascot-section-{{ section.id }} .royal-doll-character {
    position: relative;
    width: 100%;
    max-width: var(--mascot-width, 440px);
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    will-change: transform;
    pointer-events: auto;
    cursor: default;
  }

  #royal-mascot-section-{{ section.id }} .royal-doll-img {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) scale(0.96);
    max-height: 480px;
    width: auto;
    object-fit: contain;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.36s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.36s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform-origin: center bottom;
    pointer-events: none;
    filter: drop-shadow(0 14px 26px rgba(50, 25, 5, 0.22));
    z-index: 3;
  }

  #royal-mascot-section-{{ section.id }} .royal-doll-img.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) scale(1);
    z-index: 4;
  }

  /* Ground Contact Shadow */
  #royal-mascot-section-{{ section.id }} .royal-doll-ground-shadow {
    position: absolute;
    bottom: 14px;
    left: 50%;
    width: 190px;
    height: 28px;
    background: radial-gradient(ellipse at 50% 50%, rgba(35, 18, 5, 0.42) 0%, rgba(35, 18, 5, 0.12) 50%, transparent 75%);
    transform: translateX(-50%);
    border-radius: 50%;
    filter: blur(4px);
    pointer-events: none;
    z-index: 2;
    will-change: transform;
    transition: transform 0.08s linear;
  }

  /* Wardrobe Dock */
  #royal-mascot-section-{{ section.id }} .royal-wardrobe-dock {
    position: relative;
    z-index: 8;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(229, 166, 37, 0.5);
    border-radius: 40px;
    box-shadow: 0 8px 30px rgba(70, 40, 10, 0.16);
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: -6px;
    margin-bottom: 14px;
    backdrop-filter: blur(10px);
    max-width: 95%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #royal-mascot-section-{{ section.id }} .dock-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: #5a350c;
    letter-spacing: 0.08em;
    padding-left: 6px;
    white-space: nowrap;
  }

  #royal-mascot-section-{{ section.id }} .dock-swatches {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #royal-mascot-section-{{ section.id }} .dock-swatch-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 8px;
    border-radius: 24px;
    border: 1.5px solid rgba(210, 160, 40, 0.35);
    background: rgba(250, 245, 235, 0.85);
    color: #3b2207;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    white-space: nowrap;
    outline: none;
  }

  #royal-mascot-section-{{ section.id }} .dock-swatch-btn:hover {
    border-color: #c48210;
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(80, 45, 10, 0.14);
  }

  #royal-mascot-section-{{ section.id }} .dock-swatch-btn.active {
    border-color: #8a5700;
    background: #2b1704;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(43, 23, 4, 0.35);
    transform: translateY(-1px);
  }

  #royal-mascot-section-{{ section.id }} .dock-swatch-btn .swatch-ring {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--swatch-color, #F5E5C9);
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    display: inline-block;
  }

  /* Active Outfit Info Card / Drawer */
  #royal-mascot-section-{{ section.id }} .royal-outfit-info-card {
    position: relative;
    z-index: 7;
    width: 100%;
    max-width: 580px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    box-shadow: 0 6px 24px rgba(70, 40, 10, 0.12);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    backdrop-filter: blur(8px);
    margin-bottom: 12px;
  }

  #royal-mascot-section-{{ section.id }} .info-card-left {
    flex: 1;
    min-width: 0;
  }

  #royal-mascot-section-{{ section.id }} .info-card-tag {
    display: block;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #8a5700;
    margin-bottom: 2px;
  }

  #royal-mascot-section-{{ section.id }} .info-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #2b1704;
    margin: 0 0 4px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #royal-mascot-section-{{ section.id }} .info-card-desc {
    font-size: 0.78rem;
    color: #553510;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #royal-mascot-section-{{ section.id }} .info-card-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    flex-shrink: 0;
  }

  #royal-mascot-section-{{ section.id }} .info-card-price {
    font-size: 1.15rem;
    font-weight: 800;
    color: #2b1704;
    letter-spacing: -0.01em;
  }

  #royal-mascot-section-{{ section.id }} .info-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #2b1704;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  #royal-mascot-section-{{ section.id }} .info-card-btn:hover {
    background: #000000;
    transform: translateY(-1px);
  }

  /* Interaction Hint Pill */
  #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
    position: relative;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(30, 20, 10, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 30px;
    padding: 6px 16px;
    font-size: 0.74rem;
    font-weight: 600;
    color: #4a2c0c;
    backdrop-filter: blur(4px);
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-hint-icon {
    color: #8a5700;
    font-size: 0.85rem;
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    #royal-mascot-section-{{ section.id }} .butterfly-wing {
      animation: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-butterfly-creature {
      display: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
      display: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-doll-character {
      transform: none !important;
    }
  }

  @media (max-width: 640px) {
    #royal-mascot-section-{{ section.id }} {
      min-height: 660px;
      padding: 24px 14px 36px 14px;
    }
    #royal-mascot-section-{{ section.id }} .royal-doll-character {
      height: 440px;
    }
    #royal-mascot-section-{{ section.id }} .royal-doll-img {
      max-height: 400px;
    }
    #royal-mascot-section-{{ section.id }} .royal-outfit-info-card {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    #royal-mascot-section-{{ section.id }} .info-card-right {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
(function() {
  "use strict";

  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("royal-mascot-section-" + sectionId);
  var stageEl = document.getElementById("royal-mascot-stage-" + sectionId);
  var dollViewer = document.getElementById("royal-mascot-doll-" + sectionId);
  var shadowEl = document.getElementById("royal-doll-shadow-" + sectionId);
  var butterflyEl = document.getElementById("royal-mascot-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("royal-mascot-sparkles-" + sectionId);
  var badgeNameEl = document.getElementById("royal-active-name-" + sectionId);
  var cardTitleEl = document.getElementById("royal-card-title-" + sectionId);
  var cardDescEl = document.getElementById("royal-card-desc-" + sectionId);
  var cardPriceEl = document.getElementById("royal-card-price-" + sectionId);

  if (!sectionEl || !stageEl || !dollViewer) return;

  var config = {
    enableButterfly: {% if section.settings.enable_butterfly %}true{% else %}false{% endif %},
    enableSparkles: {% if section.settings.enable_sparkles %}true{% else %}false{% endif %}
  };

  // ==========================================================================
  // 1. DRESS-UP & WARDROBE SYSTEM ("Append the dress we want")
  // ==========================================================================
  var WardrobeManager = {
    outfitImgs: dollViewer.querySelectorAll(".royal-doll-img"),
    swatchBtns: sectionEl.querySelectorAll(".dock-swatch-btn"),

    init: function() {
      var self = this;
      this.swatchBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
          self.selectOutfit(btn);
        });
      });
    },

    selectOutfit: function(btn) {
      var outfitKey = btn.getAttribute("data-outfit");
      var title = btn.getAttribute("data-title");
      var price = btn.getAttribute("data-price");
      var desc = btn.getAttribute("data-desc");

      // Update active swatch state
      this.swatchBtns.forEach(function(b) { b.classList.remove("active"); });
      btn.classList.add("active");

      // Update badge & info card
      if (badgeNameEl && title) badgeNameEl.textContent = title + " Sherwani";
      if (cardTitleEl && title) cardTitleEl.textContent = title;
      if (cardPriceEl && price) cardPriceEl.textContent = price;
      if (cardDescEl && desc) cardDescEl.textContent = desc;

      // Crossfade doll outfit
      var targetImg = null;
      this.outfitImgs.forEach(function(img) {
        if (img.getAttribute("data-outfit") === outfitKey) {
          targetImg = img;
        }
      });

      if (targetImg) {
        this.outfitImgs.forEach(function(img) { img.classList.remove("active"); });
        targetImg.classList.add("active");

        // Magical equip sparkle burst around the character
        if (config.enableSparkles && SparkleTrail.ctx) {
          var stageRect = stageEl.getBoundingClientRect();
          var secRect = sectionEl.getBoundingClientRect();
          var cx = (stageRect.left + stageRect.width / 2) - secRect.left;
          var cy = (stageRect.top + stageRect.height * 0.45) - secRect.top;
          for (var i = 0; i < 28; i++) {
            SparkleTrail.addParticle(
              cx + (Math.random() - 0.5) * 160,
              cy + (Math.random() - 0.5) * 220
            );
          }
        }
      }
    }
  };

  // ==========================================================================
  // 2. FULL-SECTION 3D ROYAL BUTTERFLY & SPARKLE TRAIL
  // ==========================================================================
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !config.enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !sectionEl) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 720;
      this.canvas.width = w * dpr;
      this.canvas.height = h * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    addParticle: function(x, y) {
      if (this.particles.length > 55) return;
      var hues = ['#00e5ff', '#651fff', '#ffd700', '#76ff03', '#80d8ff'];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 8,
        radius: Math.random() * 2.2 + 0.8,
        alpha: 1.0,
        decay: Math.random() * 0.024 + 0.014,
        vx: (Math.random() - 0.5) * 0.8,
        vy: Math.random() * 0.5 + 0.3,
        color: hues[Math.floor(Math.random() * hues.length)]
      });
    },

    updateAndRender: function() {
      if (!this.ctx || !sectionEl) return;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 720;
      this.ctx.clearRect(0, 0, w, h);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        this.ctx.save();
        this.ctx.globalAlpha = Math.max(0, p.alpha);
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();
      }
    }
  };

  var ButterflyFollower = {
    el: butterflyEl,
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    angle: 0,
    isHovering: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (!this.el || !config.enableButterfly) return;

      var self = this;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 720;
      this.posX = w * 0.28;
      this.posY = h * 0.36;
      this.targetX = this.posX;
      this.targetY = this.posY;

      function updateTarget(clientX, clientY) {
        if (!sectionEl) return;
        var secRect = sectionEl.getBoundingClientRect();
        self.targetX = clientX - secRect.left;
        self.targetY = clientY - secRect.top;
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }

      sectionEl.addEventListener("mousemove", function(e) {
        updateTarget(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 80 && e.clientY <= r.bottom + 80) {
          updateTarget(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updateTarget(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      sectionEl.addEventListener("mouseleave", function() {
        self.isHovering = false;
      });
    },

    update: function(time) {
      if (!this.el || !config.enableButterfly) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 720;

      // Autonomous circular flight patrol around character when idle
      if (!this.isHovering || (time - this.lastMoveTime > 3200)) {
        var t = time * 0.0012;
        var patrolCenterX = secW * 0.5;
        var patrolCenterY = secH * 0.36;
        this.targetX = patrolCenterX + Math.cos(t) * (secW * 0.35);
        this.targetY = patrolCenterY + Math.sin(t * 2) * (secH * 0.20);
      }

      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      var dist = Math.sqrt(dx * dx + dy * dy);

      var vx = dx * 0.082;
      var vy = dy * 0.082;
      this.posX += vx;
      this.posY += vy;

      // Natural hovering bob
      var hoverX = Math.sin(time * 0.0035) * 10;
      var hoverY = Math.cos(time * 0.0042) * 8;
      var fx = this.posX + hoverX;
      var fy = this.posY + hoverY;

      // Restrain within full section boundaries
      fx = Math.max(30, Math.min(secW - 70, fx));
      fy = Math.max(30, Math.min(secH - 70, fy));

      if (dist > 2) {
        var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        var diff = (targetAngle - this.angle + 540) % 360 - 180;
        this.angle += diff * 0.12;
      }

      var tilt = Math.max(-25, Math.min(25, vx * 1.8));

      if (dist > 40) {
        this.el.classList.add("fast-flap");
        this.el.classList.remove("hover-flap");
      } else {
        this.el.classList.remove("fast-flap");
        this.el.classList.add("hover-flap");
      }

      this.el.style.transform =
        "translate3d(" + (fx - 45).toFixed(1) + "px, " + (fy - 35).toFixed(1) + "px, 0px) " +
        "rotate(" + this.angle.toFixed(1) + "deg) " +
        "rotateY(" + tilt.toFixed(1) + "deg)";

      if (config.enableSparkles && Math.random() < 0.45) {
        SparkleTrail.addParticle(fx, fy);
      }
    }
  };

  // ==========================================================================
  // 3. NATURAL 3D GAZE & CIRCULAR LEANING TRACKING PHYSICS
  // Signature bottom-section leaning, vertical pitch & circular movement (No 360 spin)
  // ==========================================================================
  var DollMotionTracker = {
    currentRotY: 0,
    currentRotX: 0,
    currentTransX: 0,
    targetRotY: 0,
    targetRotX: 0,
    targetTransX: 0,
    isCursorInside: false,
    currentClientX: 0,
    currentClientY: 0,
    lastMoveTime: performance.now(),

    init: function() {
      var self = this;

      function updateGaze(clientX, clientY) {
        self.currentClientX = clientX;
        self.currentClientY = clientY;
        self.isCursorInside = true;
        self.lastMoveTime = performance.now();
      }

      sectionEl.addEventListener("mousemove", function(e) {
        updateGaze(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 80 && e.clientY <= r.bottom + 80) {
          updateGaze(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("mouseleave", function() {
        self.isCursorInside = false;
      });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updateGaze(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
    },

    update: function(time) {
      if (!dollViewer) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 720;

      if (this.isCursorInside) {
        var dollRect = dollViewer.getBoundingClientRect();
        var dollMidX = dollRect.left + dollRect.width / 2;
        var dollMidY = dollRect.top + dollRect.height * 0.42;

        var relX = (this.currentClientX - dollMidX) / (window.innerWidth * 0.45);
        var relY = (this.currentClientY - dollMidY) / (window.innerHeight * 0.45);

        relX = Math.max(-1.15, Math.min(1.15, relX));
        relY = Math.max(-1.15, Math.min(1.15, relY));

        // Horizontal yaw, vertical pitch, and leaning displacement
        this.targetRotY = relX * 18;
        this.targetRotX = -relY * 8;
        this.targetTransX = relX * 14;
      } else if (ButterflyFollower.el && (!this.isCursorInside || (time - this.lastMoveTime > 3000))) {
        // When mouse is idle, doll follows the autonomous circular butterfly patrol
        var dollLocalX = secW * 0.5;
        var diffX = (ButterflyFollower.posX - dollLocalX) / (secW * 0.5);
        this.targetRotY = Math.max(-10, Math.min(10, diffX * 12));
        this.targetRotX = 0;
        this.targetTransX = this.targetRotY * 0.6;
      }

      // Smooth silky lerp interpolation
      this.currentRotY += (this.targetRotY - this.currentRotY) * 0.08;
      this.currentRotX += (this.targetRotX - this.currentRotX) * 0.08;
      this.currentTransX += (this.targetTransX - this.currentTransX) * 0.08;

      // Gentle organic idle vertical floating wave
      var idleY = Math.sin(time * 0.0016) * 6;

      dollViewer.style.transform =
        "translate3d(" + this.currentTransX.toFixed(2) + "px, " + idleY.toFixed(2) + "px, 0px) " +
        "rotateY(" + this.currentRotY.toFixed(2) + "deg) " +
        "rotateX(" + this.currentRotX.toFixed(2) + "deg)";

      // Dynamic ground contact shadow shifting with character lean
      if (shadowEl) {
        var shadowShift = this.currentTransX * 0.65;
        var shadowScale = 1.0 - Math.abs(this.currentRotX / 30);
        shadowEl.style.transform =
          "translateX(calc(-50% + " + shadowShift.toFixed(1) + "px)) " +
          "scaleX(" + shadowScale.toFixed(2) + ")";
      }
    }
  };

  // ==========================================================================
  // UNIFIED 60FPS RAF ANIMATION LOOP
  // ==========================================================================
  function animateFrame(time) {
    requestAnimationFrame(animateFrame);
    ButterflyFollower.update(time);
    DollMotionTracker.update(time);
    SparkleTrail.updateAndRender();
  }

  function boot() {
    WardrobeManager.init();
    SparkleTrail.init();
    ButterflyFollower.init();
    DollMotionTracker.init();
    requestAnimationFrame(animateFrame);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      boot();
    }
  });

})();
</script>

{% schema %}
{
  "name": "Royal Mascot",
  "tag": "section",
  "class": "section-royal-mascot",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E5A625"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Interactive Royal Wardrobe"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading Badge",
      "default": "ROYAL COURT ATELIER"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select any royal regalia below to instantly drape the character in handcrafted court attire."
    },
    {
      "type": "range",
      "id": "mascot_size",
      "label": "Character Max Width (px)",
      "min": 280,
      "max": 540,
      "step": 10,
      "default": 440
    },
