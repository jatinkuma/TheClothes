{% comment %}
  ==============================================================================
  ROYAL MASCOT — INTERACTIVE CHARACTER & BUTTERFLY SECTION
  Focused purely on the Mascot character & cursor-following butterfly.
  ------------------------------------------------------------------------------
  Features:
  - Central Royal Indian Mascot from the user's reference image
  - Real-time 3D Perspective Head & Goggles Rotation (Yaw, Pitch, Roll)
  - 3D Stereoscopic Parallax Goggles Layer
  - Expressive Eye Pupil Tracking Darting Behind Lenses
  - Procedural Natural Eyelid Blinking & Idle Breathing
  - Dynamic Ground Contact Shadow
  - Electric Blue Butterfly Cursor Follower with Wing Flapping & Banking
  - Magical Fairy Dust Sparkle Trail Canvas
  - Zero 360-Degree Orbit Drag (Strictly Cursor Gaze Tracking)
  - Mobile Single-Finger Touch Tracking
  - Ultra-Lightweight & Instant Loading (Zero heavy dependencies)
  ==============================================================================
{% endcomment %}

<div
  id="royal-mascot-section-{{ section.id }}"
  class="royal-mascot-section"
  style="
    --mascot-bg: {{ section.settings.bg_color | default: '#E5A625' }};
    --mascot-width: {{ section.settings.mascot_size | default: 340 }}px;
  "
>
  <!-- Background Glow & Golden Floor -->
  <div class="royal-mascot-bg-glow" aria-hidden="true"></div>

  <!-- Stage Container -->
  <div id="royal-mascot-stage-{{ section.id }}" class="royal-mascot-stage">

    <!-- Fairy Dust Sparkle Particle Canvas -->
    {% if section.settings.enable_sparkles %}
      <canvas id="royal-mascot-sparkles-{{ section.id }}" class="royal-mascot-sparkles-canvas"></canvas>
    {% endif %}

    <!-- Mascot 3D Perspective Container -->
    <div id="royal-mascot-rig-{{ section.id }}" class="royal-mascot-rig">
      
      <!-- Dynamic Ground Contact Shadow -->
      <div id="royal-mascot-shadow-{{ section.id }}" class="royal-mascot-shadow" aria-hidden="true"></div>

      <!-- Body Layer (Brocade Sherwani, Red Stole, Necklace, Churidar, Curled Mojari Shoes, Fluffy Tail) -->
      <div id="royal-mascot-body-{{ section.id }}" class="royal-mascot-layer royal-mascot-body">
        <img
          src="{{ 'royal-mascot-body.png' | asset_url }}"
          alt="Royal Indian Mascot Body"
          width="228"
          height="312"
          loading="eager"
          decoding="async"
        >
      </div>

      <!-- Head Layer (Turban, Kalgi Brooch, Feather Plume, Furry Cheeks, Snout, Goggles) -->
      <div id="royal-mascot-head-{{ section.id }}" class="royal-mascot-layer royal-mascot-head">
        <img
          src="{{ 'royal-mascot-head.png' | asset_url }}"
          alt="Royal Indian Mascot Head with Rajasthani Safa and Goggles"
          width="228"
          height="312"
          loading="eager"
          decoding="async"
        >

        <!-- Expressive Darting Eye Pupils Behind Goggles -->
        <div class="royal-mascot-eyes" aria-hidden="true">
          <!-- Left Eye Pupil -->
          <div class="royal-eye royal-eye-left">
            <div id="royal-pupil-left-{{ section.id }}" class="royal-pupil"></div>
            <div id="royal-eyelid-left-{{ section.id }}" class="royal-eyelid"></div>
          </div>
          <!-- Right Eye Pupil -->
          <div class="royal-eye royal-eye-right">
            <div id="royal-pupil-right-{{ section.id }}" class="royal-pupil"></div>
            <div id="royal-eyelid-right-{{ section.id }}" class="royal-eyelid"></div>
          </div>
        </div>

        <!-- 3D Goggles Layer (Parallax Pop Effect) -->
        <div id="royal-mascot-goggles-{{ section.id }}" class="royal-mascot-layer royal-mascot-goggles" aria-hidden="true">
          <img
            src="{{ 'royal-mascot-goggles.png' | asset_url }}"
            alt="Gold Wireframe Goggles"
            width="228"
            height="312"
            loading="eager"
            decoding="async"
          >
        </div>

      </div>

    </div>

    <!-- Interactive Hint Pill Matching Reference Image -->
    {% if section.settings.show_hint %}
      <div class="royal-mascot-hint">
        <span class="royal-mascot-hint-icon">✦</span>
        <span class="royal-mascot-hint-text">{{ section.settings.hint_text | default: 'Interactive 3D Mascot • Move mouse or drag to explore' }}</span>
      </div>
    {% endif %}

  </div>

  <!-- Electric Blue Butterfly Cursor -->
  {% if section.settings.enable_butterfly %}
    <div
      id="royal-mascot-butterfly-{{ section.id }}"
      class="royal-mascot-butterfly"
      aria-hidden="true"
      style="--bf-cyan: {{ section.settings.butterfly_color | default: '#00E5FF' }};"
    >
      <div class="royal-bf-wings">
        <!-- Left Wing -->
        <div class="royal-bf-wing royal-bf-wing-left">
          <svg viewBox="0 0 64 74" width="54" height="64">
            <defs>
              <linearGradient id="rmBfWingL-{{ section.id }}" x1="100%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#091b35" />
                <stop offset="28%" stop-color="#0d47a1" />
                <stop offset="60%" stop-color="#0288d1" />
                <stop offset="88%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 60 52 C 50 36, 24 16, 6 2 C -2 -4, -2 8, 5 22 C 10 32, 28 46, 60 56 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 60 52 C 44 48, 18 42, 10 32 C 2 20, -2 32, 6 44 C 14 56, 32 64, 60 54 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 58 50 Q 34 32 14 14 M 50 48 Q 28 34 16 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="8" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="16" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Body -->
        <div class="royal-bf-body">
          <div class="royal-bf-antennae"></div>
          <div class="royal-bf-thorax"></div>
          <div class="royal-bf-abdomen"></div>
        </div>

        <!-- Right Wing -->
        <div class="royal-bf-wing royal-bf-wing-right">
          <svg viewBox="0 0 64 74" width="54" height="64">
            <defs>
              <linearGradient id="rmBfWingR-{{ section.id }}" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#091b35" />
                <stop offset="28%" stop-color="#0d47a1" />
                <stop offset="60%" stop-color="#0288d1" />
                <stop offset="88%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 4 52 C 14 36, 40 16, 58 2 C 66 -4, 66 8, 59 22 C 54 32, 36 46, 4 56 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 4 52 C 20 48, 46 42, 54 32 C 62 20, 66 32, 58 44 C 50 56, 32 64, 4 54 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 6 50 Q 30 32 50 14 M 14 48 Q 36 34 48 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="56" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="48" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  /* ==========================================================================
     ROYAL MASCOT SECTION STYLING (Scoped)
     ========================================================================== */
  #royal-mascot-section-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 580px;
    background-color: var(--mascot-bg, #E5A625);
    background: radial-gradient(ellipse at 50% 50%, #f4c45a 0%, #e2a022 55%, #c98818 100%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    padding: 30px 20px 40px 20px;
  }

  /* Subtle Warm Center Glow */
  #royal-mascot-section-{{ section.id }} .royal-mascot-bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 48%, rgba(255, 235, 175, 0.45) 0%, transparent 65%);
    z-index: 1;
  }

  /* Stage Container */
  #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
    position: relative;
    width: 100%;
    max-width: 680px;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  /* Fairy Dust Canvas */
  #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 15;
  }

  /* Mascot Perspective Rig */
  #royal-mascot-section-{{ section.id }} .royal-mascot-rig {
    position: relative;
    width: var(--mascot-width, 340px);
    height: calc(var(--mascot-width, 340px) * 1.36);
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 800px;
    transform-style: preserve-3d;
    cursor: default;
  }

  /* Contact Ground Shadow */
  #royal-mascot-section-{{ section.id }} .royal-mascot-shadow {
    position: absolute;
    bottom: 12px;
    width: 66%;
    height: 26px;
    background: radial-gradient(ellipse at center, rgba(60, 30, 8, 0.45) 0%, rgba(60, 30, 8, 0.16) 50%, transparent 75%);
    border-radius: 50%;
    filter: blur(5px);
    z-index: 1;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Mascot Layers */
  #royal-mascot-section-{{ section.id }} .royal-mascot-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backface-visibility: hidden;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-layer img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Body Layer */
  #royal-mascot-section-{{ section.id }} .royal-mascot-body {
    z-index: 2;
    transform-origin: 52% 80%;
    will-change: transform;
  }

  /* Head Layer (3D Perspective Turning on Neck Pivot) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-head {
    z-index: 3;
    transform-origin: 52% 48.7%; /* Base of neck */
    will-change: transform;
    transform-style: preserve-3d;
  }

  /* Goggles 3D Parallax Pop */
  #royal-mascot-section-{{ section.id }} .royal-mascot-goggles {
    z-index: 6;
    pointer-events: none;
    transform-origin: 52% 48.7%;
    will-change: transform;
  }

  /* Eyes Container */
  #royal-mascot-section-{{ section.id }} .royal-mascot-eyes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  #royal-mascot-section-{{ section.id }} .royal-eye {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    overflow: hidden;
  }

  #royal-mascot-section-{{ section.id }} .royal-eye-left {
    left: 50.4%;
    top: 27.2%;
  }

  #royal-mascot-section-{{ section.id }} .royal-eye-right {
    left: 75.9%;
    top: 24.0%;
  }

  #royal-mascot-section-{{ section.id }} .royal-pupil {
    position: absolute;
    width: 11px;
    height: 11px;
    left: 4.5px;
    top: 4.5px;
    background: radial-gradient(circle at 35% 35%, #24130c 0%, #110703 80%, #000000 100%);
    border-radius: 50%;
    will-change: transform;
    transition: transform 0.05s ease-out;
  }

  #royal-mascot-section-{{ section.id }} .royal-pupil::after {
    content: '';
    position: absolute;
    width: 3px;
    height: 3px;
    top: 2px;
    left: 2px;
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.95;
  }

  /* Procedural Eyelids for Blinking */
  #royal-mascot-section-{{ section.id }} .royal-eyelid {
    position: absolute;
    inset: 0;
    background: #d89858;
    transform: scaleY(0);
    transform-origin: top center;
    border-radius: 50% 50% 0 0;
    z-index: 5;
    transition: transform 0.08s ease-in-out;
  }

  /* Hint Pill Matching Reference */
  #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
    position: absolute;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 235, 192, 0.74);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.65);
    padding: 7px 18px;
    border-radius: 22px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #241105;
    box-shadow: 0 4px 16px rgba(40, 20, 5, 0.08);
    pointer-events: none;
    z-index: 10;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-hint-icon {
    font-size: 0.95rem;
    color: #241105;
  }

  /* ==========================================================================
     CYAN / ELECTRIC BLUE 3D BUTTERFLY
     ========================================================================== */
  #royal-mascot-section-{{ section.id }} .royal-mascot-butterfly {
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 70px;
    pointer-events: none !important;
    z-index: 20;
    will-change: transform;
    filter: drop-shadow(0 4px 16px rgba(0, 229, 255, 0.85));
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wings {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 480px;
    width: 100%;
    height: 100%;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing {
    width: 40px;
    height: 48px;
    display: block;
    transform-style: preserve-3d;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing-left {
    transform-origin: 100% 50%;
    animation: rmBfFlapLeft 0.12s ease-in-out infinite alternate;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing-right {
    transform-origin: 0% 50%;
    animation: rmBfFlapRight 0.12s ease-in-out infinite alternate;
  }

  @keyframes rmBfFlapLeft {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(76deg) scaleX(0.40); }
  }

  @keyframes rmBfFlapRight {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(-76deg) scaleX(0.40); }
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-body {
    position: relative;
    width: 4.5px;
    height: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-antennae {
    position: absolute;
    top: -5px;
    width: 12px;
    height: 6px;
    border-top: 1.8px solid #00E5FF;
    border-radius: 8px 8px 0 0;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-thorax {
    width: 4.5px;
    height: 8px;
    background: #091b35;
    border-radius: 3px 3px 2px 2px;
    border: 0.6px solid #00E5FF;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-abdomen {
    width: 3.5px;
    height: 18px;
    background: linear-gradient(to bottom, #091b35, #0288d1);
    border-radius: 1px 1px 3px 3px;
  }

  @media (max-width: 600px) {
    #royal-mascot-section-{{ section.id }} {
      min-height: 500px;
      padding: 20px 10px;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
      height: 460px;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
      font-size: 0.74rem;
      padding: 6px 14px;
    }
  }
</style>

<script>
(function() {
  "use strict";

  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("royal-mascot-section-" + sectionId);
  var stageEl = document.getElementById("royal-mascot-stage-" + sectionId);
  var headEl = document.getElementById("royal-mascot-head-" + sectionId);
  var gogglesEl = document.getElementById("royal-mascot-goggles-" + sectionId);
  var bodyEl = document.getElementById("royal-mascot-body-" + sectionId);
  var shadowEl = document.getElementById("royal-mascot-shadow-" + sectionId);
  var pupilLEl = document.getElementById("royal-pupil-left-" + sectionId);
  var pupilREl = document.getElementById("royal-pupil-right-" + sectionId);
  var eyelidLEl = document.getElementById("royal-eyelid-left-" + sectionId);
  var eyelidREl = document.getElementById("royal-eyelid-right-" + sectionId);
  var butterflyEl = document.getElementById("royal-mascot-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("royal-mascot-sparkles-" + sectionId);

  if (!sectionEl || !stageEl) return;

  var sensitivity = {{ section.settings.sensitivity | default: 24 }};
  var enableButterfly = {% if section.settings.enable_butterfly %}true{% else %}false{% endif %};
  var enableSparkles = {% if section.settings.enable_sparkles %}true{% else %}false{% endif %};

  // ==========================================================================
  // 1. CHARACTER GAZE & GOGGLES TRACKING ENGINE (NO 360-DEGREE ROTATION)
  // ==========================================================================
  var MascotGazeEngine = {
    targetX: 0,
    targetY: 0,
    currentX: 0,
    currentY: 0,
    isHovering: false,
    
    maxYaw: sensitivity,
    maxPitch: 14,
    maxRoll: 5.5,

    init: function() {
      var self = this;

      // Mouse tracking (STRICTLY gaze, NO 360 drag)
      window.addEventListener("mousemove", function(e) {
        if (!stageEl) return;
        var rect = stageEl.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height * 0.44;

        var dx = (e.clientX - centerX) / (window.innerWidth * 0.48);
        var dy = (e.clientY - centerY) / (window.innerHeight * 0.48);

        self.targetX = Math.max(-1, Math.min(1, dx));
        self.targetY = Math.max(-1, Math.min(1, dy));
        self.isHovering = true;
      }, { passive: true });

      // Return naturally to neutral forward pose when mouse leaves
      document.addEventListener("mouseleave", function() {
        self.targetX = 0;
        self.targetY = 0;
        self.isHovering = false;
      });

      // Mobile Touch Drag Tracking
      window.addEventListener("touchmove", function(e) {
        if (!stageEl || !e.touches || e.touches.length === 0) return;
        var touch = e.touches[0];
        var rect = stageEl.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height * 0.44;

        var dx = (touch.clientX - centerX) / (window.innerWidth * 0.48);
        var dy = (touch.clientY - centerY) / (window.innerHeight * 0.48);

        self.targetX = Math.max(-1, Math.min(1, dx));
        self.targetY = Math.max(-1, Math.min(1, dy));
        self.isHovering = true;
      }, { passive: true });

      window.addEventListener("touchend", function() {
        self.targetX = 0;
        self.targetY = 0;
        self.isHovering = false;
      });

      requestAnimationFrame(this.tick.bind(this));
    },

    tick: function(time) {
      requestAnimationFrame(this.tick.bind(this));

      // Spring-mass smoothing (damping)
      this.currentX += (this.targetX - this.currentX) * 0.084;
      this.currentY += (this.targetY - this.currentY) * 0.084;

      // Head Euler Angles
      var yaw = this.currentX * this.maxYaw;
      var pitch = -this.currentY * this.maxPitch;
      var roll = this.currentX * this.maxRoll;
      var parallaxX = this.currentX * 9.5;
      var parallaxY = this.currentY * 6.5;

      // Idle breathing
      var breath = Math.sin(time * 0.0028) * 2.6;

      // 1. Move Head in 3D Perspective
      if (headEl) {
        headEl.style.transform =
          "translate3d(" + parallaxX.toFixed(2) + "px, " + (parallaxY + breath).toFixed(2) + "px, 14px) " +
          "rotateY(" + yaw.toFixed(2) + "deg) " +
          "rotateX(" + pitch.toFixed(2) + "deg) " +
          "rotateZ(" + roll.toFixed(2) + "deg)";
      }

      // 2. Goggles Parallax Pop (Moves goggles in 3D over the face)
      if (gogglesEl) {
        gogglesEl.style.transform =
          "translate3d(" + (parallaxX * 0.28).toFixed(2) + "px, " + (parallaxY * 0.28).toFixed(2) + "px, 16px) " +
          "rotateY(" + (yaw * 0.08).toFixed(2) + "deg)";
      }

      // 3. Subtle Body Posture Follow
      if (bodyEl) {
        var bodyYaw = this.currentX * 3.5;
        var bodyX = this.currentX * 2.2;
        bodyEl.style.transform =
          "translate3d(" + bodyX.toFixed(2) + "px, " + (breath * 0.6).toFixed(2) + "px, 0px) " +
          "rotateY(" + bodyYaw.toFixed(2) + "deg)";
      }

      // 4. Contact Shadow
      if (shadowEl) {
        var shadowSkew = -this.currentX * 5.5;
        var shadowScale = 1.0 - Math.abs(this.currentY) * 0.04;
        shadowEl.style.transform =
          "translateX(" + (this.currentX * 11).toFixed(1) + "px) " +
          "skewX(" + shadowSkew.toFixed(1) + "deg) " +
          "scale(" + shadowScale.toFixed(2) + ")";
      }

      // 5. Eye Pupil Darting
      var eyeX = this.currentX * 4.2;
      var eyeY = this.currentY * 3.5;
      if (pupilLEl) {
        pupilLEl.style.transform = "translate(" + eyeX.toFixed(1) + "px, " + eyeY.toFixed(1) + "px)";
      }
      if (pupilREl) {
        pupilREl.style.transform = "translate(" + eyeX.toFixed(1) + "px, " + eyeY.toFixed(1) + "px)";
      }

      // 6. Procedural Eyelid Blinking
      var blinkCycle = (time % 3500) / 3500;
      var isBlinking = blinkCycle > 0.955;
      var blinkScale = isBlinking ? (1.0 - Math.sin(((blinkCycle - 0.955) / 0.045) * Math.PI)) : 0;
      if (eyelidLEl && eyelidREl) {
        eyelidLEl.style.transform = "scaleY(" + (1 - blinkScale).toFixed(2) + ")";
        eyelidREl.style.transform = "scaleY(" + (1 - blinkScale).toFixed(2) + ")";
      }
    }
  };

  // ==========================================================================
  // 2. BUTTERFLY & FAIRY DUST SPARKLE TRAIL
  // ==========================================================================
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.canvas.width = rect.width * dpr;
      this.canvas.height = rect.height * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    spawn: function(x, y, vx, vy) {
      if (!enableSparkles || this.particles.length > 80) return;
      var colors = ["#00E5FF", "#B2EBF2", "#FFFFFF", "#FFD54F"];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 10,
        y: y + (Math.random() - 0.5) * 10,
        vx: (Math.random() - 0.5) * 1.1 - vx * 0.1,
        vy: (Math.random() - 0.5) * 1.1 + 0.6,
        size: Math.random() * 2.6 + 1.2,
        alpha: 1.0,
        decay: Math.random() * 0.022 + 0.016,
        color: colors[Math.floor(Math.random() * colors.length)],
        phase: Math.random() * Math.PI * 2
      });
    },

    render: function(time) {
      if (!this.ctx || !stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      this.ctx.clearRect(0, 0, rect.width, rect.height);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        var twinkle = Math.sin(time * 0.015 + p.phase) * 0.3 + 0.7;
        var drawAlpha = Math.max(0, Math.min(1, p.alpha * twinkle));

        this.ctx.save();
        this.ctx.globalAlpha = drawAlpha;
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;

        var s = p.size;
        this.ctx.beginPath();
        this.ctx.moveTo(p.x, p.y - s * 1.5);
        this.ctx.lineTo(p.x + s * 0.35, p.y - s * 0.35);
        this.ctx.lineTo(p.x + s * 1.5, p.y);
        this.ctx.lineTo(p.x + s * 0.35, p.y + s * 0.35);
        this.ctx.lineTo(p.x, p.y + s * 1.5);
        this.ctx.lineTo(p.x - s * 0.35, p.y + s * 0.35);
        this.ctx.lineTo(p.x - s * 1.5, p.y);
        this.ctx.lineTo(p.x - s * 0.35, p.y - s * 0.35);
        this.ctx.closePath();
        this.ctx.fill();

        this.ctx.restore();
      }
    }
  };

  var ButterflyEngine = {
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    currentAngle: 0,
    isActive: false,

    init: function() {
      if (!butterflyEl || !enableButterfly) return;

      var secRect = sectionEl.getBoundingClientRect();
      this.posX = secRect.width * 0.65;
      this.posY = secRect.height * 0.38;
      this.targetX = this.posX;
      this.targetY = this.posY;

      var self = this;
      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var rect = sectionEl.getBoundingClientRect();
        self.targetX = e.clientX - rect.left;
        self.targetY = e.clientY - rect.top;
        self.isActive = true;
      }, { passive: true });

      requestAnimationFrame(this.flightLoop.bind(this));
    },

    flightLoop: function(time) {
      requestAnimationFrame(this.flightLoop.bind(this));

      if (!butterflyEl || !enableButterfly) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 580;

      // Autonomous gentle hovering if idle
      if (!this.isActive) {
        var t = time * 0.0016;
        this.targetX = secW * 0.60 + Math.cos(t) * (secW * 0.16);
        this.targetY = secH * 0.38 + Math.sin(t * 1.8) * (secH * 0.12);
      }

      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      var dist = Math.sqrt(dx * dx + dy * dy);

      this.posX += dx * 0.092;
      this.posY += dy * 0.092;

      var hoverX = Math.sin(time * 0.0036) * 6;
      var hoverY = Math.cos(time * 0.0042) * 5;
      var finalX = this.posX + hoverX;
      var finalY = this.posY + hoverY;

      finalX = Math.max(20, Math.min(secW - 85, finalX));
      finalY = Math.max(20, Math.min(secH - 75, finalY));

      if (dist > 3) {
        var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        var diff = (targetAngle - this.currentAngle + 540) % 360 - 180;
        this.currentAngle += diff * 0.12;
      }
      var bankTilt = Math.max(-28, Math.min(28, (dx * 0.092) * 2.2));

      butterflyEl.style.transform =
        "translate3d(" + (finalX - 30).toFixed(1) + "px, " + (finalY - 25).toFixed(1) + "px, 0px) " +
        "rotate(" + this.currentAngle.toFixed(1) + "deg) " +
        "rotateY(" + bankTilt.toFixed(1) + "deg)";

      if (stageEl && SparkleTrail.ctx) {
        var stageRect = stageEl.getBoundingClientRect();
        var secRect = sectionEl.getBoundingClientRect();
        var relX = finalX - (stageRect.left - secRect.left);
        var relY = finalY - (stageRect.top - secRect.top);

        if (dist > 2 || Math.random() < 0.25) {
          SparkleTrail.spawn(relX, relY, dx * 0.04, dy * 0.04);
        }
      }

      SparkleTrail.render(time);
    }
  };

  function boot() {
    MascotGazeEngine.init();
    SparkleTrail.init();
    ButterflyEngine.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      boot();
    }
  });

})();
</script>

