{% comment %}
  ==============================================================================
  ROYAL MASCOT — INTERACTIVE 3D WEBGL CARTOON MASCOT & BUTTERFLY SECTION
  ------------------------------------------------------------------------------
  Features:
  - 100% FRONT-FACING Rigged 3D Polygonal Model (GLB via Three.js WebGL):
    * Cute cartoon chipmunk head with chubby cream cheeks & dark button nose
    * Round gold wireframe goggles with physical 3D depth resting on snout bridge
    * Multicolored Rajasthani royal safa with jewel Kalgi brooch & upright white plume
    * Cream brocade Sherwani with gold buttons & royal red zardozi embroidered stole
    * Gold medallion necklace, churidar & curled royal mojari shoes
    * Bushy tail curled at back
  - Continuous Circular 360° Movement ("Moment Like Circle"):
    * Smooth circular 360° gaze tracking: as cursor circles around the mascot,
      the head, goggles, and eyes follow in a fluid, continuous 360° circular loop
    * Interactive 360° drag & spin orbit rotation with smooth momentum/inertia
    * Signature bottom-section leaning & displacement action
    * Organic idle breathing & vertical floating wave
    * Soft ground contact shadow reacting dynamically in 360°
  - FULL-SECTION Butterfly Flight & Live Canvas Fairy Dust Trail:
    * Butterfly flies across the FULL 100% width and height of the entire section
      from screen edge to screen edge without any half-section boundary clipping
    * Smooth spring-damped flight physics with 3D wing fluttering & banking
    * Live canvas fairy dust sparkle trail spanning the entire section width
    * Autonomous circular flight patrol when mouse is idle
  - Responsive Desktop, Tablet & Mobile touch support
  ==============================================================================
{% endcomment %}

<!-- Three.js & GLTF Loader CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

<div
  id="royal-mascot-section-{{ section.id }}"
  class="royal-mascot-section"
  style="
    --mascot-bg: {{ section.settings.bg_color | default: '#E5A625' }};
    --mascot-width: {{ section.settings.mascot_size | default: 340 }}px;
  "
>
  <!-- Background Radiant Center Glow -->
  <div class="royal-mascot-bg-glow" aria-hidden="true"></div>

  <!-- FULL-SECTION Fairy Dust Sparkle Particle Canvas -->
  {% if section.settings.enable_sparkles %}
    <canvas id="royal-mascot-sparkles-{{ section.id }}" class="royal-mascot-sparkles-canvas"></canvas>
  {% endif %}

  <!-- FULL-SECTION Cyan / Electric Blue Butterfly Cursor -->
  {% if section.settings.enable_butterfly %}
    <div
      id="royal-mascot-butterfly-{{ section.id }}"
      class="royal-mascot-butterfly"
      aria-hidden="true"
      style="--bf-cyan: {{ section.settings.butterfly_color | default: '#00E5FF' }};"
    >
      <div class="royal-bf-wings">
        <!-- Left Wing -->
        <div class="royal-bf-wing royal-bf-wing-left">
          <svg viewBox="0 0 64 74" width="56" height="66">
            <defs>
              <linearGradient id="rmBfWingL-{{ section.id }}" x1="100%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#091b35" />
                <stop offset="28%" stop-color="#0d47a1" />
                <stop offset="60%" stop-color="#0288d1" />
                <stop offset="88%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 60 52 C 50 36, 24 16, 6 2 C -2 -4, -2 8, 5 22 C 10 32, 28 46, 60 56 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 60 52 C 44 48, 18 42, 10 32 C 2 20, -2 32, 6 44 C 14 56, 32 64, 60 54 Z"
                  fill="url(#rmBfWingL-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 58 50 Q 34 32 14 14 M 50 48 Q 28 34 16 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="8" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="16" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- Center Body -->
        <div class="royal-bf-body">
          <div class="royal-bf-antennae"></div>
          <div class="royal-bf-thorax"></div>
          <div class="royal-bf-abdomen"></div>
        </div>

        <!-- Right Wing -->
        <div class="royal-bf-wing royal-bf-wing-right">
          <svg viewBox="0 0 64 74" width="56" height="66">
            <defs>
              <linearGradient id="rmBfWingR-{{ section.id }}" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#091b35" />
                <stop offset="28%" stop-color="#0d47a1" />
                <stop offset="60%" stop-color="#0288d1" />
                <stop offset="88%" stop-color="{{ section.settings.butterfly_color | default: '#00E5FF' }}" />
                <stop offset="100%" stop-color="#ffffff" />
              </linearGradient>
            </defs>
            <path d="M 4 52 C 14 36, 40 16, 58 2 C 66 -4, 66 8, 59 22 C 54 32, 36 46, 4 56 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 4 52 C 20 48, 46 42, 54 32 C 62 20, 66 32, 58 44 C 50 56, 32 64, 4 54 Z"
                  fill="url(#rmBfWingR-{{ section.id }})" opacity="0.9" stroke="#00E5FF" stroke-width="0.8"/>
            <path d="M 6 50 Q 30 32 50 14 M 14 48 Q 36 34 48 26" fill="none" stroke="rgba(255,255,255,0.75)" stroke-width="0.75"/>
            <circle cx="56" cy="18" r="1.3" fill="#ffffff" />
            <circle cx="48" cy="32" r="1.2" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Central 3D Mascot Stage -->
  <div id="royal-mascot-stage-{{ section.id }}" class="royal-mascot-stage">

    <!-- Loading Spinner -->
    <div id="royal-mascot-spinner-{{ section.id }}" class="royal-mascot-spinner" aria-live="polite">
      <div class="royal-mascot-spinner-ring"></div>
      <span class="royal-mascot-spinner-text">Awakening 3D Royal Mascot...</span>
    </div>

    <!-- WebGL Canvas for 3D Mascot Character -->
    <canvas id="royal-mascot-canvas-{{ section.id }}" class="royal-mascot-canvas"></canvas>

    <!-- Interactive Hint Pill Matching Reference Image -->
    {% if section.settings.show_hint %}
      <div class="royal-mascot-hint">
        <span class="royal-mascot-hint-icon">✦</span>
        <span class="royal-mascot-hint-text">{{ section.settings.hint_text | default: 'Interactive 3D Mascot • Move mouse in circles or drag to rotate' }}</span>
      </div>
    {% endif %}

  </div>
</div>

<style>
  /* ==========================================================================
     ROYAL MASCOT SECTION STYLING (Scoped & Responsive)
     ========================================================================== */
  #royal-mascot-section-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 580px;
    background-color: var(--mascot-bg, #E5A625);
    background: radial-gradient(ellipse at 50% 50%, #f4c45a 0%, #e2a022 55%, #c98818 100%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    padding: 20px 20px 36px 20px;
  }

  /* Subtle Warm Center Glow */
  #royal-mascot-section-{{ section.id }} .royal-mascot-bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 48%, rgba(255, 235, 175, 0.45) 0%, transparent 65%);
    z-index: 1;
  }

  /* FULL-SECTION Fairy Dust Canvas (Covers Entire Section Width & Height) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
    z-index: 15;
  }

  /* FULL-SECTION Cyan / Electric Blue Butterfly (Flies Across Entire Section) */
  #royal-mascot-section-{{ section.id }} .royal-mascot-butterfly {
    position: absolute;
    top: 0;
    left: 0;
    width: 86px;
    height: 72px;
    pointer-events: none !important;
    z-index: 20;
    will-change: transform;
    filter: drop-shadow(0 4px 18px rgba(0, 229, 255, 0.90));
    transition: opacity 0.3s ease;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wings {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 480px;
    width: 100%;
    height: 100%;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing {
    width: 42px;
    height: 50px;
    display: block;
    transform-style: preserve-3d;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing-left {
    transform-origin: 100% 50%;
    animation: rmBfFlapLeft 0.12s ease-in-out infinite alternate;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-wing-right {
    transform-origin: 0% 50%;
    animation: rmBfFlapRight 0.12s ease-in-out infinite alternate;
  }

  @keyframes rmBfFlapLeft {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(76deg) scaleX(0.40); }
  }

  @keyframes rmBfFlapRight {
    0% { transform: rotateY(0deg) scaleX(1); }
    100% { transform: rotateY(-76deg) scaleX(0.40); }
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-body {
    position: relative;
    width: 4.5px;
    height: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-antennae {
    position: absolute;
    top: -5px;
    width: 12px;
    height: 6px;
    border-top: 1.8px solid #00E5FF;
    border-radius: 8px 8px 0 0;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-thorax {
    width: 4.5px;
    height: 8px;
    background: #091b35;
    border-radius: 3px 3px 2px 2px;
    border: 0.6px solid #00E5FF;
  }

  #royal-mascot-section-{{ section.id }} .royal-bf-abdomen {
    width: 3.5px;
    height: 18px;
    background: linear-gradient(to bottom, #091b35, #0288d1);
    border-radius: 1px 1px 3px 3px;
  }

  /* Stage Container */
  #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
    position: relative;
    width: 100%;
    max-width: 680px;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  /* WebGL Canvas */
  #royal-mascot-section-{{ section.id }} .royal-mascot-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    outline: none;
    cursor: grab;
    z-index: 4;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-canvas:active {
    cursor: grabbing;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-canvas.active {
    opacity: 1;
  }

  /* Loading Spinner */
  #royal-mascot-section-{{ section.id }} .royal-mascot-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    z-index: 12;
    background: transparent;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-spinner-ring {
    width: 44px;
    height: 44px;
    border: 3.5px solid rgba(42, 21, 8, 0.15);
    border-top-color: #241105;
    border-radius: 50%;
    animation: rmSpin 0.85s linear infinite;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-spinner-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #241105;
    letter-spacing: 0.04em;
  }

  @keyframes rmSpin {
    to { transform: rotate(360deg); }
  }

  /* Hint Pill Matching Reference */
  #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
    position: absolute;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 235, 192, 0.76);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.68);
    padding: 7px 18px;
    border-radius: 22px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #241105;
    box-shadow: 0 4px 16px rgba(40, 20, 5, 0.08);
    pointer-events: none;
    z-index: 10;
  }

  #royal-mascot-section-{{ section.id }} .royal-mascot-hint-icon {
    font-size: 0.95rem;
    color: #241105;
  }

  @media (max-width: 600px) {
    #royal-mascot-section-{{ section.id }} {
      min-height: 480px;
      padding: 16px 8px;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-stage {
      height: 450px;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-hint {
      font-size: 0.74rem;
      padding: 6px 14px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    #royal-mascot-section-{{ section.id }} .royal-bf-wing {
      animation: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-butterfly {
      display: none !important;
    }
    #royal-mascot-section-{{ section.id }} .royal-mascot-sparkles-canvas {
      display: none !important;
    }
  }
</style>

<script>
(function() {
  "use strict";

  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("royal-mascot-section-" + sectionId);
  var stageEl = document.getElementById("royal-mascot-stage-" + sectionId);
  var canvasEl = document.getElementById("royal-mascot-canvas-" + sectionId);
  var spinnerEl = document.getElementById("royal-mascot-spinner-" + sectionId);
  var butterflyEl = document.getElementById("royal-mascot-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("royal-mascot-sparkles-" + sectionId);

  if (!sectionEl || !canvasEl || !stageEl) return;

  var config = {
    modelUrl: "{{ 'royal-cartoon-mascot.glb' | asset_url }}",
    sensitivity: {{ section.settings.sensitivity | default: 28 }},
    enableButterfly: {% if section.settings.enable_butterfly %}true{% else %}false{% endif %},
    enableSparkles: {% if section.settings.enable_sparkles %}true{% else %}false{% endif %}
  };

  // ==========================================================================
  // 1. THREE.JS 3D MASCOT MANAGER (CIRCULAR MOVEMENT & 360° INTERACTIVE SPIN)
  // ==========================================================================
  var ThreeMascotManager = {
    scene: null,
    camera: null,
    renderer: null,
    characterGroup: null,
    gltfLoader: null,
    isReady: false,

    bones: {
      head: null,
      neck: null,
      chest: null,
      spine: null,
      root: null,
      eyeLeft: null,
      eyeRight: null
    },

    gogglesMeshes: [],

    // Circular movement & gaze angles
    targetRotY: 0,
    targetRotX: 0,
    targetRoll: 0,
    currentRotY: 0,
    currentRotX: 0,
    currentRoll: 0,

    // 360 Drag Orbit variables
    orbitAngleY: 0,
    isDragging: false,
    prevMouseX: 0,
    dragVelocity: 0,

    init: function() {
      if (typeof THREE === "undefined" || typeof THREE.GLTFLoader === "undefined") {
        setTimeout(ThreeMascotManager.init, 120);
        return;
      }

      try {
        var w = stageEl.clientWidth || 640;
        var h = stageEl.clientHeight || 520;

        // Scene
        this.scene = new THREE.Scene();

        // Camera directly viewing the FRONT of the character
        this.camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
        this.camera.position.set(0, 1.15, 3.25);
        this.camera.lookAt(0, 0.95, 0);

        // WebGL Renderer with High-Fidelity Color & Tone Mapping
        this.renderer = new THREE.WebGLRenderer({
          canvas: canvasEl,
          alpha: true,
          antialias: true,
          powerPreference: "high-performance"
        });
        this.renderer.setSize(w, h);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.renderer.outputEncoding = THREE.sRGBEncoding;
        this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
        this.renderer.toneMappingExposure = 1.25;

        // Studio 3-Point Lighting
        var ambientLight = new THREE.AmbientLight(0xFFF5E4, 1.55);
        this.scene.add(ambientLight);

        var keyLight = new THREE.DirectionalLight(0xFFFFFF, 1.85);
        keyLight.position.set(3.2, 4.2, 3.8);
        this.scene.add(keyLight);

        var fillLight = new THREE.DirectionalLight(0xD6EAFF, 1.15);
        fillLight.position.set(-3.2, 2.4, 2.8);
        this.scene.add(fillLight);

        var rimLight = new THREE.DirectionalLight(0xFFD54F, 1.65);
        rimLight.position.set(0, 3.2, -3.2);
        this.scene.add(rimLight);

        // Soft Radial Ground Contact Shadow
        var shadowGeo = new THREE.PlaneGeometry(1.6, 1.0);
        var shadowCanvas = document.createElement("canvas");
        shadowCanvas.width = 128;
        shadowCanvas.height = 128;
        var sCtx = shadowCanvas.getContext("2d");
        var sGrad = sCtx.createRadialGradient(64, 64, 0, 64, 64, 64);
        sGrad.addColorStop(0, "rgba(40, 20, 5, 0.52)");
        sGrad.addColorStop(0.5, "rgba(40, 20, 5, 0.20)");
        sGrad.addColorStop(1, "rgba(40, 20, 5, 0.0)");
        sCtx.fillStyle = sGrad;
        sCtx.fillRect(0, 0, 128, 128);

        var shadowTex = new THREE.CanvasTexture(shadowCanvas);
        var shadowMat = new THREE.MeshBasicMaterial({
          map: shadowTex,
          transparent: true,
          opacity: 0.75,
          depthWrite: false
        });
        var shadowPlane = new THREE.Mesh(shadowGeo, shadowMat);
        shadowPlane.rotation.x = -Math.PI / 2;
        shadowPlane.position.set(0, 0.02, 0);
        this.scene.add(shadowPlane);
        this.shadowMesh = shadowPlane;

        // Character Group
        this.characterGroup = new THREE.Group();
        this.scene.add(this.characterGroup);

        // Load 100% FRONT-FACING 3D GLB Model
        this.gltfLoader = new THREE.GLTFLoader();
        this.loadModel(config.modelUrl);

        // Setup Circular Gaze & 360 Drag Controls
        this.setupEventListeners();
        requestAnimationFrame(this.renderLoop.bind(this));

      } catch (err) {
        console.error("3D Mascot WebGL initialization error:", err);
      }
    },

    loadModel: function(url) {
      if (!this.gltfLoader) return;
      var self = this;
      this.gltfLoader.load(url, function(gltf) {
        while (self.characterGroup.children.length > 0) {
          self.characterGroup.remove(self.characterGroup.children[0]);
        }

        var model = gltf.scene;
        model.position.set(0, 0, 0);
        model.rotation.set(0, 0, 0); // 100% Front-Facing View
        self.characterGroup.add(model);

        self.bones = {
          head: null, neck: null, chest: null, spine: null, root: null,
          eyeLeft: null, eyeRight: null
        };
        self.gogglesMeshes = [];

        model.traverse(function(node) {
          if (node.isBone || node.type === "Bone") {
            var name = (node.name || "").toLowerCase();
            if (name.indexOf("head") !== -1 && !self.bones.head) self.bones.head = node;
            else if (name.indexOf("neck") !== -1 && !self.bones.neck) self.bones.neck = node;
            else if (name.indexOf("chest") !== -1 && !self.bones.chest) self.bones.chest = node;
            else if (name.indexOf("spine") !== -1 && !self.bones.spine) self.bones.spine = node;
            else if (name.indexOf("root") !== -1 && !self.bones.root) self.bones.root = node;
            else if ((name.indexOf("eye.l") !== -1 || name === "eye_l" || name === "eyel") && !self.bones.eyeLeft) self.bones.eyeLeft = node;
            else if ((name.indexOf("eye.r") !== -1 || name === "eye_r" || name === "eyer") && !self.bones.eyeRight) self.bones.eyeRight = node;
          }
          if (node.isMesh) {
            node.castShadow = true;
            node.receiveShadow = true;

            // Collect goggles meshes for dedicated 3D parallax depth
            if (node.name && node.name.indexOf("Goggles_") !== -1) {
              self.gogglesMeshes.push(node);
            }

            // Material tuning
            if (node.material) {
              node.material.side = THREE.DoubleSide;
              if (node.name.indexOf("Lens") !== -1) {
                node.material.transparent = true;
                node.material.opacity = 0.42;
                node.material.roughness = 0.05;
              }
              if (node.name.indexOf("Rim") !== -1 || node.name.indexOf("Bridge") !== -1 || node.name.indexOf("Temple") !== -1) {
                node.material.metalness = 0.95;
                node.material.roughness = 0.16;
              }
            }
          }
        });

        // Hide spinner & fade in WebGL canvas
        if (spinnerEl) spinnerEl.style.display = "none";
        canvasEl.classList.add("active");
        self.isReady = true;

      }, undefined, function(err) {
        console.warn("Could not load 3D mascot from " + url, err);
        if (spinnerEl) spinnerEl.style.display = "none";
      });
    },

    setupEventListeners: function() {
      var self = this;

      // 1. CIRCULAR GAZE TRACKING (Movement Like Circle)
      function updatePointer(clientX, clientY) {
        if (!stageEl) return;
        var rect = stageEl.getBoundingClientRect();
        var centerX = rect.left + rect.width / 2;
        var centerY = rect.top + rect.height * 0.44;

        var deltaX = (clientX - centerX) / (window.innerWidth * 0.44);
        var deltaY = (clientY - centerY) / (window.innerHeight * 0.44);

        // Circular polar coordinate calculation for smooth 360° circular tracking
        var angle = Math.atan2(deltaY, deltaX);
        var dist = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        var r = Math.min(1.25, dist);

        var sens = config.sensitivity || 28;
        var maxPitch = 20;

        // Horizontal: Cursor Left -> Look Left, Cursor Right -> Look Right
        // Vertical: Cursor UP (deltaY < 0) -> targetRotX is negative -> Head Tilts UP
        //           Cursor DOWN (deltaY > 0) -> targetRotX is positive -> Head Tilts DOWN
        self.targetRotY = Math.cos(angle) * (r * sens);
        self.targetRotX = Math.sin(angle) * (r * maxPitch);
        self.targetRoll = Math.cos(angle) * (r * 5.8);
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }

      window.addEventListener("mousemove", function(e) {
        if (self.isDragging) {
          var delta = e.clientX - self.prevMouseX;
          self.orbitAngleY += delta * 0.018;
          self.dragVelocity = delta * 0.018;
          self.prevMouseX = e.clientX;
        } else {
          updatePointer(e.clientX, e.clientY);
        }
      }, { passive: true });

      // 2. INTERACTIVE 360° CIRCULAR DRAG CONTROLS
      canvasEl.addEventListener("mousedown", function(e) {
        self.isDragging = true;
        self.prevMouseX = e.clientX;
        self.dragVelocity = 0;
      });

      window.addEventListener("mouseup", function() {
        self.isDragging = false;
      });

      // Mobile Touch Support for Circular Gaze & Drag
      canvasEl.addEventListener("touchstart", function(e) {
        if (e.touches.length === 1) {
          self.isDragging = true;
          self.prevMouseX = e.touches[0].clientX;
          self.dragVelocity = 0;
        }
      }, { passive: true });

      window.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        var touch = e.touches[0];
        if (self.isDragging) {
          var delta = touch.clientX - self.prevMouseX;
          self.orbitAngleY += delta * 0.018;
          self.dragVelocity = delta * 0.018;
          self.prevMouseX = touch.clientX;
        }
        updatePointer(touch.clientX, touch.clientY);
      }, { passive: true });

      window.addEventListener("touchend", function() {
        self.isDragging = false;
      });

      document.addEventListener("mouseleave", function() {
        self.targetRotY = 0;
        self.targetRotX = 0;
        self.targetRoll = 0;
        self.isDragging = false;
      });

      // Window Resize
      window.addEventListener("resize", function() {
        if (!self.renderer || !self.camera || !stageEl) return;
        var rw = stageEl.clientWidth || 640;
        var rh = stageEl.clientHeight || 520;
        self.camera.aspect = rw / rh;
        self.camera.updateProjectionMatrix();
        self.renderer.setSize(rw, rh);
      });
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));

      // Damping inertia for circular drag spin
      if (!this.isDragging && Math.abs(this.dragVelocity) > 0.0002) {
        this.orbitAngleY += this.dragVelocity;
        this.dragVelocity *= 0.92;
      }

      var sens = config.sensitivity || 28;

      // When mouse is idle, mascot smoothly tracks the flying butterfly in circular flight
      if (!this.isHovering || (time - this.lastMoveTime > 3200)) {
        if (typeof ButterflyFollower !== "undefined" && ButterflyFollower.posX) {
          var bRect = stageEl.getBoundingClientRect();
          var sCenterX = bRect.left + bRect.width / 2;
          var sCenterY = bRect.top + bRect.height * 0.44;
          var secRect = sectionEl.getBoundingClientRect();

          var bClientX = secRect.left + ButterflyFollower.posX;
          var bClientY = secRect.top + ButterflyFollower.posY;

          var bdx = (bClientX - sCenterX) / (window.innerWidth * 0.44);
          var bdy = (bClientY - sCenterY) / (window.innerHeight * 0.44);

          var bAngle = Math.atan2(bdy, bdx);
          var bDist = Math.sqrt(bdx * bdx + bdy * bdy);
          var br = Math.min(1.0, bDist);

          this.targetRotY = Math.cos(bAngle) * (br * sens);
          this.targetRotX = Math.sin(bAngle) * (br * 18);
          this.targetRoll = Math.cos(bAngle) * (br * 4.5);
        }
      }

      // Smooth Spring-Mass Damping (matches bottom section factor: 0.082)
      this.currentRotY += (this.targetRotY - this.currentRotY) * 0.082;
      this.currentRotX += (this.targetRotX - this.currentRotX) * 0.082;
      this.currentRoll += (this.targetRoll - this.currentRoll) * 0.082;

      if (this.isReady && this.characterGroup) {
        // 1. Organic Idle Breathing Wave
        var breathWave = Math.sin(time * 0.0022);

        // 2. Full 360° Circular Orbit + Dynamic Body Leaning Action
        var leanRatio = this.currentRotY / sens;
        this.characterGroup.position.x = leanRatio * 0.07;
        this.characterGroup.position.y = breathWave * 0.016;
        // Group combines 360 circular orbit with subtle lean
        this.characterGroup.rotation.y = this.orbitAngleY + (leanRatio * 0.10);

        // Ground shadow reacts dynamically in 3D
        if (this.shadowMesh) {
          this.shadowMesh.position.x = leanRatio * 0.08;
          this.shadowMesh.scale.x = 1.0 - Math.abs(this.currentRotX / 20) * 0.05;
        }

        // 3. 3D Head & Neck in Circular Gaze (Movement Like Circle)
        var radYaw = (this.currentRotY * Math.PI) / 180;
        var radPitch = (this.currentRotX * Math.PI) / 180;
        var radRoll = (this.currentRoll * Math.PI) / 180;

        if (this.bones.head) {
          this.bones.head.rotation.y = radYaw * 0.85;
          this.bones.head.rotation.x = radPitch * 0.90;
          this.bones.head.rotation.z = radRoll;
        }
        if (this.bones.neck) {
          this.bones.neck.rotation.y = radYaw * 0.44;
          this.bones.neck.rotation.x = radPitch * 0.38;
        }
        if (this.bones.chest) {
          this.bones.chest.rotation.y = radYaw * 0.14;
          this.bones.chest.rotation.x = radPitch * 0.12;
        }

        // 4. "Gogal Moment": 3D Goggles Physical Depth & Parallax
        if (this.gogglesMeshes.length > 0) {
          var goggleExtraYaw = radYaw * 0.06;
          var goggleExtraPitch = radPitch * 0.05;
          for (var gi = 0; gi < this.gogglesMeshes.length; gi++) {
            var gm = this.gogglesMeshes[gi];
            gm.rotation.y = goggleExtraYaw;
            gm.rotation.x = goggleExtraPitch;
          }
        }

        // 5. Expressive Eyes Circular Darting Behind Goggles
        var eyeYaw = radYaw * 1.35;
        var eyePitch = radPitch * 1.40;

        var blinkCycle = (time % 3600) / 3600;
        var blinkScale = 1.0;
        if (blinkCycle > 0.955) {
          var bt = (blinkCycle - 0.955) / 0.045;
          blinkScale = 1.0 - Math.sin(bt * Math.PI) * 0.92;
        }

        if (this.bones.eyeLeft) {
          this.bones.eyeLeft.rotation.y = eyeYaw;
          this.bones.eyeLeft.rotation.x = eyePitch;
          this.bones.eyeLeft.scale.z = blinkScale;
        }
        if (this.bones.eyeRight) {
          this.bones.eyeRight.rotation.y = eyeYaw;
          this.bones.eyeRight.rotation.x = eyePitch;
          this.bones.eyeRight.scale.z = blinkScale;
        }

        this.renderer.render(this.scene, this.camera);
      }
    }
  };

  // ==========================================================================
  // 2. FULL-SECTION CYAN BUTTERFLY & SPARKLE TRAIL
  // Spanning 100% width and height of the entire section across the screen
  // ==========================================================================
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !config.enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !sectionEl) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 580;
      this.canvas.width = w * dpr;
      this.canvas.height = h * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    addParticle: function(x, y) {
      if (this.particles.length > 60) return;
      var hues = ["#00E5FF", "#80D8FF", "#00B0FF", "#FFE082", "#FFFFFF"];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 8,
        vx: (Math.random() - 0.5) * 0.9,
        vy: Math.random() * 0.8 + 0.3,
        size: Math.random() * 2.8 + 1.0,
        alpha: 1.0,
        decay: Math.random() * 0.022 + 0.015,
        color: hues[Math.floor(Math.random() * hues.length)]
      });
    },

    updateAndRender: function() {
      if (!this.ctx || !sectionEl) return;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 580;
      this.ctx.clearRect(0, 0, w, h);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        this.ctx.save();
        this.ctx.globalAlpha = Math.max(0, p.alpha);
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();
      }
    }
  };

  var ButterflyFollower = {
    el: butterflyEl,
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    angle: 0,
    isHovering: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (!this.el || !config.enableButterfly) return;

      var self = this;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 580;
      this.posX = w * 0.72;
      this.posY = h * 0.35;
      this.targetX = this.posX;
      this.targetY = this.posY;

      function updateTargetFromEvent(clientX, clientY) {
        if (!sectionEl) return;
        var secRect = sectionEl.getBoundingClientRect();
        // Calculate position relative to the FULL section container
        self.targetX = clientX - secRect.left + 24;
        self.targetY = clientY - secRect.top - 20;
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }

      // Track cursor anywhere on section or window
      sectionEl.addEventListener("mousemove", function(e) {
        updateTargetFromEvent(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 60 && e.clientY <= r.bottom + 60) {
          updateTargetFromEvent(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updateTargetFromEvent(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      requestAnimationFrame(this.renderLoop.bind(this));
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 580;

      // When mouse is idle for > 3.2 seconds, autonomous CIRCULAR flight patrol around mascot
      if (!this.isHovering || (time - this.lastMoveTime > 3200)) {
        var t = time * 0.0013;
        var patrolCenterX = secW * 0.5;
        var patrolCenterY = secH * 0.40;
        // Circular orbit across full section
        this.targetX = patrolCenterX + Math.cos(t) * (secW * 0.36);
        this.targetY = patrolCenterY + Math.sin(t * 2) * (secH * 0.22);
      }

      // Smooth trailing physics
      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      this.posX += dx * 0.082;
      this.posY += dy * 0.082;

      // Natural hovering bob
      var hoverX = Math.sin(time * 0.0036) * 8;
      var hoverY = Math.cos(time * 0.0044) * 6;

      // Banking angle towards flight vector
      var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
      var diff = (targetAngle - this.angle + 540) % 360 - 180;
      this.angle += diff * 0.12;

      var fx = this.posX + hoverX;
      var fy = this.posY + hoverY;

      // Restrain within FULL SECTION bounds (Entire Screen Width & Height)
      fx = Math.max(30, Math.min(secW - 75, fx));
      fy = Math.max(25, Math.min(secH - 75, fy));

      this.el.style.transform =
        "translate3d(" + (fx - 40).toFixed(1) + "px, " + (fy - 32).toFixed(1) + "px, 0px) " +
        "rotate(" + this.angle.toFixed(1) + "deg)";

      // Sparkle emission across full section flight path
      if (config.enableSparkles && Math.random() < 0.65) {
        SparkleTrail.addParticle(fx, fy);
      }

      SparkleTrail.updateAndRender();
    }
  };

  function boot() {
    ThreeMascotManager.init();
    SparkleTrail.init();
    ButterflyFollower.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      boot();
    }
  });

})();
</script>

