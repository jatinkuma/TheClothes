      }
    },
    chipmunkAssets: {
      body: "{{ 'chipmunk-body-tex.png' | asset_url }}",
      head: "{{ 'chipmunk-head-tex.png' | asset_url }}",
      full: "{{ 'chipmunk-clean-master.png' | asset_url }}",
      outfits: {
        cream: "{{ 'chipmunk-body-tex.png' | asset_url }}",
        blue: "{{ 'royal-owl-achkan.png' | asset_url }}",
