</style>

<script>
(function() {
  "use strict";

  var sectionId = "{{ section.id }}";
  var sectionEl = document.getElementById("royal-mascot-section-" + sectionId);
  var stageEl = document.getElementById("royal-mascot-stage-" + sectionId);
  var canvasEl = document.getElementById("royal-mascot-canvas-" + sectionId);
  var spinnerEl = document.getElementById("royal-mascot-spinner-" + sectionId);
  var butterflyEl = document.getElementById("royal-mascot-butterfly-" + sectionId);
  var sparklesCanvas = document.getElementById("royal-mascot-sparkles-" + sectionId);
  var badgeNameEl = document.getElementById("royal-active-name-" + sectionId);
  var cardTitleEl = document.getElementById("royal-card-title-" + sectionId);
  var cardDescEl = document.getElementById("royal-card-desc-" + sectionId);
  var cardPriceEl = document.getElementById("royal-card-price-" + sectionId);

  if (!sectionEl || !stageEl || !canvasEl) return;

  var config = {
    sensitivity: {{ section.settings.sensitivity | default: 28 }},
    enableButterfly: {% if section.settings.enable_butterfly %}true{% else %}false{% endif %},
    enableSparkles: {% if section.settings.enable_sparkles %}true{% else %}false{% endif %},
    outfitUrls: {
      cream: {
        head: "{{ 'doll-cream-head.png' | asset_url }}",
        body: "{{ 'doll-cream-body.png' | asset_url }}"
      },
      blue: {
        head: "{{ 'doll-blue-head.png' | asset_url }}",
        body: "{{ 'doll-blue-body.png' | asset_url }}"
      },
      green: {
        head: "{{ 'doll-green-head.png' | asset_url }}",
        body: "{{ 'doll-green-body.png' | asset_url }}"
      },
      red: {
        head: "{{ 'doll-red-head.png' | asset_url }}",
        body: "{{ 'doll-red-body.png' | asset_url }}"
      }
    }
  };

  // ==========================================================================
  // 1. THREE.JS 3D AVATAR MANAGER (NATURAL BODY MOVEMENT & CIRCULAR GAZE)
  // No 360° spin: authentic human biomechanics, head & torso tracking, weight shift
  // ==========================================================================
  var ThreeAvatarManager = {
    scene: null,
    camera: null,
    renderer: null,
    characterGroup: null,
    bodyMesh: null,
    headGroup: null,
    headMesh: null,
    shadowMesh: null,
    textureLoader: null,
    loadedTextures: {},
    isReady: false,

    // Smooth Biomechanical Angles
    headYaw: 0,
    headPitch: 0,
    headRoll: 0,
    targetHeadYaw: 0,
    targetHeadPitch: 0,
    targetHeadRoll: 0,

    torsoYaw: 0,
    torsoPitch: 0,
    torsoLean: 0,
    targetTorsoYaw: 0,
    targetTorsoPitch: 0,
    targetTorsoLean: 0,

    leanX: 0,
    targetLeanX: 0,

    isCursorActive: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (typeof THREE === "undefined") {
        setTimeout(ThreeAvatarManager.init, 120);
        return;
      }

      try {
        var w = stageEl.clientWidth || 580;
        var h = canvasEl.clientHeight || 480;

        // Scene
        this.scene = new THREE.Scene();

        // Perspective Camera directly viewing the FRONT of the character
        this.camera = new THREE.PerspectiveCamera(38, w / h, 0.1, 100);
        this.camera.position.set(0, 1.15, 3.25);
        this.camera.lookAt(0, 0.95, 0);

        // WebGL Renderer with High-Fidelity Color & Tone Mapping
        this.renderer = new THREE.WebGLRenderer({
          canvas: canvasEl,
          alpha: true,
          antialias: true,
          powerPreference: "high-performance"
        });
        this.renderer.setSize(w, h);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        this.renderer.outputEncoding = THREE.sRGBEncoding;
        this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
        this.renderer.toneMappingExposure = 1.25;

        // Ground Contact Shadow Mesh (Reacts smoothly to character lean & posture)
        var shadowGeo = new THREE.PlaneGeometry(1.65, 0.45);
        var shadowCanvas = document.createElement("canvas");
        shadowCanvas.width = 256;
        shadowCanvas.height = 128;
        var sctx = shadowCanvas.getContext("2d");
        var grad = sctx.createRadialGradient(128, 64, 0, 128, 64, 110);
        grad.addColorStop(0, "rgba(35, 18, 5, 0.50)");
        grad.addColorStop(0.45, "rgba(35, 18, 5, 0.16)");
        grad.addColorStop(1, "rgba(35, 18, 5, 0)");
        sctx.fillStyle = grad;
        sctx.fillRect(0, 0, 256, 128);

        var shadowTex = new THREE.CanvasTexture(shadowCanvas);
        var shadowMat = new THREE.MeshBasicMaterial({
          map: shadowTex,
          transparent: true,
          opacity: 0.85,
          depthWrite: false
        });
        var shadowPlane = new THREE.Mesh(shadowGeo, shadowMat);
        shadowPlane.rotation.x = -Math.PI / 2;
        shadowPlane.position.set(0, 0.02, 0);
        this.scene.add(shadowPlane);
        this.shadowMesh = shadowPlane;

        // Character Group (Anchored naturally on floor)
        this.characterGroup = new THREE.Group();
        this.scene.add(this.characterGroup);

        // Build 3D Articulated Avatar Hierarchy
        this.textureLoader = new THREE.TextureLoader();
        this.buildAvatarRig("cream");

        // Setup Event Listeners & Animation Loop
        this.setupEventListeners();
        requestAnimationFrame(this.renderLoop.bind(this));

        // Hide spinner once loaded
        if (spinnerEl) spinnerEl.classList.add("loaded");
        this.isReady = true;

      } catch (err) {
        console.error("Three.js Avatar initialization error:", err);
      }
    },

    loadTexture: function(url, callback) {
      if (this.loadedTextures[url]) {
        if (callback) callback(this.loadedTextures[url]);
        return this.loadedTextures[url];
      }
      var self = this;
      var tex = this.textureLoader.load(url, function(loaded) {
        loaded.generateMipmaps = true;
        loaded.minFilter = THREE.LinearMipmapLinearFilter;
        loaded.magFilter = THREE.LinearFilter;
        loaded.encoding = THREE.sRGBEncoding;
        if (callback) callback(loaded);
      });
      tex.encoding = THREE.sRGBEncoding;
      this.loadedTextures[url] = tex;
      return tex;
    },

    buildAvatarRig: function(outfitKey) {
      var urls = config.outfitUrls[outfitKey] || config.outfitUrls.cream;

      var charHeight = 2.10;
      var charWidth = charHeight * (848.0 / 1264.0); // ~1.409
      var neckPivotY = charHeight * (1.0 - (446.0 / 1264.0)); // ~1.359

      // 1. Torso & Body Mesh (Feet, Sherwani, Neck Base)
      var bodyGeo = new THREE.PlaneGeometry(charWidth, charHeight, 16, 24);
      var bodyTex = this.loadTexture(urls.body);
      var bodyMat = new THREE.MeshBasicMaterial({
        map: bodyTex,
        transparent: true,
        alphaTest: 0.005,
        depthWrite: false,
        side: THREE.DoubleSide
      });
      this.bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
      this.bodyMesh.position.set(0, charHeight * 0.5, 0);
      this.bodyMesh.renderOrder = 2;
      this.characterGroup.add(this.bodyMesh);

      // 2. Head Group & Mesh (Turban, Plume, Kalgi Brooch, Face, Gaze Eyes)
      this.headGroup = new THREE.Group();
      this.headGroup.position.set(0, neckPivotY, 0.025); // Sub-millimeter neck pivot with true 3D parallax depth
      this.characterGroup.add(this.headGroup);

      var headGeo = new THREE.PlaneGeometry(charWidth, charHeight, 16, 24);
      var headTex = this.loadTexture(urls.head);
      var headMat = new THREE.MeshBasicMaterial({
        map: headTex,
        transparent: true,
        alphaTest: 0.005,
        depthWrite: false,
        side: THREE.DoubleSide
      });
      this.headMesh = new THREE.Mesh(headGeo, headMat);
      // Offset so the head graphic sits exactly on top of the neck joint
      this.headMesh.position.set(0, (charHeight * 0.5) - neckPivotY, 0);
      this.headMesh.renderOrder = 3;
      this.headGroup.add(this.headMesh);
    },

    equipDress: function(outfitKey, customUrl) {
      var self = this;
      if (customUrl) {
        var tex = this.loadTexture(customUrl, function(t) {
          if (self.bodyMesh) {
            self.bodyMesh.material.map = t;
            self.bodyMesh.material.needsUpdate = true;
          }
          if (self.headMesh) {
            self.headMesh.visible = false;
          }
        });
        return;
      }

      var urls = config.outfitUrls[outfitKey] || config.outfitUrls.cream;

      if (this.headMesh) this.headMesh.visible = true;

      this.loadTexture(urls.body, function(bodyTex) {
        if (self.bodyMesh) {
          self.bodyMesh.material.map = bodyTex;
          self.bodyMesh.material.needsUpdate = true;
        }
      });

      this.loadTexture(urls.head, function(headTex) {
        if (self.headMesh) {
          self.headMesh.material.map = headTex;
          self.headMesh.material.needsUpdate = true;
        }
      });
    },

    setupEventListeners: function() {
      var self = this;

      function updateGaze(clientX, clientY) {
        if (!stageEl) return;
        var rect = stageEl.getBoundingClientRect();
        var midX = rect.left + rect.width / 2;
        var midY = rect.top + rect.height * 0.40;

        // Normalized displacement from character center
        var relX = (clientX - midX) / (window.innerWidth * 0.42);
        var relY = (clientY - midY) / (window.innerHeight * 0.42);

        var clampedX = Math.max(-1.15, Math.min(1.15, relX));
        var clampedY = Math.max(-1.15, Math.min(1.15, relY));

        // 1. Natural Head Gaze (Yaw, Pitch, Roll)
        self.targetHeadYaw = -clampedX * 22;      // Up to ±22° horizontal head turn
        self.targetHeadPitch = -clampedY * 12;    // Up to ±12° vertical head pitch
        self.targetHeadRoll = -clampedX * 3.5;    // Subtle lifelike lateral neck roll

        // 2. Natural Torso Anatomical Follow-Through
        self.targetTorsoYaw = self.targetHeadYaw * 0.35;    // Torso rotates ~35% of head angle
        self.targetTorsoPitch = self.targetHeadPitch * 0.25;
        self.targetTorsoLean = -clampedX * 0.035;          // Subtle shoulder posture lean (radians)

        // 3. Weight-Shift Leaning Displacement
        self.targetLeanX = -clampedX * 0.12;

        self.isCursorActive = true;
        self.lastMoveTime = performance.now();
      }

      sectionEl.addEventListener("mousemove", function(e) {
        updateGaze(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 80 && e.clientY <= r.bottom + 80) {
          updateGaze(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updateGaze(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      sectionEl.addEventListener("mouseleave", function() {
        self.isCursorActive = false;
      });

      window.addEventListener("resize", function() {
        if (!self.renderer || !self.camera || !stageEl) return;
        var w = stageEl.clientWidth || 580;
        var h = canvasEl.clientHeight || 480;
        self.camera.aspect = w / h;
        self.camera.updateProjectionMatrix();
        self.renderer.setSize(w, h);
      });
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));

      // Autonomous circular gaze patrol following the 3D butterfly when cursor is idle
      if ((time - this.lastMoveTime > 3000) && ButterflyFollower.el) {
        var secW = sectionEl.offsetWidth || window.innerWidth;
        var charMidX = secW * 0.5;
        var diffX = (ButterflyFollower.posX - charMidX) / (secW * 0.5);
        var diffY = (ButterflyFollower.posY - (sectionEl.offsetHeight * 0.36)) / (sectionEl.offsetHeight * 0.36);

        var bClampedX = Math.max(-1.0, Math.min(1.0, diffX));
        var bClampedY = Math.max(-1.0, Math.min(1.0, diffY));

        this.targetHeadYaw = -bClampedX * 16;
        this.targetHeadPitch = -bClampedY * 8;
        this.targetHeadRoll = -bClampedX * 2.5;

        this.targetTorsoYaw = this.targetHeadYaw * 0.30;
        this.targetTorsoPitch = this.targetHeadPitch * 0.20;
        this.targetTorsoLean = -bClampedX * 0.025;
        this.targetLeanX = -bClampedX * 0.08;
      }

      // Smooth Organic Spring Lerp (Natural human biomechanics, no stiffness)
      var ease = 0.075;
      this.headYaw += (this.targetHeadYaw - this.headYaw) * ease;
      this.headPitch += (this.targetHeadPitch - this.headPitch) * ease;
      this.headRoll += (this.targetHeadRoll - this.headRoll) * ease;

      this.torsoYaw += (this.targetTorsoYaw - this.torsoYaw) * ease;
      this.torsoPitch += (this.targetTorsoPitch - this.torsoPitch) * ease;
      this.torsoLean += (this.targetTorsoLean - this.torsoLean) * ease;
      this.leanX += (this.targetLeanX - this.leanX) * ease;

      // Gentle organic sinusoidal breathing float
      var breatheY = Math.sin(time * 0.0018) * 0.012;
      var breathePitch = Math.sin(time * 0.0018) * 0.008;

      // 1. Character Group: Grounded Leaning & Weight Shift
      this.characterGroup.position.x = this.leanX;
      this.characterGroup.position.y = breatheY;
      this.characterGroup.rotation.z = this.torsoLean;
      this.characterGroup.rotation.y = 0; // FRONT-FACING ONLY (NO 360 SPIN)

      // 2. Torso / Body: Natural Anatomical Rotation
      var radTorsoYaw = (this.torsoYaw * Math.PI) / 180;
      var radTorsoPitch = (this.torsoPitch * Math.PI) / 180;
      if (this.bodyMesh) {
        this.bodyMesh.rotation.y = radTorsoYaw;
        this.bodyMesh.rotation.x = radTorsoPitch + breathePitch;
      }

      // 3. Head & Neck: True Circular Gaze & Parallax Depth
      var radHeadYaw = (this.headYaw * Math.PI) / 180;
      var radHeadPitch = (this.headPitch * Math.PI) / 180;
      var radHeadRoll = (this.headRoll * Math.PI) / 180;
      if (this.headGroup) {
        this.headGroup.rotation.y = radHeadYaw;
        this.headGroup.rotation.x = radHeadPitch;
        this.headGroup.rotation.z = radHeadRoll;
      }

      // 4. Ground Contact Shadow: Dynamic shift reacting to lean
      if (this.shadowMesh) {
        this.shadowMesh.position.x = this.leanX * 0.70;
        this.shadowMesh.scale.x = 1.0 - Math.abs(this.headPitch / 30) * 0.06;
      }

      // Render WebGL frame
      if (this.renderer && this.scene && this.camera) {
        this.renderer.render(this.scene, this.camera);
      }
    }
  };

  // ==========================================================================
  // 2. DRESS-UP & WARDROBE SYSTEM ("Append the dress we want")
  // ==========================================================================
  var WardrobeManager = {
    swatchBtns: sectionEl.querySelectorAll(".dock-swatch-btn"),

    init: function() {
      var self = this;
      this.swatchBtns.forEach(function(btn) {
        btn.addEventListener("click", function() {
          self.selectOutfit(btn);
        });
      });
    },

    selectOutfit: function(btn) {
      var outfitKey = btn.getAttribute("data-outfit");
      var title = btn.getAttribute("data-title");
      var price = btn.getAttribute("data-price");
      var desc = btn.getAttribute("data-desc");
      var customUrl = btn.getAttribute("data-custom-url");

      // Update active swatch state
      this.swatchBtns.forEach(function(b) { b.classList.remove("active"); });
      btn.classList.add("active");

      // Update badge & info card
      if (badgeNameEl && title) badgeNameEl.textContent = title + " Sherwani";
      if (cardTitleEl && title) cardTitleEl.textContent = title;
      if (cardPriceEl && price) cardPriceEl.textContent = price;
      if (cardDescEl && desc) cardDescEl.textContent = desc;

      // Equip dress in Three.js WebGL
      ThreeAvatarManager.equipDress(outfitKey, customUrl);

      // Magical fairy dust equip sparkle burst around the character
      if (config.enableSparkles && SparkleTrail.ctx) {
        var stageRect = stageEl.getBoundingClientRect();
        var secRect = sectionEl.getBoundingClientRect();
        var cx = (stageRect.left + stageRect.width / 2) - secRect.left;
        var cy = (stageRect.top + stageRect.height * 0.42) - secRect.top;
        for (var i = 0; i < 28; i++) {
          SparkleTrail.addParticle(
            cx + (Math.random() - 0.5) * 160,
            cy + (Math.random() - 0.5) * 220
          );
        }
      }
    }
  };

  // ==========================================================================
  // 3. FULL-SECTION 3D ROYAL BUTTERFLY & SPARKLE TRAIL
  // ==========================================================================
  var SparkleTrail = {
    canvas: sparklesCanvas,
    ctx: null,
    particles: [],

    init: function() {
      if (!this.canvas || !config.enableSparkles) return;
      this.ctx = this.canvas.getContext("2d");
      this.resize();
      window.addEventListener("resize", this.resize.bind(this));
    },

    resize: function() {
      if (!this.canvas || !sectionEl) return;
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 740;
      this.canvas.width = w * dpr;
      this.canvas.height = h * dpr;
      if (this.ctx) this.ctx.scale(dpr, dpr);
    },

    addParticle: function(x, y) {
      if (this.particles.length > 55) return;
      var hues = ['#00e5ff', '#651fff', '#ffd700', '#76ff03', '#80d8ff'];
      this.particles.push({
        x: x + (Math.random() - 0.5) * 8,
        y: y + (Math.random() - 0.5) * 8,
        radius: Math.random() * 2.2 + 0.8,
        alpha: 1.0,
        decay: Math.random() * 0.024 + 0.014,
        vx: (Math.random() - 0.5) * 0.8,
        vy: Math.random() * 0.5 + 0.3,
        color: hues[Math.floor(Math.random() * hues.length)]
      });
    },

    updateAndRender: function() {
      if (!this.ctx || !sectionEl) return;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 740;
      this.ctx.clearRect(0, 0, w, h);

      for (var i = this.particles.length - 1; i >= 0; i--) {
        var p = this.particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          this.particles.splice(i, 1);
          continue;
        }

        this.ctx.save();
        this.ctx.globalAlpha = Math.max(0, p.alpha);
        this.ctx.fillStyle = p.color;
        this.ctx.shadowColor = p.color;
        this.ctx.shadowBlur = 6;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.restore();
      }
    }
  };

  var ButterflyFollower = {
    el: butterflyEl,
    posX: 0,
    posY: 0,
    targetX: 0,
    targetY: 0,
    angle: 0,
    isHovering: false,
    lastMoveTime: performance.now(),

    init: function() {
      if (!this.el || !config.enableButterfly) return;

      var self = this;
      var w = sectionEl.offsetWidth || window.innerWidth;
      var h = sectionEl.offsetHeight || 740;
      this.posX = w * 0.28;
      this.posY = h * 0.36;
      this.targetX = this.posX;
      this.targetY = this.posY;

      function updateTarget(clientX, clientY) {
        if (!sectionEl) return;
        var secRect = sectionEl.getBoundingClientRect();
        self.targetX = clientX - secRect.left;
        self.targetY = clientY - secRect.top;
        self.isHovering = true;
        self.lastMoveTime = performance.now();
      }

      sectionEl.addEventListener("mousemove", function(e) {
        updateTarget(e.clientX, e.clientY);
      }, { passive: true });

      window.addEventListener("mousemove", function(e) {
        if (!sectionEl) return;
        var r = sectionEl.getBoundingClientRect();
        if (e.clientY >= r.top - 80 && e.clientY <= r.bottom + 80) {
          updateTarget(e.clientX, e.clientY);
        }
      }, { passive: true });

      sectionEl.addEventListener("touchmove", function(e) {
        if (!e.touches || e.touches.length === 0) return;
        updateTarget(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });

      sectionEl.addEventListener("mouseleave", function() {
        self.isHovering = false;
      });

      requestAnimationFrame(this.renderLoop.bind(this));
    },

    renderLoop: function(time) {
      requestAnimationFrame(this.renderLoop.bind(this));

      if (!this.el || !config.enableButterfly) return;

      var secW = sectionEl.offsetWidth || window.innerWidth;
      var secH = sectionEl.offsetHeight || 740;

      // Autonomous circular flight patrol around character when idle
      if (!this.isHovering || (time - this.lastMoveTime > 3200)) {
        var t = time * 0.0012;
        var patrolCenterX = secW * 0.5;
        var patrolCenterY = secH * 0.36;
        this.targetX = patrolCenterX + Math.cos(t) * (secW * 0.35);
        this.targetY = patrolCenterY + Math.sin(t * 2) * (secH * 0.20);
      }

      var dx = this.targetX - this.posX;
      var dy = this.targetY - this.posY;
      var dist = Math.sqrt(dx * dx + dy * dy);

      var vx = dx * 0.082;
      var vy = dy * 0.082;
      this.posX += vx;
      this.posY += vy;

      // Natural hovering bob
      var hoverX = Math.sin(time * 0.0035) * 10;
      var hoverY = Math.cos(time * 0.0042) * 8;
      var fx = this.posX + hoverX;
      var fy = this.posY + hoverY;

      // Restrain within full section boundaries
      fx = Math.max(30, Math.min(secW - 70, fx));
      fy = Math.max(30, Math.min(secH - 70, fy));

      if (dist > 2) {
        var targetAngle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        var diff = (targetAngle - this.angle + 540) % 360 - 180;
        this.angle += diff * 0.12;
      }

      var tilt = Math.max(-25, Math.min(25, vx * 1.8));

      if (dist > 40) {
        this.el.classList.add("fast-flap");
        this.el.classList.remove("hover-flap");
      } else {
        this.el.classList.remove("fast-flap");
        this.el.classList.add("hover-flap");
      }

      this.el.style.transform =
        "translate3d(" + (fx - 45).toFixed(1) + "px, " + (fy - 35).toFixed(1) + "px, 0px) " +
        "rotate(" + this.angle.toFixed(1) + "deg) " +
        "rotateY(" + tilt.toFixed(1) + "deg)";

      if (config.enableSparkles && Math.random() < 0.45) {
        SparkleTrail.addParticle(fx, fy);
      }

      SparkleTrail.updateAndRender();
    }
  };

  function boot() {
    ThreeAvatarManager.init();
    WardrobeManager.init();
    SparkleTrail.init();
    ButterflyFollower.init();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

  document.addEventListener("shopify:section:load", function(e) {
    if (e.detail && e.detail.sectionId === sectionId) {
      boot();
    }
  });

})();
</script>

