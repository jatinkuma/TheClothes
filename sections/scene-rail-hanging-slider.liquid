    position: fixed;
    top: 0;
    right: 0;
    width: min(540px, 100vw);
    height: 100vh;
    background: #ffffff;
    color: #1a1815;
    z-index: 1001;
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.25);
    transform: translate3d(105%, 0, 0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }
  .scene-drawer.is-open {
    transform: translate3d(0, 0, 0);
  }

  .scene-drawer-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f4f1ea;
    border: none;
    color: #1a1815;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .scene-drawer-close:hover {
    background: #e6e2d8;
    transform: rotate(90deg);
  }

  .scene-drawer-scrollable {
    flex-grow: 1;
    overflow-y: auto;
    padding: 40px 32px;
  }
  @media (max-width: 480px) {
    .scene-drawer-scrollable { padding: 30px 20px; }
  }

  .scene-drawer-main-image-wrap {
