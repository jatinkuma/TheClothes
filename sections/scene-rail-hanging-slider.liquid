    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .scene-drawer-main-img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    transition: opacity 0.25s ease;
  }

  .scene-drawer-angle-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    justify-content: center;
  }
  .scene-angle-tab {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 14px;
    background: #f4f1ea;
    border: 1px solid #e5dfd3;
    border-radius: 999px;
    color: #555;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .scene-angle-tab.is-active,
  .scene-angle-tab:hover {
    background: var(--sr-accent);
    color: #ffffff;
    border-color: var(--sr-accent);
  }

  .scene-drawer-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sr-accent);
    margin-bottom: 8px;
  }
  .scene-drawer-title {
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 10px 0;
  }
  .scene-drawer-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 16px;
  }
  .scene-drawer-price {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--sr-accent);
  }
  .scene-drawer-compare {
    font-size: 1.05rem;
    text-decoration: line-through;
    opacity: 0.55;
  }
  .scene-drawer-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4a453f;
    margin: 0 0 24px 0;
  }

  .scene-drawer-variants-wrap {
    margin-bottom: 22px;
  }
  .scene-variant-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }
  .scene-variant-select {
    width: 100%;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid #d8d2c4;
    background: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    color: #1a1815;
    outline: none;
    cursor: pointer;
  }
  .scene-variant-select:focus {
    border-color: var(--sr-accent);
  }

  .scene-drawer-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
  }
  .scene-qty-control {
    display: flex;
    align-items: center;
    border: 1px solid #d8d2c4;
    border-radius: 8px;
    background: #ffffff;
  }
  .scene-qty-btn {
    width: 36px;
    height: 48px;
    background: transparent;
    border: none;
    font-size: 1.2rem;
    color: #1a1815;
    cursor: pointer;
  }
  .scene-qty-input {
    width: 44px;
    height: 48px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-weight: 600;
    color: #1a1815;
    -moz-appearance: textfield;
  }
  .scene-qty-input::-webkit-outer-spin-button,
  .scene-qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .scene-btn-add-cart {
    flex-grow: 1;
    height: 48px;
    background: var(--sr-accent);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .scene-btn-add-cart:hover {
    background: #7d5420;
    transform: translateY(-1px);
  }
  .scene-btn-add-cart.is-loading .btn-text { opacity: 0; }
  .scene-btn-add-cart.is-loading .btn-spinner {
    display: block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spinBtn 0.7s linear infinite;
  }
  .btn-spinner { display: none; }
  @keyframes spinBtn { to { transform: rotate(360deg); } }

  .scene-drawer-feedback {
    font-size: 0.88rem;
    min-height: 22px;
    margin-bottom: 14px;
    font-weight: 600;
  }
  .scene-drawer-feedback.is-success { color: #227038; }
  .scene-drawer-feedback.is-error { color: #b52c2c; }

  .scene-drawer-full-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #1a1815;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  .scene-drawer-full-link:hover { color: var(--sr-accent); }
</style>

{% comment %}
  ==============================================================================
  JAVASCRIPT: Curved Rail Physics, Real-Time Trajectory, Drawer & Cart API
  ==============================================================================
{% endcomment %}
<script>
  (function() {
    function initSceneRail(sectionId) {
      var root = document.getElementById("scene-rail-" + sectionId);
      if (!root) return;

      var stage = root.querySelector("[data-scene-stage]");
      var viewport = root.querySelector("[data-scene-viewport]");
      var track = root.querySelector("[data-scene-track]");
      var prevBtn = root.querySelector("[data-scene-prev]");
      var nextBtn = root.querySelector("[data-scene-next]");
      var progressPill = root.querySelector("[data-progress-pill]");

      var railSvg = root.querySelector("[data-rail-svg]");
      var railCore = root.querySelector("[data-rail-core]");
      var railShadow = root.querySelector("[data-rail-shadow]");
      var railSpecular = root.querySelector("[data-rail-specular]");

      // Bottom info bindings
      var activeTitle = root.querySelector("[data-active-title]");
      var activePrice = root.querySelector("[data-active-price]");
      var activeCompare = root.querySelector("[data-active-compare]");
      var activeSubtitle = root.querySelector("[data-active-subtitle]");

      // Drawer bindings
      var backdrop = root.querySelector("[data-drawer-backdrop]");
      var drawer = root.querySelector("[data-drawer]");
      var drawerClose = root.querySelector("[data-drawer-close]");
      var drawerMainImg = root.querySelector("[data-drawer-main-img]");
      var drawerTitle = root.querySelector("[data-drawer-title]");
      var drawerPrice = root.querySelector("[data-drawer-price]");
      var drawerCompare = root.querySelector("[data-drawer-compare]");
      var drawerDesc = root.querySelector("[data-drawer-desc]");
      var drawerVariantSelect = root.querySelector("[data-drawer-variant-select]");
      var drawerVariantsWrap = root.querySelector("[data-drawer-variants-wrap]");
      var drawerFullLink = root.querySelector("[data-drawer-full-link]");
      var drawerAddBtn = root.querySelector("[data-drawer-add-btn]");
      var drawerFeedback = root.querySelector("[data-drawer-feedback]");
      var angleTabs = root.querySelectorAll("[data-angle]");
      var qtyInput = root.querySelector("[data-qty-input]");
      var qtyMinus = root.querySelector("[data-qty-minus]");
      var qtyPlus = root.querySelector("[data-qty-plus]");

      if (!stage || !viewport || !track) return;

      var sagDepth = parseFloat(root.dataset.railSag) || 65;
      var yAnchor = parseFloat(root.dataset.railTop) || 45;
      var enableTilt = root.dataset.tilt === "true";
      var slides = Array.prototype.slice.call(track.querySelectorAll("[data-scene-slide]"));

      var currentDrawerItem = null;

      // 1. DYNAMIC SVG CURVED RAIL GEOMETRY
      function updateRailSvg() {
        var w = stage.clientWidth || 1400;
        var h = Math.max(180, yAnchor + sagDepth + 60);

        if (railSvg) {
          railSvg.setAttribute("viewBox", "0 0 " + w + " " + h);
          railSvg.style.height = h + "px";
        }

        // Quadratic Bézier: M 0,yAnchor Q (w/2),(yAnchor + 2*sagDepth) w,yAnchor
        // Exactly matches parabolic sagDepth at center
        var p1Y = yAnchor + (2.0 * sagDepth);
        var pathData = "M 0," + yAnchor + " Q " + (w * 0.5) + "," + p1Y + " " + w + "," + yAnchor;
        var shadowData = "M 0," + (yAnchor + 8) + " Q " + (w * 0.5) + "," + (p1Y + 8) + " " + w + "," + (yAnchor + 8);
        var specularData = "M 0," + (yAnchor - 1) + " Q " + (w * 0.5) + "," + (p1Y - 1) + " " + w + "," + (yAnchor - 1);

        if (railCore) railCore.setAttribute("d", pathData);
        if (railShadow) railShadow.setAttribute("d", shadowData);
        if (railSpecular) railSpecular.setAttribute("d", specularData);
      }

      // 2. REAL-TIME CURVE TRAJECTORY FOR HANGING PRODUCTS
      var isTicking = false;

      function updateItemsAlongCurve() {
        isTicking = false;
        var stageRect = stage.getBoundingClientRect();
        var stageW = stageRect.width || 1400;
        var stageCenterX = stageRect.left + (stageW * 0.5);
        var halfW = Math.max(1, stageW * 0.5);

        for (var i = 0; i < slides.length; i++) {
          var slide = slides[i];
          var rect = slide.getBoundingClientRect();
          var slideCenterX = rect.left + (rect.width * 0.5);
          var relX = slideCenterX - stageCenterX;

          // Normalized coordinate: -1 (left), 0 (center dip), +1 (right)
          var u = relX / halfW;
          u = Math.max(-1.3, Math.min(1.3, u));

          // Parabolic dip: y = sagDepth * (1 - u^2)
          var yDip = Math.max(0, sagDepth * (1.0 - (u * u)));

          // Tangent slope: dy/dx = - (2 * sagDepth * u) / halfW
          var slope = - (2.0 * sagDepth * u) / halfW;
          var angleDeg = (Math.atan(slope) * 180) / Math.PI;
          var tilt = enableTilt ? Math.max(-11, Math.min(11, angleDeg)) : 0;

          var assembly = slide.querySelector(".scene-hanger-assembly");
          if (assembly) {
            assembly.style.setProperty("--curve-y", yDip.toFixed(1) + "px");
            assembly.style.setProperty("--curve-tilt", tilt.toFixed(2) + "deg");
          }
        }

        // Update progress rail
        if (progressPill) {
          var maxScroll = viewport.scrollWidth - viewport.clientWidth;
          if (maxScroll <= 0) {
            progressPill.style.left = "0%";
          } else {
            var prog = Math.min(1.0, Math.max(0.0, viewport.scrollLeft / maxScroll));
            progressPill.style.left = (prog * 100) + "%";
          }
        }
      }

      function requestCurveUpdate() {
        if (!isTicking) {
          isTicking = true;
          requestAnimationFrame(updateItemsAlongCurve);
        }
      }

      // 3. EDITORIAL HOVER HIGHLIGHT & BOTTOM INFO UPDATES
      function setActiveProductInfo(slide) {
        if (!slide) return;
        var title = slide.dataset.title;
        var price = slide.dataset.price;
        var compare = slide.dataset.compare;
        var desc = slide.dataset.desc;

        if (activeTitle && title) activeTitle.textContent = title;
        if (activePrice && price) activePrice.textContent = price;
        if (activeCompare) {
          if (compare && compare !== "") {
            activeCompare.textContent = compare;
            activeCompare.style.display = "inline";
          } else {
            activeCompare.style.display = "none";
          }
        }
        if (activeSubtitle && desc) activeSubtitle.textContent = desc;
      }

      slides.forEach(function(slide) {
        slide.addEventListener("mouseenter", function() {
          setActiveProductInfo(slide);
        });

        // Click to Open Focused Detail Drawer
        var clickable = slide.querySelector("[data-open-drawer]");
        if (clickable) {
          clickable.addEventListener("click", function(e) {
            if (isDragging) return;
            e.preventDefault();
            openDrawer(slide);
          });
        }
      });

      // 4. PRODUCT DETAIL DRAWER OPEN / CLOSE / MULTI-ANGLE SWITCHER
      function openDrawer(slide) {
        if (!drawer || !backdrop) return;
        currentDrawerItem = slide;

        var title = slide.dataset.title || "";
        var price = slide.dataset.price || "";
        var compare = slide.dataset.compare || "";
        var desc = slide.dataset.desc || "";
        var url = slide.dataset.url || "#";
        var frontImg = slide.dataset.frontImg || "";
        var backImg = slide.dataset.backImg || frontImg;
        var sideImg = slide.dataset.sideImg || frontImg;

        if (drawerTitle) drawerTitle.textContent = title;
        if (drawerPrice) drawerPrice.textContent = price;
        if (drawerCompare) {
          if (compare && compare !== "") {
            drawerCompare.textContent = compare;
            drawerCompare.style.display = "inline";
          } else {
            drawerCompare.style.display = "none";
          }
        }
        if (drawerDesc) drawerDesc.textContent = desc;
        if (drawerFullLink) drawerFullLink.setAttribute("href", url);

        // Main Image & Angle Tabs
        if (drawerMainImg) {
          drawerMainImg.src = frontImg;
          drawerMainImg.alt = title;
        }

        angleTabs.forEach(function(tab) {
          tab.classList.remove("is-active");
          if (tab.dataset.angle === "front") tab.classList.add("is-active");
        });

        // Variants dropdown
        if (drawerVariantSelect && drawerVariantsWrap) {
          drawerVariantSelect.innerHTML = "";
          var rawVariants = slide.dataset.variants;
          var variants = [];
          try {
            if (rawVariants) variants = JSON.parse(rawVariants);
          } catch (e) {
            variants = [];
          }

          if (variants && variants.length > 0) {
            variants.forEach(function(v) {
              var opt = document.createElement("option");
              opt.value = v.id;
              opt.textContent = v.title + (v.available === false ? " (Sold Out)" : "");
              if (v.available === false) opt.disabled = true;
              drawerVariantSelect.appendChild(opt);
            });
            drawerVariantsWrap.style.display = "block";
          } else {
            drawerVariantsWrap.style.display = "none";
          }
        }

        if (qtyInput) qtyInput.value = "1";
        if (drawerFeedback) {
          drawerFeedback.textContent = "";
          drawerFeedback.className = "scene-drawer-feedback";
        }

        drawer.classList.add("is-open");
        backdrop.classList.add("is-open");
        drawer.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.remove("is-open");
        backdrop.classList.remove("is-open");
        drawer.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      if (drawerClose) drawerClose.addEventListener("click", closeDrawer);
      if (backdrop) backdrop.addEventListener("click", closeDrawer);
      window.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && drawer && drawer.classList.contains("is-open")) {
          closeDrawer();
        }
      });

      // Angle tab switcher
      angleTabs.forEach(function(tab) {
        tab.addEventListener("click", function() {
          if (!currentDrawerItem) return;
          angleTabs.forEach(function(t) { t.classList.remove("is-active"); });
          tab.classList.add("is-active");

          var angle = tab.dataset.angle;
          var targetSrc = currentDrawerItem.dataset.frontImg;
          if (angle === "back") targetSrc = currentDrawerItem.dataset.backImg || targetSrc;
          if (angle === "side") targetSrc = currentDrawerItem.dataset.sideImg || targetSrc;

          if (drawerMainImg && targetSrc) {
            drawerMainImg.style.opacity = "0.4";
            setTimeout(function() {
              drawerMainImg.src = targetSrc;
              drawerMainImg.style.opacity = "1";
            }, 120);
          }
        });
      });

      // Quantity controls
      if (qtyMinus && qtyInput) {
        qtyMinus.addEventListener("click", function() {
          var val = parseInt(qtyInput.value) || 1;
          if (val > 1) qtyInput.value = val - 1;
        });
      }
      if (qtyPlus && qtyInput) {
        qtyPlus.addEventListener("click", function() {
          var val = parseInt(qtyInput.value) || 1;
          qtyInput.value = val + 1;
        });
      }

      // Native Shopify Ajax Add to Cart (/cart/add.js)
      if (drawerAddBtn) {
        drawerAddBtn.addEventListener("click", function() {
          if (!currentDrawerItem) return;
          var variantId = drawerVariantSelect ? drawerVariantSelect.value : null;
          var qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

          if (!variantId && currentDrawerItem.dataset.productId) {
            variantId = currentDrawerItem.dataset.productId;
          }

          drawerAddBtn.classList.add("is-loading");
          if (drawerFeedback) {
            drawerFeedback.textContent = "";
            drawerFeedback.className = "scene-drawer-feedback";
          }

          // If demonstration item
          if (!variantId || variantId.indexOf("demo") !== -1) {
            setTimeout(function() {
              drawerAddBtn.classList.remove("is-loading");
              if (drawerFeedback) {
                drawerFeedback.textContent = "✓ Atelier piece added to preview bag!";
                drawerFeedback.classList.add("is-success");
              }
            }, 500);
            return;
          }

          fetch("/cart/add.js", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({
              id: variantId,
              quantity: qty
            })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            drawerAddBtn.classList.remove("is-loading");
            if (data.status && data.status !== 200) {
              if (drawerFeedback) {
                drawerFeedback.textContent = data.description || "Could not add item.";
                drawerFeedback.classList.add("is-error");
              }
            } else {
              if (drawerFeedback) {
                drawerFeedback.textContent = "✓ Added to your shopping bag!";
                drawerFeedback.classList.add("is-success");
              }
              // Dispatch native Shopify theme events
              document.dispatchEvent(new CustomEvent("cart:refresh", { bubbles: true }));
              document.dispatchEvent(new CustomEvent("theme:cart:update", { bubbles: true }));
            }
          })
          .catch(function(err) {
            drawerAddBtn.classList.remove("is-loading");
            if (drawerFeedback) {
              drawerFeedback.textContent = "Error adding to cart.";
              drawerFeedback.classList.add("is-error");
            }
          });
        });
      }

      // 5. MOUSE DRAG & TOUCH SWIPE MECHANICS
      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var isDragging = false;

      viewport.addEventListener("mousedown", function(e) {
        isDown = true;
        isDragging = false;
        startX = e.pageX - viewport.offsetLeft;
        scrollLeft = viewport.scrollLeft;
        viewport.style.scrollBehavior = "auto";
      });

      window.addEventListener("mouseup", function() {
        if (!isDown) return;
        isDown = false;
        viewport.style.scrollBehavior = "smooth";
        setTimeout(function() { isDragging = false; }, 60);
      });

      viewport.addEventListener("mousemove", function(e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - viewport.offsetLeft;
        var walk = (x - startX) * 1.4;
        if (Math.abs(walk) > 5) isDragging = true;
        viewport.scrollLeft = scrollLeft - walk;
        requestCurveUpdate();
      });

      // 6. BUTTON NAVIGATION
      function getScrollDistance() {
        var firstSlide = track.querySelector(".scene-slide");
        if (firstSlide) {
          return firstSlide.offsetWidth + 40;
        }
        return viewport.clientWidth * 0.75;
      }

      if (prevBtn) {
        prevBtn.addEventListener("click", function() {
          viewport.scrollBy({ left: -getScrollDistance(), behavior: "smooth" });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", function() {
          viewport.scrollBy({ left: getScrollDistance(), behavior: "smooth" });
        });
      }

      // Keyboard & Scroll events
      viewport.addEventListener("scroll", requestCurveUpdate, { passive: true });
      window.addEventListener("resize", function() {
        updateRailSvg();
        requestCurveUpdate();
      }, { passive: true });

      viewport.addEventListener("keydown", function(e) {
        if (e.key === "ArrowLeft") {
          viewport.scrollBy({ left: -getScrollDistance(), behavior: "smooth" });
        } else if (e.key === "ArrowRight") {
          viewport.scrollBy({ left: getScrollDistance(), behavior: "smooth" });
        }
      });

      // Autoplay
      {% if section.settings.autoplay %}
        var autoTimer = null;
        var autoSpeed = ({{ section.settings.autoplay_speed | default: 5 }}) * 1000;

        function startAutoplay() {
          if (autoTimer) clearInterval(autoTimer);
          autoTimer = setInterval(function() {
            var maxScroll = viewport.scrollWidth - viewport.clientWidth;
            if (viewport.scrollLeft >= maxScroll - 15) {
              viewport.scrollTo({ left: 0, behavior: "smooth" });
            } else {
              viewport.scrollBy({ left: getScrollDistance(), behavior: "smooth" });
            }
          }, autoSpeed);
        }

        function stopAutoplay() {
          if (autoTimer) clearInterval(autoTimer);
        }

        root.addEventListener("mouseenter", stopAutoplay);
        root.addEventListener("mouseleave", startAutoplay);
        root.addEventListener("touchstart", stopAutoplay, { passive: true });
        startAutoplay();
      {% endif %}

      // Initial execution
      updateRailSvg();
      updateItemsAlongCurve();
      if (slides.length > 0) setActiveProductInfo(slides[0]);

      setTimeout(function() {
        updateRailSvg();
        updateItemsAlongCurve();
      }, 100);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function() {
        initSceneRail("{{ section_id }}");
      });
    } else {
      initSceneRail("{{ section_id }}");
    }

    // Shopify Theme Editor Integration
    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail && e.detail.sectionId === "{{ section_id }}") {
        initSceneRail("{{ section_id }}");
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Scene Rail Slider",
  "tag": "section",
  "class": "scene-rail-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header & Editorial Text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Badge",
      "default": "HAUTE COUTURE 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Royal Scene Rail"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each bespoke garment hangs along a sculpted metallic architectural rail. Hover to inspect, click to open full tailoring details."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background & Dimensions"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F2EB"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Optional)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#1A1815"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Price Color",
      "default": "#93672E"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height Mode",
      "options": [
