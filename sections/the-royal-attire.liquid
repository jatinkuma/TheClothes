  }
</style>

<script>
(function() {
  var sectionId = "{{ section.id }}";
  var wrapper = document.getElementById("the-royal-attire-" + sectionId);
  if (!wrapper) return;

  // 1. Assets Map
  var paletteMap = {
    cream: {
      body: "{{ 'royal-doll-cream-body.png' | asset_url }}",
      head: "{{ 'royal-doll-cream-head.png' | asset_url }}"
    },
    red: {
      body: "{{ 'royal-doll-red-body.png' | asset_url }}",
      head: "{{ 'royal-doll-red-head.png' | asset_url }}"
    },
    blue: {
      body: "{{ 'royal-doll-blue-body.png' | asset_url }}",
      head: "{{ 'royal-doll-blue-head.png' | asset_url }}"
    },
    green: {
      body: "{{ 'royal-doll-green-body.png' | asset_url }}",
      head: "{{ 'royal-doll-green-head.png' | asset_url }}"
    }
  };

  var bodyImg = document.getElementById("tra-avatar-body-" + sectionId);
  var headImg = document.getElementById("tra-avatar-head-" + sectionId);
  var blinkImg = document.getElementById("tra-avatar-blink-" + sectionId);
  var headPivot = document.getElementById("tra-avatar-head-pivot-" + sectionId);
  var bodyWrap = wrapper.querySelector(".tra-avatar-body-wrap");
  var mascotRig = document.getElementById("tra-mascot-rig-" + sectionId);

  // 2. Character Mechanics: Breathing, Blinking, Head Sway & Cursor Tilt
  var targetRotY = 0, currentRotY = 0;
  var targetRotX = 0, currentRotX = 0;
  var isHovering = false;

  window.addEventListener("mousemove", function(e) {
    if (!mascotRig) return;
    var rect = mascotRig.getBoundingClientRect();
    var centerX = rect.left + rect.width / 2;
    var centerY = rect.top + rect.height * 0.42;

    var diffX = (e.clientX - centerX) / (window.innerWidth * 0.5);
    var diffY = (e.clientY - centerY) / (window.innerHeight * 0.5);

    // Limit continuous head sway within natural anatomical bounds (-26deg to +26deg)
    targetRotY = Math.max(-26, Math.min(26, diffX * 26));
    targetRotX = Math.max(-12, Math.min(12, -diffY * 12));
    isHovering = true;
  });

  window.addEventListener("mouseleave", function() {
    targetRotY = 0;
    targetRotX = 0;
    isHovering = false;
  });

  // Autonomous Blinking Loop (with double-blink probability)
  function triggerBlink() {
    if (!blinkImg) return;
    blinkImg.classList.add("blinking");
    setTimeout(function() {
      blinkImg.classList.remove("blinking");
      // 25% chance of realistic double-blink
      if (Math.random() < 0.25) {
        setTimeout(function() {
          blinkImg.classList.add("blinking");
          setTimeout(function() {
            blinkImg.classList.remove("blinking");
          }, 110);
        }, 130);
      }
    }, 120);

    var nextBlink = 2600 + Math.random() * 2400;
    setTimeout(triggerBlink, nextBlink);
  }
  setTimeout(triggerBlink, 2000);

  // Main 60FPS Animation Loop: Breathing & Smooth Head Sway
  function animateCharacter(time) {
    // 1. Idle breathing sine wave (chest expansion scaleY/scaleX)
    var breath = Math.sin(time * 0.0022);
    if (bodyWrap) {
      var scaleY = 1 + breath * 0.018;
      var scaleX = 1 - breath * 0.010;
      bodyWrap.style.transform = "scale(" + scaleX + ", " + scaleY + ")";
    }

    // 2. Smooth spring-damped head rotation
    currentRotY += (targetRotY - currentRotY) * 0.085;
    currentRotX += (targetRotX - currentRotX) * 0.085;

    // Organic idle sway when mouse is stationary
    var idleSway = Math.sin(time * 0.0014) * 2.2;
    var finalRotY = currentRotY + idleSway;
    var finalTiltZ = finalRotY * 0.16;

    if (headPivot) {
      headPivot.style.transform = 
        "rotateY(" + finalRotY.toFixed(2) + "deg) " +
        "rotateX(" + currentRotX.toFixed(2) + "deg) " +
        "rotateZ(" + finalTiltZ.toFixed(2) + "deg)";
    }

    requestAnimationFrame(animateCharacter);
  }
  requestAnimationFrame(animateCharacter);

  // 3. Instant Live Drape Switching
  function applyPalette(paletteName) {
    if (!paletteMap[paletteName]) return;
    if (bodyImg) bodyImg.src = paletteMap[paletteName].body;
    if (headImg) headImg.src = paletteMap[paletteName].head;
    if (mascotRig) mascotRig.setAttribute("data-palette", paletteName);

    // Update active state in dress-up bar
    var dressBtns = wrapper.querySelectorAll(".tra-dress-btn");
    dressBtns.forEach(function(btn) {
      if (btn.getAttribute("data-palette") === paletteName) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });
  }

  // Bind Dress-up bar buttons
  var dressBtns = wrapper.querySelectorAll(".tra-dress-btn");
  dressBtns.forEach(function(btn) {
    btn.addEventListener("click", function() {
      var p = btn.getAttribute("data-palette");
      applyPalette(p);
    });
  });

  // Bind Product Card thumbnail clicks to drape onto character
  var cardThumbs = wrapper.querySelectorAll(".tra-card-thumb-wrap");
  cardThumbs.forEach(function(thumb) {
    thumb.addEventListener("click", function() {
      var card = thumb.closest(".tra-card");
      if (!card) return;
      var p = card.getAttribute("data-palette");
      applyPalette(p);

      // Smooth scroll back up to character on small screens
      if (window.innerWidth < 768) {
        var mascotEl = document.getElementById("the-mascot-" + sectionId);
        if (mascotEl) mascotEl.scrollIntoView({ behavior: "smooth" });
      }
    });
  });

  // 4. Antigravity Color-Changing Butterfly Cursor
  var butterfly = document.getElementById("tra-butterfly-cursor-" + sectionId);
  if (butterfly) {
    var bfX = window.innerWidth / 2;
    var bfY = window.innerHeight / 2;
    var targetBfX = bfX;
    var targetBfY = bfY;

    window.addEventListener("mousemove", function(e) {
      targetBfX = e.clientX;
      targetBfY = e.clientY;
    });

    function updateButterfly(time) {
      // Buoyant physics lag + float
      bfX += (targetBfX - bfX) * 0.12;
      bfY += (targetBfY - bfY) * 0.12;

      var hoverFloatY = Math.sin(time * 0.0035) * 11;
      var hoverFloatX = Math.cos(time * 0.0028) * 5;

      var posX = bfX + hoverFloatX + 16;
      var posY = bfY + hoverFloatY - 24;

      butterfly.style.transform = "translate(" + posX.toFixed(1) + "px, " + posY.toFixed(1) + "px)";

      // Dynamic Section Color Shifting based on scroll position
      var heroSec = document.getElementById("the-mascot-" + sectionId);
      var collSec = document.getElementById("the-collection-" + sectionId);
      var stylSec = document.getElementById("the-stylist-" + sectionId);

      var scrollMid = window.scrollY + window.innerHeight * 0.45;

      if (stylSec && scrollMid >= stylSec.offsetTop) {
        butterfly.setAttribute("data-theme", "gold");
      } else if (collSec && scrollMid >= collSec.offsetTop) {
        butterfly.setAttribute("data-theme", "purple");
      } else {
        butterfly.setAttribute("data-theme", "blue");
      }

      requestAnimationFrame(updateButterfly);
    }
    requestAnimationFrame(updateButterfly);
  }

  // 5. The Royal Stylist: AI Generation & Particle Starburst
  var magicCanvas = document.getElementById("tra-magic-canvas-" + sectionId);
  var askAiBtn = document.getElementById("tra-ask-ai-btn-" + sectionId);
  var aiBtnText = document.getElementById("tra-ai-btn-text-" + sectionId);
  var insightTitle = document.getElementById("tra-ai-insight-title-" + sectionId);
  var insightDesc = document.getElementById("tra-ai-insight-desc-" + sectionId);

  var royalAiPresets = [
    {
      preset: "coronation",
      title: "The Maharaja's Coronation",
      palette: "cream",
      insight: "Pure ivory symbolizes truth and sovereignty, accented by ruby red to honor royal valor and victory in state processions."
    },
    {
      preset: "mewar-starlight",
      title: "The Mewar Starlight",
      palette: "blue",
      insight: "Deep celestial lapis blue paired with gleaming gold zari mirrors the starlit skies over Lake Pichola, worn during autumn court banquets."
    },
    {
      preset: "garden-gala",
      title: "The Royal Garden Gala",
      palette: "green",
      insight: "Vibrant emerald silk embellished with marigold saffron captures the vitality of royal palace gardens in bloom."
    },
    {
      preset: "jodhpur-sunbreak",
      title: "The Jodhpur Sunbreak",
      palette: "cream",
      insight: "Warm sunbreak yellow paired with indigo trims celebrates the sun-drenched ramparts of Mehrangarh Fort."
    }
  ];

  // Particle Starburst Canvas Animation
  var particles = [];
  function triggerStarburst(x, y) {
    if (!magicCanvas) return;
    magicCanvas.width = window.innerWidth;
    magicCanvas.height = window.innerHeight;
    var ctx = magicCanvas.getContext("2d");

    var colors = ["#FFD700", "#FF1744", "#00E5FF", "#E040FB", "#FFF"];
    for (var i = 0; i < 90; i++) {
      var angle = Math.random() * Math.PI * 2;
      var speed = 3 + Math.random() * 8;
      particles.push({
        x: x || window.innerWidth / 2,
        y: y || window.innerHeight * 0.6,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        size: 3 + Math.random() * 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: 1,
        decay: 0.016 + Math.random() * 0.018
      });
    }

    function renderParticles() {
      ctx.clearRect(0, 0, magicCanvas.width, magicCanvas.height);
      var alive = false;
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        if (p.alpha > 0) {
          alive = true;
          ctx.save();
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.12; // gentle gravity
          p.alpha -= p.decay;
        }
      }
      if (alive) {
        requestAnimationFrame(renderParticles);
      } else {
        particles = [];
        ctx.clearRect(0, 0, magicCanvas.width, magicCanvas.height);
      }
    }
    requestAnimationFrame(renderParticles);
  }

  // Ask AI Button Click Handler
  if (askAiBtn) {
    askAiBtn.addEventListener("click", function(e) {
      if (aiBtnText) aiBtnText.textContent = "AI Consulting Court Lore...";

      var rect = askAiBtn.getBoundingClientRect();
      var clickX = rect.left + rect.width / 2;
      var clickY = rect.top + rect.height / 2;

      setTimeout(function() {
        var choice = royalAiPresets[Math.floor(Math.random() * royalAiPresets.length)];
        applyPalette(choice.palette);

        if (insightTitle) insightTitle.textContent = choice.title;
        if (insightDesc) insightDesc.textContent = choice.insight;

        // Update preset list active state
        var pItems = wrapper.querySelectorAll(".tra-preset-item");
        pItems.forEach(function(item) {
          if (item.getAttribute("data-preset") === choice.preset) {
            item.classList.add("active");
          } else {
            item.classList.remove("active");
          }
        });

        triggerStarburst(clickX, clickY);
        if (aiBtnText) aiBtnText.textContent = "Ask AI for Royal Match";
      }, 450);
    });
  }

  // Preset list item clicks
  var presetItems = wrapper.querySelectorAll(".tra-preset-item");
  presetItems.forEach(function(item) {
    item.addEventListener("click", function() {
      var pName = item.getAttribute("data-preset");
      var matched = royalAiPresets.find(function(rp) { return rp.preset === pName; });
      if (matched) {
        applyPalette(matched.palette);
        if (insightTitle) insightTitle.textContent = matched.title;
        if (insightDesc) insightDesc.textContent = matched.insight;

        presetItems.forEach(function(pi) { pi.classList.remove("active"); });
        item.classList.add("active");

        var rect = item.getBoundingClientRect();
        triggerStarburst(rect.left + rect.width / 2, rect.top + rect.height / 2);
      }
    });
  });

  // Swatches click
  var swatches = wrapper.querySelectorAll(".tra-swatch");
  swatches.forEach(function(sw) {
    sw.addEventListener("click", function() {
      var pal = sw.getAttribute("data-palette");
      applyPalette(pal);
      swatches.forEach(function(s) { s.classList.remove("active"); });
      sw.classList.add("active");
    });
  });

  // Hue slider tint
  var hueSlider = document.getElementById("tra-hue-slider-" + sectionId);
  var hueLabel = document.getElementById("tra-hue-label-" + sectionId);
  if (hueSlider) {
    hueSlider.addEventListener("input", function() {
      var deg = hueSlider.value;
      if (hueLabel) hueLabel.textContent = deg + "° Custom Tint";
      if (bodyImg) bodyImg.style.filter = "hue-rotate(" + deg + "deg)";
    });
  }

  // Enquire Buttons Toast / Alert
  var enquireBtns = wrapper.querySelectorAll(".tra-enquire-btn");
  enquireBtns.forEach(function(btn) {
    btn.addEventListener("click", function() {
      var piece = btn.getAttribute("data-piece");
      alert("Thank you for your royal enquiry for "" + piece + "". Our master atelier specialist will reach out to schedule your private fitting.");
    });
  });

})();
</script>

