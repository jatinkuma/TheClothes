{% comment %}
  THE ROYAL ATTIRE - Replaceable 3D Character & Interactive Fashion System
  - Three.js WebGL 3D Engine with rigged skeletal bone rotation & 360° interactive viewer
  - Fully replaceable 3D character system (.glb / .gltf) via section settings
  - Product-based 3D clothing system: loads matching 3D Sherwani outfits on product click
  - Real-time continuous head & neck rotation following the cursor with natural easing
  - Complete, unified, connected character presentation with NO cut seams or neck gaps
  - Global butterfly cursor is rendered globally via layout/theme.liquid
{% endcomment %}

<!-- Three.js & GLTF Loader for Rigged 3D Character & Clothing Models -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

<div id="the-royal-attire-{{ section.id }}" class="the-royal-attire-wrapper" style="--tra-bg: {{ section.settings.bg_color | default: '#EA9B1B' }};">
  
  <!-- Canvas for AI Magical Sparkles / Starburst in Stylist Panel -->
  <canvas id="tra-magic-canvas-{{ section.id }}" class="tra-magic-canvas"></canvas>

  <!-- 1. HEADER & NAVIGATION -->
  <header class="tra-header">
    <div class="tra-header-left">
      <div class="tra-crown-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
        </svg>
      </div>
      <h1 class="tra-brand-title">{{ section.settings.brand_title | default: 'The Royal Attire' }}</h1>
    </div>

    <nav class="tra-nav">
      <a href="#the-collection-{{ section.id }}" class="tra-nav-link">Collection</a>
      <a href="#the-mascot-{{ section.id }}" class="tra-nav-link">Atelier</a>
      <a href="#the-stylist-{{ section.id }}" class="tra-nav-link">The Stylist</a>
      <a href="#heritage-{{ section.id }}" class="tra-nav-link">Heritage</a>
    </nav>

    <div class="tra-social-links">
      <a href="https://instagram.com" target="_blank" rel="noopener" class="tra-social-icon" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </a>
      <a href="https://pinterest.com" target="_blank" rel="noopener" class="tra-social-icon" aria-label="Pinterest">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.365-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://facebook.com" target="_blank" rel="noopener" class="tra-social-icon" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://wa.me/" target="_blank" rel="noopener" class="tra-social-icon" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
    </div>
  </header>

  <!-- 2. HERO SHOWCASE WITH REPLACEABLE 3D CHARACTER ENGINE -->
  <section id="the-mascot-{{ section.id }}" class="tra-hero-section">
    <div class="tra-hero-header">
      <span class="tra-badge">{{ section.settings.subtitle | default: 'THE COLLECTION' }}</span>
      <h2 class="tra-main-heading">{{ section.settings.heading | default: 'Worn by royalty, made by hand' }}</h2>
      <p class="tra-hero-sub">{{ section.settings.description | default: 'Explore handcrafted heritage regalia. Select any piece below to instantly dress our 3D royal character in authentic court attire.' }}</p>
    </div>

    <!-- Central Stage: Replaceable 3D Animated Character Stage -->
    <div class="tra-stage-container" id="tra-stage-container-{{ section.id }}">
      <div class="tra-pedestal-glow"></div>
      
      <!-- 3D Model Loading Spinner -->
      <div id="tra-3d-spinner-{{ section.id }}" class="tra-3d-spinner">
        <div class="tra-spinner-circle"></div>
        <span>Preparing 3D Atelier...</span>
      </div>

      <!-- Real-Time Interactive 3D WebGL Canvas for Rigged 3D Character & Outfits -->
      <canvas id="tra-3d-webgl-canvas-{{ section.id }}" class="tra-3d-webgl-canvas"></canvas>

      <!-- Complete Unified Fallback Stage (Used when WebGL is initializing or loading) -->
      <div id="tra-mascot-stage-{{ section.id }}" class="tra-mascot-stage" style="display: none;">
        <div id="tra-character-gaze-rig-{{ section.id }}" class="tra-character-gaze-rig">
          <div class="tra-character-inner">
            <img id="tra-unified-character-{{ section.id }}" 
                 class="tra-unified-character-img"
                 src="{{ 'royal-owl-master.png' | asset_url }}" 
                 alt="The Royal Mascot in Ceremonial Court Attire" 
                 loading="eager" />
          </div>
        </div>
      </div>

      <!-- 3D 360-Degree Interactive Rotation Cue -->
      <div class="tra-3d-cue">
        <span class="tra-3d-cue-icon">↺</span>
        <span class="tra-3d-cue-text">Real-Time 3D Gaze Tracking &bull; Natural Body & Eye Movement</span>
      </div>

      <!-- Live Quick-Dressing Outfit Bar -->
      <div class="tra-dressup-bar">
        <span class="tra-bar-label">Live 3D Sherwani</span>
        <div class="tra-bar-buttons">
          <button type="button" class="tra-dress-btn active" data-outfit="maroon" data-model="{{ 'sherwani-maroon.glb' | asset_url }}" data-item="Maroon Sherwani">
            <span class="tra-btn-dot" style="background:#8B1E1E;"></span>
            <span>Maroon</span>
          </button>
          <button type="button" class="tra-dress-btn" data-outfit="blue" data-model="{{ 'sherwani-blue.glb' | asset_url }}" data-item="Blue Sherwani">
            <span class="tra-btn-dot" style="background:#1B3B6F;"></span>
            <span>Blue</span>
          </button>
          <button type="button" class="tra-dress-btn" data-outfit="ivory" data-model="{{ 'sherwani-ivory.glb' | asset_url }}" data-item="Ivory Sherwani">
            <span class="tra-btn-dot" style="background:#F5E5C9;"></span>
            <span>Ivory</span>
          </button>
          <button type="button" class="tra-dress-btn" data-outfit="emerald" data-model="{{ 'sherwani-emerald.glb' | asset_url }}" data-item="Emerald Sherwani">
            <span class="tra-btn-dot" style="background:#1E4A38;"></span>
            <span>Emerald</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PRODUCT SHOWCASE GRID (SHOPIFY PRODUCT-BASED 3D CLOTHING SYSTEM) -->
  <section id="the-collection-{{ section.id }}" class="tra-collection-section">
    <div class="tra-section-head">
      <span class="tra-sub-title">CRAFTED FOR NOBILITY</span>
      <h3 class="tra-section-title">The Masterpiece Gallery</h3>
      <p class="tra-section-desc">Click any Sherwani to equip its tailored 3D outfit directly onto the character above.</p>
    </div>

    <div class="tra-product-grid">
      
      <!-- Card 1: Maroon Sherwani -->
      <article class="tra-card active" data-outfit="maroon" data-model="{{ 'sherwani-maroon.glb' | asset_url }}" data-product="Maroon Royal Sherwani">
        <div class="tra-card-thumb-wrap">
          <img src="{{ 'royal-owl-dupatta.png' | asset_url }}" alt="Maroon Royal Sherwani" class="tra-card-img" />
          <span class="tra-drape-pill">Equipped in 3D</span>
        </div>
        <div class="tra-card-info">
          <span class="tra-card-cat">Ceremonial State Regalia</span>
          <h4 class="tra-card-title">Maroon Royal Sherwani</h4>
          <p class="tra-card-summary">Hand-tailored raw mulberry silk sherwani enriched with antique gold zardozi placket embroidery and ruby brooch stole.</p>
          <div class="tra-card-foot">
            <span class="tra-card-price">Rs. 56,000</span>
            <button type="button" class="tra-enquire-btn" data-piece="Maroon Royal Sherwani">Enquire about this piece</button>
          </div>
        </div>
      </article>

      <!-- Card 2: Blue Sherwani -->
      <article class="tra-card" data-outfit="blue" data-model="{{ 'sherwani-blue.glb' | asset_url }}" data-product="Sapphire Blue Jodhpuri">
        <div class="tra-card-thumb-wrap">
          <img src="{{ 'royal-owl-achkan.png' | asset_url }}" alt="Sapphire Blue Jodhpuri" class="tra-card-img" />
          <span class="tra-drape-pill">Equip in 3D</span>
        </div>
        <div class="tra-card-info">
          <span class="tra-card-cat">Royal Court Jodhpuri</span>
          <h4 class="tra-card-title">Sapphire Blue Jodhpuri</h4>
          <p class="tra-card-summary">Celestial lapis blue brocade adorned with spun real silver and gold thread floral booti motifs and mandarin collar.</p>
          <div class="tra-card-foot">
            <span class="tra-card-price">Rs. 52,000</span>
            <button type="button" class="tra-enquire-btn" data-piece="Sapphire Blue Jodhpuri">Enquire about this piece</button>
          </div>
        </div>
      </article>

      <!-- Card 3: Ivory Sherwani -->
      <article class="tra-card" data-outfit="ivory" data-model="{{ 'sherwani-ivory.glb' | asset_url }}" data-product="Imperial Ivory Sherwani">
        <div class="tra-card-thumb-wrap">
          <img src="{{ 'royal-owl-safa.png' | asset_url }}" alt="Imperial Ivory Sherwani" class="tra-card-img" />
          <span class="tra-drape-pill">Equip in 3D</span>
        </div>
        <div class="tra-card-info">
          <span class="tra-card-cat">Coronation Brocade Coat</span>
          <h4 class="tra-card-title">Imperial Ivory Sherwani</h4>
          <p class="tra-card-summary">Chanderi silk woven with intricate ivory-on-cream needlework, freshwater pearl button fastenings, and gold piping.</p>
          <div class="tra-card-foot">
            <span class="tra-card-price">Rs. 48,000</span>
            <button type="button" class="tra-enquire-btn" data-piece="Imperial Ivory Sherwani">Enquire about this piece</button>
          </div>
        </div>
      </article>

      <!-- Card 4: Emerald Sherwani -->
      <article class="tra-card" data-outfit="emerald" data-model="{{ 'sherwani-emerald.glb' | asset_url }}" data-product="Emerald Heritage Sherwani">
        <div class="tra-card-thumb-wrap">
          <img src="{{ 'royal-owl-mojari.png' | asset_url }}" alt="Emerald Heritage Sherwani" class="tra-card-img" />
          <span class="tra-drape-pill">Equip in 3D</span>
        </div>
        <div class="tra-card-info">
          <span class="tra-card-cat">Palace Garden Gala Coat</span>
          <h4 class="tra-card-title">Emerald Heritage Sherwani</h4>
          <p class="tra-card-summary">Deep royal emerald silk coat inspired by imperial Mughal garden florals with handcrafted filigree cuffs and velvet mojari.</p>
          <div class="tra-card-foot">
            <span class="tra-card-price">Rs. 54,000</span>
            <button type="button" class="tra-enquire-btn" data-piece="Emerald Heritage Sherwani">Enquire about this piece</button>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- 4. DEDICATED SECTION: "THE ROYAL STYLIST" (AI CUSTOMIZATION PANEL) -->
  <section id="the-stylist-{{ section.id }}" class="tra-stylist-section">
    <div class="tra-stylist-inner">
      
      <div class="tra-stylist-banner">
        <div class="tra-stylist-pill">BESPOKE ATELIER</div>
        <h3 class="tra-stylist-title">The Royal Stylist</h3>
        <p class="tra-stylist-tagline">AI-assisted royal curation, customized vegetable dyes, and ancestral court significance.</p>
      </div>

      <!-- AI Generation Trigger & Sparkle Centerpiece -->
      <div class="tra-ai-bar">
        <button type="button" id="tra-ask-ai-btn-{{ section.id }}" class="tra-ai-btn">
          <span class="tra-ai-sparkle-icon">✨</span>
          <span id="tra-ai-btn-text-{{ section.id }}">Ask AI for Royal Match</span>
          <span class="tra-ai-sparkle-icon">✨</span>
        </button>
        <span class="tra-ai-subtext">Click to trigger royal color harmony with magical court sparkles.</span>
      </div>

      <!-- Court Lore Insight Notification Box -->
      <div id="tra-ai-insight-box-{{ section.id }}" class="tra-insight-box">
        <div class="tra-insight-badge">Court Significance</div>
        <div id="tra-ai-insight-title-{{ section.id }}" class="tra-insight-title">The Maharaja's Coronation</div>
        <p id="tra-ai-insight-desc-{{ section.id }}" class="tra-insight-desc">
          Pure ivory symbolizes truth and sovereignty, accented by ruby red to honor royal valor and victory in state processions.
        </p>
      </div>

      <!-- Stylist Controls Grid: Left Presets / Right Mix & Match -->
      <div class="tra-stylist-grid">
        
        <!-- Left: Curated Royal Palettes -->
        <div class="tra-stylist-box">
          <div class="tra-box-head">
            <span class="tra-box-icon">👑</span>
            <h4>Curated Royal Palettes</h4>
          </div>

          <div class="tra-presets-list">
            <button type="button" class="tra-preset-item active" data-preset="coronation" data-outfit="maroon">
              <div class="tra-pi-left">
                <strong>The Maharaja's Coronation</strong>
                <span>Ivory, Ruby &amp; 24k Gold</span>
              </div>
              <div class="tra-pi-dots">
                <span class="tra-dot" style="background:#8B1E1E;"></span>
                <span class="tra-dot" style="background:#F3DFB2;"></span>
                <span class="tra-dot" style="background:#D4AF37;"></span>
              </div>
            </button>

            <button type="button" class="tra-preset-item" data-preset="mewar-starlight" data-outfit="blue">
              <div class="tra-pi-left">
                <strong>The Mewar Starlight</strong>
                <span>Lapis Blue, Silver &amp; Amber</span>
              </div>
              <div class="tra-pi-dots">
                <span class="tra-dot" style="background:#1B3B6F;"></span>
                <span class="tra-dot" style="background:#E0E0E0;"></span>
                <span class="tra-dot" style="background:#C27803;"></span>
              </div>
            </button>

            <button type="button" class="tra-preset-item" data-preset="garden-gala" data-outfit="emerald">
              <div class="tra-pi-left">
                <strong>The Royal Garden Gala</strong>
                <span>Emerald, Saffron &amp; Pearl</span>
              </div>
              <div class="tra-pi-dots">
                <span class="tra-dot" style="background:#1E4A38;"></span>
                <span class="tra-dot" style="background:#EA9B1B;"></span>
                <span class="tra-dot" style="background:#FAF6EE;"></span>
              </div>
            </button>

            <button type="button" class="tra-preset-item" data-preset="jodhpur-sunbreak" data-outfit="ivory">
              <div class="tra-pi-left">
                <strong>The Jodhpur Sunbreak</strong>
                <span>Saffron Yellow, Indigo &amp; Pearl</span>
              </div>
              <div class="tra-pi-dots">
                <span class="tra-dot" style="background:#E5A93C;"></span>
                <span class="tra-dot" style="background:#2C3E50;"></span>
                <span class="tra-dot" style="background:#F5E6CC;"></span>
              </div>
            </button>
          </div>
        </div>

        <!-- Right: Mix & Match Color Swatches & Hue Slider -->
        <div class="tra-stylist-box">
          <div class="tra-box-head">
            <span class="tra-box-icon">🎨</span>
            <h4>Mix &amp; Match Atelier</h4>
          </div>

          <!-- Garment Selector Tabs -->
          <div class="tra-tabs">
            <button type="button" class="tra-tab active" data-tab="safa">Safa (Turban)</button>
            <button type="button" class="tra-tab" data-tab="achkan">Achkan (Coat)</button>
            <button type="button" class="tra-tab" data-tab="dupatta">Dupatta (Stole)</button>
            <button type="button" class="tra-tab" data-tab="mojari">Mojari (Shoes)</button>
          </div>

          <!-- Silk Color Swatches -->
          <div class="tra-swatches-area">
            <span class="tra-area-label">Pure Silk Dye Swatches</span>
            <div class="tra-swatches-row">
              <button type="button" class="tra-swatch active" data-outfit="maroon" title="Ruby Crimson" style="background:#8B1E1E;"></button>
              <button type="button" class="tra-swatch" data-outfit="blue" title="Sapphire Midnight" style="background:#1B3B6F;"></button>
              <button type="button" class="tra-swatch" data-outfit="ivory" title="Ivory Brocade" style="background:#F3DFB2;"></button>
              <button type="button" class="tra-swatch" data-outfit="emerald" title="Emerald Court" style="background:#1E4A38;"></button>
              <button type="button" class="tra-swatch" data-outfit="ivory" title="Imperial Gold" style="background:#D4AF37;"></button>
              <button type="button" class="tra-swatch" data-outfit="maroon" title="Deep Amber" style="background:#C27803;"></button>
            </div>
          </div>

          <!-- Fine Hue Slider -->
          <div class="tra-slider-area">
            <div class="tra-slider-head">
              <span class="tra-area-label">Fine Vegetable Dye Hue</span>
              <span id="tra-hue-label-{{ section.id }}" class="tra-hue-val">0° (Natural)</span>
            </div>
            <input type="range" id="tra-hue-slider-{{ section.id }}" class="tra-hue-range" min="0" max="360" value="0" />
            <div class="tra-slider-hint">Slide to custom-tint the selected 3D Sherwani in real time on the royal character.</div>
          </div>

        </div>

      </div>
    </div>
  </section>

</div>

<style>
  /* ==========================================================
     THE ROYAL ATTIRE - STYLES
     ========================================================== */
  #the-royal-attire-{{ section.id }} {
    position: relative;
    background-color: var(--tra-bg, #EA9B1B);
    color: #1E1610;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    overflow: hidden;
    padding-bottom: 80px;
    box-sizing: border-box;
  }

  #the-royal-attire-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* Fullscreen AI Magic Canvas for Starburst */
  .tra-magic-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 99998;
  }

  /* 1. Header & Nav */
  .tra-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .tra-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tra-crown-icon {
    color: #9B1B30;
  }

  .tra-brand-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1E1610;
  }

  .tra-nav {
    display: flex;
    gap: 32px;
  }

  .tra-nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #2D1E12;
    text-decoration: none;
    letter-spacing: 0.05em;
    position: relative;
    padding-bottom: 4px;
    transition: color 0.2s ease;
  }

  .tra-nav-link:hover {
    color: #9B1B30;
  }

  .tra-social-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .tra-social-icon {
    color: #2D1E12;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-flex;
  }

  .tra-social-icon:hover {
    color: #9B1B30;
    transform: translateY(-2px);
  }

  /* 2. Hero Section & Character Stage */
  .tra-hero-section {
    padding: 50px 24px 30px;
    text-align: center;
  }

  .tra-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
