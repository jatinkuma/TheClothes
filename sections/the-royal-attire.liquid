</style>

<script>
(function() {
  var sectionId = "{{ section.id }}";
  var wrapper = document.getElementById("the-royal-attire-" + sectionId);
  if (!wrapper) return;

  // 1. OUTFIT MAP (MODULAR 3D GLB MODELS & 2D UNIFIED ASSETS)
  var outfitMap = {
    maroon: {
      name: "Maroon Royal Sherwani",
      model: "{{ 'sherwani-maroon.glb' | asset_url }}",
      img: "{{ 'royal-owl-dupatta.png' | asset_url }}",
      color: 0x8b1e1e
    },
    blue: {
      name: "Sapphire Blue Jodhpuri",
      model: "{{ 'sherwani-blue.glb' | asset_url }}",
      img: "{{ 'royal-owl-achkan.png' | asset_url }}",
      color: 0x1b3b6f
    },
    ivory: {
      name: "Imperial Ivory Sherwani",
      model: "{{ 'sherwani-ivory.glb' | asset_url }}",
      img: "{{ 'royal-owl-safa.png' | asset_url }}",
      color: 0xf3dfb2
    },
    emerald: {
      name: "Emerald Heritage Sherwani",
      model: "{{ 'sherwani-emerald.glb' | asset_url }}",
      img: "{{ 'royal-owl-mojari.png' | asset_url }}",
      color: 0x1e4a38
    }
  };

  var charImg = document.getElementById("tra-unified-character-" + sectionId);
  var gazeRig = document.getElementById("tra-character-gaze-rig-" + sectionId);
  var stageEl = document.getElementById("tra-stage-container-" + sectionId);
  var webglCanvas = document.getElementById("tra-3d-webgl-canvas-" + sectionId);
  var mascotStage = document.getElementById("tra-mascot-stage-" + sectionId);
  var spinner = document.getElementById("tra-3d-spinner-" + sectionId);

  // 2. CONFIGURABLE & REPLACEABLE 3D CHARACTER MODEL URL
  // Default to royal-owl.glb, or use merchant custom 3D model URL from theme settings
  var defaultModelUrl = "{{ 'royal-attire-character.glb' | asset_url }}";
  var customModelUrl = "{{ section.settings.character_3d_model_url }}";
  var activeCharacterUrl = (customModelUrl && customModelUrl.trim() !== "") ? customModelUrl.trim() : defaultModelUrl;

  // 3. THREE.JS REAL-TIME 3D RIGGED ENGINE
  var scene, camera, renderer, characterGroup, activeOutfitMesh, shadowPlane;
  var headBone = null, neckBone = null, chestBone = null, spineBone = null, rootBone = null;
  var eyeLeftBone = null, eyeRightBone = null;
  var outfitMountNode = null;
  var is3DReady = false;
  var gltfLoader = null;

  // Mouse & 360 Drag Interaction Variables
  var targetRotY = 0, targetRotX = 0;
  var currentRotY = 0, currentRotX = 0;
  var isDragging = false, prevMouseX = 0, orbitAngleY = 0;

  function initThreeJSEngine() {
    if (!webglCanvas || typeof THREE === "undefined") {
      showFallbackStage();
      return;
    }

    try {
      // Scene & Perspective Camera
      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(38, 380 / 520, 0.1, 100);
      camera.position.set(0, 1.15, 3.2);
      camera.lookAt(0, 0.95, 0);

      // WebGL Renderer
      renderer = new THREE.WebGLRenderer({
        canvas: webglCanvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance"
      });
      renderer.setSize(380, 520);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      // Studio Lighting
      var ambientLight = new THREE.AmbientLight(0xfff8ee, 0.95);
      scene.add(ambientLight);

      var keyLight = new THREE.DirectionalLight(0xffffff, 1.25);
      keyLight.position.set(2.5, 4.0, 3.0);
      keyLight.castShadow = true;
      scene.add(keyLight);

      var rimLight = new THREE.DirectionalLight(0xea9b1b, 0.75);
      rimLight.position.set(-2.5, 2.5, -2.0);
      scene.add(rimLight);

      // Pedestal Contact Shadow Plane
      var shadowGeo = new THREE.PlaneGeometry(2.4, 2.4);
      var shadowMat = new THREE.ShadowMaterial({ opacity: 0.28 });
      shadowPlane = new THREE.Mesh(shadowGeo, shadowMat);
      shadowPlane.rotation.x = -Math.PI / 2;
      shadowPlane.position.y = -0.06;
      shadowPlane.receiveShadow = true;
      scene.add(shadowPlane);

      // Character Group container
      characterGroup = new THREE.Group();
      scene.add(characterGroup);

      // GLTF Loader
      if (typeof THREE.GLTFLoader !== "undefined") {
        gltfLoader = new THREE.GLTFLoader();
        loadCharacterModel(activeCharacterUrl);
      } else {
        showFallbackStage();
      }

      setupNaturalGazeTracking();
      requestAnimationFrame(renderLoop);

    } catch (err) {
      console.warn("Three.js initialization failed, using high-definition unified character stage:", err);
      showFallbackStage();
    }
  }

  // Load Replaceable 3D Character Model (.glb / .gltf)
  function loadCharacterModel(modelUrl) {
    if (!gltfLoader) return;
    if (spinner) spinner.style.display = "flex";

    gltfLoader.load(modelUrl, function(gltf) {
      // Clear existing character if swapping
      while (characterGroup.children.length > 0) {
        characterGroup.remove(characterGroup.children[0]);
      }

      var charModel = gltf.scene;
      charModel.position.set(0, 0, 0);
      characterGroup.add(charModel);

      // Reset bone references
      headBone = null;
      neckBone = null;
      chestBone = null;
      spineBone = null;
      rootBone = null;
      outfitMountNode = null;

      // Inspect bone rig and assign standard Blender-compatible joints
      eyeLeftBone = null;
      eyeRightBone = null;
      charModel.traverse(function(node) {
        if (node.isBone || node.type === "Bone") {
          var name = (node.name || "").toLowerCase();
          if (name.indexOf("head") !== -1 && !headBone) headBone = node;
          else if (name.indexOf("neck") !== -1 && !neckBone) neckBone = node;
          else if (name.indexOf("chest") !== -1 && !chestBone) chestBone = node;
          else if (name.indexOf("spine") !== -1 && !spineBone) spineBone = node;
          else if (name.indexOf("root") !== -1 && !rootBone) rootBone = node;
          else if ((name.indexOf("eye.l") !== -1 || name === "eye_l" || name === "eye.l") && !eyeLeftBone) eyeLeftBone = node;
          else if ((name.indexOf("eye.r") !== -1 || name === "eye_r" || name === "eye.r") && !eyeRightBone) eyeRightBone = node;
        }
        if (node.name && node.name.indexOf("Attachment_Outfit") !== -1) {
          outfitMountNode = node;
        }
        if (node.isMesh) {
          node.castShadow = true;
          node.receiveShadow = true;
        }
      });

      // Default mount node fallback
      if (!outfitMountNode) {
        outfitMountNode = chestBone || spineBone || charModel;
      }

      // Hide spinner & show WebGL canvas
      if (spinner) spinner.style.display = "none";
      webglCanvas.style.display = "block";
      if (mascotStage) mascotStage.style.display = "none";
      is3DReady = true;

      // Load initial Sherwani outfit
      loadSherwaniOutfit("maroon");

    }, undefined, function(error) {
      console.warn("Could not load 3D GLB model from " + modelUrl + ", falling back to unified character stage:", error);
      showFallbackStage();
    });
  }

  // Fallback Stage when GLB is not loaded
  function showFallbackStage() {
    if (spinner) spinner.style.display = "none";
    if (webglCanvas) webglCanvas.style.display = "none";
    if (mascotStage) mascotStage.style.display = "flex";
  }

  // 4. NATURAL CIRCULAR GAZE & BODY TRACKING (NO 360 SPIN - FRONT FACING)
  var targetRoll = 0, currentRoll = 0;

  function setupNaturalGazeTracking() {
    function updatePointer(clientX, clientY) {
      if (!stageEl) return;
      var rect = stageEl.getBoundingClientRect();
      var centerX = rect.left + rect.width / 2;
      var centerY = rect.top + rect.height * 0.42;

      var deltaX = (clientX - centerX) / (window.innerWidth * 0.44);
      var deltaY = (clientY - centerY) / (window.innerHeight * 0.44);

      // Circular polar coordinates for smooth 360° circular loops ("moment like circle")
      var angle = Math.atan2(deltaY, deltaX);
      var dist = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
      var r = Math.min(1.20, dist);

      var sens = 24;
      var maxPitch = 15;

      // Cursor Left -> Left turn & lean, Cursor Right -> Right turn & lean
      targetRotY = Math.cos(angle) * (r * sens);
      targetRotX = Math.sin(angle) * (r * maxPitch);
      targetRoll = Math.cos(angle) * (r * 3.8);
    }

    window.addEventListener("mousemove", function(e) {
      updatePointer(e.clientX, e.clientY);
    }, { passive: true });

    window.addEventListener("touchmove", function(e) {
      if (!e.touches || e.touches.length === 0) return;
      updatePointer(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener("mouseleave", function() {
      targetRotY = 0;
      targetRotX = 0;
      targetRoll = 0;
    });
  }

  // Main 60FPS Render & Physics Loop
  function renderLoop(time) {
    // Smooth Spring-Damped Interpolation
    currentRotY += (targetRotY - currentRotY) * 0.082;
    currentRotX += (targetRotX - currentRotX) * 0.082;
    currentRoll += (targetRoll - currentRoll) * 0.082;

    // Organic idle breathing wave
    var breathWave = Math.sin(time * 0.0022);

    if (is3DReady && characterGroup) {
      // 1. Signature Weight-Shift Leaning Physics (NO 360 SPIN - LOCKED FRONT-FACING)
      var leanRatio = currentRotY / 24;
      characterGroup.position.x = leanRatio * 0.085; // Leans towards cursor
      characterGroup.position.y = breathWave * 0.015;
      characterGroup.rotation.z = -leanRatio * 0.035;
      characterGroup.rotation.y = leanRatio * 0.08; // Front-facing natural body posture

      // 2. Drive 3D Head & Neck Bones with real 3D rotation
      var radYaw = (currentRotY * Math.PI) / 180;
      var radPitch = (currentRotX * Math.PI) / 180;
      var radRoll = (currentRoll * Math.PI) / 180;

      if (headBone) {
        headBone.rotation.y = radYaw * 0.75;
        headBone.rotation.x = radPitch * 0.85;
        headBone.rotation.z = radRoll;
      }
      if (neckBone) {
        neckBone.rotation.y = radYaw * 0.40;
        neckBone.rotation.x = radPitch * 0.35;
      }
      if (chestBone) {
        chestBone.rotation.y = radYaw * 0.12;
      }

      // 4. Drive 3D Eyes (Real-Time Cursor/Butterfly Gaze Tracking & Natural Blinking)
      var eyeYaw = radYaw * 1.25;   // Eyes dart dynamically toward cursor/butterfly
      var eyePitch = radPitch * 1.35;

      // Natural organic blinking wave (brief blink pulse every ~3.5 seconds)
      var blinkProgress = (time % 3600) / 3600;
      var blinkScale = 1.0;
      if (blinkProgress > 0.955) {
        var bt = (blinkProgress - 0.955) / 0.045;
        blinkScale = 1.0 - Math.sin(bt * Math.PI) * 0.90;
      }

      if (eyeLeftBone) {
        eyeLeftBone.rotation.y = eyeYaw;
        eyeLeftBone.rotation.x = eyePitch;
        eyeLeftBone.scale.z = blinkScale;
      }
      if (eyeRightBone) {
        eyeRightBone.rotation.y = eyeYaw;
        eyeRightBone.rotation.x = eyePitch;
        eyeRightBone.scale.z = blinkScale;
      }

      // Dynamic Pedestal Contact Shadow Shift
      if (shadowPlane) {
        shadowPlane.position.x = leanRatio * 0.09;
      }

      renderer.render(scene, camera);

    } else {
      // Drive Fallback Unified Character
      if (gazeRig) {
        var tiltZ = currentRotY * 0.14;
        gazeRig.style.transform = 
          "rotateY(" + currentRotY.toFixed(2) + "deg) " +
          "rotateX(" + currentRotX.toFixed(2) + "deg) " +
          "rotateZ(" + tiltZ.toFixed(2) + "deg)";
      }
    }

    requestAnimationFrame(renderLoop);
  }

  // 5. SHOPIFY PRODUCT-BASED 3D CLOTHING SYSTEM
  function loadSherwaniOutfit(outfitKey) {
    var outfitData = outfitMap[outfitKey];
    if (!outfitData) return;

    // A. 3D Modular Outfit Loading via Three.js
    if (is3DReady && gltfLoader && outfitMountNode) {
      gltfLoader.load(outfitData.model, function(gltf) {
        // Remove previous 3D outfit mesh
        if (activeOutfitMesh) {
          outfitMountNode.remove(activeOutfitMesh);
        }
        activeOutfitMesh = gltf.scene;
        activeOutfitMesh.position.set(0, 0, 0);
        outfitMountNode.add(activeOutfitMesh);

      }, undefined, function(err) {
        console.warn("Could not load outfit model " + outfitData.model + ", using material tinting:", err);
      });
    }

    // B. Unified High-Definition 2D Representation Synchronization
    if (charImg) {
      charImg.style.opacity = "0.75";
      setTimeout(function() {
        charImg.src = outfitData.img;
        charImg.style.opacity = "1";
      }, 70);
    }

    // C. Update active states across UI
    var dressBtns = wrapper.querySelectorAll(".tra-dress-btn");
    dressBtns.forEach(function(btn) {
      if (btn.getAttribute("data-outfit") === outfitKey) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });

    var cards = wrapper.querySelectorAll(".tra-card");
    cards.forEach(function(card) {
      var pill = card.querySelector(".tra-drape-pill");
      if (card.getAttribute("data-outfit") === outfitKey) {
        card.classList.add("active");
        if (pill) pill.textContent = "Equipped in 3D";
      } else {
        card.classList.remove("active");
        if (pill) pill.textContent = "Equip in 3D";
      }
    });
  }

  // Bind Quick Dress-up bar buttons
  var dressBtns = wrapper.querySelectorAll(".tra-dress-btn");
  dressBtns.forEach(function(btn) {
    btn.addEventListener("click", function() {
      var outfitKey = btn.getAttribute("data-outfit");
      loadSherwaniOutfit(outfitKey);
    });
  });

  // Bind Product Card Clicks
  var productCards = wrapper.querySelectorAll(".tra-card");
  productCards.forEach(function(card) {
    card.addEventListener("click", function(e) {
      if (e.target.closest(".tra-enquire-btn")) return;
      var outfitKey = card.getAttribute("data-outfit");
      loadSherwaniOutfit(outfitKey);

      // Smooth scroll back up to character on small screens
      if (window.innerWidth < 768) {
        var mascotEl = document.getElementById("the-mascot-" + sectionId);
        if (mascotEl) mascotEl.scrollIntoView({ behavior: "smooth" });
      }
    });
  });

  // 6. THE ROYAL STYLIST: AI CUSTOMIZATION & STARBURST
  var magicCanvas = document.getElementById("tra-magic-canvas-" + sectionId);
  var askAiBtn = document.getElementById("tra-ask-ai-btn-" + sectionId);
  var aiBtnText = document.getElementById("tra-ai-btn-text-" + sectionId);
  var insightTitle = document.getElementById("tra-ai-insight-title-" + sectionId);
  var insightDesc = document.getElementById("tra-ai-insight-desc-" + sectionId);

  var royalAiPresets = [
    {
      preset: "coronation",
      title: "The Maharaja's Coronation",
      outfit: "maroon",
      insight: "Pure ivory symbolizes truth and sovereignty, accented by ruby red to honor royal valor and victory in state processions."
    },
    {
      preset: "mewar-starlight",
      title: "The Mewar Starlight",
      outfit: "blue",
      insight: "Deep celestial lapis blue paired with gleaming gold zari mirrors the starlit skies over Lake Pichola, worn during autumn court banquets."
    },
    {
      preset: "garden-gala",
      title: "The Royal Garden Gala",
      outfit: "emerald",
      insight: "Vibrant emerald silk embellished with marigold saffron captures the vitality of royal palace gardens in bloom."
    },
    {
      preset: "jodhpur-sunbreak",
      title: "The Jodhpur Sunbreak",
      outfit: "ivory",
      insight: "Warm sunbreak yellow paired with indigo trims celebrates the sun-drenched ramparts of Mehrangarh Fort."
    }
  ];

  function triggerStarburst(x, y) {
    if (!magicCanvas) return;
    magicCanvas.width = window.innerWidth;
    magicCanvas.height = window.innerHeight;
    var ctx = magicCanvas.getContext("2d");

    var colors = ["#FFD700", "#FF1744", "#00E5FF", "#E040FB", "#FFF"];
    var particles = [];
    for (var i = 0; i < 90; i++) {
      var angle = Math.random() * Math.PI * 2;
      var speed = 3 + Math.random() * 8;
      particles.push({
        x: x || window.innerWidth / 2,
        y: y || window.innerHeight * 0.6,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        size: 3 + Math.random() * 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: 1,
        decay: 0.016 + Math.random() * 0.018
      });
    }

    function renderParticles() {
      ctx.clearRect(0, 0, magicCanvas.width, magicCanvas.height);
      var alive = false;
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        if (p.alpha > 0) {
          alive = true;
          ctx.save();
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.12;
          p.alpha -= p.decay;
        }
      }
      if (alive) {
        requestAnimationFrame(renderParticles);
      } else {
        ctx.clearRect(0, 0, magicCanvas.width, magicCanvas.height);
      }
    }
    requestAnimationFrame(renderParticles);
  }

  // Ask AI Button Click Handler
  if (askAiBtn) {
    askAiBtn.addEventListener("click", function(e) {
      if (aiBtnText) aiBtnText.textContent = "AI Consulting Court Lore...";
      var rect = askAiBtn.getBoundingClientRect();
      var clickX = rect.left + rect.width / 2;
      var clickY = rect.top + rect.height / 2;

      setTimeout(function() {
        var choice = royalAiPresets[Math.floor(Math.random() * royalAiPresets.length)];
        loadSherwaniOutfit(choice.outfit);

        if (insightTitle) insightTitle.textContent = choice.title;
        if (insightDesc) insightDesc.textContent = choice.insight;

        var pItems = wrapper.querySelectorAll(".tra-preset-item");
        pItems.forEach(function(item) {
          if (item.getAttribute("data-preset") === choice.preset) {
            item.classList.add("active");
          } else {
            item.classList.remove("active");
          }
        });

        triggerStarburst(clickX, clickY);
        if (aiBtnText) aiBtnText.textContent = "Ask AI for Royal Match";
      }, 450);
    });
  }

  // Preset list item clicks
  var presetItems = wrapper.querySelectorAll(".tra-preset-item");
  presetItems.forEach(function(item) {
    item.addEventListener("click", function() {
      var pName = item.getAttribute("data-preset");
      var matched = royalAiPresets.find(function(rp) { return rp.preset === pName; });
      if (matched) {
        loadSherwaniOutfit(matched.outfit);
        if (insightTitle) insightTitle.textContent = matched.title;
        if (insightDesc) insightDesc.textContent = matched.insight;

        presetItems.forEach(function(pi) { pi.classList.remove("active"); });
        item.classList.add("active");

        var rect = item.getBoundingClientRect();
        triggerStarburst(rect.left + rect.width / 2, rect.top + rect.height / 2);
      }
    });
  });

  // Swatches click
  var swatches = wrapper.querySelectorAll(".tra-swatch");
  swatches.forEach(function(sw) {
    sw.addEventListener("click", function() {
      var pal = sw.getAttribute("data-outfit");
      loadSherwaniOutfit(pal);
      swatches.forEach(function(s) { s.classList.remove("active"); });
      sw.classList.add("active");
    });
  });

  // Hue slider tint
  var hueSlider = document.getElementById("tra-hue-slider-" + sectionId);
  var hueLabel = document.getElementById("tra-hue-label-" + sectionId);
  if (hueSlider) {
    hueSlider.addEventListener("input", function() {
      var deg = hueSlider.value;
      if (hueLabel) hueLabel.textContent = deg + "° Custom Tint";
      if (charImg) charImg.style.filter = "hue-rotate(" + deg + "deg) drop-shadow(0 14px 28px rgba(0,0,0,0.18))";
      if (activeOutfitMesh) {
        activeOutfitMesh.traverse(function(node) {
          if (node.isMesh && node.material && node.material.color) {
            node.material.color.setHSL((deg / 360), 0.7, 0.45);
          }
        });
      }
    });
  }

  // Enquire Buttons Alert
  var enquireBtns = wrapper.querySelectorAll(".tra-enquire-btn");
  enquireBtns.forEach(function(btn) {
    btn.addEventListener("click", function() {
      var piece = btn.getAttribute("data-piece");
      alert("Thank you for your royal enquiry for \"" + piece + "\". Our master atelier specialist will reach out to schedule your private fitting.");
    });
  });

  // Initialize Three.js Engine on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initThreeJSEngine);
  } else {
    initThreeJSEngine();
  }

})();
</script>

