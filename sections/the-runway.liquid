{{ 'the-runway.css' | asset_url | stylesheet_tag }}
<script src="{{ 'the-runway.js' | asset_url }}" defer="defer"></script>

<style>
.rw__cat-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 20px;
  background: color-mix(in srgb, var(--rw-accent) 10%, transparent);
  color: var(--rw-accent);
  border: 1px solid color-mix(in srgb, var(--rw-accent) 22%, transparent);
  margin-right: 6px;
  vertical-align: middle;
}
.rw__tick-cat {
  font-weight: 700;
  opacity: 0.65;
}
</style>

{%- liquid
  assign sec_heading = section.settings.heading | default: 'Try the Look.'
  assign sec_subheading = section.settings.subheading | default: 'Curated Men, Women & Couple Sets. Tap a pin to see the piece.'
  assign layout_style = section.settings.layout_style | default: 'ring'
  assign mobile_style = section.settings.mobile_style | default: 'ring'
  assign feel = section.settings.feel | default: 'balanced'
  assign speed = section.settings.speed | default: 5
  assign autoplay = section.settings.autoplay
  if autoplay == nil
    assign autoplay = true
  endif
  assign blur = section.settings.blur
  if blur == nil
    assign blur = true
  endif

  assign look_count = section.blocks.size
  if look_count == 0
    assign look_count = 6
  endif
-%}

<section id="shopify-section-{{ section.id }}" class="shopify-section section-the-runway">
<runway-section
  id="Runway-{{ section.id }}"
  class="rw rw--add-icon rw--popup rw--list has-dividers has-border"
  data-feel="{{ feel }}"
  data-blur="{% if blur %}true{% else %}false{% endif %}"
  data-mblur="{% if blur %}true{% else %}false{% endif %}"
  data-style="{{ layout_style }}"
  data-mstyle="{{ mobile_style }}"
  data-fit="true"
  data-height-mode="{{ section.settings.height_mode | default: 'original' }}"
  data-height-vh="{{ section.settings.height_vh | default: 100 }}"
  data-mheight-mode="{{ section.settings.mheight_mode | default: 'custom' }}"
  data-mheight-vh="{{ section.settings.mheight_vh | default: 109 }}"
  data-reflect="false"
  data-autoplay="{% if autoplay %}true{% else %}false{% endif %}"
  data-speed="{{ speed | times: 1000 }}"
  data-after-add="stay"
  data-money-format="{{ shop.money_format | escape }}"
  data-msg-choose="Pick a size for: [items]"
  data-msg-error="Couldn’t add to bag. Please try again."
  data-msg-soldout="Sold out"
  style="
    --rw-c-stage: {{ section.settings.color_stage | default: '#ffffff' }};
    --rw-c-panel: {{ section.settings.color_panel | default: '#ffffff' }};
    --rw-c-text: {{ section.settings.color_text | default: '#151413' }};
    --rw-c-muted: {{ section.settings.color_muted | default: '#66625c' }};
    --rw-c-accent: {{ section.settings.color_accent | default: '#0e0e0e' }};
    --rw-c-on-accent: {{ section.settings.color_on_accent | default: '#ffffff' }};
    --rw-c-line: {{ section.settings.color_line | default: '#c8c8c8' }};
    --rw-card: {{ section.settings.color_card | default: '#DFDFDF' }};
    --rw-hf: var(--font-heading--family, inherit);
    --rw-hw: var(--font-heading--weight, 400);
    --rw-h-d: 46px; --rw-h-m: 24px;
    --rw-sub-d: 12px; --rw-sub-m: 12px;
    --rw-eyebrow-d: 11px; --rw-eyebrow-m: 10px;
    --rw-label-d: 10px; --rw-label-m: 9px;
    --rw-chip-d: 17px; --rw-chip-m: 18px;
    --rw-ph-d: 18px; --rw-ph-m: 16px;
    --rw-pt-size-d: 13px; --rw-pt-size-m: 12px;
    --rw-price-d: 12px; --rw-price-m: 12px;
    --rw-opt-d: 11px; --rw-opt-m: 11px;
    --rw-total-d: 16px; --rw-total-m: 16px;
    --rw-thumb-d: 92px; --rw-thumb-m: 62px;
    --rw-tag-top: 18px; --rw-tag-left: 0px;
    --rw-thumb-radius: 0px;
    --rw-morph: 900ms; --rw-bar-r: 20px;
    --rw-panel-w: 380px;
    --rw-panel-pad-d: 32px;
    --rw-radius: 0px;
    --rw-max: none;
    --rw-speed: {{ speed }}s;
    --rw-ax: 40%;
    --rw-btn-radius: 0px; --rw-pill-radius: 30px; --rw-add-radius: 20px;
  "
>
  <div class="rw__sticky">
    <div class="rw__grid">
      <div class="rw__left">
        <div class="rw__head">
          <div class="rw__intro">
            <h2 class="rw__title">{{ sec_heading | escape }}</h2>
            <p class="rw__sub">{{ sec_subheading | escape }}</p>
          </div>
          <span class="rw__sr" aria-live="polite" aria-atomic="true" data-rw-live></span>
        </div>

        <div class="rw__stage" data-rw-stage tabindex="0" role="region" aria-roledescription="carousel" aria-label="Looks carousel">
          <span class="rw__walk" aria-hidden="true"><span class="rw__walk-line"></span></span>

          <!-- STAGE ACTORS (3D CAROUSEL) -->
          <div class="rw__actors" data-rw-actors>
            {%- for i in (0..5) -%}
              {%- if i < look_count -%}
                {%- assign blk = section.blocks[i] -%}
                {%- assign l_idx = i -%}
                {%- assign l_num = i | plus: 1 -%}
                {%- assign default_title = 'The City Edit' -%}
                {%- case i -%}
                  {%- when 0 -%}{%- assign default_title = "Men's Street Set" -%}{%- assign fb_img = 'rw-model-1.webp' -%}
                  {%- when 1 -%}{%- assign default_title = "Women's Atelier Fit" -%}{%- assign fb_img = 'rw-model-2.webp' -%}
                  {%- when 2 -%}{%- assign default_title = 'Couple Tee Pair' -%}{%- assign fb_img = 'rw-model-3.webp' -%}
                  {%- when 3 -%}{%- assign default_title = "Men's Utility Look" -%}{%- assign fb_img = 'rw-model-4.webp' -%}
                  {%- when 4 -%}{%- assign default_title = "Women's Relaxed Fit" -%}{%- assign fb_img = 'rw-model-5.webp' -%}
                  {%- when 5 -%}{%- assign default_title = 'His & Hers Matching Set' -%}{%- assign fb_img = 'rw-model-6.webp' -%}
                {%- endcase -%}
                {%- assign l_title = blk.settings.title | default: default_title -%}
                {%- assign m_img = blk.settings.model_image -%}

                <div class="rw__model" data-rw-model data-index="{{ l_idx }}" aria-hidden="true" {% if blk %}{{ blk.shopify_attributes }}{% endif %}>
                  <span class="rw__shadow" aria-hidden="true"></span>
                  <div class="rw__figure" style="--rw-ar: 0.5625;">
                    <div class="rw__art">
                      {%- if m_img != blank -%}
                        <img src="{{ m_img | image_url: width: 1100 }}" alt="{{ l_title | escape }}" srcset="{{ m_img | image_url: width: 360 }} 360w, {{ m_img | image_url: width: 540 }} 540w, {{ m_img | image_url: width: 720 }} 720w, {{ m_img | image_url: width: 900 }} 900w, {{ m_img | image_url: width: 1100 }} 1100w" width="1100" height="1956" loading="lazy" sizes="(min-width: 750px) 320px, 220px" draggable="false">
                      {%- else -%}
                        <img src="{{ fb_img | asset_url }}" alt="{{ l_title | escape }}" srcset="{{ fb_img | asset_url }} 1100w" width="1100" height="1956" loading="lazy" sizes="(min-width: 750px) 320px, 220px" draggable="false">
                      {%- endif -%}
                      <button type="button" class="rw__hit" data-rw-go="{{ l_idx }}" aria-label="Look {{ l_num }}: {{ l_title | escape }}" tabindex="-1"></button>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- FOREGROUND HEROES (ACTIVE LOOK WITH HOTSPOT PINS) -->
          <div class="rw__heroes" data-rw-heroes>
            {%- for i in (0..5) -%}
              {%- if i < look_count -%}
                {%- assign blk = section.blocks[i] -%}
                {%- assign l_idx = i -%}
                {%- assign l_num = i | plus: 1 -%}
                {%- assign default_title = 'The City Edit' -%}
                {%- case i -%}
                  {%- when 0 -%}{%- assign default_title = "Men's Street Set" -%}{%- assign fb_img = 'rw-model-1.webp' -%}
                  {%- when 1 -%}{%- assign default_title = "Women's Atelier Fit" -%}{%- assign fb_img = 'rw-model-2.webp' -%}
                  {%- when 2 -%}{%- assign default_title = 'Couple Tee Pair' -%}{%- assign fb_img = 'rw-model-3.webp' -%}
                  {%- when 3 -%}{%- assign default_title = "Men's Utility Look" -%}{%- assign fb_img = 'rw-model-4.webp' -%}
                  {%- when 4 -%}{%- assign default_title = "Women's Relaxed Fit" -%}{%- assign fb_img = 'rw-model-5.webp' -%}
                  {%- when 5 -%}{%- assign default_title = 'His & Hers Matching Set' -%}{%- assign fb_img = 'rw-model-6.webp' -%}
                {%- endcase -%}
                {%- assign l_title = blk.settings.title | default: default_title -%}
                {%- assign m_img = blk.settings.model_image -%}

                {%- if m_img != blank -%}
                  {%- assign probe_url = m_img | image_url: width: 96 -%}
                  {%- assign hero_img_url = m_img | image_url: width: 1100 -%}
                {%- else -%}
                  {%- assign probe_url = fb_img | asset_url -%}
                  {%- assign hero_img_url = fb_img | asset_url -%}
                {%- endif -%}

                <div class="rw__hero{% if l_idx == 0 %} is-on{% endif %}" data-rw-hero data-index="{{ l_idx }}" data-name="{{ l_title | escape }}" data-label="Look {{ l_num }}: {{ l_title | escape }}" data-probe="{{ probe_url }}" {% if blk %}{{ blk.shopify_attributes }}{% endif %}>
                  <div class="rw__morph">
                    <span class="rw__shadow" aria-hidden="true"></span>
                    <div class="rw__figure" style="--rw-ar: 0.5625;">
                      <div class="rw__art">
                        <img src="{{ hero_img_url }}" alt="{{ l_title | escape }}" width="1100" height="1956" loading="{% if l_idx == 0 %}eager{% else %}lazy{% endif %}" sizes="(min-width: 750px) 320px, 220px" draggable="false">
                        <button type="button" class="rw__zoom" data-rw-zoom aria-label="View look: {{ l_title | escape }}" tabindex="-1"></button>
                        <div class="rw__pins">
                          {%- if blk.settings.product_1 != blank -%}
                            <!-- Custom Piece 1 -->
                            <button type="button" class="rw__pin" data-rw-pin="1" data-tip="{{ blk.settings.piece_1_label | default: blk.settings.product_1.title | escape }}" style="left: {{ blk.settings.pin_1_x | default: 48 }}%; top: {{ blk.settings.pin_1_y | default: 38 }}%; --pi: 1;" aria-label="1: {{ blk.settings.product_1.title | escape }}" tabindex="-1">
                              <span class="rw__pin-dot" aria-hidden="true">1</span>
                            </button>
                            {%- if blk.settings.product_2 != blank -%}
                              <!-- Custom Piece 2 -->
                              <button type="button" class="rw__pin" data-rw-pin="2" data-tip="{{ blk.settings.piece_2_label | default: blk.settings.product_2.title | escape }}" style="left: {{ blk.settings.pin_2_x | default: 48 }}%; top: {{ blk.settings.pin_2_y | default: 72 }}%; --pi: 2;" aria-label="2: {{ blk.settings.product_2.title | escape }}" tabindex="-1">
                                <span class="rw__pin-dot" aria-hidden="true">2</span>
                              </button>
                            {%- endif -%}
                            {%- if blk.settings.product_3 != blank -%}
                              <!-- Custom Piece 3 -->
                              <button type="button" class="rw__pin" data-rw-pin="3" data-tip="{{ blk.settings.piece_3_label | default: blk.settings.product_3.title | escape }}" style="left: {{ blk.settings.pin_3_x | default: 50 }}%; top: {{ blk.settings.pin_3_y | default: 50 }}%; --pi: 3;" aria-label="3: {{ blk.settings.product_3.title | escape }}" tabindex="-1">
                                <span class="rw__pin-dot" aria-hidden="true">3</span>
                              </button>
                            {%- endif -%}
                            {%- if blk.settings.product_4 != blank -%}
                              <!-- Custom Piece 4 -->
                              <button type="button" class="rw__pin" data-rw-pin="4" data-tip="{{ blk.settings.piece_4_label | default: blk.settings.product_4.title | escape }}" style="left: {{ blk.settings.pin_4_x | default: 50 }}%; top: {{ blk.settings.pin_4_y | default: 50 }}%; --pi: 4;" aria-label="4: {{ blk.settings.product_4.title | escape }}" tabindex="-1">
                                <span class="rw__pin-dot" aria-hidden="true">4</span>
                              </button>
                            {%- endif -%}
                          {%- else -%}
                            <!-- Default Men, Women & Couple Pair Hotspot Pins -->
                            {%- case l_idx -%}
                              {%- when 0 -%}
                                <button type="button" class="rw__pin" data-rw-pin="1" data-tip="Men's Urban Culture Tee" style="left: 48%; top: 38%; --pi: 1;" aria-label="1: Men's Urban Culture Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">1</span></button>
                                <button type="button" class="rw__pin" data-rw-pin="2" data-tip="Cargo Streetwear Joggers" style="left: 48%; top: 72%; --pi: 2;" aria-label="2: Cargo Streetwear Joggers" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">2</span></button>
                              {%- when 1 -%}
                                <button type="button" class="rw__pin" data-rw-pin="1" data-tip="Women's Cropped Boxy Tee" style="left: 50%; top: 36%; --pi: 1;" aria-label="1: Women's Cropped Boxy Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">1</span></button>
                                <button type="button" class="rw__pin" data-rw-pin="2" data-tip="Women's Fleece Joggers" style="left: 48%; top: 70%; --pi: 2;" aria-label="2: Women's Fleece Joggers" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">2</span></button>
                              {%- when 2 -%}
                                <button type="button" class="rw__pin" data-rw-pin="1" data-tip="His Oversized Tee" style="left: 42%; top: 38%; --pi: 1;" aria-label="1: His Oversized Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">1</span></button>
                                <button type="button" class="rw__pin" data-rw-pin="2" data-tip="Her Boxy Street Tee" style="left: 58%; top: 42%; --pi: 2;" aria-label="2: Her Boxy Street Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">2</span></button>
                              {%- when 3 -%}
                                <button type="button" class="rw__pin" data-rw-pin="1" data-tip="Men's Acid Wash Tee" style="left: 50%; top: 36%; --pi: 1;" aria-label="1: Men's Acid Wash Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">1</span></button>
                                <button type="button" class="rw__pin" data-rw-pin="2" data-tip="Men's Olive Cargo Pants" style="left: 48%; top: 70%; --pi: 2;" aria-label="2: Men's Olive Cargo Pants" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">2</span></button>
                              {%- when 4 -%}
                                <button type="button" class="rw__pin" data-rw-pin="1" data-tip="Women's Boxy Street Tee" style="left: 50%; top: 36%; --pi: 1;" aria-label="1: Women's Boxy Street Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">1</span></button>
                                <button type="button" class="rw__pin" data-rw-pin="2" data-tip="Women's Utility Joggers" style="left: 48%; top: 70%; --pi: 2;" aria-label="2: Women's Utility Joggers" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">2</span></button>
                              {%- when 5 -%}
                                <button type="button" class="rw__pin" data-rw-pin="1" data-tip="His Matching Tee" style="left: 45%; top: 36%; --pi: 1;" aria-label="1: His Matching Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">1</span></button>
                                <button type="button" class="rw__pin" data-rw-pin="2" data-tip="Her Matching Tee" style="left: 55%; top: 38%; --pi: 2;" aria-label="2: Her Matching Tee" tabindex="-1"><span class="rw__pin-dot" aria-hidden="true">2</span></button>
                            {%- endcase -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- CONTROLS & TICKS -->
          <div class="rw__controls">
            <button type="button" class="rw__icon" data-rw-prev aria-label="Previous look">
              <svg width="26" height="14" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M25 7H1M7 1L1 7l6 6"/></svg>
            </button>
            <div class="rw__ticks">
              {%- for i in (0..5) -%}
                {%- if i < look_count -%}
                  {%- assign blk = section.blocks[i] -%}
                  {%- assign l_idx = i -%}
                  {%- assign l_num = i | plus: 1 -%}
                  {%- assign default_title = 'The City Edit' -%}
                  {%- assign default_cat = 'Men' -%}
                  {%- case i -%}
                    {%- when 0 -%}{%- assign default_title = "Men's Street Set" -%}{%- assign default_cat = 'Men' -%}
                    {%- when 1 -%}{%- assign default_title = "Women's Atelier Fit" -%}{%- assign default_cat = 'Women' -%}
                    {%- when 2 -%}{%- assign default_title = 'Couple Tee Pair' -%}{%- assign default_cat = 'Couple Pair' -%}
                    {%- when 3 -%}{%- assign default_title = "Men's Utility Look" -%}{%- assign default_cat = 'Men' -%}
                    {%- when 4 -%}{%- assign default_title = "Women's Relaxed Fit" -%}{%- assign default_cat = 'Women' -%}
                    {%- when 5 -%}{%- assign default_title = 'His & Hers Matching Set' -%}{%- assign default_cat = 'Matching Set' -%}
                  {%- endcase -%}
                  {%- assign l_title = blk.settings.title | default: default_title -%}
                  {%- assign l_category = blk.settings.category | default: default_cat -%}

                  <button type="button" class="rw__tick" data-rw-tick="{{ l_idx }}" aria-current="{% if l_idx == 0 %}true{% else %}false{% endif %}" aria-label="Look {{ l_num }}: {{ l_title | escape }}">
                    <span class="rw__tick-bar" aria-hidden="true"></span>
                    <span class="rw__tick-label" aria-hidden="true">0{{ l_num }}<span class="rw__tick-name">&nbsp;&nbsp;<span class="rw__tick-cat">[{{ l_category | escape }}]</span> {{ l_title | escape }}</span></span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="rw__icon" data-rw-next aria-label="Next look">
              <svg width="26" height="14" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1 7h24M19 1l6 6-6 6"/></svg>
            </button>
            <button type="button" class="rw__icon rw__auto" data-rw-auto-toggle aria-label="Pause autoplay">
              <svg class="rw__i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6 3v18M18 3v18"/></svg>
              <svg class="rw__i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6 3l13 9-13 9V3z"/></svg>
            </button>
          </div>

          <!-- LIGHTBOX MODAL -->
          <div class="rw__lb" data-rw-lb data-word="Look" role="region" aria-label="View look" aria-hidden="true">
            <div class="rw__lb-stage" data-rw-lb-stage></div>
            <div class="rw__lb-top">
              <p class="rw__lb-cap"><span class="rw__lb-kicker" data-rw-lb-kicker></span><span class="rw__lb-name" data-rw-lb-name></span></p>
              <button type="button" class="rw__lb-close" data-rw-zoom-close aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
              </button>
            </div>
            <p class="rw__lb-hint">Tap a dot to shop the piece</p>
          </div>
        </div>
      </div>

      <!-- SIDEBAR LOOKBOOK PANEL (MEN, WOMEN & COUPLE PAIRS) -->
      <aside class="rw__panel has-rule" aria-label="In this look">
        <div class="rw__panel-inner">
          <div class="rw__panel-head">
            <h3 class="rw__panel-title">In this look</h3>
            <span class="rw__label" data-rw-pieces>2 pieces</span>
          </div>

          {%- for i in (0..5) -%}
            {%- if i < look_count -%}
              {%- assign blk = section.blocks[i] -%}
              {%- assign l_idx = i -%}
              {%- assign l_num = i | plus: 1 -%}
              {%- assign default_title = 'The City Edit' -%}
              {%- assign default_cat = 'Men' -%}
              {%- case i -%}
                {%- when 0 -%}{%- assign default_title = "Men's Street Set" -%}{%- assign default_cat = 'Men' -%}
                {%- when 1 -%}{%- assign default_title = "Women's Atelier Fit" -%}{%- assign default_cat = 'Women' -%}
                {%- when 2 -%}{%- assign default_title = 'Couple Tee Pair' -%}{%- assign default_cat = 'Couple Pair' -%}
                {%- when 3 -%}{%- assign default_title = "Men's Utility Look" -%}{%- assign default_cat = 'Men' -%}
                {%- when 4 -%}{%- assign default_title = "Women's Relaxed Fit" -%}{%- assign default_cat = 'Women' -%}
                {%- when 5 -%}{%- assign default_title = 'His & Hers Matching Set' -%}{%- assign default_cat = 'Matching Set' -%}
              {%- endcase -%}
              {%- assign l_title = blk.settings.title | default: default_title -%}
              {%- assign l_category = blk.settings.category | default: default_cat -%}

              {%- comment -%} Determine pieces count {%- endcomment -%}
              {%- assign display_pieces = 2 -%}
              {%- if blk.settings.product_1 != blank -%}
                {%- assign display_pieces = 1 -%}
                {%- if blk.settings.product_2 != blank -%}{%- assign display_pieces = 2 -%}{%- endif -%}
                {%- if blk.settings.product_3 != blank -%}{%- assign display_pieces = 3 -%}{%- endif -%}
                {%- if blk.settings.product_4 != blank -%}{%- assign display_pieces = 4 -%}{%- endif -%}
              {%- endif -%}

              <div class="rw__look-panel{% if l_idx == 0 %} is-in{% endif %}" data-rw-panel="{{ l_idx }}"{% unless l_idx == 0 %} hidden{% endunless %} {% if blk %}{{ blk.shopify_attributes }}{% endif %}>
                <div class="rw__mhead">
                  <div class="rw__mhead-meta">
                    <span class="rw__cat-badge">{{ l_category | escape }}</span>
                    <span class="rw__mhead-title">{{ l_title | escape }}</span>
                  </div>
                  <span class="rw__label" data-rw-pieces-text>{{ display_pieces }} pieces</span>
                </div>

                <ul class="rw__items" role="list">
                  {%- if blk.settings.product_1 != blank -%}
                    {%- for p_i in (1..4) -%}
                      {%- capture p_key -%}product_{{ p_i }}{%- endcapture -%}
                      {%- capture label_key -%}piece_{{ p_i }}_label{%- endcapture -%}
                      {%- assign prod = blk.settings[p_key] -%}
                      {%- assign p_role = blk.settings[label_key] -%}
                      {%- if prod != blank -%}
                        <li class="rw__item" data-rw-card="{{ p_i }}" style="--i: {{ p_i }};" data-title="{{ prod.title | escape }}" data-price="{{ prod.price }}" data-selected="{{ prod.first_available_variant.id }}" data-variant-id="{% if prod.has_only_default_variant %}{{ prod.first_available_variant.id }}{% endif %}">
