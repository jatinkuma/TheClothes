                  {%- for p_i in (1..4) -%}
                    {%- capture p_key -%}product_{{ p_i }}{%- endcapture -%}
                    {%- assign p_prod = blk.settings[p_key] -%}
                    {%- if p_prod != blank -%}
                      {%- assign dynamic_look_total = dynamic_look_total | plus: p_prod.price -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- case l_idx -%}
                    {%- when 0 -%}{%- assign dynamic_look_total = 39800 -%}
                    {%- when 1 -%}{%- assign dynamic_look_total = 38800 -%}
                    {%- when 2 -%}{%- assign dynamic_look_total = 38800 -%}
                    {%- when 3 -%}{%- assign dynamic_look_total = 39800 -%}
                    {%- when 4 -%}{%- assign dynamic_look_total = 38800 -%}
                    {%- when 5 -%}{%- assign dynamic_look_total = 38800 -%}
                  {%- endcase -%}
