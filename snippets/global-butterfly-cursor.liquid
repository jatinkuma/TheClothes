{% comment %}
  GLOBAL BUTTERFLY CURSOR
  Active across all pages of the website.
  - Autonomous continuous 3D wing fluttering (flaps even when stationary)
  - Smooth linear-interpolation (lerp) trailing lag with buoyant hover
  - Royal Sapphire Blue & Imperial Gold luxury color combination
  - Non-intrusive: pointer-events: none; never blocks any clicks or buttons
{% endcomment %}

<div id="global-butterfly-cursor" class="global-butterfly-cursor" aria-hidden="true">
  <div class="gbc-ambient-glow"></div>
  <div class="gbc-wings-container">
    
    <!-- Left Wing -->
    <div class="gbc-wing gbc-wing-left">
      <svg viewBox="0 0 54 72" class="gbc-wing-svg">
        <defs>
          <linearGradient id="gbc-wing-grad-left" x1="100%" y1="100%" x2="0%" y2="0%">
            <stop offset="0%" stop-color="#0F2B5C"/>
            <stop offset="35%" stop-color="#1A62B8"/>
            <stop offset="70%" stop-color="#00D2FC"/>
            <stop offset="95%" stop-color="#FFD700"/>
          </linearGradient>
          <linearGradient id="gbc-gold-edge-left" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFE066"/>
            <stop offset="60%" stop-color="#D4AF37"/>
            <stop offset="100%" stop-color="#996515"/>
          </linearGradient>
        </defs>
        <!-- Upper Forewing -->
        <path d="M52,56 C42,42 16,22 6,4 C-2,-4 -2,8 5,22 C9,30 22,46 52,60 Z" 
              fill="url(#gbc-wing-grad-left)" stroke="url(#gbc-gold-edge-left)" stroke-width="1.2"/>
        <!-- Forewing Shimmer Veins -->
        <path d="M50,54 C36,40 22,26 12,12 M44,52 C32,42 24,34 14,24" 
              fill="none" stroke="rgba(255, 235, 150, 0.45)" stroke-width="0.8"/>
        <!-- Lower Hindwing -->
        <path d="M52,56 C40,54 20,48 12,36 C4,24 -2,36 6,48 C14,60 32,68 52,58 Z" 
              fill="url(#gbc-wing-grad-left)" opacity="0.9" stroke="url(#gbc-gold-edge-left)" stroke-width="1.2"/>
        <!-- Golden Margin Dots -->
        <circle cx="8" cy="18" r="1.2" fill="#FFF275"/>
        <circle cx="16" cy="30" r="1.2" fill="#FFF275"/>
        <circle cx="10" cy="46" r="1.2" fill="#FFF275"/>
      </svg>
    </div>

    <!-- Center Body & Antennae -->
    <div class="gbc-body">
      <div class="gbc-antennae"></div>
      <div class="gbc-thorax"></div>
      <div class="gbc-abdomen"></div>
    </div>

    <!-- Right Wing -->
    <div class="gbc-wing gbc-wing-right">
      <svg viewBox="0 0 54 72" class="gbc-wing-svg">
        <defs>
          <linearGradient id="gbc-wing-grad-right" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0F2B5C"/>
            <stop offset="35%" stop-color="#1A62B8"/>
            <stop offset="70%" stop-color="#00D2FC"/>
            <stop offset="95%" stop-color="#FFD700"/>
          </linearGradient>
          <linearGradient id="gbc-gold-edge-right" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#FFE066"/>
            <stop offset="60%" stop-color="#D4AF37"/>
            <stop offset="100%" stop-color="#996515"/>
          </linearGradient>
        </defs>
        <!-- Upper Forewing -->
        <path d="M2,56 C12,42 38,22 48,4 C56,-4 56,8 49,22 C45,30 32,46 2,60 Z" 
              fill="url(#gbc-wing-grad-right)" stroke="url(#gbc-gold-edge-right)" stroke-width="1.2"/>
        <!-- Forewing Shimmer Veins -->
        <path d="M4,54 C18,40 32,26 42,12 M10,52 C22,42 30,34 40,24" 
              fill="none" stroke="rgba(255, 235, 150, 0.45)" stroke-width="0.8"/>
        <!-- Lower Hindwing -->
        <path d="M2,56 C14,54 34,48 42,36 C50,24 56,36 48,48 C40,60 22,68 2,58 Z" 
              fill="url(#gbc-wing-grad-right)" opacity="0.9" stroke="url(#gbc-gold-edge-right)" stroke-width="1.2"/>
        <!-- Golden Margin Dots -->
        <circle cx="46" cy="18" r="1.2" fill="#FFF275"/>
        <circle cx="38" cy="30" r="1.2" fill="#FFF275"/>
        <circle cx="44" cy="46" r="1.2" fill="#FFF275"/>
      </svg>
    </div>

  </div>
</div>

<style>
  /* ==========================================================================
     GLOBAL BUTTERFLY CURSOR - STYLES
     ========================================================================== */
  .global-butterfly-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 48px;
    height: 48px;
    pointer-events: none !important;
    z-index: 2147483647 !important; /* Always on top of all elements */
    will-change: transform, opacity;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-100px, -100px);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .global-butterfly-cursor.is-active {
    opacity: 1;
  }

  /* Soft Royal Radiant Aura */
  .gbc-ambient-glow {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 210, 252, 0.45) 0%, rgba(255, 215, 0, 0.18) 45%, transparent 70%);
    pointer-events: none !important;
    filter: blur(4px);
  }

  .gbc-wings-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 500px;
    filter: drop-shadow(0 2px 8px rgba(15, 43, 92, 0.5));
  }

  /* Wings with continuous independent 3D fluttering */
  .gbc-wing {
    width: 21px;
    height: 28px;
    display: block;
    will-change: transform;
    pointer-events: none !important;
  }

  .gbc-wing-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .gbc-wing-left {
    transform-origin: 100% 50%;
    animation: gbcWingFlapLeft 0.125s infinite alternate ease-in-out;
  }

  .gbc-wing-right {
    transform-origin: 0% 50%;
    animation: gbcWingFlapRight 0.125s infinite alternate ease-in-out;
  }

  @keyframes gbcWingFlapLeft {
    0% {
      transform: rotateY(0deg) scaleX(1);
    }
    100% {
      transform: rotateY(70deg) scaleX(0.4);
    }
  }

  @keyframes gbcWingFlapRight {
    0% {
      transform: rotateY(0deg) scaleX(1);
    }
    100% {
      transform: rotateY(-70deg) scaleX(0.4);
    }
  }

  /* Anatomical Slender Torso */
  .gbc-body {
    position: relative;
    width: 3.5px;
    height: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
    pointer-events: none !important;
  }

  .gbc-antennae {
    position: absolute;
    top: -5px;
    width: 11px;
    height: 5px;
    border-top: 1.5px solid #101B2E;
    border-radius: 6px 6px 0 0;
  }

  .gbc-thorax {
    width: 3.5px;
    height: 6px;
    background: #182233;
    border-radius: 2px 2px 1px 1px;
    border: 0.5px solid #D4AF37;
  }

  .gbc-abdomen {
    width: 3px;
    height: 12px;
    background: linear-gradient(to bottom, #182233, #0A101C);
    border-radius: 1px 1px 2px 2px;
  }

  /* Hide butterfly on touch devices to preserve mobile ergonomics */
  @media (hover: none) and (pointer: coarse) {
    .global-butterfly-cursor {
      display: none !important;
    }
  }
</style>

<script>
(function() {
  // Prevent duplicate execution if snippet is included multiple times
  if (window.__globalButterflyInitialized) return;
  window.__globalButterflyInitialized = true;

  document.addEventListener("DOMContentLoaded", function() {
    var cursorEl = document.getElementById("global-butterfly-cursor");
    if (!cursorEl) return;

    var mouseX = window.innerWidth / 2;
    var mouseY = window.innerHeight / 2;
    var currentX = mouseX;
    var currentY = mouseY;
    var isMouseActive = false;
    var LERP_FACTOR = 0.14; // Smooth trailing lag

    window.addEventListener("mousemove", function(e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!isMouseActive) {
        isMouseActive = true;
        cursorEl.classList.add("is-active");
      }
    }, { passive: true });

    window.addEventListener("mouseleave", function() {
      cursorEl.classList.remove("is-active");
    });

    // 60FPS RAF Engine: Physics lag + buoyant hover
    function render(time) {
      currentX += (mouseX - currentX) * LERP_FACTOR;
      currentY += (mouseY - currentY) * LERP_FACTOR;

      // Gentle continuous hover float (flaps and floats even when mouse stops)
      var hoverFloatY = Math.sin(time * 0.0035) * 6;
      var hoverFloatX = Math.cos(time * 0.0028) * 4;

      var posX = currentX + hoverFloatX + 14;
      var posY = currentY + hoverFloatY - 22;

      cursorEl.style.transform = "translate3d(" + posX.toFixed(1) + "px, " + posY.toFixed(1) + "px, 0)";

      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);
  });
})();
</script>
